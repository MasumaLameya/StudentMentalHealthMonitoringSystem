@model StudentMentalHealthMonitoringSystem.ViewModels.AcademicAdministrationReportViewModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Academic Administration & Clearance Report";
}

<style>
    .glass-card-admin {
        background: #ffffff;
        border: 1px solid #E5D8CC;
        border-radius: 1.25rem;
        box-shadow: 0 8px 24px rgba(94, 80, 63, 0.06);
    }
    .metric-card-admin {
        background: #FAF6F0;
        border: 1px solid #EDE2D8;
        border-radius: 1rem;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .metric-card-admin:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(166, 124, 82, 0.12);
    }
    .table-admin thead th {
        background-color: #F4EEE8;
        color: #5E503F;
        font-weight: 700;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border-bottom: 2px solid #E5D8CC;
        padding: 0.9rem 0.75rem;
    }
    .table-admin tbody td {
        padding: 1rem 0.75rem;
        vertical-align: middle;
        border-bottom: 1px solid #F0E8DF;
    }
    .table-admin tbody tr:hover {
        background-color: #FCFAF8;
    }
</style>

<div class="container-fluid py-2">

    <!-- ================= Top Header Banner ================= -->
    <div class="card border-0 shadow-sm rounded-4 mb-4" style="background: linear-gradient(135deg, #1E293B 0%, #334155 100%);">
        <div class="card-body p-4 text-white">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div>
                    <div class="badge bg-white text-dark rounded-pill px-3 py-1.5 mb-2 fw-semibold shadow-sm">
                        <i class="bi bi-mortarboard-fill text-primary me-1"></i> Academic Administration &amp; Governance
                    </div>
                    <h2 class="fw-bold mb-1 text-white">
                        <i class="bi bi-file-earmark-ruled me-2"></i> Academic Administration &amp; Clearance Report
                    </h2>
                    <p class="text-white-50 mb-0 fs-6">
                        Monitor university-wide screening compliance, department coordinator action notices, and course registration clearance status.
                    </p>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <button type="button" onclick="window.print()" class="btn btn-outline-light rounded-pill px-3 py-2 fw-semibold">
                        <i class="bi bi-printer me-1"></i> Print Report
                    </button>
                    <a asp-controller="Admin" asp-action="Reports" class="btn btn-light rounded-pill px-4 py-2 fw-semibold shadow-sm">
                        <i class="bi bi-arrow-left me-1"></i> Back to Hub
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- ================= KPI Summary Metric Cards ================= -->
    <div class="row g-3 mb-4">
        <div class="col-xl-2 col-md-4 col-sm-6">
            <div class="metric-card-admin p-3 text-center h-100">
                <small class="text-muted text-uppercase fw-bold d-block mb-1" style="font-size: 0.72rem;">Total Campus Enrollment</small>
                <h3 class="fw-bold mb-0" style="color: #1E293B;">@Model.TotalCampusStudents</h3>
                <small class="text-muted">Enrolled Students</small>
            </div>
        </div>

        <div class="col-xl-3 col-md-4 col-sm-6">
            <div class="metric-card-admin p-3 text-center h-100 border-success-subtle" style="background:#F0FDF4;">
                <small class="text-success text-uppercase fw-bold d-block mb-1" style="font-size: 0.72rem;">Cleared for Course Registration</small>
                <h3 class="fw-bold mb-0 text-success">@Model.TotalClearedStudents</h3>
                <small class="text-success-emphasis">Screening 100% Completed</small>
            </div>
        </div>

        <div class="col-xl-3 col-md-4 col-sm-6">
            <div class="metric-card-admin p-3 text-center h-100 border-danger-subtle" style="background:#FEF2F2;">
                <small class="text-danger text-uppercase fw-bold d-block mb-1" style="font-size: 0.72rem;">Registration Locked / Blocked</small>
                <h3 class="fw-bold mb-0 text-danger">@Model.TotalBlockedStudents</h3>
                <small class="text-danger-emphasis">Non-Compliant Students</small>
            </div>
        </div>

        <div class="col-xl-2 col-md-6 col-sm-6">
            <div class="metric-card-admin p-3 text-center h-100 border-warning-subtle" style="background:#FFFBEB;">
                <small class="text-warning-emphasis text-uppercase fw-bold d-block mb-1" style="font-size: 0.72rem;">High-Risk Under Care</small>
                <h3 class="fw-bold mb-0 text-warning-emphasis">@Model.TotalHighRiskMonitored</h3>
                <small class="text-muted">Academic Monitoring</small>
            </div>
        </div>

        <div class="col-xl-2 col-md-6 col-sm-12">
            <div class="metric-card-admin p-3 text-center h-100" style="background:#F8FAFC;">
                <small class="text-primary text-uppercase fw-bold d-block mb-1" style="font-size: 0.72rem;">Campus Clearance Rate</small>
                <h3 class="fw-bold mb-0 text-primary">@Model.OverallCampusClearanceRate%</h3>
                <small class="text-muted">Institutional Metric</small>
            </div>
        </div>
    </div>

    <!-- ================= Departmental Clearance Cards ================= -->
    <div class="glass-card-admin mb-4">
        <div class="card-header border-0 py-3" style="background:#F4EEE8;">
            <h5 class="mb-0 fw-bold" style="color:#5E503F;">
                <i class="bi bi-buildings me-2"></i> Departmental Clearance &amp; Coordinator Action Summary
            </h5>
        </div>
        <div class="card-body p-4">
            <div class="row g-3">
                @foreach (var dept in Model.DepartmentStatuses)
                {
                    <div class="col-xl-3 col-md-6">
                        <div class="p-3 rounded-4" style="background:#FAF6F0; border:1px solid #EDE2D8;">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <strong class="text-dark fs-6">@dept.DepartmentName</strong>
                                <span class="badge @(dept.ClearancePercentage >= 80 ? "bg-success" : dept.ClearancePercentage >= 50 ? "bg-warning text-dark" : "bg-danger") rounded-pill px-2.5 py-1">
                                    @dept.ClearancePercentage% Cleared
                                </span>
                            </div>
                            <div class="progress mb-2" style="height: 8px; border-radius: 1rem; background: #EADDD0;">
                                <div class="progress-bar bg-success" role="progressbar" style="width: @dept.ClearancePercentage%;"></div>
                            </div>
                            <div class="d-flex justify-content-between text-muted small">
                                <span><i class="bi bi-check-circle text-success me-1"></i> @dept.ClearedStudents Cleared</span>
                                <span><i class="bi bi-slash-circle text-danger me-1"></i> @dept.BlockedStudents Blocked</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- ================= Filter Toolbar ================= -->
    <div class="glass-card-admin mb-4">
        <div class="card-body p-3">
            <form method="get" asp-controller="Admin" asp-action="AcademicAdministrationReport" class="row g-2 align-items-center">
                <div class="col-md-3 col-sm-6">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Search student name, ID..." />
                    </div>
                </div>

                <div class="col-md-2 col-sm-6">
                    <select name="department" class="form-select form-select-sm" onchange="this.form.submit()">
                        <option value="All" selected="@(Model.SelectedDepartment == "All")">All Departments</option>
                        @foreach (var dept in Model.AvailableDepartments)
                        {
                            <option value="@dept" selected="@(Model.SelectedDepartment == dept)">@dept</option>
                        }
                    </select>
                </div>

                <div class="col-md-2 col-sm-6">
                    <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
                        <option value="All" selected="@(Model.SelectedStatus == "All")">All Registration Statuses</option>
                        <option value="Cleared" selected="@(Model.SelectedStatus == "Cleared")">Cleared for Registration</option>
                        <option value="Blocked" selected="@(Model.SelectedStatus == "Blocked")">Registration Blocked</option>
                    </select>
                </div>

                <div class="col-md-2 col-sm-6">
                    <select name="semester" class="form-select form-select-sm" onchange="this.form.submit()">
                        @foreach (var sem in Model.AvailableSemesters)
                        {
                            <option value="@sem" selected="@(Model.SelectedSemester == sem)">@sem</option>
                        }
                    </select>
                </div>

                <div class="col-md-3 col-sm-12 d-flex gap-2">
                    <button type="submit" class="btn btn-sm btn-dark rounded-pill px-3 w-100 fw-semibold">
                        <i class="bi bi-funnel me-1"></i> Apply Filter
                    </button>
                    <a asp-controller="Admin" asp-action="AcademicAdministrationReport" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                        Reset
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- ================= Student Academic Standing & Clearance Table ================= -->
    <div class="glass-card-admin">
        <div class="card-header border-0 py-3 d-flex justify-content-between align-items-center" style="background:#F4EEE8;">
            <h5 class="mb-0 fw-bold" style="color:#5E503F;">
                <i class="bi bi-card-checklist me-2"></i> Student Registration Clearance &amp; Coordinator Action Log (@Model.StudentRoster.Count records)
            </h5>
            <span class="badge bg-secondary rounded-pill px-3 py-1">Academic Clearance Roster</span>
        </div>

        <div class="card-body p-0">
            @if (Model.StudentRoster != null && Model.StudentRoster.Any())
            {
                <div class="table-responsive">
                    <table class="table table-admin align-middle mb-0">
                        <thead>
                            <tr>
                                <th class="ps-4">Student</th>
                                <th>Department / Term</th>
                                <th>PHQ-9</th>
                                <th>C-SSRS</th>
                                <th>Registration Status</th>
                                <th>Risk Severity</th>
                                <th style="width: 32%;">Administrative Action &amp; Standing</th>
                                <th class="text-center pe-4">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.StudentRoster)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center gap-2">
                                            <img src="@(string.IsNullOrEmpty(item.ProfileImage) ? "/images/default-avatar.png" : item.ProfileImage)"
                                                 class="rounded-circle border" style="width: 40px; height: 40px; object-fit: cover;" alt="@item.StudentName" />
                                            <div>
                                                <strong class="d-block text-dark" style="font-size: 0.95rem;">@item.StudentName</strong>
                                                <small class="text-muted">ID: @item.StudentIdNumber</small>
                                            </div>
                                        </div>
                                    </td>

                                    <td>
                                        <div class="fw-semibold text-dark">@item.Department</div>
                                        <small class="text-muted">@item.Semester</small>
                                    </td>

                                    <td>
                                        @if (item.HasPHQ)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success rounded-pill px-2.5 py-1">
                                                <i class="bi bi-check-circle-fill me-1"></i> Completed
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger rounded-pill px-2.5 py-1">
                                                <i class="bi bi-x-circle-fill me-1"></i> Pending
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @if (item.HasCSSRS)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success rounded-pill px-2.5 py-1">
                                                <i class="bi bi-check-circle-fill me-1"></i> Completed
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger rounded-pill px-2.5 py-1">
                                                <i class="bi bi-x-circle-fill me-1"></i> Pending
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @if (item.RegistrationClearance == "Cleared")
                                        {
                                            <span class="badge bg-success text-white rounded-pill px-3 py-1.5 shadow-sm">
                                                <i class="bi bi-unlock-fill me-1"></i> Cleared
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger text-white rounded-pill px-3 py-1.5 shadow-sm">
                                                <i class="bi bi-lock-fill me-1"></i> Blocked
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @if (item.MentalHealthSeverity == "Extremely Severe")
                                        {
                                            <span class="badge bg-danger text-white rounded-pill px-2.5 py-1">
                                                Extremely Severe
                                            </span>
                                        }
                                        else if (item.MentalHealthSeverity == "Severe")
                                        {
                                            <span class="badge bg-warning text-dark rounded-pill px-2.5 py-1">
                                                Severe
                                            </span>
                                        }
                                        else if (item.MentalHealthSeverity == "Moderate")
                                        {
                                            <span class="badge bg-info text-dark rounded-pill px-2.5 py-1">
                                                Moderate
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary rounded-pill px-2.5 py-1">
                                                Normal
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <p class="mb-0 small text-dark" style="line-height: 1.4;">
                                            @item.ActionRequired
                                        </p>
                                    </td>

                                    <td class="text-center pe-4">
                                        <a asp-controller="Admin" asp-action="StudentDetails" asp-route-id="@item.StudentId"
                                           class="btn btn-sm btn-outline-dark rounded-pill px-3 py-1.5 fw-semibold">
                                            <i class="bi bi-person-lines-fill me-1"></i> View Student
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <p class="text-muted mb-0">No student records found matching your filter criteria.</p>
                </div>
            }
        </div>
    </div>

</div>
