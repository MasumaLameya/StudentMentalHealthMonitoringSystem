@model StudentMentalHealthMonitoringSystem.Models.Student

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Add Student";
}

<div class="container-fluid">

    <!-- ================= Header ================= -->

    <div class="card border-0 shadow-sm rounded-4 mb-4"
         style="background:#F4EEE8;">

        <div class="card-body p-4">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <h2 class="fw-bold mb-1"
                        style="color:#5F5146;">

                        Add Student

                    </h2>

                    <p class="text-muted mb-0">

                        Add a new student to the system.

                    </p>

                </div>

                <a asp-controller="Admin"
                   asp-action="Students"
                   class="btn rounded-3 px-4"
                   style="background:#8A7563;
                    color:white;">

                    <i class="bi bi-arrow-left me-1"></i>

                    Back

                </a>

            </div>

        </div>

    </div>


    <!-- ================= Form ================= -->

    <div class="card border-0 shadow-sm rounded-4">

        <div class="card-body p-4">

            <form asp-controller="Admin"
                  asp-action="AddStudent"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-4">
                </div>


                <!-- ================= Personal Information ================= -->

                <h4 class="mb-4"
                    style="color:#5F5146;">

                    Personal Information

                </h4>

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label asp-for="StudentIdNumber"
                               class="form-label fw-semibold">

                            Student ID

                        </label>

                        <input asp-for="StudentIdNumber"
                               class="form-control rounded-3"
                               placeholder="Enter student ID" />

                        <span asp-validation-for="StudentIdNumber"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-6 mb-3">

                        <label asp-for="FullName"
                               class="form-label fw-semibold">

                            Full Name

                        </label>

                        <input asp-for="FullName"
                               class="form-control rounded-3"
                               placeholder="Enter full name" />

                        <span asp-validation-for="FullName"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-6 mb-3">

                        <label asp-for="Email"
                               class="form-label fw-semibold">

                            Email

                        </label>

                        <input asp-for="Email"
                               type="email"
                               class="form-control rounded-3"
                               placeholder="Enter email" />

                        <span asp-validation-for="Email"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-6 mb-3">

                        <label asp-for="Phone"
                               class="form-label fw-semibold">

                            Phone

                        </label>

                        <input asp-for="Phone"
                               class="form-control rounded-3"
                               placeholder="Enter phone number" />

                        <span asp-validation-for="Phone"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-6 mb-3">

                        <label asp-for="DateOfBirth"
                               class="form-label fw-semibold">

                            Date of Birth

                        </label>

                        <input asp-for="DateOfBirth"
                               type="date"
                               class="form-control rounded-3" />

                        <span asp-validation-for="DateOfBirth"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-6 mb-3">

                        <label asp-for="Gender"
                               class="form-label fw-semibold">

                            Gender

                        </label>

                        <select asp-for="Gender"
                                class="form-select rounded-3">

                            <option value="">
                                -- Select Gender --
                            </option>

                            <option value="Male">
                                Male
                            </option>

                            <option value="Female">
                                Female
                            </option>

                            <option value="Other">
                                Other
                            </option>

                        </select>

                        <span asp-validation-for="Gender"
                              class="text-danger">
                        </span>

                    </div>

                </div>


                <hr class="my-4">


                <!-- ================= Academic Information ================= -->

                <h4 class="mb-4"
                    style="color:#5F5146;">

                    Academic Information

                </h4>

                <div class="row">

                    <div class="col-md-4 mb-3">
                        <label asp-for="Department"
                               class="form-label fw-semibold">
                            Department
                        </label>
                        <select asp-for="Department"
                                class="form-select rounded-3">
                            <option value="">-- Select Department --</option>
                            <option value="CSE">CSE</option>
                            <option value="EEE">EEE</option>
                            <option value="Mechanical">Mechanical</option>
                            <option value="Civil">Civil</option>
                            <option value="BBA">BBA</option>
                            <option value="BATHM">BATHM</option>
                        </select>
                        <span asp-validation-for="Department"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="col-md-4 mb-3">

                        <label asp-for="AdmissionYear"
                               class="form-label fw-semibold">

                            Academic / Batch Year

                        </label>

                        <select asp-for="AdmissionYear"
                                class="form-select rounded-3">
                            <option value="">-- Select Year --</option>
                            <option value="2027">2027</option>
                            <option value="2026">2026</option>
                            <option value="2025">2025</option>
                            <option value="2024">2024</option>
                            <option value="2023">2023</option>
                            <option value="2022">2022</option>
                            <option value="2021">2021</option>
                            <option value="2020">2020</option>
                        </select>

                        <span asp-validation-for="AdmissionYear"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-4 mb-3">

                        <label asp-for="Semester"
                               class="form-label fw-semibold">

                            Admission Term / Semester

                        </label>

                        <select asp-for="Semester"
                                class="form-select rounded-3">
                            <option value="">-- Select Term --</option>
                            <option value="Spring">Spring</option>
                            <option value="Summer">Summer</option>
                            <option value="Fall">Fall</option>
                        </select>

                        <span asp-validation-for="Semester"
                              class="text-danger">
                        </span>

                    </div>

                </div>


                <hr class="my-4">


                <!-- ================= Additional Information ================= -->

                <h4 class="mb-4"
                    style="color:#5F5146;">

                    Additional Information

                </h4>

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label asp-for="Height"
                               class="form-label fw-semibold">

                            Height

                        </label>

                        <input asp-for="Height"
                               class="form-control rounded-3"
                               placeholder="Enter height" />

                    </div>


                    <div class="col-md-6 mb-3">

                        <label asp-for="Weight"
                               class="form-label fw-semibold">

                            Weight

                        </label>

                        <input asp-for="Weight"
                               class="form-control rounded-3"
                               placeholder="Enter weight" />

                    </div>


                    <div class="col-md-6 mb-3">

                        <label asp-for="FinancialCondition"
                               class="form-label fw-semibold">

                            Financial Condition

                        </label>

                        <input asp-for="FinancialCondition"
                               class="form-control rounded-3"
                               placeholder="Enter financial condition" />

                    </div>

                </div>


                <hr class="my-4">


                <!-- ================= Guardian Information ================= -->

                <h4 class="mb-4"
                    style="color:#5F5146;">

                    Guardian Information

                </h4>

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label asp-for="GuardianName"
                               class="form-label fw-semibold">

                            Guardian Name

                        </label>

                        <input asp-for="GuardianName"
                               class="form-control rounded-3"
                               placeholder="Enter guardian name" />

                    </div>


                    <div class="col-md-6 mb-3">
                        <label asp-for="Relationship"
                               class="form-label fw-semibold">
                            Relationship
                        </label>
                        <select asp-for="Relationship"
                                class="form-select rounded-3">
                            <option value="">-- Select Relationship --</option>
                            <option value="Father">Father</option>
                            <option value="Mother">Mother</option>
                            <option value="Brother">Brother</option>
                            <option value="Sister">Sister</option>
                            <option value="Uncle">Uncle</option>
                            <option value="Aunt">Aunt</option>
                            <option value="Grandfather">Grandfather</option>
                            <option value="Grandmother">Grandmother</option>
                            <option value="Spouse">Spouse</option>
                            <option value="Legal Guardian">Legal Guardian</option>
                            <option value="Other">Other</option>
                        </select>
                        <span asp-validation-for="Relationship"
                              class="text-danger">
                        </span>
                    </div>


                    <div class="col-md-6 mb-3">

                        <label asp-for="GuardianPhone"
                               class="form-label fw-semibold">

                            Guardian Phone

                        </label>

                        <input asp-for="GuardianPhone"
                               class="form-control rounded-3"
                               placeholder="Enter guardian phone" />

                    </div>


                    <div class="col-md-6 mb-3">

                        <label asp-for="GuardianEmail"
                               class="form-label fw-semibold">

                            Guardian Email

                        </label>

                        <input asp-for="GuardianEmail"
                               type="email"
                               class="form-control rounded-3"
                               placeholder="Enter guardian email" />

                    </div>

                </div>


                <hr class="my-4">


                <!-- ================= Profile Image ================= -->

                <h4 class="mb-4"
                    style="color:#5F5146;">

                    Profile Image

                </h4>

                <div class="mb-4">

                    <label asp-for="ImageFile"
                           class="form-label fw-semibold">

                        Upload Image

                    </label>

                    <input asp-for="ImageFile"
                           type="file"
                           class="form-control rounded-3"
                           accept=".jpg,.jpeg,.png,image/*" />

                    <span asp-validation-for="ImageFile"
                          class="text-danger">
                    </span>

                </div>


                <!-- ================= Buttons ================= -->

                <div class="d-flex justify-content-end gap-2">

                    <a asp-controller="Admin"
                       asp-action="Students"
                       class="btn rounded-3 px-4"
                       style="background:#E8DDD2;
                        color:#5F5146;">

                        Cancel

                    </a>

                    <button type="submit"
                            class="btn rounded-3 px-4"
                            style="background:#A67C52;
                        color:white;">

                        <i class="bi bi-person-plus me-1"></i>

                        Add Student

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
