@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Settings";
}

<div class="container-fluid">

    <!-- ================= Header ================= -->

    <div class="card border-0 shadow-sm rounded-4 mb-4"
         style="background:#F1EAE4;">

        <div class="card-body p-4">

            <h2 class="fw-bold mb-1"
                style="color:#5C5148;">

                ⚙️ Settings

            </h2>

            <p class="text-muted mb-0">

                Manage your administrator account and system settings.

            </p>

        </div>

    </div>


    <!-- ================= Settings Cards ================= -->

    <div class="row">

        <!-- Profile -->

        <div class="col-lg-6 mb-4">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-body p-4">

                    <div class="d-flex align-items-center mb-4">

                        <div class="rounded-4 d-flex align-items-center justify-content-center me-3"
                             style="width:60px;
                            height:60px;
                            background:#E5DAD1;">

                            <i class="bi bi-person-circle"
                               style="font-size:28px;
                            color:#806C5D;"></i>

                        </div>

                        <div>

                            <h4 class="fw-bold mb-1"
                                style="color:#5C5148;">

                                Admin Profile

                            </h4>

                            <small class="text-muted">

                                Update your personal information.

                            </small>

                        </div>

                    </div>

                    <p class="text-muted">

                        Change your name, email, phone number
                        and profile picture.

                    </p>

                    <a asp-controller="Admin"
                       asp-action="Profile"
                       class="btn rounded-3 px-4"
                       style="background:#A67C52;
                        color:white;">

                        <i class="bi bi-person-gear me-1"></i>

                        Manage Profile

                    </a>

                </div>

            </div>

        </div>


        <!-- Logout -->

        <div class="col-lg-6 mb-4">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-body p-4">

                    <div class="d-flex align-items-center mb-4">

                        <div class="rounded-4 d-flex align-items-center justify-content-center me-3"
                             style="width:60px;
                            height:60px;
                            background:#E7C4BD;">

                            <i class="bi bi-box-arrow-right"
                               style="font-size:28px;
                            color:#A45E53;"></i>

                        </div>

                        <div>

                            <h4 class="fw-bold mb-1"
                                style="color:#5C5148;">

                                Logout

                            </h4>

                            <small class="text-muted">

                                End your current administrator session.

                            </small>

                        </div>

                    </div>

                    <p class="text-muted">

                        You will be redirected to the login page
                        after logging out.

                    </p>

                    <a asp-controller="Admin"
                       asp-action="Logout"
                       class="btn rounded-3 px-4"
                       style="background:#B96A5B;
                        color:white;">

                        <i class="bi bi-box-arrow-right me-1"></i>

                        Logout

                    </a>

                </div>

            </div>

        </div>

    </div>


    <!-- ================= Account Information ================= -->

    <div class="card border-0 shadow-sm rounded-4">

        <div class="card-header border-0 py-3"
             style="background:#E8DDD2;">

            <h5 class="mb-0"
                style="color:#5C5148;">

                Account Settings

            </h5>

        </div>

        <div class="card-body p-4">

            <div class="row">

                <div class="col-md-4 mb-3">

                    <small class="text-muted">
                        Account Type
                    </small>

                    <div class="fw-semibold"
                         style="color:#5C5148;">

                        Administrator

                    </div>

                </div>

                <div class="col-md-4 mb-3">

                    <small class="text-muted">
                        Access Level
                    </small>

                    <div class="fw-semibold"
                         style="color:#5C5148;">

                        Full Administrative Access

                    </div>

                </div>

                <div class="col-md-4 mb-3">

                    <small class="text-muted">
                        System
                    </small>

                    <div class="fw-semibold"
                         style="color:#5C5148;">

                        Student Mental Health Monitoring System

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>