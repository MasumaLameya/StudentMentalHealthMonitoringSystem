@model StudentMentalHealthMonitoringSystem.Models.Student

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Delete Student";
}

<div class="container-fluid">

    <!-- ================= Header ================= -->

    <div class="card border-0 shadow-sm rounded-4 mb-4"
         style="background:#F4EEE8;">

        <div class="card-body p-4">

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

                <div>

                    <h2 class="fw-bold mb-1"
                        style="color:#5F5146;">

                        Delete Student

                    </h2>

                    <p class="text-muted mb-0">

                        Review the student information before deleting.

                    </p>

                </div>

                <a asp-controller="Admin"
                   asp-action="Students"
                   class="btn rounded-3 px-4"
                   style="background:#8A7563;
                    color:white;">

                    <i class="bi bi-arrow-left me-1"></i>

                    Back to Students

                </a>

            </div>

        </div>

    </div>


    <!-- ================= Delete Confirmation ================= -->

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-body p-4">


                    <!-- ================= Student Profile ================= -->

                    <div class="text-center mb-4">

                        @if (!string.IsNullOrEmpty(Model.ProfileImage))
                        {
                            <img src="@Model.ProfileImage"
                                 width="140"
                                 height="140"
                                 class="rounded-circle border shadow-sm"
                                 style="object-fit:cover;">
                        }
                        else
                        {
                            <img src="https://ui-avatars.com/api/?name=@Uri.EscapeDataString(Model.FullName)&background=A67C52&color=fff&size=140"
                                 width="140"
                                 height="140"
                                 class="rounded-circle shadow-sm">
                        }

                        <h3 class="mt-3 mb-2"
                            style="color:#5F5146;">

                            @Model.FullName

                        </h3>

                        <span class="badge rounded-pill px-3 py-2"
                              style="background:#EEE4DA;
                            color:#705F50;">

                            Student

                        </span>

                    </div>


                    <!-- ================= Warning ================= -->

                    <div class="alert rounded-3 mb-4"
                         style="background:#F7E6E2;
                        border:1px solid #E7C4BD;
                        color:#70433C;">

                        <div class="d-flex align-items-start">

                            <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>

                            <div>

                                <strong>
                                    Are you sure you want to delete this student?
                                </strong>

                                <p class="mb-0 mt-1">

                                    This action will permanently remove the
                                    student and related records from the system.

                                </p>

                            </div>

                        </div>

                    </div>


                    <!-- ================= Student Information ================= -->

                    <div class="table-responsive">

                        <table class="table table-bordered align-middle mb-0">

                            <tbody>

                                <tr>

                                    <th style="width:35%;
                                        background:#F4EEE8;
                                        color:#5F5146;">

                                        Student ID

                                    </th>

                                    <td>

                                        @Model.StudentIdNumber

                                    </td>

                                </tr>


                                <tr>

                                    <th style="background:#F4EEE8;
                                        color:#5F5146;">

                                        Full Name

                                    </th>

                                    <td>

                                        @Model.FullName

                                    </td>

                                </tr>


                                <tr>

                                    <th style="background:#F4EEE8;
                                        color:#5F5146;">

                                        Email

                                    </th>

                                    <td>

                                        @Model.Email

                                    </td>

                                </tr>


                                <tr>

                                    <th style="background:#F4EEE8;
                                        color:#5F5146;">

                                        Phone

                                    </th>

                                    <td>

                                        @Model.Phone

                                    </td>

                                </tr>


                                <tr>

                                    <th style="background:#F4EEE8;
                                        color:#5F5146;">

                                        Department

                                    </th>

                                    <td>

                                        @Model.Department

                                    </td>

                                </tr>


                                <tr>

                                    <th style="background:#F4EEE8;
                                        color:#5F5146;">

                                        Semester

                                    </th>

                                    <td>

                                        @Model.Semester

                                    </td>

                                </tr>

                            </tbody>

                        </table>

                    </div>


                    <!-- ================= Delete Form ================= -->

                    <form asp-controller="Admin"
                          asp-action="ConfirmDeleteStudent"
                          method="post"
                          class="mt-4">

                        @Html.AntiForgeryToken()

                        <!-- Student ID -->

                        <input type="hidden"
                               name="id"
                               value="@Model.StudentId" />


                        <!-- Buttons -->

                        <div class="d-flex justify-content-end gap-2">

                            <a asp-controller="Admin"
                               asp-action="Students"
                               class="btn rounded-3 px-4"
                               style="background:#E8DDD2;
                                color:#5F5146;">

                                <i class="bi bi-x-circle me-1"></i>

                                Cancel

                            </a>


                            <button type="submit"
                                    class="btn rounded-3 px-4"
                                    style="background:#B96A5B;
                                color:white;">

                                <i class="bi bi-trash me-1"></i>

                                Delete Student

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>