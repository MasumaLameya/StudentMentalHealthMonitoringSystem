@model IEnumerable<StudentMentalHealthMonitoringSystem.ViewModels.DepartmentViewModel>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Department Management";
}

<div class="container-fluid">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert border-0 rounded-3 mb-4 d-flex align-items-center gap-2 p-3" style="background:#E6F4EA; border-left:4px solid #2E7D32; border-left-style:solid;">
            <i class="bi bi-check-circle-fill" style="color:#2E7D32; font-size:18px;"></i>
            <span style="color:#1B5E20; font-weight:600;">@TempData["SuccessMessage"]</span>
        </div>
    }

    <!-- ================= Header ================= -->

    <div class="card border-0 shadow-sm rounded-4 mb-4"
         style="background:#F3EAE2;">

        <div class="card-body p-4">

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

                <div>

                    <h2 class="fw-bold mb-1"
                        style="color:#5C5148;">

                        🏛️ Department Management

                    </h2>

                    <p class="text-muted mb-0">

                        View departments and the number of registered students.

                    </p>

                </div>

                <div class="text-end">

                    <div class="small text-muted">
                        Total Departments
                    </div>

                    <h4 class="fw-bold mb-0"
                        style="color:#8A7563;">

                        @Model.Count()

                    </h4>

                </div>

            </div>

        </div>

    </div>


    <!-- ================= Search ================= -->

    <div class="card border-0 shadow-sm rounded-4 mb-4">

        <div class="card-body">

            <label for="departmentSearch"
                   class="form-label fw-semibold"
                   style="color:#5C5148;">

                Search Department

            </label>

            <div class="input-group">

                <span class="input-group-text"
                      style="background:#F3EAE2;
                    border-color:#DDD2C8;">

                    <i class="bi bi-search"
                       style="color:#8A7563;"></i>

                </span>

                <input type="text"
                       id="departmentSearch"
                       class="form-control"
                       placeholder="Search department..."
                       autocomplete="off"
                       style="border-color:#DDD2C8;" />

                <button type="button"
                        id="clearDepartmentSearch"
                        class="btn"
                        style="background:#E7DDD5;
                    color:#5C5148;
                    display:none;">

                    <i class="bi bi-x-lg"></i>

                </button>

            </div>

        </div>

    </div>


    <!-- ================= Department Cards ================= -->

    <div class="row"
         id="departmentContainer">

        @if (Model != null && Model.Any())
        {
            foreach (var department in Model)
            {
                <div class="col-xl-4 col-lg-6 mb-4 department-item">

                    <div class="card border-0 shadow-sm rounded-4 h-100">

                        <div class="card-body p-4">

                            <div class="d-flex align-items-center">

                                <div class="rounded-4 d-flex align-items-center justify-content-center me-3"
                                     style="width:60px;
                                    height:60px;
                                    background:#E6D6C8;">

                                    <i class="bi bi-building"
                                       style="font-size:27px;
                                    color:#806C5D;"></i>

                                </div>

                                <div>

                                    <h4 class="fw-bold mb-1"
                                        style="color:#5C5148;">

                                        @department.DepartmentName

                                    </h4>

                                    <small class="text-muted">

                                        Academic Department

                                    </small>

                                </div>

                            </div>


                            <hr class="my-4">


                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">

                                <div>

                                    <small class="text-muted">
                                        Registered Students
                                    </small>

                                    <h3 class="fw-bold mb-0"
                                        style="color:#8A7563;">

                                        @department.TotalStudents

                                    </h3>

                                </div>

                                <div class="d-flex gap-2 flex-wrap">

                                    <a asp-controller="Admin" asp-action="Students" asp-route-department="@department.DepartmentName" class="btn rounded-3 fw-bold px-3 py-2 text-white shadow-sm" style="background:#8A7563;">
                                        <i class="bi bi-people me-1"></i> Students (@department.TotalStudents)
                                    </a>

                                    <button type="button" class="btn rounded-3 fw-bold px-3 py-2 text-white shadow-sm"
                                            style="background:#006837;"
                                            data-bs-toggle="modal"
                                            data-bs-target="#changeDepartmentPasswordModal"
                                            data-dept-id="@department.DepartmentId"
                                            data-dept-name="@department.DepartmentName">
                                        <i class="bi bi-key-fill me-1"></i> Change Password
                                    </button>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>
            }
        }
        else
        {
            <div class="col-12">

                <div class="card border-0 shadow-sm rounded-4">

                    <div class="card-body text-center py-5">

                        <i class="bi bi-building-x"
                           style="font-size:45px;
                        color:#B8AAA0;"></i>

                        <h5 class="mt-3"
                            style="color:#5C5148;">

                            No Departments Found

                        </h5>

                        <p class="text-muted mb-0">

                            No department information is currently available.

                        </p>

                    </div>

                </div>

            </div>
        }

    </div>


    <!-- ================= No Search Result ================= -->

    <div id="noDepartmentResult"
         class="card border-0 shadow-sm rounded-4"
         style="display:none;">

        <div class="card-body text-center py-5">

            <i class="bi bi-search"
               style="font-size:40px;
            color:#B8AAA0;"></i>

            <h5 class="mt-3"
                style="color:#5C5148;">

                No Matching Department

            </h5>

            <p class="text-muted mb-0">

                Try searching with another department name.

            </p>

        </div>

    </div>

</div>


<!-- ================= Search Script ================= -->

<script>

        document.addEventListener("DOMContentLoaded", function() {

            const searchInput =
                document.getElementById("departmentSearch");

            const clearButton =
                document.getElementById("clearDepartmentSearch");

            const departmentItems =
                document.querySelectorAll(".department-item");

            const noResult =
                document.getElementById("noDepartmentResult");


            function normalizeText(text) {

                return text
                    .toLowerCase()
                    .trim()
                    .replace(/\s+/g, " ");

            }


            function searchDepartments() {

                const searchValue =
                    normalizeText(searchInput.value);

                let visibleCount = 0;


                departmentItems.forEach(function(item) {

                    const departmentText =
                        normalizeText(item.textContent);

                    if (
                        searchValue === "" ||
                        departmentText.includes(searchValue)
                    ) {

                        item.style.display = "";

                        visibleCount++;

                    }
                    else {

                        item.style.display = "none";

                    }

                });


                if (
                    visibleCount === 0 &&
                    searchValue !== ""
                ) {

                    noResult.style.display = "";

                }
                else {

                    noResult.style.display = "none";

                }


                if (searchValue !== "") {

                    clearButton.style.display = "block";

                }
                else {

                    clearButton.style.display = "none";

                }

            }


            searchInput.addEventListener(
                "input",
                searchDepartments
            );


            clearButton.addEventListener(
                "click",
                function() {

                    searchInput.value = "";

                    searchDepartments();

                    searchInput.focus();

                }
            );

        });

        // Setup Change Department Password Modal
        var changeDeptPasswordModal = document.getElementById('changeDepartmentPasswordModal');
        if (changeDeptPasswordModal) {
            changeDeptPasswordModal.addEventListener('show.bs.modal', function(event) {
                var button = event.relatedTarget;
                var deptId = button.getAttribute('data-dept-id');
                var deptName = button.getAttribute('data-dept-name');

                document.getElementById('modalDeptId').value = deptId;
                document.getElementById('modalDeptNameDisplay').textContent = deptName;
                document.getElementById('deptNewPassword').value = '';
                document.getElementById('deptConfirmPassword').value = '';
            });
        }
    </script>

    <!-- ================= Change Department Password Modal ================= -->
    <div class="modal fade" id="changeDepartmentPasswordModal" tabindex="-1" aria-labelledby="changeDepartmentPasswordModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 border-0 shadow">
                <div class="modal-header border-0 bg-success text-white rounded-top-4 p-4">
                    <div>
                        <h5 class="modal-title fw-bold mb-1" id="changeDepartmentPasswordModalLabel">
                            <i class="bi bi-key-fill me-2"></i>Change Department Password
                        </h5>
                        <p class="text-white-50 small mb-0">Set a new password for <span id="modalDeptNameDisplay" class="fw-bold text-white"></span></p>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-controller="Admin" asp-action="ChangeDepartmentPassword" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="departmentId" id="modalDeptId" />

                    <div class="modal-body p-4">
                        <div class="mb-3">
                            <label class="form-label fw-bold small text-secondary">New Password *</label>
                            <input type="password" name="newPassword" id="deptNewPassword" class="form-control rounded-3 py-2" placeholder="Minimum 6 characters" minlength="6" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold small text-secondary">Confirm New Password *</label>
                            <input type="password" name="confirmPassword" id="deptConfirmPassword" class="form-control rounded-3 py-2" placeholder="Re-type new password" minlength="6" required />
                        </div>

                        <div class="alert alert-light border rounded-3 p-3 mb-0 small text-muted">
                            <i class="bi bi-info-circle me-1 text-success"></i>
                            The department head can use this new password to immediately sign in to their portal.
                        </div>
                    </div>

                    <div class="modal-footer border-0 bg-light p-3 rounded-bottom-4">
                        <button type="button" class="btn btn-secondary rounded-3 px-4" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-success rounded-3 px-4 fw-bold">
                            <i class="bi bi-check-circle me-1"></i> Update Password
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>