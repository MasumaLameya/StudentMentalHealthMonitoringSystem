@model StudentMentalHealthMonitoringSystem.Models.ObservationReport

@using StudentMentalHealthMonitoringSystem.Models
@using StudentMentalHealthMonitoringSystem.ViewModels

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Observation Report";

    var observations = ViewBag.Observations as List<CounselingObservation> ?? new List<CounselingObservation>();
    var progressDetail = ViewBag.ProgressDetail as StudentProgressReportDetailViewModel 
        ?? StudentMentalHealthMonitoringSystem.Services.ProgressScoringService.BuildDetailViewModel(Model, observations);
    var latestObservation = observations.LastOrDefault();
}

<style>
    .glass-card-admin {
        background: #ffffff;
        border: 1px solid #E5D8CC;
        border-radius: 1.25rem;
        box-shadow: 0 8px 24px rgba(94, 80, 63, 0.06);
    }
    .metric-card-admin {
        background: #FAF6F0;
        border: 1px solid #EDE2D8;
        border-radius: 1rem;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .metric-card-admin:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(166, 124, 82, 0.12);
    }
    .table-admin thead th {
        background-color: #F4EEE8;
        color: #5E503F;
        font-weight: 700;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border-bottom: 2px solid #E5D8CC;
        padding: 0.9rem 0.75rem;
    }
    .table-admin tbody td {
        padding: 1rem 0.75rem;
        vertical-align: middle;
        border-bottom: 1px solid #F0E8DF;
    }
    .table-admin tbody tr:hover {
        background-color: #FCFAF8;
    }
    .score-badge-admin {
        font-size: 1rem;
        font-weight: 700;
        padding: 0.35rem 0.75rem;
        border-radius: 2rem;
    }
</style>

<div class="container-fluid py-4" id="adminObservationReportContent">

    <!-- ================= Header ================= -->
    <div class="card border-0 shadow-sm rounded-4 mb-4" style="background: linear-gradient(135deg, #5E503F 0%, #A67C52 100%);">
        <div class="card-body p-4 text-white">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div>
                    <div class="badge bg-white text-dark rounded-pill px-3 py-1.5 mb-2 fw-semibold">
                        <i class="bi bi-shield-check text-primary me-1"></i> Admin Oversight &amp; Audit
                    </div>
                    <h2 class="fw-bold mb-1 text-white">
                        Student Clinical Observation Report
                    </h2>
                    <p class="text-white-50 mb-0 fs-6">
                        Counseling follow-up observation records, session-by-session improvement indicators, and progress line graph.
                    </p>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-danger rounded-pill px-4 py-2 fw-semibold shadow-sm" onclick="downloadReportPdf('#adminObservationReportContent', { title: 'Observation_Report_@(Model.Student?.StudentIdNumber ?? "Record")', filename: 'Observation_Report_@(Model.Student?.StudentIdNumber ?? "Record")' })">
                        <i class="bi bi-file-earmark-pdf-fill me-1"></i> Download PDF
                    </button>
                    <a asp-controller="Admin" asp-action="ObservationReports" class="btn btn-light rounded-pill px-4 py-2 fw-semibold shadow-sm">
                        <i class="bi bi-arrow-left me-1"></i> Back to Reports
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- ================= Student / Case Overview Card ================= -->
    <div class="glass-card-admin mb-4">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div class="d-flex align-items-center gap-3">
                    <img src="@(string.IsNullOrEmpty(Model.Student?.ProfileImage) ? "/images/default-avatar.png" : Model.Student.ProfileImage)"
                         class="rounded-circle shadow-sm border border-3 border-secondary-subtle" 
                         style="width: 72px; height: 72px; object-fit: cover;" 
                         alt="@(Model.Student?.FullName ?? "Student")" />
                    <div>
                        <h4 class="fw-bold mb-1" style="color: #5E503F;">
                            @(Model.Student?.FullName ?? "Student")
                        </h4>
                        <div class="d-flex align-items-center flex-wrap gap-2 text-muted fs-6">
                            <span><i class="bi bi-card-text me-1 text-secondary"></i> ID: <strong>@(Model.Student?.StudentIdNumber ?? "-")</strong></span>
                            <span>•</span>
                            <span><i class="bi bi-building me-1 text-secondary"></i> Dept: <strong>@(Model.Student?.Department ?? "-")</strong></span>
                            <span>•</span>
                            <span><i class="bi bi-calendar3 me-1 text-secondary"></i> Trimester: <strong>@(Model.Semester)</strong></span>
                            <span>•</span>
                            <span><i class="bi bi-person-badge me-1 text-secondary"></i> Psychologist: <strong>@(Model.Psychologist?.FullName ?? "-")</strong></span>
                        </div>
                    </div>
                </div>

                <div>
                    @if (Model.IsFinal)
                    {
                        <span class="badge bg-success-subtle text-success border border-success fs-6 px-4 py-2.5 rounded-pill shadow-sm">
                            <i class="bi bi-check-circle-fill me-1.5"></i> Follow-up Completed (Finalized)
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning fs-6 px-4 py-2.5 rounded-pill shadow-sm">
                            <i class="bi bi-arrow-repeat me-1.5"></i> Continuous Follow-up (In Progress)
                        </span>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- ================= Summary Metrics Cards ================= -->
    <div class="row g-3 mb-4">
        <div class="col-md-3 col-sm-6">
            <div class="metric-card-admin p-3.5 text-center h-100">
                <small class="text-muted text-uppercase fw-bold d-block mb-1" style="font-size: 0.75rem; letter-spacing: 0.5px;">Total Sessions</small>
                <h3 class="fw-bold mb-0" style="color: #5E503F;">@progressDetail.TotalSessions</h3>
                <small class="text-muted">
                    @progressDetail.FirstSessionDate.ToString("MMM dd, yyyy") - @progressDetail.LatestSessionDate.ToString("MMM dd, yyyy")
                </small>
            </div>
        </div>

        <div class="col-md-3 col-sm-6">
            <div class="metric-card-admin p-3.5 text-center h-100">
                <small class="text-muted text-uppercase fw-bold d-block mb-1" style="font-size: 0.75rem; letter-spacing: 0.5px;">Initial Baseline Score</small>
                <h3 class="fw-bold mb-0 text-secondary">@progressDetail.InitialScore <span class="fs-6 text-muted">/ 100</span></h3>
                <small class="text-muted">Session 1 Evaluation</small>
            </div>
        </div>

        <div class="col-md-3 col-sm-6">
            <div class="metric-card-admin p-3.5 text-center h-100">
                <small class="text-muted text-uppercase fw-bold d-block mb-1" style="font-size: 0.75rem; letter-spacing: 0.5px;">Latest Follow-up Score</small>
                <h3 class="fw-bold mb-0 text-primary">@progressDetail.LatestScore <span class="fs-6 text-muted">/ 100</span></h3>
                <small class="text-muted">
                    Score Difference: <strong>@(progressDetail.ScoreDifference >= 0 ? "+" + progressDetail.ScoreDifference : progressDetail.ScoreDifference.ToString())</strong> pts
                </small>
            </div>
        </div>

        <div class="col-md-3 col-sm-6">
            <div class="metric-card-admin p-3.5 text-center h-100">
                <small class="text-muted text-uppercase fw-bold d-block mb-1" style="font-size: 0.75rem; letter-spacing: 0.5px;">Overall Progress Status</small>
                <div class="mt-2">
                    @if (progressDetail.OverallImprovementStatus == "Improved")
                    {
                        <span class="badge bg-success fs-6 px-3 py-2 rounded-pill shadow-sm">
                            <i class="bi bi-arrow-up-right-circle me-1"></i> Overall Improved
                        </span>
                    }
                    else if (progressDetail.OverallImprovementStatus == "Deteriorated")
                    {
                        <span class="badge bg-danger fs-6 px-3 py-2 rounded-pill shadow-sm">
                            <i class="bi bi-arrow-down-right-circle me-1"></i> Needs Attention
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark fs-6 px-3 py-2 rounded-pill shadow-sm">
                            <i class="bi bi-dash-circle me-1"></i> Stable Progress
                        </span>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- ================= Line Chart: Follow-up Progress Trajectory ================= -->
    <div class="glass-card-admin mb-4">
        <div class="card-header border-0 pt-4 px-4 pb-0 bg-transparent">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <h5 class="fw-bold mb-1" style="color: #5E503F;">
                        <i class="bi bi-graph-up-arrow me-2 text-primary"></i>
                        Session-by-Session Follow-up Progress Line Graph
                    </h5>
                    <p class="text-muted small mb-0">
                        Visualizing student recovery trajectory and milestone scores across all counseling follow-ups (X-axis: Sessions, Y-axis: Score 0-100)
                    </p>
                </div>
                <div class="badge bg-light text-secondary border px-3 py-2 rounded-pill">
                    <i class="bi bi-dot text-success fs-5 align-middle"></i> Target Recovery Threshold &gt; 75.0
                </div>
            </div>
        </div>
        <div class="card-body p-4" style="min-height: 350px;">
            <canvas id="adminObservationProgressChart" style="max-height: 320px;"></canvas>
        </div>
    </div>

    <!-- ================= Follow-up Observation Details Table ================= -->
    <div class="glass-card-admin mb-4">
        <div class="card-header border-0 pt-4 px-4 pb-2 bg-transparent">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <h5 class="fw-bold mb-1" style="color: #5E503F;">
                        <i class="bi bi-table me-2 text-primary"></i>
                        Follow-up Observation Details &amp; Improvement Analysis Table
                    </h5>
                    <p class="text-muted small mb-0">
                        Observation metrics after each follow-up: mental health conditions, safety risks, functional domain status, score change (+/-), and improvement status.
                    </p>
                </div>
                <span class="badge bg-secondary-subtle text-secondary border rounded-pill px-3 py-1.5">
                    @progressDetail.Sessions.Count Recorded Sessions
                </span>
            </div>
        </div>

        <div class="card-body p-4">
            @if (progressDetail.Sessions.Any())
            {
                <div class="table-responsive">
                    <table class="table table-admin align-middle">
                        <thead>
                            <tr>
                                <th style="min-width: 140px;">Follow-up Stage</th>
                                <th style="min-width: 130px;">Date &amp; Time</th>
                                <th class="text-center" style="min-width: 120px;">Mental Health</th>
                                <th class="text-center" style="min-width: 110px;">Safety Risk</th>
                                <th style="min-width: 180px;">Functional Domains</th>
                                <th class="text-center" style="min-width: 110px;">Score</th>
                                <th class="text-center" style="min-width: 160px;">Improvement Status</th>
                                <th style="min-width: 140px;">Student Reported</th>
                                <th style="min-width: 220px;">Clinical Observation Summary</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var session in progressDetail.Sessions)
                            {
                                <tr>
                                    <!-- Stage / Title -->
                                    <td>
                                        <div class="fw-bold text-dark">
                                            @session.SessionTitle
                                        </div>
                                        <small class="text-muted">Counseling #@session.CounselingId</small>
                                    </td>

                                    <!-- Date & Time -->
                                    <td>
                                        <div class="fw-semibold text-dark">
                                            @session.SessionDate.ToString("dd MMM yyyy")
                                        </div>
                                        <small class="text-muted">
                                            <i class="bi bi-clock me-1"></i>@session.CounselingTime
                                        </small>
                                    </td>

                                    <!-- Mental Health -->
                                    <td class="text-center">
                                        @if (session.MentalHealthStatus == "Normal")
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success rounded-pill px-2.5 py-1">Normal</span>
                                        }
                                        else if (session.MentalHealthStatus == "Moderate")
                                        {
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning rounded-pill px-2.5 py-1">Moderate</span>
                                        }
                                        else if (session.MentalHealthStatus == "Severe")
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger rounded-pill px-2.5 py-1">Severe</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-dark-subtle text-dark border rounded-pill px-2.5 py-1">@session.MentalHealthStatus</span>
                                        }
                                    </td>

                                    <!-- Safety Risk -->
                                    <td class="text-center">
                                        @if (session.SafetyRisk == "No Current Risk" || session.SafetyRisk == "No Risk")
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success rounded-pill px-2 py-1">No Risk</span>
                                        }
                                        else if (session.SafetyRisk == "Low Risk")
                                        {
                                            <span class="badge bg-info-subtle text-info-emphasis border border-info rounded-pill px-2 py-1">Low Risk</span>
                                        }
                                        else if (session.SafetyRisk == "Moderate Risk")
                                        {
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning rounded-pill px-2 py-1">Moderate</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger text-white rounded-pill px-2 py-1">@session.SafetyRisk</span>
                                        }
                                    </td>

                                    <!-- Functional Domains -->
                                    <td>
                                        <div class="d-flex flex-column gap-1" style="font-size: 0.8rem;">
                                            <div><span class="text-muted">Acad:</span> <strong>@session.AcademicFunctioning</strong></div>
                                            <div><span class="text-muted">Sleep:</span> <strong>@session.SleepCondition</strong></div>
                                            <div><span class="text-muted">Social:</span> <strong>@session.SocialInteraction</strong></div>
                                        </div>
                                    </td>

                                    <!-- Score -->
                                    <td class="text-center">
                                        <div class="score-badge-admin @(session.SessionScore >= 75 ? "bg-success-subtle text-success border border-success" : session.SessionScore >= 50 ? "bg-info-subtle text-info-emphasis border border-info" : "bg-warning-subtle text-warning-emphasis border border-warning")">
                                            @session.SessionScore
                                        </div>
                                        <small class="text-muted d-block mt-0.5">out of 100</small>
                                    </td>

                                    <!-- Improvement Status (how much improved or not) -->
                                    <td class="text-center">
                                        @if (session.SessionNumber == 1)
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary rounded-pill px-3 py-1.5">
                                                <i class="bi bi-flag-fill me-1"></i> Initial Baseline
                                            </span>
                                        }
                                        else if (session.SessionImprovementStatus == "Improved")
                                        {
                                            <span class="badge bg-success rounded-pill px-3 py-1.5 shadow-sm">
                                                <i class="bi bi-arrow-up-right me-1"></i> +@session.ScoreChange pts (Improved)
                                            </span>
                                        }
                                        else if (session.SessionImprovementStatus == "Deteriorated")
                                        {
                                            <span class="badge bg-danger rounded-pill px-3 py-1.5 shadow-sm">
                                                <i class="bi bi-arrow-down-right me-1"></i> @session.ScoreChange pts (Deteriorated)
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info-subtle text-info-emphasis border border-info rounded-pill px-3 py-1.5">
                                                <i class="bi bi-dash me-1"></i> Stable (@(session.ScoreChange >= 0 ? "+" : "")@session.ScoreChange pts)
                                            </span>
                                        }
                                    </td>

                                    <!-- Student Reported -->
                                    <td>
                                        <span class="badge bg-light text-dark border px-2.5 py-1 rounded-pill">
                                            @session.StudentReportedImprovement
                                        </span>
                                    </td>

                                    <!-- Clinical Observation -->
                                    <td>
                                        <div class="text-dark small" style="max-width: 320px; line-height: 1.4;">
                                            @(string.IsNullOrEmpty(session.ClinicalObservation) ? "-" : session.ClinicalObservation)
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center text-muted py-5">
                    <i class="bi bi-clipboard-x fs-1 d-block mb-2 text-secondary"></i>
                    No counseling observations are available for this student.
                </div>
            }
        </div>
    </div>

    <!-- ================= Detailed Individual Session Cards ================= -->
    <div class="glass-card-admin mb-4">
        <div class="card-header border-0 py-3.5 px-4" style="background:#E8DDD2; border-radius: 1.25rem 1.25rem 0 0;">
            <h5 class="mb-0 fw-bold" style="color:#5E503F;">
                <i class="bi bi-journal-text me-2"></i>
                Full Clinical Session Observation Records
            </h5>
        </div>

        <div class="card-body p-4">
            @if (observations.Any())
            {
                var sessionNumber = 1;
                @foreach (var item in observations)
                {
                    var counseling = item.Counseling;
                    var sessionScore = StudentMentalHealthMonitoringSystem.Services.ProgressScoringService.CalculateObservationScore(item);

                    <div class="card border rounded-4 mb-4 shadow-sm" style="border-color:#E5D8CC !important;">
                        <div class="card-header border-0 py-3 px-4" style="background:#F7F2ED; border-radius: 0.9rem 0.9rem 0 0;">
                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge bg-secondary text-white rounded-circle p-2" style="width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center;">
                                        @sessionNumber
                                    </span>
                                    <strong class="fs-6" style="color:#5E503F;">
                                        @(sessionNumber == 1 ? "Session 1 (Baseline Assessment)" : $"Follow-up Session {sessionNumber - 1}")
                                    </strong>
                                </div>

                                <div class="d-flex align-items-center gap-3">
                                    <span class="badge bg-white text-dark border px-3 py-1.5 rounded-pill">
                                        Score: <strong>@sessionScore / 100</strong>
                                    </span>
                                    @if (counseling != null)
                                    {
                                        <span class="text-muted small">
                                            <i class="bi bi-calendar-event me-1"></i>@counseling.CounselingDate.ToString("dd MMM yyyy") | 
                                            <i class="bi bi-clock me-1"></i>@DateTime.Today.Add(counseling.AppointmentTime).ToString("h:mm tt")
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="card-body p-4">
                            <div class="row g-4">
                                <div class="col-md-3 col-sm-6">
                                    <small class="text-muted d-block">Overall Progress</small>
                                    <strong class="text-dark">@item.OverallProgressStatus</strong>
                                </div>
                                <div class="col-md-3 col-sm-6">
                                    <small class="text-muted d-block">Mental Health Condition</small>
                                    <strong class="text-dark">@item.CurrentMentalHealthStatus</strong>
                                </div>
                                <div class="col-md-3 col-sm-6">
                                    <small class="text-muted d-block">Safety Risk</small>
                                    <strong class="text-dark">@item.CurrentSafetyRisk</strong>
                                </div>
                                <div class="col-md-3 col-sm-6">
                                    <small class="text-muted d-block">Student-Reported Change</small>
                                    <strong class="text-dark">@item.StudentReportedImprovement</strong>
                                </div>

                                <div class="col-md-3 col-sm-6">
                                    <small class="text-muted d-block">PHQ-9 Score</small>
                                    <strong>@(item.PHQScore?.ToString() ?? "Not Available")</strong>
                                </div>
                                <div class="col-md-3 col-sm-6">
                                    <small class="text-muted d-block">PHQ-9 Status</small>
                                    <strong>@(item.PHQProjectStatus ?? "Not Assessed")</strong>
                                </div>
                                <div class="col-md-3 col-sm-6">
                                    <small class="text-muted d-block">C-SSRS Risk</small>
                                    <strong>@(item.CSSRSRiskLevel ?? "Not Available")</strong>
                                </div>
                                <div class="col-md-3 col-sm-6">
                                    <small class="text-muted d-block">C-SSRS Status</small>
                                    <strong>@(item.CSSRSProjectStatus ?? "Not Assessed")</strong>
                                </div>
                            </div>

                            <hr class="my-3 opacity-25" />

                            <h6 class="fw-bold mb-2 text-secondary" style="font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.5px;">
                                Functional Status Breakdown
                            </h6>
                            <div class="row g-3">
                                <div class="col-md-2 col-sm-4 col-6">
                                    <small class="text-muted d-block">Academic</small>
                                    <strong>@item.AcademicFunctioning</strong>
                                </div>
                                <div class="col-md-2 col-sm-4 col-6">
                                    <small class="text-muted d-block">Sleep</small>
                                    <strong>@item.SleepCondition</strong>
                                </div>
                                <div class="col-md-2 col-sm-4 col-6">
                                    <small class="text-muted d-block">Social</small>
                                    <strong>@item.SocialInteraction</strong>
                                </div>
                                <div class="col-md-3 col-sm-6 col-6">
                                    <small class="text-muted d-block">Daily Activities</small>
                                    <strong>@item.DailyActivities</strong>
                                </div>
                                <div class="col-md-3 col-sm-6 col-6">
                                    <small class="text-muted d-block">Emotional Regulation</small>
                                    <strong>@item.EmotionalRegulation</strong>
                                </div>
                            </div>

                            <hr class="my-3 opacity-25" />

                            <div class="row g-3">
                                <div class="col-md-12">
                                    <small class="text-muted d-block mb-1">Assessment Basis</small>
                                    <div class="text-dark">@item.AssessmentBasis.Replace(" | ", ", ")</div>
                                </div>

                                <div class="col-md-12">
                                    <small class="text-muted d-block mb-1">Clinical Observation Notes</small>
                                    <div class="p-3 bg-light rounded-3 text-dark" style="white-space:pre-line; font-size: 0.9rem;">
                                        @item.ClinicalObservation
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <small class="text-muted d-block mb-1">Assessment Summary</small>
                                    <div class="text-dark" style="white-space:pre-line;">@item.AssessmentSummary</div>
                                </div>

                                <div class="col-md-6">
                                    <small class="text-muted d-block mb-1">Recommended Action</small>
                                    <div class="text-dark">@item.RecommendedAction.Replace(" | ", ", ")</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    sessionNumber++;
                }
            }
        </div>
    </div>

    <!-- ================= Latest / Final Updated Condition Summary ================= -->
    <div class="glass-card-admin">
        <div class="card-header border-0 py-3.5 px-4" style="background:#E4EEE5; border-radius: 1.25rem 1.25rem 0 0;">
            <h5 class="mb-0 fw-bold" style="color:#536857;">
                <i class="bi bi-shield-check me-2"></i>
                @(Model.IsFinal ? "Final Clinical Conclusion & Outcome" : "Latest Ongoing Clinical Assessment")
            </h5>
        </div>

        <div class="card-body p-4">
            <div class="row g-4">
                <div class="col-md-4 col-sm-6">
                    <small class="text-muted d-block">Initial Baseline Condition</small>
                    <strong class="fs-6" style="color:#5E503F;">@Model.InitialStatus</strong>
                </div>

                <div class="col-md-4 col-sm-6">
                    <small class="text-muted d-block">Current / Final Condition</small>
                    <strong class="fs-6" style="color:#5E503F;">@Model.CurrentStatus</strong>
                </div>

                <div class="col-md-4 col-sm-6">
                    <small class="text-muted d-block">Overall Progress Status</small>
                    <strong class="fs-6" style="color:#5E503F;">@Model.OverallProgressStatus</strong>
                </div>

                <div class="col-md-4 col-sm-6">
                    <small class="text-muted d-block">Latest PHQ-9 Status</small>
                    <strong>@(latestObservation?.PHQProjectStatus ?? "Not Assessed")</strong>
                </div>

                <div class="col-md-4 col-sm-6">
                    <small class="text-muted d-block">Latest C-SSRS Risk Level</small>
                    <strong>@(latestObservation?.CSSRSRiskLevel ?? "Not Available")</strong>
                </div>

                <div class="col-md-4 col-sm-6">
                    <small class="text-muted d-block">Current Safety Risk</small>
                    <strong>@Model.CurrentSafetyRisk</strong>
                </div>
            </div>

            <hr class="my-4 opacity-25" />

            <div class="mb-3">
                <small class="text-muted d-block mb-1">Assessment Basis</small>
                <div style="color:#5E503F;">@Model.LatestAssessmentBasis.Replace(" | ", ", ")</div>
            </div>

            <div class="mb-3">
                <small class="text-muted d-block mb-1">Latest Assessment Summary</small>
                <div class="p-3 bg-light rounded-3 text-dark" style="white-space:pre-line;">
                    @Model.LatestConditionSummary
                </div>
            </div>

            <div>
                <small class="text-muted d-block mb-1">Recommended Action</small>
                <div style="color:#5E503F;">@Model.LatestRecommendedAction.Replace(" | ", ", ")</div>
            </div>
        </div>
    </div>

</div>

<!-- Chart.js Library and Initialization -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const sessionLabels = [];
        const sessionScores = [];
        const sessionDates = [];
        const scoreChanges = [];
        const mentalHealthStatuses = [];

        @foreach (var s in progressDetail.Sessions)
        {
            <text>
            sessionLabels.push('@(s.SessionNumber == 1 ? "Session 1 (Initial)" : $"Follow-up {s.SessionNumber - 1}")');
            sessionScores.push(@s.SessionScore);
            sessionDates.push('@s.SessionDate.ToString("MMM dd")');
            scoreChanges.push('@(s.SessionNumber == 1 ? "Baseline" : (s.ScoreChange >= 0 ? "+" + s.ScoreChange : s.ScoreChange.ToString()) + " pts")');
            mentalHealthStatuses.push('@s.MentalHealthStatus');
            </text>
        }

        const canvas = document.getElementById('adminObservationProgressChart');
        if (canvas && sessionLabels.length > 0) {
            const ctx = canvas.getContext('2d');

            const gradient = ctx.createLinearGradient(0, 0, 0, 300);
            gradient.addColorStop(0, 'rgba(166, 124, 82, 0.35)');
            gradient.addColorStop(1, 'rgba(166, 124, 82, 0.02)');

            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: sessionLabels,
                    datasets: [
                        {
                            label: 'Recovery / Progress Score',
                            data: sessionScores,
                            borderColor: '#A67C52',
                            backgroundColor: gradient,
                            borderWidth: 3,
                            fill: true,
                            tension: 0.35,
                            pointBackgroundColor: '#5E503F',
                            pointBorderColor: '#ffffff',
                            pointBorderWidth: 2,
                            pointRadius: 6,
                            pointHoverRadius: 8
                        },
                        {
                            label: 'Recovery Target (75)',
                            data: sessionLabels.map(() => 75),
                            borderColor: 'rgba(40, 167, 69, 0.5)',
                            borderWidth: 1.5,
                            borderDash: [5, 5],
                            pointRadius: 0,
                            fill: false
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: {
                        mode: 'index',
                        intersect: false
                    },
                    plugins: {
                        legend: {
                            display: true,
                            position: 'top',
                            labels: {
                                usePointStyle: true,
                                boxWidth: 8
                            }
                        },
                        tooltip: {
                            backgroundColor: '#5E503F',
                            titleFont: { size: 13, weight: 'bold' },
                            bodyFont: { size: 12 },
                            padding: 12,
                            cornerRadius: 8,
                            callbacks: {
                                afterLabel: function(context) {
                                    const idx = context.dataIndex;
                                    if (context.datasetIndex === 0) {
                                        return [
                                            'Date: ' + sessionDates[idx],
                                            'Condition: ' + mentalHealthStatuses[idx],
                                            'Change: ' + scoreChanges[idx]
                                        ];
                                    }
                                    return '';
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            min: 0,
                            max: 100,
                            ticks: {
                                stepSize: 20
                            },
                            grid: {
                                color: 'rgba(0, 0, 0, 0.05)'
                            },
                            title: {
                                display: true,
                                text: 'Recovery Score (0 - 100)'
                            }
                        },
                        x: {
                            grid: {
                                display: false
                            },
                            title: {
                                display: true,
                                text: 'Counseling Sessions / Follow-up Stages'
                            }
                        }
                    }
                }
            });
        }
    });
</script>
