@model StudentMentalHealthMonitoringSystem.ViewModels.AdminDashboardViewModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container-fluid">

    <!-- ================= Welcome Banner ================= -->
    <div class="card border-0 shadow-sm rounded-4 mb-4" style="background: linear-gradient(135deg, #5F5146 0%, #8A7563 100%);">
        <div class="card-body p-4 text-white">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div class="d-flex align-items-center gap-3">
                    @if (!string.IsNullOrEmpty(Model.Admin?.ProfileImage))
                    {
                        <img src="@Model.Admin.ProfileImage"
                             class="rounded-circle shadow-sm border border-2 border-white"
                             width="64"
                             height="64"
                             style="object-fit:cover;">
                    }
                    else
                    {
                        <img src="https://ui-avatars.com/api/?name=@Uri.EscapeDataString(Model.Admin?.FullName ?? "Admin")&background=FFFFFF&color=5F5146&size=64"
                             class="rounded-circle shadow-sm border border-2 border-white"
                             width="64"
                             height="64">
                    }
                    <div>
                        <div class="badge bg-white text-dark rounded-pill px-3 py-1 mb-1 fw-semibold shadow-sm">
                            <i class="bi bi-shield-lock-fill text-primary me-1"></i> System Administrator
                        </div>
                        <h2 class="fw-bold mb-0 text-white">
                            Welcome Back, @Model.Admin?.FullName 👋
                        </h2>
                        <p class="text-white-50 mb-0 small">
                            Manage students, psychologists, departments, and institutional reports from one unified hub.
                        </p>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-light text-dark rounded-pill px-3 py-2 fw-bold shadow-sm">
                        <i class="bi bi-calendar-event me-1 text-primary"></i> @DateTime.Now.ToString("dd MMM yyyy")
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- ================= Semester Transition Callout ================= -->
    <div class="card border-0 shadow-sm rounded-4 mb-4" style="background: linear-gradient(135deg, #002147 0%, #004D25 100%); color: white;">
        <div class="card-body p-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h4 class="fw-bold mb-1 text-white">
                    <i class="bi bi-arrow-repeat me-2"></i>Semester Transition &amp; Governance
                </h4>
                <p class="text-white-50 mb-0">End current 4-month semester term, advance compliant students, and reset screening requirements for the new term.</p>
            </div>
            <a href="/Admin/SemesterManagement" class="btn btn-warning rounded-3 text-dark fw-bold px-4 py-2.5 shadow-sm">
                <i class="bi bi-rocket-takeoff me-1"></i> End &amp; Start Semester
            </a>
        </div>
    </div>

    <!-- ================= Statistics ================= -->
    <div class="row g-4 mb-4">

        <div class="col-xl-4 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-3 h-100" style="background:#ffffff; border-left: 5px solid #8A7563 !important;">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="text-muted mb-0 fw-semibold">
                            <i class="bi bi-mortarboard me-1 text-primary"></i> Total Students
                        </h6>
                        <span class="badge bg-primary-subtle text-primary rounded-pill px-2.5 py-1">Enrolled</span>
                    </div>
                    <h2 class="fw-bold mb-0" style="color:#4A3F35;">
                        @Model.TotalStudents
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-xl-4 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-3 h-100" style="background:#ffffff; border-left: 5px solid #DC2626 !important;">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="text-muted mb-0 fw-semibold">
                            <i class="bi bi-exclamation-triangle-fill text-danger me-1"></i> High Risk Students
                        </h6>
                        <span class="badge bg-danger rounded-pill px-2.5 py-1">Critical Priority</span>
                    </div>
                    <h2 class="fw-bold mb-0 text-danger">
                        @Model.HighRiskStudents
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-xl-4 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-3 h-100" style="background:#ffffff; border-left: 5px solid #059669 !important;">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="text-muted mb-0 fw-semibold">
                            <i class="bi bi-person-workspace me-1 text-success"></i> Psychologists
                        </h6>
                        <span class="badge bg-success-subtle text-success rounded-pill px-2.5 py-1">Active Staff</span>
                    </div>
                    <h2 class="fw-bold mb-0" style="color:#4A3F35;">
                        @Model.TotalPsychologists
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-xl-6 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-3 h-100" style="background:#ffffff; border-left: 5px solid #6366F1 !important;">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="text-muted mb-0 fw-semibold">
                            <i class="bi bi-building me-1 text-indigo"></i> Total Departments
                        </h6>
                        <span class="badge bg-indigo-subtle text-indigo rounded-pill px-2.5 py-1">Academic</span>
                    </div>
                    <h2 class="fw-bold mb-0" style="color:#4A3F35;">
                        @Model.TotalDepartments
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-xl-6 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-3 h-100" style="background:#ffffff; border-left: 5px solid #D97706 !important;">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="text-muted mb-0 fw-semibold">
                            <i class="bi bi-journal-check me-1 text-warning-emphasis"></i> Counseling Sessions
                        </h6>
                        <span class="badge bg-warning-subtle text-warning-emphasis rounded-pill px-2.5 py-1">Total Bookings</span>
                    </div>
                    <h2 class="fw-bold mb-0" style="color:#4A3F35;">
                        @Model.TotalCounselingSessions
                    </h2>
                </div>
            </div>
        </div>

    </div>

    <!-- ================= Bottom Section ================= -->
    <div class="row g-4">

        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header border-0 rounded-top-4 py-3 px-4 fw-bold"
                     style="background:#EDE2D8; color:#5F5146;">
                    <i class="bi bi-clock-history me-2"></i> Pending Counseling
                </div>
                <div class="card-body p-4">
                    <h1 class="fw-bold mb-2" style="color:#8A7563;">
                        @Model.PendingCounselingSessions
                    </h1>
                    <p class="text-muted mb-0">
                        Appointments awaiting clinician follow-up or completion.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header border-0 rounded-top-4 py-3 px-4 fw-bold"
                     style="background:#EDE2D8; color:#5F5146;">
                    <i class="bi bi-lightning-charge me-2"></i> Quick Actions
                </div>
                <div class="card-body p-4 d-grid gap-2">
                    <a asp-action="Students"
                       class="btn rounded-3 fw-semibold py-2.5 text-white"
                       style="background:#8A7563;">
                        <i class="bi bi-mortarboard me-2"></i> Manage Students
                    </a>

                    <a asp-action="Psychologists"
                       class="btn rounded-3 fw-semibold py-2.5 text-white"
                       style="background:#8A7563;">
                        <i class="bi bi-person-workspace me-2"></i> Manage Psychologists
                    </a>

                    <a asp-action="Reports"
                       class="btn rounded-3 fw-semibold py-2.5 text-white"
                       style="background:#5F5146;">
                        <i class="bi bi-file-earmark-bar-graph me-2"></i> View Reports Hub
                    </a>
                </div>
            </div>
        </div>

    </div>

</div>