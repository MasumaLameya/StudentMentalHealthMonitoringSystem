@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container-fluid">

    <div class="row">

        <!-- Sidebar -->

        <div class="col-lg-3">

            <div class="card shadow">

                <div class="card-body">

                    <div class="text-center">

                        <img src="https://ui-avatars.com/api/?name=Admin&background=212529&color=fff&size=120"
                             class="rounded-circle mb-3">

                        <h4>Administrator</h4>

                        <p class="text-muted">

                            System Administrator

                        </p>

                    </div>

                    <hr>

                    <div class="list-group">

                        <a href="/Admin/Dashboard" class="list-group-item list-group-item-action active">
                            Dashboard
                        </a>

                        <a href="/Admin/Students" class="list-group-item list-group-item-action">
                            Students
                        </a>

                        <a href="/Admin/Psychologists" class="list-group-item list-group-item-action">
                            Psychologists
                        </a>

                        <a href="/Admin/Departments" class="list-group-item list-group-item-action">
                            Departments
                        </a>

                        <a href="/Admin/Reports" class="list-group-item list-group-item-action">
                            Reports
                        </a>

                        <a href="/Admin/Analytics" class="list-group-item list-group-item-action">
                            Analytics
                        </a>

                        <a href="/Admin/Settings" class="list-group-item list-group-item-action">
                            Settings
                        </a>

                        <a href="/Admin/Profile" class="list-group-item list-group-item-action">
                            Profile
                        </a>

                    </div>

                </div>

            </div>

        </div>

        <!-- Main -->

        <div class="col-lg-9">

            <h2 class="mb-4">

                Admin Dashboard

            </h2>

            <div class="row">

                <div class="col-md-3 mb-4">

                    <div class="card bg-primary text-white shadow">

                        <div class="card-body">

                            <h6>Total Students</h6>

                            <h2>1245</h2>

                        </div>

                    </div>

                </div>

                <div class="col-md-3 mb-4">

                    <div class="card bg-success text-white shadow">

                        <div class="card-body">

                            <h6>Psychologists</h6>

                            <h2>12</h2>

                        </div>

                    </div>

                </div>

                <div class="col-md-3 mb-4">

                    <div class="card bg-warning shadow">

                        <div class="card-body">

                            <h6>Departments</h6>

                            <h2>8</h2>

                        </div>

                    </div>

                </div>

                <div class="col-md-3 mb-4">

                    <div class="card bg-danger text-white shadow">

                        <div class="card-body">

                            <h6>High Risk</h6>

                            <h2>24</h2>

                        </div>

                    </div>

                </div>

            </div>

            <div class="row">

                <div class="col-md-7">

                    <div class="card shadow">

                        <div class="card-header bg-primary text-white">

                            Recent System Activities

                        </div>

                        <div class="card-body">

                            <table class="table table-bordered">

                                <tr>

                                    <th>Activity</th>

                                    <th>Status</th>

                                </tr>

                                <tr>

                                    <td>Student Registration</td>

                                    <td>Completed</td>

                                </tr>

                                <tr>

                                    <td>Semester Screening</td>

                                    <td>Running</td>

                                </tr>

                                <tr>

                                    <td>Counseling Session</td>

                                    <td>Scheduled</td>

                                </tr>

                                <tr>

                                    <td>Guardian Notification</td>

                                    <td>Pending</td>

                                </tr>

                            </table>

                        </div>

                    </div>

                </div>

                <div class="col-md-5">

                    <div class="card shadow">

                        <div class="card-header bg-dark text-white">

                            Quick Management

                        </div>

                        <div class="card-body d-grid gap-2">

                            <a href="/Admin/Students" class="btn btn-outline-primary">

                                Manage Students

                            </a>

                            <a href="/Admin/Psychologists" class="btn btn-outline-success">

                                Manage Psychologists

                            </a>

                            <a href="/Admin/Departments" class="btn btn-outline-warning">

                                Manage Departments

                            </a>

                            <a href="/Admin/Reports" class="btn btn-outline-danger">

                                View Reports

                            </a>

                            <a href="/Admin/Analytics" class="btn btn-outline-info">

                                Analytics

                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>