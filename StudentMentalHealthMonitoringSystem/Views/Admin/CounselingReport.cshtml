@model IEnumerable<StudentMentalHealthMonitoringSystem.Models.Counseling>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Counseling Report";
}

<div class="container-fluid" id="adminCounselingReportContent">

    <!-- ================= Header ================= -->

    <div class="card border-0 shadow-sm rounded-4 mb-4"
         style="background:#F4EEE8;">

        <div class="card-body p-4">

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

                <div>

                    <h2 class="fw-bold mb-1"
                        style="color:#5F5146;">

                        🩺 Counseling Report

                    </h2>

                    <p class="text-muted mb-0">

                        View all student counseling appointments and assignments.

                    </p>

                </div>

                <div class="d-flex align-items-center gap-3">
                    <div class="text-end">
                        <div class="fw-bold"
                             style="font-size:25px;
                            color:#A67C52;">
                            @Model.Count()
                        </div>
                        <small class="text-muted">
                            Total Appointments
                        </small>
                    </div>
                </div>

            </div>

        </div>

    </div>


    <!-- ================= Summary ================= -->

    <div class="row g-3 mb-4">

        <div class="col-md-3">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-body">

                    <small class="text-muted">
                        Total
                    </small>

                    <h3 class="fw-bold mt-2"
                        style="color:#5F5146;">

                        @Model.Count()

                    </h3>

                </div>

            </div>

        </div>


        <div class="col-md-3">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-body">

                    <small class="text-muted">
                        Confirmed
                    </small>

                    <h3 class="fw-bold mt-2"
                        style="color:#A67C52;">

                        @Model.Count(c => c.Status == "Confirmed")

                    </h3>

                </div>

            </div>

        </div>


        <div class="col-md-3">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-body">

                    <small class="text-muted">
                        Completed
                    </small>

                    <h3 class="fw-bold mt-2 text-success">

                        @Model.Count(c => c.Status == "Completed")

                    </h3>

                </div>

            </div>

        </div>


        <div class="col-md-3">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-body">

                    <small class="text-muted">
                        Cancelled
                    </small>

                    <h3 class="fw-bold mt-2 text-danger">

                        @Model.Count(c => c.Status == "Cancelled")

                    </h3>

                </div>

            </div>

        </div>

    </div>


    <!-- ================= Search & Filter Bar ================= -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3" style="background:#FAF6F0; border-radius: 1rem;">
            <div class="row g-3 align-items-center">
                <div class="col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 rounded-start-3" style="color:#A67C52;">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" id="counselingSearchInput" class="form-control border-start-0 rounded-end-3" placeholder="Search by student, ID, or psychologist..." onkeyup="filterCounselingTable()" />
                    </div>
                </div>
                <div class="col-md-3">
                    <select id="counselingStatusFilter" class="form-select rounded-3" onchange="filterCounselingTable()">
                        <option value="">All Statuses</option>
                        <option value="Confirmed">Confirmed</option>
                        <option value="Completed">Completed</option>
                        <option value="Cancelled">Cancelled</option>
                        <option value="Pending">Pending</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <select id="counselingRiskFilter" class="form-select rounded-3" onchange="filterCounselingTable()">
                        <option value="">All Risk Levels</option>
                        <option value="High">High Risk</option>
                        <option value="Moderate">Moderate Risk</option>
                        <option value="Low">Low Risk</option>
                    </select>
                </div>
                <div class="col-md-1">
                    <button class="btn btn-outline-secondary w-100 rounded-3" onclick="resetCounselingFilters()" title="Reset Filters">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- ================= Counseling Table ================= -->

    <div class="card border-0 shadow-sm rounded-4">

        <div class="card-body p-4">

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle" id="counselingTable">

                        <thead>

                            <tr>

                                <th>
                                    Student
                                </th>

                                <th>
                                    Psychologist
                                </th>

                                <th>
                                    Date
                                </th>

                                <th>
                                    Time
                                </th>

                                <th>
                                    Room
                                </th>

                                <th>
                                    Risk
                                </th>

                                <th>
                                    Status
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var counseling in Model)
                            {
                                <tr>

                                    <!-- Student -->

                                    <td>

                                        <div class="fw-semibold">

                                            @counseling.Student?.FullName

                                        </div>

                                        <small class="text-muted">

                                            @counseling.Student?.StudentIdNumber

                                        </small>

                                    </td>


                                    <!-- Psychologist -->

                                    <td>

                                        @counseling.Psychologist?.FullName

                                    </td>


                                    <!-- Date -->

                                    <td>

                                        @counseling.CounselingDate.ToString(
                                            "dd MMM yyyy")

                                    </td>


                                    <!-- Time -->

                                    <td>

                                        @counseling.AppointmentTime.ToString(
                                            @"hh\:mm")

                                        -

                                        @counseling.AppointmentEndTime.ToString(
                                            @"hh\:mm")

                                    </td>


                                    <!-- Room -->

                                    <td>

                                        @(string.IsNullOrWhiteSpace(
                                            counseling.AppointmentRoom)
                                            ? "Not assigned"
                                            : counseling.AppointmentRoom)

                                    </td>


                                    <!-- Risk -->

                                    <td>

                                        @if (counseling.RiskLevel == "High")
                                        {
                                            <span class="badge bg-danger rounded-pill px-3 py-2">

                                                High

                                            </span>
                                        }
                                        else if (counseling.RiskLevel == "Moderate")
                                        {
                                            <span class="badge bg-warning text-dark rounded-pill px-3 py-2">

                                                Moderate

                                            </span>
                                        }
                                        else if (counseling.RiskLevel == "Low")
                                        {
                                            <span class="badge bg-success rounded-pill px-3 py-2">

                                                Low

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">

                                                Not assessed

                                            </span>
                                        }

                                    </td>


                                    <!-- Status -->

                                    <td>

                                        @if (counseling.Status == "Completed")
                                        {
                                            <span class="badge bg-success rounded-pill px-3 py-2">

                                                Completed

                                            </span>
                                        }
                                        else if (counseling.Status == "Cancelled")
                                        {
                                            <span class="badge bg-danger rounded-pill px-3 py-2">

                                                Cancelled

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill px-3 py-2"
                                                  style="background:#EEE4DA;
                                                color:#705F50;">

                                                @counseling.Status

                                            </span>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <i class="bi bi-calendar-x"
                       style="font-size:50px;
                    color:#B7A99A;"></i>

                    <h5 class="mt-3"
                        style="color:#5F5146;">

                        No Counseling Records

                    </h5>

                    <p class="text-muted mb-0">

                        No counseling appointments have been created yet.

                    </p>

                </div>
            }

        </div>

</div>

@section Scripts {
    <script>
        function filterCounselingTable() {
            var searchInput = document.getElementById("counselingSearchInput").value.toLowerCase().trim();
            var statusFilter = document.getElementById("counselingStatusFilter").value.toLowerCase().trim();
            var riskFilter = document.getElementById("counselingRiskFilter").value.toLowerCase().trim();

            var table = document.getElementById("counselingTable");
            if (!table) return;
            var rows = table.getElementsByTagName("tbody")[0].getElementsByTagName("tr");

            for (var i = 0; i < rows.length; i++) {
                var row = rows[i];
                var text = row.innerText.toLowerCase();

                // Get risk cell text (6th column, index 5)
                var riskCell = row.cells[5] ? row.cells[5].innerText.toLowerCase() : "";
                // Get status cell text (7th column, index 6)
                var statusCell = row.cells[6] ? row.cells[6].innerText.toLowerCase() : "";

                var matchesSearch = !searchInput || text.indexOf(searchInput) > -1;
                var matchesStatus = !statusFilter || statusCell.indexOf(statusFilter) > -1;
                var matchesRisk = !riskFilter || riskCell.indexOf(riskFilter) > -1;

                if (matchesSearch && matchesStatus && matchesRisk) {
                    row.style.display = "";
                } else {
                    row.style.display = "none";
                }
            }
        }

        function resetCounselingFilters() {
            document.getElementById("counselingSearchInput").value = "";
            document.getElementById("counselingStatusFilter").value = "";
            document.getElementById("counselingRiskFilter").value = "";
            filterCounselingTable();
        }
    </script>
}