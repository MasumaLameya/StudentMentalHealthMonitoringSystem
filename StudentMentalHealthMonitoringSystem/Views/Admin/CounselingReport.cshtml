@model IEnumerable<StudentMentalHealthMonitoringSystem.Models.Counseling>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Counseling Report";
}

<div class="container-fluid" id="adminCounselingReportContent">

    <!-- ================= Header ================= -->

    <div class="card border-0 shadow-sm rounded-4 mb-4"
         style="background:#F4EEE8;">

        <div class="card-body p-4">

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

                <div>

                    <h2 class="fw-bold mb-1"
                        style="color:#5F5146;">

                        🩺 Counseling Report

                    </h2>

                    <p class="text-muted mb-0">

                        View all student counseling appointments and assignments.

                    </p>

                </div>

                <div class="d-flex align-items-center gap-3">
                    <div class="text-end">
                        <div class="fw-bold"
                             style="font-size:25px;
                            color:#A67C52;">
                            @Model.Count()
                        </div>
                        <small class="text-muted">
                            Total Appointments
                        </small>
                    </div>
                </div>

            </div>

        </div>

    </div>


    <!-- ================= Summary ================= -->

    <div class="row g-3 mb-4">

        <div class="col-md-3">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-body">

                    <small class="text-muted">
                        Total
                    </small>

                    <h3 class="fw-bold mt-2"
                        style="color:#5F5146;">

                        @Model.Count()

                    </h3>

                </div>

            </div>

        </div>


        <div class="col-md-3">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-body">

                    <small class="text-muted">
                        Confirmed
                    </small>

                    <h3 class="fw-bold mt-2"
                        style="color:#A67C52;">

                        @Model.Count(c => c.Status == "Confirmed")

                    </h3>

                </div>

            </div>

        </div>


        <div class="col-md-3">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-body">

                    <small class="text-muted">
                        Completed
                    </small>

                    <h3 class="fw-bold mt-2 text-success">

                        @Model.Count(c => c.Status == "Completed")

                    </h3>

                </div>

            </div>

        </div>


        <div class="col-md-3">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-body">

                    <small class="text-muted">
                        Cancelled
                    </small>

                    <h3 class="fw-bold mt-2 text-danger">

                        @Model.Count(c => c.Status == "Cancelled")

                    </h3>

                </div>

            </div>

        </div>

    </div>


    <!-- ================= Counseling Table ================= -->

    <div class="card border-0 shadow-sm rounded-4">

        <div class="card-body p-4">

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead>

                            <tr>

                                <th>
                                    Student
                                </th>

                                <th>
                                    Psychologist
                                </th>

                                <th>
                                    Date
                                </th>

                                <th>
                                    Time
                                </th>

                                <th>
                                    Room
                                </th>

                                <th>
                                    Risk
                                </th>

                                <th>
                                    Status
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var counseling in Model)
                            {
                                <tr>

                                    <!-- Student -->

                                    <td>

                                        <div class="fw-semibold">

                                            @counseling.Student?.FullName

                                        </div>

                                        <small class="text-muted">

                                            @counseling.Student?.StudentIdNumber

                                        </small>

                                    </td>


                                    <!-- Psychologist -->

                                    <td>

                                        @counseling.Psychologist?.FullName

                                    </td>


                                    <!-- Date -->

                                    <td>

                                        @counseling.CounselingDate.ToString(
                                            "dd MMM yyyy")

                                    </td>


                                    <!-- Time -->

                                    <td>

                                        @counseling.AppointmentTime.ToString(
                                            @"hh\:mm")

                                        -

                                        @counseling.AppointmentEndTime.ToString(
                                            @"hh\:mm")

                                    </td>


                                    <!-- Room -->

                                    <td>

                                        @(string.IsNullOrWhiteSpace(
                                            counseling.AppointmentRoom)
                                            ? "Not assigned"
                                            : counseling.AppointmentRoom)

                                    </td>


                                    <!-- Risk -->

                                    <td>

                                        @if (counseling.RiskLevel == "High")
                                        {
                                            <span class="badge bg-danger rounded-pill px-3 py-2">

                                                High

                                            </span>
                                        }
                                        else if (counseling.RiskLevel == "Moderate")
                                        {
                                            <span class="badge bg-warning text-dark rounded-pill px-3 py-2">

                                                Moderate

                                            </span>
                                        }
                                        else if (counseling.RiskLevel == "Low")
                                        {
                                            <span class="badge bg-success rounded-pill px-3 py-2">

                                                Low

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">

                                                Not assessed

                                            </span>
                                        }

                                    </td>


                                    <!-- Status -->

                                    <td>

                                        @if (counseling.Status == "Completed")
                                        {
                                            <span class="badge bg-success rounded-pill px-3 py-2">

                                                Completed

                                            </span>
                                        }
                                        else if (counseling.Status == "Cancelled")
                                        {
                                            <span class="badge bg-danger rounded-pill px-3 py-2">

                                                Cancelled

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill px-3 py-2"
                                                  style="background:#EEE4DA;
                                                color:#705F50;">

                                                @counseling.Status

                                            </span>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <i class="bi bi-calendar-x"
                       style="font-size:50px;
                    color:#B7A99A;"></i>

                    <h5 class="mt-3"
                        style="color:#5F5146;">

                        No Counseling Records

                    </h5>

                    <p class="text-muted mb-0">

                        No counseling appointments have been created yet.

                    </p>

                </div>
            }

        </div>

    </div>

</div>ipt>