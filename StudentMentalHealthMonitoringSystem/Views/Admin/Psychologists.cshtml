@model IEnumerable<StudentMentalHealthMonitoringSystem.Models.Psychologist>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Psychologists";
}

<div class="container-fluid">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert border-0 rounded-3 mb-4 d-flex align-items-center gap-2 p-3" style="background:#E6F4EA; border-left:4px solid #2E7D32; border-left-style:solid;">
            <i class="bi bi-check-circle-fill" style="color:#2E7D32; font-size:18px;"></i>
            <span style="color:#1B5E20; font-weight:600;">@TempData["SuccessMessage"]</span>
        </div>
    }

    <!-- ================= Header ================= -->

    <div class="card border-0 shadow-sm rounded-4 mb-4"
         style="background:#F4EEE8;">

        <div class="card-body p-4">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <h2 class="fw-bold mb-1"
                        style="color:#5F5146;">

                        Psychologist Management

                    </h2>

                    <p class="text-muted mb-0">

                        Manage registered psychologists and their information.

                    </p>

                </div>

                <a asp-controller="Admin"
                   asp-action="AddPsychologist"
                   class="btn rounded-3 px-4"
                   style="background:#B89B7A;color:white;">

                    <i class="bi bi-person-plus me-1"></i>

                    Add Psychologist

                </a>

            </div>

        </div>

    </div>


    <!-- ================= Search ================= -->

    <div class="card border-0 shadow-sm rounded-4 mb-4">

        <div class="card-body">

            <div class="row align-items-center">

                <div class="col-md-6">

                    <label class="form-label fw-semibold"
                           style="color:#5F5146;">

                        Search Psychologist

                    </label>

                    <input type="text"
                           id="searchPsychologist"
                           class="form-control rounded-3"
                           placeholder="Search by name, email or specialization..." />

                </div>

                <div class="col-md-6 text-md-end mt-3 mt-md-0">

                    <span class="text-muted">

                        Total Psychologists:

                    </span>

                    <strong style="color:#8A7563;">

                        @Model.Count()

                    </strong>

                </div>

            </div>

        </div>

    </div>


    <!-- ================= Psychologist Table ================= -->

    <div class="card border-0 shadow-sm rounded-4">

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0"
                       id="psychologistTable">

                    <thead style="background:#E8DDD2;">

                        <tr>

                            <th class="px-4 py-3">
                                Photo
                            </th>

                            <th class="py-3">
                                Name
                            </th>

                            <th class="py-3">
                                Email
                            </th>

                            <th class="py-3">
                                Specialization
                            </th>

                            <th class="py-3">
                                Qualification
                            </th>

                            <th class="py-3">
                                Experience
                            </th>

                            <th class="py-3 text-center">
                                Actions
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            foreach (var psychologist in Model)
                            {
                                <tr class="@(psychologist.IsSuspended ? "table-warning" : "")">

                                    <!-- ================= Photo ================= -->

                                    <td class="px-4">

                                        @if (!string.IsNullOrEmpty(
                                            psychologist.ProfileImage))
                                        {
                                            <img src="@psychologist.ProfileImage"
                                                 width="55"
                                                 height="55"
                                                 class="rounded-circle border"
                                                 style="object-fit:cover; @(psychologist.IsSuspended ? "opacity:0.6;" : "")">
                                        }
                                        else
                                        {
                                            <img src="https://ui-avatars.com/api/?name=@Uri.EscapeDataString(psychologist.FullName)&background=@(psychologist.IsSuspended ? "999" : "B89B7A")&color=fff&size=55"
                                                 width="55"
                                                 height="55"
                                                 class="rounded-circle"
                                                 style="@(psychologist.IsSuspended ? "opacity:0.6;" : "")">
                                        }

                                    </td>


                                    <!-- ================= Name ================= -->

                                    <td>

                                        <strong style="color:#5F5146;">
                                            @psychologist.FullName
                                        </strong>
                                        @if (psychologist.IsSuspended)
                                        {
                                            <span class="badge ms-2 px-2 py-1 rounded-pill" style="background:#E65C00; color:#fff; font-size:10px;">Suspended</span>
                                        }

                                    </td>


                                    <!-- ================= Email ================= -->

                                    <td>

                                        @psychologist.Email

                                    </td>


                                    <!-- ================= Specialization ================= -->

                                    <td>

                                        <span class="badge rounded-pill px-3 py-2"
                                              style="background:#EEE4DA;
                                            color:#705F50;">

                                            @psychologist.Specialization

                                        </span>

                                    </td>


                                    <!-- ================= Qualification ================= -->

                                    <td>

                                        @psychologist.Qualification

                                    </td>


                                    <!-- ================= Experience ================= -->

                                    <td>

                                        @psychologist.Experience years

                                    </td>


                                    <!-- ================= Actions ================= -->

                                    <td class="text-center">

                                        <div class="d-flex justify-content-center gap-1">

                                            <!-- View -->

                                            <a asp-controller="Admin"
                                               asp-action="PsychologistDetails"
                                               asp-route-id="@psychologist.PsychologistId"
                                               class="btn btn-sm rounded-3"
                                               style="background:#D8C7B8; color:#55483D;"
                                               title="View">
                                                <i class="bi bi-eye"></i>
                                            </a>


                                            <!-- Edit -->

                                            <a asp-controller="Admin"
                                               asp-action="EditPsychologist"
                                               asp-route-id="@psychologist.PsychologistId"
                                               class="btn btn-sm rounded-3"
                                               style="background:#E5D3B3; color:#665438;"
                                               title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>


                                            <!-- Suspend / Unsuspend -->

                                            @if (psychologist.IsSuspended)
                                            {
                                                <form asp-controller="Admin" asp-action="UnsuspendPsychologist" method="post" style="display:inline;">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@psychologist.PsychologistId" />
                                                    <button type="submit" class="btn btn-sm rounded-3"
                                                            style="background:#D4EDDA; color:#155724;"
                                                            title="Reactivate Psychologist"
                                                            onclick="return confirm('Reactivate this psychologist account?')">
                                                        <i class="bi bi-person-check"></i>
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <form asp-controller="Admin" asp-action="SuspendPsychologist" method="post" style="display:inline;">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@psychologist.PsychologistId" />
                                                    <button type="submit" class="btn btn-sm rounded-3"
                                                            style="background:#FFE0B2; color:#7A3A00;"
                                                            title="Suspend Psychologist"
                                                            onclick="return confirm('Suspend this psychologist account? They will not be able to log in.')">
                                                        <i class="bi bi-person-slash"></i>
                                                    </button>
                                                </form>
                                            }

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="7"
                                    class="text-center py-5">

                                    <i class="bi bi-person-x"
                                       style="font-size:45px;
                                    color:#B8AAA0;"></i>

                                    <p class="text-muted mt-2 mb-0">

                                        No psychologists found.

                                    </p>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>


<!-- ================= Search Script ================= -->

<script>

    document
        .getElementById("searchPsychologist")
        .addEventListener("keyup", function() {

            let searchValue =
                this.value.toLowerCase();

            document
                .querySelectorAll("#psychologistTable tbody tr")
                .forEach(function(row) {

                    let text =
                        row.innerText.toLowerCase();

                    row.style.display =
                        text.includes(searchValue)
                            ? ""
                            : "none";

                });

        });

</script>