@model StudentMentalHealthMonitoringSystem.Models.Psychologist

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Edit Psychologist";
}

<div class="container-fluid">

    <!-- ================= Header ================= -->

    <div class="card border-0 shadow-sm rounded-4 mb-4"
         style="background:#F4EEE8;">

        <div class="card-body p-4">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <h2 class="fw-bold mb-1"
                        style="color:#5F5146;">

                        Edit Psychologist

                    </h2>

                    <p class="text-muted mb-0">

                        Update psychologist personal and professional information.

                    </p>

                </div>

                <a asp-controller="Admin"
                   asp-action="PsychologistDetails"
                   asp-route-id="@Model.PsychologistId"
                   class="btn rounded-3 px-4"
                   style="background:#8A7563;color:white;">

                    <i class="bi bi-arrow-left me-1"></i>

                    Back

                </a>

            </div>

        </div>

    </div>


    <!-- ================= Edit Form ================= -->

    <div class="card border-0 shadow-sm rounded-4">

        <div class="card-body p-4">

            <form asp-controller="Admin"
                  asp-action="EditPsychologist"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <input asp-for="PsychologistId"
                       type="hidden" />

                <input asp-for="ProfileImage"
                       type="hidden" />

                <!-- Validation -->

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-4">
                </div>


                <!-- ================= Profile Image ================= -->

                <div class="text-center mb-4">

                    @if (!string.IsNullOrEmpty(Model.ProfileImage))
                    {
                        <img src="@Model.ProfileImage"
                             width="150"
                             height="150"
                             class="rounded-circle border shadow-sm mb-3"
                             style="object-fit:cover;">
                    }
                    else
                    {
                        <img src="https://ui-avatars.com/api/?name=@Uri.EscapeDataString(Model.FullName)&background=B89B7A&color=fff&size=150"
                             width="150"
                             height="150"
                             class="rounded-circle shadow-sm mb-3">
                    }

                    <div>

                        <label asp-for="ImageFile"
                               class="form-label fw-semibold"
                               style="color:#5F5146;">

                            Change Profile Image

                        </label>

                        <input asp-for="ImageFile"
                               type="file"
                               class="form-control"
                               accept=".jpg,.jpeg,.png,image/*" />

                        <span asp-validation-for="ImageFile"
                              class="text-danger">
                        </span>

                    </div>

                </div>


                <hr class="mb-4" />


                <!-- ================= Basic Information ================= -->

                <h4 class="mb-4"
                    style="color:#5F5146;">

                    Basic Information

                </h4>

                <div class="row">

                    <!-- Full Name -->

                    <div class="col-md-6 mb-3">

                        <label asp-for="FullName"
                               class="form-label fw-semibold">

                            Full Name

                        </label>

                        <input asp-for="FullName"
                               class="form-control rounded-3"
                               placeholder="Enter full name" />

                        <span asp-validation-for="FullName"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Email -->

                    <div class="col-md-6 mb-3">

                        <label asp-for="Email"
                               class="form-label fw-semibold">

                            Email

                        </label>

                        <input asp-for="Email"
                               type="email"
                               class="form-control rounded-3"
                               placeholder="Enter email address" />

                        <span asp-validation-for="Email"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Phone -->

                    <div class="col-md-6 mb-3">

                        <label asp-for="Phone"
                               class="form-label fw-semibold">

                            Phone

                        </label>

                        <input asp-for="Phone"
                               class="form-control rounded-3"
                               placeholder="Enter phone number" />

                        <span asp-validation-for="Phone"
                              class="text-danger">
                        </span>

                    </div>

                </div>


                <hr class="my-4" />


                <!-- ================= Professional Information ================= -->

                <h4 class="mb-4"
                    style="color:#5F5146;">

                    Professional Information

                </h4>

                <div class="row">

                    <!-- Specialization -->

                    <div class="col-md-6 mb-3">

                        <label asp-for="Specialization"
                               class="form-label fw-semibold">

                            Specialization

                        </label>

                        <select asp-for="Specialization"
                                class="form-select rounded-3">

                            <option value="">
                                -- Select Specialization --
                            </option>

                            <option value="Clinical Psychologist">
                                Clinical Psychologist
                            </option>

                            <option value="Counseling Psychologist">
                                Counseling Psychologist
                            </option>

                            <option value="Educational Psychologist">
                                Educational Psychologist
                            </option>

                            <option value="Child Psychologist">
                                Child Psychologist
                            </option>

                            <option value="Health Psychologist">
                                Health Psychologist
                            </option>

                        </select>

                        <span asp-validation-for="Specialization"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Qualification -->

                    <div class="col-md-6 mb-3">

                        <label asp-for="Qualification"
                               class="form-label fw-semibold">

                            Qualification

                        </label>

                        <input asp-for="Qualification"
                               class="form-control rounded-3"
                               placeholder="e.g. MSc in Clinical Psychology" />

                        <span asp-validation-for="Qualification"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Experience -->

                    <div class="col-md-6 mb-3">

                        <label asp-for="Experience"
                               class="form-label fw-semibold">

                            Experience (Years)

                        </label>

                        <input asp-for="Experience"
                               type="number"
                               min="0"
                               max="50"
                               class="form-control rounded-3"
                               placeholder="Enter years of experience" />

                        <span asp-validation-for="Experience"
                              class="text-danger">
                        </span>

                    </div>

                </div>


                <!-- ================= Buttons ================= -->

                <div class="d-flex justify-content-end gap-2 mt-4">

                    <a asp-controller="Admin"
                       asp-action="PsychologistDetails"
                       asp-route-id="@Model.PsychologistId"
                       class="btn rounded-3 px-4"
                       style="background:#E8DDD2;
                        color:#5F5146;">

                        Cancel

                    </a>

                    <button type="submit"
                            class="btn rounded-3 px-4"
                            style="background:#B89B7A;
                        color:white;">

                        <i class="bi bi-check-circle me-1"></i>

                        Save Changes

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
