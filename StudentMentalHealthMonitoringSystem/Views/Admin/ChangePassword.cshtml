@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Change Admin Password";
}

<div class="container-fluid" style="max-width: 600px;">

    <!-- ================= Header ================= -->
    <div class="card border-0 shadow-sm rounded-4 mb-4" style="background:#F4EEE8;">
        <div class="card-body p-4 text-center">
            <div class="badge p-3 rounded-circle mb-2" style="background:#E8DDD2; color:#5F5146;">
                <i class="bi bi-shield-lock-fill fs-2"></i>
            </div>
            <h3 class="fw-bold mb-1" style="color:#5F5146;">Change Password</h3>
            <p class="text-muted mb-0">Update your System Administrator account password.</p>
        </div>
    </div>

    <!-- ================= Form Card ================= -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-5">
        <div class="card-body p-4 p-md-5">

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger border-0 rounded-3 mb-4 fs-6">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> @ViewBag.Error
                </div>
            }

            <form asp-controller="Admin" asp-action="ChangePassword" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3.5">
                    <label class="form-label fw-bold" style="color:#5F5146;">Current Password</label>
                    <input type="password" name="currentPassword" class="form-control rounded-3 py-2.5" placeholder="••••••••" required />
                </div>

                <div class="mb-3.5">
                    <label class="form-label fw-bold" style="color:#5F5146;">New Password</label>
                    <input type="password" name="newPassword" class="form-control rounded-3 py-2.5" placeholder="••••••••" minlength="6" required />
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold" style="color:#5F5146;">Confirm New Password</label>
                    <input type="password" name="confirmPassword" class="form-control rounded-3 py-2.5" placeholder="••••••••" minlength="6" required />
                </div>

                <div class="d-flex justify-content-between align-items-center pt-2">
                    <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-outline-secondary rounded-3 px-4">Cancel</a>
                    <button type="submit" class="btn text-white rounded-3 px-4 py-2.5 fw-bold" style="background:#B89B7A;">
                        <i class="bi bi-key-fill me-1.5"></i> Update Password
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>
