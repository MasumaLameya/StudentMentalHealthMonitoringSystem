@{
    ViewData["Title"] = "Reports";
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header bg-dark text-white">

            <h3>System Reports</h3>

        </div>

        <div class="card-body">

            <div class="d-grid gap-3">

                <button class="btn btn-primary">Student Report</button>

                <button class="btn btn-success">Department Report</button>

                <button class="btn btn-warning">Psychologist Report</button>

                <button class="btn btn-danger">Mental Health Report</button>

                <button class="btn btn-dark">Graduation Report</button>

            </div>

        </div>

    </div>

</div>
