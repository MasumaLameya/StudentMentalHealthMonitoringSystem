@model StudentMentalHealthMonitoringSystem.Models.Psychologist

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Delete Psychologist";
}

<div class="container-fluid">

    <!-- ================= Header ================= -->

    <div class="card border-0 shadow-sm rounded-4 mb-4"
         style="background:#F4EEE8;">

        <div class="card-body p-4">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <h2 class="fw-bold mb-1"
                        style="color:#5F5146;">

                        Delete Psychologist

                    </h2>

                    <p class="text-muted mb-0">

                        Review the information before removing this psychologist.

                    </p>

                </div>

                <a asp-controller="Admin"
                   asp-action="Psychologists"
                   class="btn rounded-3 px-4"
                   style="background:#8A7563;color:white;">

                    <i class="bi bi-arrow-left me-1"></i>

                    Back

                </a>

            </div>

        </div>

    </div>


    <!-- ================= Confirmation Card ================= -->

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-body p-4">

                    <div class="text-center mb-4">

                        @if (!string.IsNullOrEmpty(Model.ProfileImage))
                        {
                            <img src="@Model.ProfileImage"
                                 width="140"
                                 height="140"
                                 class="rounded-circle border shadow-sm"
                                 style="object-fit:cover;">
                        }
                        else
                        {
                            <img src="https://ui-avatars.com/api/?name=@Uri.EscapeDataString(Model.FullName)&background=B89B7A&color=fff&size=140"
                                 width="140"
                                 height="140"
                                 class="rounded-circle shadow-sm">
                        }

                        <h3 class="mt-3"
                            style="color:#5F5146;">

                            @Model.FullName

                        </h3>

                        <span class="badge rounded-pill px-3 py-2"
                              style="background:#EEE4DA;
                            color:#705F50;">

                            @Model.Specialization

                        </span>

                    </div>


                    <!-- ================= Warning ================= -->

                    <div class="alert rounded-3"
                         style="background:#F7E6E2;
                        border:1px solid #E7C4BD;
                        color:#70433C;">

                        <div class="d-flex">

                            <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>

                            <div>

                                <strong>
                                    Are you sure you want to delete this psychologist?
                                </strong>

                                <p class="mb-0 mt-1">

                                    This action will remove the psychologist
                                    from the system.

                                </p>

                            </div>

                        </div>

                    </div>


                    <!-- ================= Information ================= -->

                    <div class="table-responsive mt-4">

                        <table class="table table-bordered align-middle">

                            <tr>

                                <th style="width:35%;background:#F4EEE8;">
                                    Full Name
                                </th>

                                <td>
                                    @Model.FullName
                                </td>

                            </tr>

                            <tr>

                                <th style="background:#F4EEE8;">
                                    Email
                                </th>

                                <td>
                                    @Model.Email
                                </td>

                            </tr>

                            <tr>

                                <th style="background:#F4EEE8;">
                                    Phone
                                </th>

                                <td>
                                    @Model.Phone
                                </td>

                            </tr>

                            <tr>

                                <th style="background:#F4EEE8;">
                                    Specialization
                                </th>

                                <td>
                                    @Model.Specialization
                                </td>

                            </tr>

                            <tr>

                                <th style="background:#F4EEE8;">
                                    Qualification
                                </th>

                                <td>
                                    @Model.Qualification
                                </td>

                            </tr>

                            <tr>

                                <th style="background:#F4EEE8;">
                                    Experience
                                </th>

                                <td>
                                    @Model.Experience years
                                </td>

                            </tr>

                        </table>

                    </div>


                    <!-- ================= Delete Form ================= -->

                    <form asp-controller="Admin"
                          asp-action="DeletePsychologist"
                          method="post"
                          class="mt-4">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               asp-for="PsychologistId" />

                        <div class="d-flex justify-content-end gap-2">

                            <a asp-controller="Admin"
                               asp-action="Psychologists"
                               class="btn rounded-3 px-4"
                               style="background:#E8DDD2;
                                color:#5F5146;">

                                Cancel

                            </a>

                            <button type="submit"
                                    class="btn rounded-3 px-4"
                                    style="background:#B96A5B;
                                color:white;">

                                <i class="bi bi-trash me-1"></i>

                                Delete Psychologist

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>