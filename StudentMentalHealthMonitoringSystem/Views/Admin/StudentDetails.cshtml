@model StudentMentalHealthMonitoringSystem.ViewModels.PsychologistStudentViewModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Student Details";
}

<div class="container-fluid" id="adminStudentDetailsContent">

    @if (TempData["Success"] != null || TempData["SuccessMessage"] != null)
    {
        <div class="alert border-0 rounded-3 mb-4 d-flex align-items-center gap-2 p-3" style="background:#E6F4EA; border-left:4px solid #2E7D32; border-left-style:solid;">
            <i class="bi bi-check-circle-fill" style="color:#2E7D32; font-size:18px;"></i>
            <span style="color:#1B5E20; font-weight:600;">@(TempData["Success"] ?? TempData["SuccessMessage"])</span>
        </div>
    }
    @if (TempData["Error"] != null || TempData["ErrorMessage"] != null)
    {
        <div class="alert border-0 rounded-3 mb-4 d-flex align-items-center gap-2 p-3" style="background:#FDE8E8; border-left:4px solid #C62828; border-left-style:solid;">
            <i class="bi bi-exclamation-triangle-fill" style="color:#C62828; font-size:18px;"></i>
            <span style="color:#B71C1C; font-weight:600;">@(TempData["Error"] ?? TempData["ErrorMessage"])</span>
        </div>
    }

    <!-- ================= Header ================= -->

    <div class="card border-0 shadow-sm rounded-4 mb-4"
         style="background:#F4EEE8;">

        <div class="card-body p-4">

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

                <div>

                    <h2 class="fw-bold mb-1"
                        style="color:#5F5146;">

                        👨‍🎓 Student Clinical & Assessment Profile

                    </h2>

                    <p class="text-muted mb-0">
                        Complete student health metrics, assessment history & screening records.
                    </p>

                </div>

                <div class="d-flex gap-2 flex-wrap">
                    <button type="button" class="btn text-white rounded-3 px-3 shadow-sm fw-bold" style="background:#A67C52;" data-bs-toggle="modal" data-bs-target="#changeStudentPasswordModal">
                        <i class="bi bi-key-fill me-1"></i> Change Password
                    </button>
                    <a asp-controller="Admin"
                       asp-action="Students"
                       class="btn rounded-3 px-3"
                       style="background:#8A7563;
                        color:white;">
                        <i class="bi bi-arrow-left me-1"></i> Back to Students
                    </a>
                </div>

            </div>

        </div>

    </div>


    <!-- ================= Student Profile ================= -->

    <div class="row">

        <!-- Profile -->

        <div class="col-lg-4 mb-4">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-body text-center p-4">

                    @if (!string.IsNullOrEmpty(Model.Student?.ProfileImage))
                    {
                        <img src="@Model.Student.ProfileImage"
                             width="160"
                             height="160"
                             class="rounded-circle border shadow-sm mb-3"
                             style="object-fit:cover;">
                    }
                    else
                    {
                        <img src="https://ui-avatars.com/api/?name=@Uri.EscapeDataString(Model.Student?.FullName ?? "Student")&background=A67C52&color=fff&size=160"
                             width="160"
                             height="160"
                             class="rounded-circle shadow-sm mb-3">
                    }

                    <h3 style="color:#5F5146;">

                        @Model.Student?.FullName

                    </h3>

                    <p class="text-muted mb-2">

                        @Model.Student?.StudentIdNumber

                    </p>

                    <span class="badge rounded-pill px-3 py-2"
                          style="background:#EEE4DA;
                        color:#705F50;">

                        @Model.Student?.Department

                    </span>

                </div>

            </div>

        </div>


        <!-- Basic Information -->

        <div class="col-lg-8 mb-4">

            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-header border-0 py-3"
                     style="background:#E8DDD2;">

                    <h4 class="mb-0"
                        style="color:#5F5146;">

                        Personal Information

                    </h4>

                </div>

                <div class="card-body p-4">

                    <div class="row">

                        <div class="col-md-6 mb-4">

                            <small class="text-muted">
                                Student ID
                            </small>

                            <div class="fw-semibold"
                                 style="color:#5F5146;">

                                @Model.Student?.StudentIdNumber

                            </div>

                        </div>


                        <div class="col-md-6 mb-4">

                            <small class="text-muted">
                                Full Name
                            </small>

                            <div class="fw-semibold"
                                 style="color:#5F5146;">

                                @Model.Student?.FullName

                            </div>

                        </div>


                        <div class="col-md-6 mb-4">

                            <small class="text-muted">
                                Email
                            </small>

                            <div class="fw-semibold"
                                 style="color:#5F5146;">

                                @Model.Student?.Email

                            </div>

                        </div>


                        <div class="col-md-6 mb-4">

                            <small class="text-muted">
                                Phone
                            </small>

                            <div class="fw-semibold"
                                 style="color:#5F5146;">

                                @Model.Student?.Phone

                            </div>

                        </div>


                        <div class="col-md-6 mb-4">

                            <small class="text-muted">
                                Department
                            </small>

                            <div class="fw-semibold"
                                 style="color:#5F5146;">

                                @Model.Student?.Department

                            </div>

                        </div>


                        <div class="col-md-6 mb-4">

                            <small class="text-muted">
                                Semester
                            </small>

                            <div class="fw-semibold"
                                 style="color:#5F5146;">

                                @Model.Student?.Semester

                            </div>

                        </div>


                        <div class="col-md-6 mb-4">

                            <small class="text-muted">
                                Gender
                            </small>

                            <div class="fw-semibold"
                                 style="color:#5F5146;">

                                @Model.Student?.Gender

                            </div>

                        </div>


                        <div class="col-md-6 mb-4">

                            <small class="text-muted">
                                Date of Birth
                            </small>

                            <div class="fw-semibold"
                                 style="color:#5F5146;">

                                @Model.Student?.DateOfBirth

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ================= Physical & Financial Information ================= -->

    <div class="card border-0 shadow-sm rounded-4 mb-4">

        <div class="card-header border-0 py-3"
             style="background:#E8DDD2;">

            <h4 class="mb-0"
                style="color:#5F5146;">

                Additional Information

            </h4>

        </div>

        <div class="card-body p-4">

            <div class="row">

                <div class="col-md-3 mb-3">

                    <small class="text-muted">
                        Height
                    </small>

                    <div class="fw-semibold">

                        @Model.Student?.Height

                    </div>

                </div>


                <div class="col-md-3 mb-3">

                    <small class="text-muted">
                        Weight
                    </small>

                    <div class="fw-semibold">

                        @Model.Student?.Weight

                    </div>

                </div>


                <div class="col-md-3 mb-3">

                    <small class="text-muted">
                        Financial Condition
                    </small>

                    <div class="fw-semibold">

                        @Model.Student?.FinancialCondition

                    </div>

                </div>


                <div class="col-md-3 mb-3">

                    <small class="text-muted">
                        Guardian
                    </small>

                    <div class="fw-semibold">

                        @Model.Student?.GuardianName

                    </div>

                </div>


                <div class="col-md-6">

                    <small class="text-muted">
                        Guardian Phone
                    </small>

                    <div class="fw-semibold">

                        @Model.Student?.GuardianPhone

                    </div>

                </div>


                <div class="col-md-6">

                    <small class="text-muted">
                        Guardian Email
                    </small>

                    <div class="fw-semibold">

                        @Model.Student?.GuardianEmail

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ================= Assessment Summary ================= -->

    <div class="row">

        <!-- PHQ -->

        <div class="col-md-6 mb-4">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-header border-0 py-3"
                     style="background:#E8DDD2;">

                    <h5 class="mb-0"
                        style="color:#5F5146;">

                        PHQ Assessment

                    </h5>

                </div>

                <div class="card-body p-4">

                    @if (Model.PHQAssessment != null)
                    {
                        <p class="mb-2">

                            <strong>Score:</strong>

                            @Model.PHQAssessment.TotalScore

                        </p>

                        <p class="mb-0">

                            <strong>Date:</strong>

                            @Model.PHQAssessment.AssessmentDate.ToString("dd MMM yyyy")

                        </p>
                    }
                    else
                    {
                        <p class="text-muted mb-0">

                            No PHQ assessment available.

                        </p>
                    }

                </div>

            </div>

        </div>


        <!-- C-SSRS -->

        <div class="col-md-6 mb-4">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-header border-0 py-3"
                     style="background:#E8DDD2;">

                    <h5 class="mb-0"
                        style="color:#5F5146;">

                        C-SSRS Assessment

                    </h5>

                </div>

                <div class="card-body p-4">

                    @if (Model.CSSRSAssessment != null)
                    {
                        <p class="mb-2">

                            <strong>Risk Level:</strong>

                            <span class="badge rounded-pill px-3 py-2"
                                  style="background:#E7C4BD;
                                color:#7A4038;">

                                @Model.CSSRSAssessment.RiskLevel

                            </span>

                        </p>

                        <p class="mb-0">

                            <strong>Date:</strong>

                            @Model.CSSRSAssessment.AssessmentDate.ToString("dd MMM yyyy")

                        </p>
                    }
                    else
                    {
                        <p class="text-muted mb-0">

                            No C-SSRS assessment available.

                        </p>
                    }

                </div>

            </div>

        </div>

    </div>


    <!-- ================= Action Buttons ================= -->

    <div class="card border-0 shadow-sm rounded-4 mb-4">

        <div class="card-body text-end d-flex justify-content-end gap-2">

            <button type="button" class="btn text-white rounded-3 px-4 fw-bold" style="background:#A67C52;" data-bs-toggle="modal" data-bs-target="#changeStudentPasswordModal">
                <i class="bi bi-key-fill me-1"></i> Change Password
            </button>

            <a asp-controller="Admin"
               asp-action="EditStudent"
               asp-route-id="@Model.Student?.StudentId"
               class="btn rounded-3 px-4"
               style="background:#E5D3B3;
                color:#665438;">

                <i class="bi bi-pencil me-1"></i>

                Edit Student

            </a>

        </div>

    </div>

</div>

<!-- ================= Change Student Password Modal ================= -->
<div class="modal fade" id="changeStudentPasswordModal" tabindex="-1" aria-labelledby="changeStudentPasswordModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4 overflow-hidden">
            <div class="modal-header border-0 text-white p-4" style="background: linear-gradient(135deg, #8A7563, #5F5146);">
                <div>
                    <h5 class="modal-title fw-bold mb-1" id="changeStudentPasswordModalLabel">
                        <i class="bi bi-key-fill me-2"></i>Change Student Password
                    </h5>
                    <small class="text-white-50">Direct password reset by Administrator</small>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Admin" asp-action="ChangeStudentPassword" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="studentId" value="@(Model.Student?.StudentId ?? 0)" />
                <input type="hidden" name="returnUrl" value="/Admin/StudentDetails/@(Model.Student?.StudentId ?? 0)" />

                <div class="modal-body p-4">
                    <div class="p-3 rounded-3 mb-3" style="background:#FAF6F2; border:1px solid #E8DDD2;">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <small class="text-muted d-block">Student Name</small>
                                <strong class="text-dark">@(Model.Student?.FullName ?? "N/A")</strong>
                            </div>
                            <div class="text-end">
                                <small class="text-muted d-block">Student ID</small>
                                <span class="badge px-2.5 py-1 rounded-pill" style="background:#EEE4DA; color:#705F50;">@(Model.Student?.StudentIdNumber ?? "N/A")</span>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="detailNewPassword" class="form-label fw-semibold text-secondary small">New Password *</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-lock-fill text-muted"></i></span>
                            <input type="password" name="newPassword" id="detailNewPassword" class="form-control border-start-0" placeholder="Minimum 8 characters" required />
                        </div>
                        <small class="text-muted" style="font-size: 0.75rem;">Must contain at least 1 uppercase, 1 lowercase, 1 number & 1 special character.</small>
                    </div>

                    <div class="mb-3">
                        <label for="detailConfirmPassword" class="form-label fw-semibold text-secondary small">Confirm New Password *</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-shield-check text-muted"></i></span>
                            <input type="password" name="confirmPassword" id="detailConfirmPassword" class="form-control border-start-0" placeholder="Re-enter new password" required />
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 p-4 pt-0">
                    <button type="button" class="btn rounded-3 px-4" style="background:#E8DDD2; color:#5F5146;" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn text-white rounded-3 px-4 fw-bold" style="background:#A67C52;">
                        <i class="bi bi-check2-circle me-1"></i> Update Password
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>