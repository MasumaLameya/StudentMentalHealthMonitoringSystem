@model StudentMentalHealthMonitoringSystem.ViewModels.PsychologistStudentViewModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Student Details";
}

<div class="container-fluid" id="adminStudentDetailsContent">

    <!-- ================= Header ================= -->

    <div class="card border-0 shadow-sm rounded-4 mb-4"
         style="background:#F4EEE8;">

        <div class="card-body p-4">

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

                <div>

                    <h2 class="fw-bold mb-1"
                        style="color:#5F5146;">

                        👨‍🎓 Student Clinical & Assessment Profile

                    </h2>

                    <p class="text-muted mb-0">
                        Complete student health metrics, assessment history & screening records.
                    </p>

                </div>

                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-danger rounded-3 px-4 shadow-sm fw-bold" onclick="downloadReportPdf('#adminStudentDetailsContent', { title: 'Student_Report_@(Model.Student?.StudentIdNumber ?? "Profile")', filename: 'Student_Report_@(Model.Student?.StudentIdNumber ?? "Profile")' })">
                        <i class="bi bi-file-earmark-pdf-fill me-1"></i> Download PDF
                    </button>
                    <a asp-controller="Admin"
                       asp-action="Students"
                       class="btn rounded-3 px-4"
                       style="background:#8A7563;
                        color:white;">
                        <i class="bi bi-arrow-left me-1"></i> Back to Students
                    </a>
                </div>

            </div>

        </div>

    </div>


    <!-- ================= Student Profile ================= -->

    <div class="row">

        <!-- Profile -->

        <div class="col-lg-4 mb-4">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-body text-center p-4">

                    @if (!string.IsNullOrEmpty(Model.Student?.ProfileImage))
                    {
                        <img src="@Model.Student.ProfileImage"
                             width="160"
                             height="160"
                             class="rounded-circle border shadow-sm mb-3"
                             style="object-fit:cover;">
                    }
                    else
                    {
                        <img src="https://ui-avatars.com/api/?name=@Uri.EscapeDataString(Model.Student?.FullName ?? "Student")&background=A67C52&color=fff&size=160"
                             width="160"
                             height="160"
                             class="rounded-circle shadow-sm mb-3">
                    }

                    <h3 style="color:#5F5146;">

                        @Model.Student?.FullName

                    </h3>

                    <p class="text-muted mb-2">

                        @Model.Student?.StudentIdNumber

                    </p>

                    <span class="badge rounded-pill px-3 py-2"
                          style="background:#EEE4DA;
                        color:#705F50;">

                        @Model.Student?.Department

                    </span>

                </div>

            </div>

        </div>


        <!-- Basic Information -->

        <div class="col-lg-8 mb-4">

            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-header border-0 py-3"
                     style="background:#E8DDD2;">

                    <h4 class="mb-0"
                        style="color:#5F5146;">

                        Personal Information

                    </h4>

                </div>

                <div class="card-body p-4">

                    <div class="row">

                        <div class="col-md-6 mb-4">

                            <small class="text-muted">
                                Student ID
                            </small>

                            <div class="fw-semibold"
                                 style="color:#5F5146;">

                                @Model.Student?.StudentIdNumber

                            </div>

                        </div>


                        <div class="col-md-6 mb-4">

                            <small class="text-muted">
                                Full Name
                            </small>

                            <div class="fw-semibold"
                                 style="color:#5F5146;">

                                @Model.Student?.FullName

                            </div>

                        </div>


                        <div class="col-md-6 mb-4">

                            <small class="text-muted">
                                Email
                            </small>

                            <div class="fw-semibold"
                                 style="color:#5F5146;">

                                @Model.Student?.Email

                            </div>

                        </div>


                        <div class="col-md-6 mb-4">

                            <small class="text-muted">
                                Phone
                            </small>

                            <div class="fw-semibold"
                                 style="color:#5F5146;">

                                @Model.Student?.Phone

                            </div>

                        </div>


                        <div class="col-md-6 mb-4">

                            <small class="text-muted">
                                Department
                            </small>

                            <div class="fw-semibold"
                                 style="color:#5F5146;">

                                @Model.Student?.Department

                            </div>

                        </div>


                        <div class="col-md-6 mb-4">

                            <small class="text-muted">
                                Semester
                            </small>

                            <div class="fw-semibold"
                                 style="color:#5F5146;">

                                @Model.Student?.Semester

                            </div>

                        </div>


                        <div class="col-md-6 mb-4">

                            <small class="text-muted">
                                Gender
                            </small>

                            <div class="fw-semibold"
                                 style="color:#5F5146;">

                                @Model.Student?.Gender

                            </div>

                        </div>


                        <div class="col-md-6 mb-4">

                            <small class="text-muted">
                                Date of Birth
                            </small>

                            <div class="fw-semibold"
                                 style="color:#5F5146;">

                                @Model.Student?.DateOfBirth

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ================= Physical & Financial Information ================= -->

    <div class="card border-0 shadow-sm rounded-4 mb-4">

        <div class="card-header border-0 py-3"
             style="background:#E8DDD2;">

            <h4 class="mb-0"
                style="color:#5F5146;">

                Additional Information

            </h4>

        </div>

        <div class="card-body p-4">

            <div class="row">

                <div class="col-md-3 mb-3">

                    <small class="text-muted">
                        Height
                    </small>

                    <div class="fw-semibold">

                        @Model.Student?.Height

                    </div>

                </div>


                <div class="col-md-3 mb-3">

                    <small class="text-muted">
                        Weight
                    </small>

                    <div class="fw-semibold">

                        @Model.Student?.Weight

                    </div>

                </div>


                <div class="col-md-3 mb-3">

                    <small class="text-muted">
                        Financial Condition
                    </small>

                    <div class="fw-semibold">

                        @Model.Student?.FinancialCondition

                    </div>

                </div>


                <div class="col-md-3 mb-3">

                    <small class="text-muted">
                        Guardian
                    </small>

                    <div class="fw-semibold">

                        @Model.Student?.GuardianName

                    </div>

                </div>


                <div class="col-md-6">

                    <small class="text-muted">
                        Guardian Phone
                    </small>

                    <div class="fw-semibold">

                        @Model.Student?.GuardianPhone

                    </div>

                </div>


                <div class="col-md-6">

                    <small class="text-muted">
                        Guardian Email
                    </small>

                    <div class="fw-semibold">

                        @Model.Student?.GuardianEmail

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ================= Assessment Summary ================= -->

    <div class="row">

        <!-- PHQ -->

        <div class="col-md-6 mb-4">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-header border-0 py-3"
                     style="background:#E8DDD2;">

                    <h5 class="mb-0"
                        style="color:#5F5146;">

                        PHQ Assessment

                    </h5>

                </div>

                <div class="card-body p-4">

                    @if (Model.PHQAssessment != null)
                    {
                        <p class="mb-2">

                            <strong>Score:</strong>

                            @Model.PHQAssessment.TotalScore

                        </p>

                        <p class="mb-0">

                            <strong>Date:</strong>

                            @Model.PHQAssessment.AssessmentDate.ToString("dd MMM yyyy")

                        </p>
                    }
                    else
                    {
                        <p class="text-muted mb-0">

                            No PHQ assessment available.

                        </p>
                    }

                </div>

            </div>

        </div>


        <!-- C-SSRS -->

        <div class="col-md-6 mb-4">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-header border-0 py-3"
                     style="background:#E8DDD2;">

                    <h5 class="mb-0"
                        style="color:#5F5146;">

                        C-SSRS Assessment

                    </h5>

                </div>

                <div class="card-body p-4">

                    @if (Model.CSSRSAssessment != null)
                    {
                        <p class="mb-2">

                            <strong>Risk Level:</strong>

                            <span class="badge rounded-pill px-3 py-2"
                                  style="background:#E7C4BD;
                                color:#7A4038;">

                                @Model.CSSRSAssessment.RiskLevel

                            </span>

                        </p>

                        <p class="mb-0">

                            <strong>Date:</strong>

                            @Model.CSSRSAssessment.AssessmentDate.ToString("dd MMM yyyy")

                        </p>
                    }
                    else
                    {
                        <p class="text-muted mb-0">

                            No C-SSRS assessment available.

                        </p>
                    }

                </div>

            </div>

        </div>

    </div>


    <!-- ================= Action Buttons ================= -->

    <div class="card border-0 shadow-sm rounded-4 mb-4">

        <div class="card-body text-end">

            <a asp-controller="Admin"
               asp-action="EditStudent"
               asp-route-id="@Model.Student?.StudentId"
               class="btn rounded-3 px-4 me-2"
               style="background:#E5D3B3;
                color:#665438;">

                <i class="bi bi-pencil me-1"></i>

                Edit Student

            </a>


            <a asp-controller="Admin"
               asp-action="DeleteStudent"
               asp-route-id="@Model.Student?.StudentId"
               class="btn rounded-3 px-4"
               style="background:#E7C4BD;
                color:#7A4038;">

                <i class="bi bi-trash me-1"></i>

                Delete Student

            </a>

        </div>

    </div>

</div>