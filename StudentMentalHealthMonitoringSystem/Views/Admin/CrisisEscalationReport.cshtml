@model StudentMentalHealthMonitoringSystem.ViewModels.AdminCrisisReportViewModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Crisis Escalation & Safety Audit Report";
}

<style>
    .glass-card-admin {
        background: #ffffff;
        border: 1px solid #E5D8CC;
        border-radius: 1.25rem;
        box-shadow: 0 8px 24px rgba(94, 80, 63, 0.06);
    }
    .metric-card-admin {
        background: #FAF6F0;
        border: 1px solid #EDE2D8;
        border-radius: 1rem;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .metric-card-admin:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(166, 124, 82, 0.12);
    }
    .table-admin thead th {
        background-color: #F4EEE8;
        color: #5E503F;
        font-weight: 700;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border-bottom: 2px solid #E5D8CC;
        padding: 0.9rem 0.75rem;
    }
    .table-admin tbody td {
        padding: 1rem 0.75rem;
        vertical-align: middle;
        border-bottom: 1px solid #F0E8DF;
    }
    .table-admin tbody tr:hover {
        background-color: #FCFAF8;
    }
</style>

<div class="container-fluid py-2" id="adminCrisisReportContent">

    <!-- ================= Top Header Banner ================= -->
    <div class="card border-0 shadow-sm rounded-4 mb-4" style="background: linear-gradient(135deg, #991B1B 0%, #DC2626 100%);">
        <div class="card-body p-4 text-white">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div>
                    <div class="badge bg-white text-danger rounded-pill px-3 py-1.5 mb-2 fw-semibold shadow-sm">
                        <i class="bi bi-shield-fill-exclamation me-1"></i> Critical Care &amp; Clinical Safety Audit
                    </div>
                    <h2 class="fw-bold mb-1 text-white">
                        <i class="bi bi-exclamation-octagon-fill me-2"></i> Multi-Source Crisis Escalation Report
                    </h2>
                    <p class="text-white-50 mb-0 fs-6">
                        Unified tracking of all severe psychological triggers across C-SSRS, PHQ-9, AI Chat, and Voice Bot for institutional crisis prevention.
                    </p>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <a asp-controller="Admin" asp-action="Reports" class="btn btn-light text-danger rounded-pill px-4 py-2 fw-semibold shadow-sm">
                        <i class="bi bi-arrow-left me-1"></i> Back to Hub
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- ================= KPI Summary Metric Cards ================= -->
    <div class="row g-3 mb-4">
        <div class="col-md-3 col-sm-6">
            <div class="metric-card-admin p-3 text-center h-100 border-danger-subtle" style="background:#FFF5F5;">
                <small class="text-danger text-uppercase fw-bold d-block mb-1" style="font-size: 0.72rem;">Total Crisis Triggers</small>
                <h3 class="fw-bold mb-0 text-danger">@Model.TotalCrisisEvents</h3>
                <small class="text-muted">Multi-Source High Risk Cases</small>
            </div>
        </div>

        <div class="col-md-3 col-sm-6">
            <div class="metric-card-admin p-3 text-center h-100 border-danger" style="background:#FEF2F2;">
                <small class="text-danger text-uppercase fw-bold d-block mb-1" style="font-size: 0.72rem;">Extremely Severe Cases</small>
                <h3 class="fw-bold mb-0 text-danger">@Model.ExtremelySevereCount</h3>
                <small class="text-danger-emphasis">Highest Clinical Priority</small>
            </div>
        </div>

        <div class="col-md-3 col-sm-6">
            <div class="metric-card-admin p-3 text-center h-100 border-warning-subtle" style="background:#FFFBEB;">
                <small class="text-warning-emphasis text-uppercase fw-bold d-block mb-1" style="font-size: 0.72rem;">Overdue Interventions (&gt;48h)</small>
                <h3 class="fw-bold mb-0 text-warning-emphasis">@Model.OverdueInterventionsCount</h3>
                <small class="text-muted">Unattended / Unconfirmed</small>
            </div>
        </div>

        <div class="col-md-3 col-sm-6">
            <div class="metric-card-admin p-3 text-center h-100 border-success-subtle" style="background:#F0FDF4;">
                <small class="text-success text-uppercase fw-bold d-block mb-1" style="font-size: 0.72rem;">Resolved &amp; Completed</small>
                <h3 class="fw-bold mb-0 text-success">@Model.ResolvedInterventionsCount</h3>
                <small class="text-muted">Counseling Sessions Held</small>
            </div>
        </div>
    </div>

    <!-- ================= Filter Toolbar ================= -->
    <div class="glass-card-admin mb-4">
        <div class="card-body p-3">
            <form method="get" asp-controller="Admin" asp-action="CrisisEscalationReport" class="row g-2 align-items-center">
                <div class="col-md-3 col-sm-6">
                    <label class="small text-muted fw-bold mb-1">Trigger Source</label>
                    <select name="sourceFilter" class="form-select form-select-sm" onchange="this.form.submit()">
                        <option value="All" selected="@(Model.SelectedSource == "All")">All Sources (C-SSRS, PHQ-9, AI)</option>
                        <option value="C-SSRS" selected="@(Model.SelectedSource == "C-SSRS")">C-SSRS Suicide Risk</option>
                        <option value="PHQ-9" selected="@(Model.SelectedSource == "PHQ-9")">PHQ-9 Depression (Q9 Self-harm)</option>
                        <option value="AI Chat" selected="@(Model.SelectedSource == "AI Chat")">AI Chatbot Companion</option>
                        <option value="Voice Bot" selected="@(Model.SelectedSource == "Voice Bot")">AI Live Voice Bot</option>
                    </select>
                </div>

                <div class="col-md-3 col-sm-6">
                    <label class="small text-muted fw-bold mb-1">Department</label>
                    <select name="department" class="form-select form-select-sm" onchange="this.form.submit()">
                        <option value="All" selected="@(Model.SelectedDepartment == "All")">All Departments</option>
                        @foreach (var dept in Model.AvailableDepartments)
                        {
                            <option value="@dept" selected="@(Model.SelectedDepartment == dept)">@dept</option>
                        }
                    </select>
                </div>

                <div class="col-md-3 col-sm-6">
                    <label class="small text-muted fw-bold mb-1">Intervention Status</label>
                    <select name="statusFilter" class="form-select form-select-sm" onchange="this.form.submit()">
                        <option value="All" selected="@(Model.SelectedStatus == "All")">All Care Statuses</option>
                        <option value="Overdue" selected="@(Model.SelectedStatus == "Overdue")">Overdue (&gt; 48 hours)</option>
                        <option value="Pending" selected="@(Model.SelectedStatus == "Pending")">Confirmed / Pending Session</option>
                        <option value="Completed" selected="@(Model.SelectedStatus == "Completed")">Completed Session</option>
                    </select>
                </div>

                <div class="col-md-3 col-sm-6 d-flex align-items-end gap-2">
                    <button type="submit" class="btn btn-sm btn-danger rounded-pill px-3 w-100 fw-semibold">
                        <i class="bi bi-funnel me-1"></i> Filter
                    </button>
                    <a asp-controller="Admin" asp-action="CrisisEscalationReport" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                        Reset
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- ================= Crisis Records Table ================= -->
    <div class="glass-card-admin">
        <div class="card-header border-0 py-3 d-flex justify-content-between align-items-center" style="background:#F4EEE8;">
            <h5 class="mb-0 fw-bold" style="color:#5E503F;">
                <i class="bi bi-clipboard2-pulse-fill me-2 text-danger"></i> High-Risk Student Escalation Roster (@Model.Items.Count records)
            </h5>
            <span class="badge bg-danger-subtle text-danger border border-danger rounded-pill px-3 py-1">
                Institutional Safety Priority
            </span>
        </div>

        <div class="card-body p-0">
            @if (Model.Items != null && Model.Items.Any())
            {
                <div class="table-responsive">
                    <table class="table table-admin align-middle mb-0">
                        <thead>
                            <tr>
                                <th class="ps-4">Student</th>
                                <th>Trigger Source</th>
                                <th>Severity</th>
                                <th style="width: 28%;">Crisis Detection Details</th>
                                <th>Triggered Date</th>
                                <th>Assigned Psychologist</th>
                                <th>Care Status</th>
                                <th class="text-center pe-4">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center gap-2">
                                            <img src="@(string.IsNullOrEmpty(item.ProfileImage) ? "/images/default-avatar.png" : item.ProfileImage)"
                                                 class="rounded-circle border" style="width: 40px; height: 40px; object-fit: cover;" alt="@item.StudentName" />
                                            <div>
                                                <strong class="d-block text-dark" style="font-size: 0.95rem;">@item.StudentName</strong>
                                                <small class="text-muted">ID: @item.StudentIdNumber • @item.Department</small>
                                            </div>
                                        </div>
                                    </td>

                                    <td>
                                        <span class="badge rounded-pill px-3 py-1.5 fw-bold" style="background:#E8DDD2; color:#5F5146;">
                                            @item.TriggerSource
                                        </span>
                                    </td>

                                    <td>
                                        @if (item.SeverityLevel == "Extremely Severe")
                                        {
                                            <span class="badge bg-danger text-white rounded-pill px-3 py-1.5 shadow-sm">
                                                <i class="bi bi-exclamation-octagon-fill me-1"></i> Extremely Severe
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark rounded-pill px-3 py-1.5 shadow-sm">
                                                <i class="bi bi-exclamation-triangle-fill me-1"></i> Severe
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <p class="mb-0 text-dark small text-truncate-2" style="line-height: 1.4; max-width: 340px;">
                                            @item.TriggerDetails
                                        </p>
                                    </td>

                                    <td>
                                        <div class="fw-semibold text-dark" style="font-size: 0.88rem;">
                                            @item.TriggerDate.ToString("dd MMM yyyy")
                                        </div>
                                        <small class="text-muted">@item.TriggerDate.ToString("h:mm tt")</small>
                                    </td>

                                    <td>
                                        <div class="fw-semibold text-dark" style="font-size: 0.88rem;">
                                            @(string.IsNullOrEmpty(item.AssignedPsychologistName) ? "Unassigned" : item.AssignedPsychologistName)
                                        </div>
                                        @if (item.CounselingDate.HasValue)
                                        {
                                            <small class="text-muted">Appt: @item.CounselingDate.Value.ToString("dd MMM yyyy")</small>
                                        }
                                    </td>

                                    <td>
                                        @if (item.CounselingStatus == "Completed")
                                        {
                                            <span class="badge bg-success text-white rounded-pill px-3 py-1.5">
                                                <i class="bi bi-check-circle-fill me-1"></i> Session Completed
                                            </span>
                                        }
                                        else if (item.IsOverdue)
                                        {
                                            <span class="badge bg-danger text-white rounded-pill px-3 py-1.5 shadow-sm animate-pulse">
                                                <i class="bi bi-alarm-fill me-1"></i> Overdue (&gt;48h)
                                            </span>
                                        }
                                        else if (item.CounselingStatus == "Confirmed" || item.CounselingStatus == "Pending")
                                        {
                                            <span class="badge bg-primary text-white rounded-pill px-3 py-1.5">
                                                <i class="bi bi-calendar-check me-1"></i> @item.CounselingStatus
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary text-white rounded-pill px-3 py-1.5">
                                                @item.CounselingStatus
                                            </span>
                                        }
                                    </td>

                                    <td class="text-center pe-4">
                                        <a asp-controller="Admin" asp-action="StudentDetails" asp-route-id="@item.StudentId"
                                           class="btn btn-sm btn-outline-dark rounded-pill px-3 py-1.5 fw-semibold">
                                            <i class="bi bi-person-bounding-box me-1"></i> Student Case
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <div class="rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3" style="width:70px; height:70px; background:#DCFCE7;">
                        <i class="bi bi-shield-check fs-2 text-success"></i>
                    </div>
                    <h5 class="fw-bold" style="color:#166534;">No Active Crisis Escalation Records</h5>
                    <p class="text-muted mb-0">All high-risk triggers have been resolved or no matching records found.</p>
                </div>
            }
        </div>
    </div>

</div>
