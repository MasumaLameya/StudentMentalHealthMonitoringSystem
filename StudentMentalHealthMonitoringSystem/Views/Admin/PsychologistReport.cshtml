@model IEnumerable<StudentMentalHealthMonitoringSystem.Models.Psychologist>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Psychologist Report";
}

<div class="container-fluid" id="adminPsychologistReportContent">

    <!-- ================= Header ================= -->

    <div class="card border-0 shadow-sm rounded-4 mb-4"
         style="background:#EDE9E5;">

        <div class="card-body p-4">

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

                <div>

                    <h2 class="fw-bold mb-1"
                        style="color:#5C5148;">

                        🧠 Psychologist Report

                    </h2>

                    <p class="text-muted mb-0">

                        Overview of registered psychologists and their professional information.

                    </p>

                </div>

                <div class="d-flex gap-2">
                    <a asp-controller="Admin"
                       asp-action="Reports"
                       class="btn rounded-3 px-4"
                       style="background:#806C5D;
                        color:white;">
                        <i class="bi bi-arrow-left me-1"></i> Back to Reports
                    </a>
                </div>

            </div>

        </div>

    </div>


    <!-- ================= Summary ================= -->

    <div class="row mb-4">

        <div class="col-md-4 mb-3">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <small class="text-muted">
                                Total Psychologists
                            </small>

                            <h2 class="fw-bold mb-0"
                                style="color:#806C5D;">

                                @Model.Count()

                            </h2>

                        </div>

                        <div class="rounded-circle d-flex align-items-center justify-content-center"
                             style="width:55px;
                            height:55px;
                            background:#E2DCD8;">

                            <i class="bi bi-people"
                               style="font-size:24px;
                            color:#76695F;"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <div class="col-md-4 mb-3">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <small class="text-muted">
                                Specializations
                            </small>

                            <h2 class="fw-bold mb-0"
                                style="color:#718471;">

                                @Model
                                .Select(p => p.Specialization)
                                .Where(s => !string.IsNullOrEmpty(s))
                                .Distinct()
                                .Count()

                            </h2>

                        </div>

                        <div class="rounded-circle d-flex align-items-center justify-content-center"
                             style="width:55px;
                            height:55px;
                            background:#DDE5DD;">

                            <i class="bi bi-award"
                               style="font-size:24px;
                            color:#687D68;"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <div class="col-md-4 mb-3">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <small class="text-muted">
                                Report Date
                            </small>

                            <h5 class="fw-bold mb-0 mt-2"
                                style="color:#806C5D;">

                                @DateTime.Now.ToString("dd MMM yyyy")

                            </h5>

                        </div>

                        <div class="rounded-circle d-flex align-items-center justify-content-center"
                             style="width:55px;
                            height:55px;
                            background:#E8DDD2;">

                            <i class="bi bi-calendar3"
                               style="font-size:23px;
                            color:#806C5D;"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ================= Search ================= -->

    <div class="card border-0 shadow-sm rounded-4 mb-4">

        <div class="card-body">

            <label for="psychologistSearch"
                   class="form-label fw-semibold"
                   style="color:#5C5148;">

                Search Psychologist

            </label>

            <div class="input-group">

                <span class="input-group-text"
                      style="background:#EDE9E5;
                    border-color:#D9D1CB;">

                    <i class="bi bi-search"
                       style="color:#806C5D;"></i>

                </span>

                <input type="text"
                       id="psychologistSearch"
                       class="form-control"
                       placeholder="Search by name, email, phone, specialization or qualification..."
                       autocomplete="off"
                       style="border-color:#D9D1CB;" />

                <button type="button"
                        id="clearPsychologistSearch"
                        class="btn"
                        style="background:#E2DCD8;
                    color:#5C5148;
                    display:none;">

                    <i class="bi bi-x-lg"></i>

                </button>

            </div>

        </div>

    </div>


    <!-- ================= Psychologist Table ================= -->

    <div class="card border-0 shadow-sm rounded-4">

        <div class="card-header border-0 py-3"
             style="background:#E2DCD8;">

            <h5 class="mb-0"
                style="color:#5C5148;">

                Psychologist Information

            </h5>

        </div>

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead>

                        <tr>

                            <th class="px-4">
                                #
                            </th>

                            <th>
                                Psychologist
                            </th>

                            <th>
                                Email
                            </th>

                            <th>
                                Phone
                            </th>

                            <th>
                                Specialization
                            </th>

                            <th>
                                Qualification
                            </th>

                            <th>
                                Experience
                            </th>

                            <th>
                                Action
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            var serial = 1;

                            foreach (var psychologist in Model)
                            {
                                <tr class="psychologist-row">

                                    <!-- Serial -->

                                    <td class="px-4">

                                        @serial

                                    </td>


                                    <!-- Profile -->

                                    <td>

                                        <div class="d-flex align-items-center">

                                            @if (!string.IsNullOrEmpty(psychologist.ProfileImage))
                                            {
                                                <img src="@psychologist.ProfileImage"
                                                     width="45"
                                                     height="45"
                                                     class="rounded-circle me-2 border"
                                                     style="object-fit:cover;">
                                            }
                                            else
                                            {
                                                <img src="https://ui-avatars.com/api/?name=@Uri.EscapeDataString(psychologist.FullName)&background=806C5D&color=fff&size=45"
                                                     width="45"
                                                     height="45"
                                                     class="rounded-circle me-2">
                                            }

                                            <div>

                                                <div class="fw-semibold"
                                                     style="color:#5C5148;">

                                                    @psychologist.FullName

                                                </div>

                                                <small class="text-muted">

                                                    ID:
                                                    @psychologist.PsychologistId

                                                </small>

                                            </div>

                                        </div>

                                    </td>


                                    <!-- Email -->

                                    <td>

                                        @psychologist.Email

                                    </td>


                                    <!-- Phone -->

                                    <td>

                                        @psychologist.Phone

                                    </td>


                                    <!-- Specialization -->

                                    <td>

                                        <span class="badge rounded-pill px-3 py-2"
                                              style="background:#DDE5DD;
                                            color:#526052;">

                                            @psychologist.Specialization

                                        </span>

                                    </td>


                                    <!-- Qualification -->

                                    <td>

                                        @psychologist.Qualification

                                    </td>


                                    <!-- Experience -->

                                    <td>

                                        @psychologist.Experience

                                    </td>


                                    <!-- Action -->

                                    <td>

                                        <a asp-controller="Admin"
                                           asp-action="PsychologistDetails"
                                           asp-route-id="@psychologist.PsychologistId"
                                           class="btn btn-sm rounded-3"
                                           style="background:#D8C7B8;
                                            color:#55483D;">

                                            <i class="bi bi-eye me-1"></i>

                                            View

                                        </a>

                                    </td>

                                </tr>

                                serial++;
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="8"
                                    class="text-center py-5">

                                    <i class="bi bi-person-x"
                                       style="font-size:45px;
                                    color:#B8AAA0;"></i>

                                    <h5 class="mt-3"
                                        style="color:#5C5148;">

                                        No Psychologists Found

                                    </h5>

                                    <p class="text-muted mb-0">

                                        No psychologist records are currently available.

                                    </p>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>


    <!-- ================= No Search Result ================= -->

    <div id="noPsychologistResult"
         class="card border-0 shadow-sm rounded-4 mt-4"
         style="display:none;">

        <div class="card-body text-center py-4">

            <i class="bi bi-search"
               style="font-size:35px;
            color:#B8AAA0;"></i>

            <h5 class="mt-2"
                style="color:#5C5148;">

                No Matching Psychologist Found

            </h5>

            <p class="text-muted mb-0">

                Try searching with a different keyword.

            </p>

        </div>

    </div>

</div>


<!-- ================= Search Script ================= -->

<script>

    document.addEventListener("DOMContentLoaded", function() {

        const searchInput =
            document.getElementById("psychologistSearch");

        const clearButton =
            document.getElementById("clearPsychologistSearch");

        const rows =
            document.querySelectorAll(".psychologist-row");

        const noResult =
            document.getElementById("noPsychologistResult");


        function normalizeText(text) {

            return text
                .toLowerCase()
                .trim()
                .replace(/\s+/g, " ");

        }


        function searchPsychologists() {

            const value =
                normalizeText(searchInput.value);

            let visibleRows = 0;


            rows.forEach(function(row) {

                const rowText =
                    normalizeText(row.textContent);

                if (
                    value === "" ||
                    rowText.includes(value)
                ) {

                    row.style.display = "";

                    visibleRows++;

                }
                else {

                    row.style.display = "none";

                }

            });


            if (
                value !== "" &&
                visibleRows === 0
            ) {

                noResult.style.display = "";

            }
            else {

                noResult.style.display = "none";

            }


            clearButton.style.display =
                value !== "" ? "block" : "none";

        }


        searchInput.addEventListener(
            "input",
            searchPsychologists
        );


        clearButton.addEventListener(
            "click",
            function() {

                searchInput.value = "";

                searchPsychologists();

                searchInput.focus();

            }
        );

    });

</script>