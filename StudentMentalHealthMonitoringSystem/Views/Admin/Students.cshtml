@model IEnumerable<StudentMentalHealthMonitoringSystem.Models.Student>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Student Management";
}

<div class="container-fluid">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert border-0 rounded-3 mb-4 d-flex align-items-center gap-2 p-3" style="background:#E6F4EA; border-left:4px solid #2E7D32; border-left-style:solid;">
            <i class="bi bi-check-circle-fill" style="color:#2E7D32; font-size:18px;"></i>
            <span style="color:#1B5E20; font-weight:600;">@TempData["SuccessMessage"]</span>
        </div>
    }

    <!-- ================= Header ================= -->

    <div class="card border-0 shadow-sm rounded-4 mb-4"
         style="background:#F4EEE8;">

        <div class="card-body p-4">

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

                <div>

                    <h2 class="fw-bold mb-1"
                        style="color:#5F5146;">

                        👨‍🎓 Student Management

                    </h2>

                    <p class="text-muted mb-0">

                        Manage registered students and their information.

                    </p>

                </div>

                <div class="text-end">

                    <div class="small text-muted">
                        Total Students
                    </div>

                    <h4 class="fw-bold mb-0"
                        style="color:#8A7563;">

                        <span id="totalStudents">
                            @Model.Count()
                        </span>

                    </h4>

                </div>

            </div>

        </div>

    </div>


    <!-- ================= Search & Filter ================= -->

    <div class="card border-0 shadow-sm rounded-4 mb-4">

        <div class="card-body">

            <form method="get" asp-action="Students" class="row g-3 align-items-center mb-3">
                <div class="col-md-6">
                    <label class="form-label fw-semibold" style="color:#5F5146;"><i class="bi bi-building me-1"></i> Filter by Department</label>
                    <select name="department" class="form-select rounded-3" onchange="this.form.submit()">
                        <option value="All" selected="@(ViewBag.SelectedDepartment == "All" || ViewBag.SelectedDepartment == null)">All Departments</option>
                        @if (ViewBag.AvailableDepartments != null)
                        {
                            foreach (var dept in (List<string>)ViewBag.AvailableDepartments)
                            {
                                <option value="@dept" selected="@(ViewBag.SelectedDepartment == dept)">@dept</option>
                            }
                        }
                    </select>
                </div>
            </form>

            <label for="searchStudent"
                   class="form-label fw-semibold"
                   style="color:#5F5146;">

                Search Student

            </label>

            <div class="input-group">

                <span class="input-group-text"
                      style="background:#F4EEE8;
                    border-color:#DDD0C4;">

                    <i class="bi bi-search"
                       style="color:#8A7563;"></i>

                </span>

                <input type="text"
                       id="searchStudent"
                       class="form-control"
                       placeholder="Search by Student ID, Name, Department, Semester or Email..."
                       autocomplete="off"
                       style="border-color:#DDD0C4;" />

                <button type="button"
                        id="clearSearch"
                        class="btn"
                        style="background:#E8DDD2;
                    color:#5F5146;
                    display:none;">

                    <i class="bi bi-x-lg"></i>

                </button>

            </div>

            <small class="text-muted">

                Search results update automatically.

            </small>

        </div>

    </div>


    <!-- ================= Student Table ================= -->

    <div class="card border-0 shadow-sm rounded-4">

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0"
                       id="studentTable">

                    <thead style="background:#E8DDD2;">

                        <tr>

                            <th class="px-4 py-3">
                                Photo
                            </th>

                            <th class="py-3">
                                Student ID
                            </th>

                            <th class="py-3">
                                Name
                            </th>

                            <th class="py-3">
                                Department
                            </th>

                            <th class="py-3">
                                Semester
                            </th>

                            <th class="py-3">
                                Email
                            </th>

                            <th class="py-3 text-center">
                                Actions
                            </th>

                        </tr>

                    </thead>

                    <tbody id="studentTableBody">

                        @if (Model != null && Model.Any())
                        {
                            foreach (var student in Model)
                            {
                                <tr class="student-row @(student.IsSuspended ? "table-warning" : "")">

                                    <!-- Photo -->

                                    <td class="px-4">

                                        @if (!string.IsNullOrEmpty(student.ProfileImage))
                                        {
                                            <img src="@student.ProfileImage"
                                                 width="55"
                                                 height="55"
                                                 class="rounded-circle border shadow-sm"
                                                 style="object-fit:cover; @(student.IsSuspended ? "opacity:0.6;" : "")">
                                        }
                                        else
                                        {
                                            <img src="https://ui-avatars.com/api/?name=@Uri.EscapeDataString(student.FullName)&background=@(student.IsSuspended ? "999" : "A67C52")&color=fff&size=55"
                                                 width="55"
                                                 height="55"
                                                 class="rounded-circle"
                                                 style="@(student.IsSuspended ? "opacity:0.6;" : "")">
                                        }

                                    </td>


                                    <!-- Student ID -->

                                    <td>

                                        <span class="fw-semibold"
                                              style="color:#5F5146;">

                                            @student.StudentIdNumber

                                        </span>

                                    </td>


                                    <!-- Name -->

                                    <td>

                                        <strong style="color:#5F5146;">
                                            @student.FullName
                                        </strong>
                                        @if (student.IsSuspended)
                                        {
                                            <span class="badge ms-2 px-2 py-1 rounded-pill" style="background:#E65C00; color:#fff; font-size:10px;">Suspended</span>
                                        }

                                    </td>


                                    <!-- Department -->

                                    <td>

                                        <span class="badge rounded-pill px-3 py-2"
                                              style="background:#EEE4DA;
                                            color:#705F50;">

                                            @student.Department

                                        </span>

                                    </td>


                                    <!-- Semester -->

                                    <td>

                                        @student.Semester

                                    </td>


                                    <!-- Email -->

                                    <td>

                                        @student.Email

                                    </td>


                                    <!-- Actions -->

                                    <td>

                                        <div class="d-flex justify-content-center gap-1">

                                            <a asp-controller="Admin"
                                               asp-action="StudentDetails"
                                               asp-route-id="@student.StudentId"
                                               class="btn btn-sm rounded-3"
                                               style="background:#D8C7B8; color:#55483D;"
                                               title="View Student">
                                                <i class="bi bi-eye"></i>
                                            </a>

                                            <a asp-controller="Admin"
                                               asp-action="EditStudent"
                                               asp-route-id="@student.StudentId"
                                               class="btn btn-sm rounded-3"
                                               style="background:#E5D3B3; color:#665438;"
                                               title="Edit Student">
                                                <i class="bi bi-pencil"></i>
                                            </a>

                                            @if (student.IsSuspended)
                                            {
                                                <form asp-controller="Admin" asp-action="UnsuspendStudent" method="post" style="display:inline;">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@student.StudentId" />
                                                    <button type="submit" class="btn btn-sm rounded-3"
                                                            style="background:#D4EDDA; color:#155724;"
                                                            title="Reactivate Student"
                                                            onclick="return confirm('Reactivate this student account?')">
                                                        <i class="bi bi-person-check"></i>
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <form asp-controller="Admin" asp-action="SuspendStudent" method="post" style="display:inline;">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@student.StudentId" />
                                                    <button type="submit" class="btn btn-sm rounded-3"
                                                            style="background:#FFE0B2; color:#7A3A00;"
                                                            title="Suspend Student"
                                                            onclick="return confirm('Suspend this student account? They will not be able to log in.')">
                                                        <i class="bi bi-person-slash"></i>
                                                    </button>
                                                </form>
                                            }

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="7"
                                    class="text-center py-5">

                                    <i class="bi bi-person-x"
                                       style="font-size:45px;
                                    color:#B8AAA0;"></i>

                                    <p class="text-muted mt-2 mb-0">

                                        No students found.

                                    </p>

                                </td>

                            </tr>
                        }

                    </tbody>

                    <!-- ================= No Search Result ================= -->

                    <tbody>

                        <tr id="noSearchResult"
                            style="display:none;">

                            <td colspan="7"
                                class="text-center py-5">

                                <i class="bi bi-search"
                                   style="font-size:40px;
                                color:#B8AAA0;"></i>

                                <h5 class="mt-3"
                                    style="color:#5F5146;">

                                    No matching student found

                                </h5>

                                <p class="text-muted mb-0">

                                    Try searching with a different name,
                                    ID, department or email.

                                </p>

                            </td>

                        </tr>

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>


<!-- ================= Search Script ================= -->

<script>

    document.addEventListener("DOMContentLoaded", function() {

        const searchInput =
            document.getElementById("searchStudent");

        const clearButton =
            document.getElementById("clearSearch");

        const rows =
            document.querySelectorAll(".student-row");

        const noResult =
            document.getElementById("noSearchResult");

        const totalStudents =
            document.getElementById("totalStudents");


        function normalizeText(text) {

            return text
                .toLowerCase()
                .trim()
                .replace(/\s+/g, " ");

        }


        function searchStudents() {

            const searchValue =
                normalizeText(searchInput.value);

            let visibleCount = 0;


            rows.forEach(function(row) {

                const rowText =
                    normalizeText(row.textContent);

                if (
                    searchValue === "" ||
                    rowText.includes(searchValue)
                ) {

                    row.style.display = "";

                    visibleCount++;

                }
                else {

                    row.style.display = "none";

                }

            });


            // Show / hide no result message

            if (visibleCount === 0 && searchValue !== "") {

                noResult.style.display = "";

            }
            else {

                noResult.style.display = "none";

            }


            // Update visible student count

            totalStudents.textContent =
                visibleCount;


            // Show clear button

            if (searchValue !== "") {

                clearButton.style.display = "block";

            }
            else {

                clearButton.style.display = "none";

                totalStudents.textContent =
                    rows.length;

            }

        }


        // Search while typing

        searchInput.addEventListener(
            "input",
            searchStudents
        );


        // Clear search

        clearButton.addEventListener(
            "click",
            function() {

                searchInput.value = "";

                searchStudents();

                searchInput.focus();

            }
        );

    });

</script>