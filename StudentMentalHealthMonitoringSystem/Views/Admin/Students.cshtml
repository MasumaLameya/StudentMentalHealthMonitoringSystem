@model IEnumerable<StudentMentalHealthMonitoringSystem.Models.Student>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Student Management";
}

<div class="container-fluid">

    @if (TempData["Success"] != null || TempData["SuccessMessage"] != null)
    {
        <div class="alert border-0 rounded-3 mb-4 d-flex align-items-center gap-2 p-3" style="background:#E6F4EA; border-left:4px solid #2E7D32; border-left-style:solid;">
            <i class="bi bi-check-circle-fill" style="color:#2E7D32; font-size:18px;"></i>
            <span style="color:#1B5E20; font-weight:600;">@(TempData["Success"] ?? TempData["SuccessMessage"])</span>
        </div>
    }
    @if (TempData["Error"] != null || TempData["ErrorMessage"] != null)
    {
        <div class="alert border-0 rounded-3 mb-4 d-flex align-items-center gap-2 p-3" style="background:#FDE8E8; border-left:4px solid #C62828; border-left-style:solid;">
            <i class="bi bi-exclamation-triangle-fill" style="color:#C62828; font-size:18px;"></i>
            <span style="color:#B71C1C; font-weight:600;">@(TempData["Error"] ?? TempData["ErrorMessage"])</span>
        </div>
    }

    <!-- ================= Header & Summary Cards ================= -->

    <div class="card border-0 shadow-sm rounded-4 mb-4"
         style="background:#F4EEE8;">

        <div class="card-body p-4">

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

                <div>

                    <h2 class="fw-bold mb-1"
                        style="color:#5F5146;">

                        👨‍🎓 Student Management &amp; Account Governance

                    </h2>

                    <p class="text-muted mb-0">

                        Manage registered students, view account status, and reactivate accounts suspended due to missed counseling appointments.

                    </p>

                </div>

                <div class="d-flex gap-2 flex-wrap">
                    <a asp-controller="Admin" asp-action="AddStudent" class="btn text-white rounded-3 px-3 shadow-sm fw-bold" style="background:#A67C52;">
                        <i class="bi bi-person-plus-fill me-1"></i> Add New Student
                    </a>
                </div>

            </div>

        </div>

    </div>

    <!-- ================= KPI Summary Metrics ================= -->
    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-md-6 col-sm-6">
            <a asp-controller="Admin" asp-action="Students" asp-route-department="@ViewBag.SelectedDepartment" asp-route-filter="All" class="text-decoration-none">
                <div class="card border-0 shadow-sm rounded-4 p-3 h-100 @(ViewBag.SelectedFilter == "All" ? "border border-2 border-dark" : "")" style="background: #FFFFFF;">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <small class="text-muted text-uppercase fw-bold d-block mb-1" style="font-size: 0.72rem;">Total Campus Enrollment</small>
                            <h3 class="fw-bold mb-0" style="color:#5F5146;">@(ViewBag.TotalCount ?? Model.Count())</h3>
                            <small class="text-muted">All Enrolled Students</small>
                        </div>
                        <div class="rounded-circle p-3 d-flex align-items-center justify-content-center" style="background:#F4EEE8; color:#8A7563; width:48px; height:48px;">
                            <i class="bi bi-people-fill fs-5"></i>
                        </div>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-xl-3 col-md-6 col-sm-6">
            <a asp-controller="Admin" asp-action="Students" asp-route-department="@ViewBag.SelectedDepartment" asp-route-filter="Active" class="text-decoration-none">
                <div class="card border-0 shadow-sm rounded-4 p-3 h-100 @(ViewBag.SelectedFilter == "Active" ? "border border-2 border-success" : "")" style="background: #F0FDF4;">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <small class="text-success text-uppercase fw-bold d-block mb-1" style="font-size: 0.72rem;">Active Student Accounts</small>
                            <h3 class="fw-bold mb-0 text-success">@(ViewBag.ActiveCount ?? 0)</h3>
                            <small class="text-success">Login Permitted</small>
                        </div>
                        <div class="rounded-circle p-3 d-flex align-items-center justify-content-center" style="background:#DCFCE7; color:#15803D; width:48px; height:48px;">
                            <i class="bi bi-check-circle-fill fs-5"></i>
                        </div>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-xl-3 col-md-6 col-sm-6">
            <a asp-controller="Admin" asp-action="Students" asp-route-department="@ViewBag.SelectedDepartment" asp-route-filter="Suspended" class="text-decoration-none">
                <div class="card border-0 shadow-sm rounded-4 p-3 h-100 @(ViewBag.SelectedFilter == "Suspended" ? "border border-2 border-warning" : "")" style="background: #FFFBEB;">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <small class="text-warning-emphasis text-uppercase fw-bold d-block mb-1" style="font-size: 0.72rem;">Total Suspended</small>
                            <h3 class="fw-bold mb-0 text-warning-emphasis">@(ViewBag.SuspendedCount ?? 0)</h3>
                            <small class="text-muted">Blocked from Login</small>
                        </div>
                        <div class="rounded-circle p-3 d-flex align-items-center justify-content-center" style="background:#FEF3C7; color:#B45309; width:48px; height:48px;">
                            <i class="bi bi-slash-circle-fill fs-5"></i>
                        </div>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-xl-3 col-md-6 col-sm-6">
            <a asp-controller="Admin" asp-action="Students" asp-route-department="@ViewBag.SelectedDepartment" asp-route-filter="MissedSuspended" class="text-decoration-none">
                <div class="card border-0 shadow-sm rounded-4 p-3 h-100 @(ViewBag.SelectedFilter == "MissedSuspended" ? "border border-2 border-danger" : "")" style="background: #FEF2F2;">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <small class="text-danger text-uppercase fw-bold d-block mb-1" style="font-size: 0.72rem;">2x Missed Auto-Sessions</small>
                            <h3 class="fw-bold mb-0 text-danger">@(ViewBag.MissedSuspendedCount ?? 0)</h3>
                            <small class="text-danger-emphasis">Auto-Suspended Students</small>
                        </div>
                        <div class="rounded-circle p-3 d-flex align-items-center justify-content-center" style="background:#FEE2E2; color:#DC2626; width:48px; height:48px;">
                            <i class="bi bi-calendar-x-fill fs-5"></i>
                        </div>
                    </div>
                </div>
            </a>
        </div>
    </div>


    <!-- ================= Search & Filter ================= -->

    <div class="card border-0 shadow-sm rounded-4 mb-4">

        <div class="card-body">

            <form method="get" asp-action="Students" class="row g-3 align-items-center mb-3">
                <input type="hidden" name="filter" value="@ViewBag.SelectedFilter" />
                <div class="col-md-6">
                    <label class="form-label fw-semibold" style="color:#5F5146;"><i class="bi bi-building me-1"></i> Filter by Department</label>
                    <select name="department" class="form-select rounded-3" onchange="this.form.submit()">
                        <option value="All" selected="@(ViewBag.SelectedDepartment == "All" || ViewBag.SelectedDepartment == null)">All Departments</option>
                        @if (ViewBag.AvailableDepartments != null)
                        {
                            foreach (var dept in (List<string>)ViewBag.AvailableDepartments)
                            {
                                <option value="@dept" selected="@(ViewBag.SelectedDepartment == dept)">@dept</option>
                            }
                        }
                    </select>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold" style="color:#5F5146;"><i class="bi bi-funnel me-1"></i> Filter by Account Status</label>
                    <div class="d-flex gap-2 flex-wrap">
                        <a asp-controller="Admin" asp-action="Students" asp-route-department="@ViewBag.SelectedDepartment" asp-route-filter="All" class="btn btn-sm rounded-pill px-3 fw-semibold @(ViewBag.SelectedFilter == "All" || string.IsNullOrWhiteSpace(ViewBag.SelectedFilter) ? "btn-dark" : "btn-outline-secondary")">
                            All (@(ViewBag.TotalCount ?? Model.Count()))
                        </a>
                        <a asp-controller="Admin" asp-action="Students" asp-route-department="@ViewBag.SelectedDepartment" asp-route-filter="Active" class="btn btn-sm rounded-pill px-3 fw-semibold @(ViewBag.SelectedFilter == "Active" ? "btn-success" : "btn-outline-success")">
                            Active (@(ViewBag.ActiveCount ?? 0))
                        </a>
                        <a asp-controller="Admin" asp-action="Students" asp-route-department="@ViewBag.SelectedDepartment" asp-route-filter="Suspended" class="btn btn-sm rounded-pill px-3 fw-semibold @(ViewBag.SelectedFilter == "Suspended" ? "btn-warning" : "btn-outline-warning")">
                            All Suspended (@(ViewBag.SuspendedCount ?? 0))
                        </a>
                        <a asp-controller="Admin" asp-action="Students" asp-route-department="@ViewBag.SelectedDepartment" asp-route-filter="MissedSuspended" class="btn btn-sm rounded-pill px-3 fw-semibold @(ViewBag.SelectedFilter == "MissedSuspended" ? "btn-danger" : "btn-outline-danger")">
                            <i class="bi bi-calendar-x me-1"></i> 2x Missed Suspended (@(ViewBag.MissedSuspendedCount ?? 0))
                        </a>
                    </div>
                </div>
            </form>

            <label for="searchStudent"
                   class="form-label fw-semibold"
                   style="color:#5F5146;">

                Search Student

            </label>

            <div class="input-group">

                <span class="input-group-text"
                      style="background:#F4EEE8;
                    border-color:#DDD0C4;">

                    <i class="bi bi-search"
                       style="color:#8A7563;"></i>

                </span>

                <input type="text"
                       id="searchStudent"
                       class="form-control"
                       placeholder="Search by Student ID, Name, Department, Semester or Email..."
                       autocomplete="off"
                       style="border-color:#DDD0C4;" />

                <button type="button"
                        id="clearSearch"
                        class="btn"
                        style="background:#E8DDD2;
                    color:#5F5146;
                    display:none;">

                    <i class="bi bi-x-lg"></i>

                </button>

            </div>

            <small class="text-muted">

                Search results update automatically. Showing <strong id="visibleStudentCount">@Model.Count()</strong> students.

            </small>

        </div>

    </div>


    <!-- ================= Student Table ================= -->

    <div class="card border-0 shadow-sm rounded-4">

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0"
                       id="studentTable">

                    <thead style="background:#E8DDD2;">

                        <tr>

                            <th class="px-4 py-3">
                                Photo
                            </th>

                            <th class="py-3">
                                Student ID
                            </th>

                            <th class="py-3">
                                Name &amp; Status
                            </th>

                            <th class="py-3">
                                Department
                            </th>

                            <th class="py-3">
                                Semester
                            </th>

                            <th class="py-3">
                                Email
                            </th>

                            <th class="py-3 text-center">
                                Actions
                            </th>

                        </tr>

                    </thead>

                    <tbody id="studentTableBody">

                        @if (Model != null && Model.Any())
                        {
                            var streakMap = ViewBag.MissedStreakMap as Dictionary<int, int>;

                            foreach (var student in Model)
                            {
                                int missedStreak = (streakMap != null && streakMap.ContainsKey(student.StudentId)) ? streakMap[student.StudentId] : 0;
                                bool is2xMissedSuspended = student.IsSuspended && missedStreak >= 2;

                                <tr class="student-row @(is2xMissedSuspended ? "table-danger" : (student.IsSuspended ? "table-warning" : ""))">

                                    <!-- Photo -->

                                    <td class="px-4">

                                        @if (!string.IsNullOrEmpty(student.ProfileImage))
                                        {
                                            <img src="@student.ProfileImage"
                                                 width="55"
                                                 height="55"
                                                 class="rounded-circle border shadow-sm"
                                                 style="object-fit:cover; @(student.IsSuspended ? "opacity:0.6;" : "")">
                                        }
                                        else
                                        {
                                            <img src="https://ui-avatars.com/api/?name=@Uri.EscapeDataString(student.FullName)&background=@(is2xMissedSuspended ? "DC2626" : (student.IsSuspended ? "999" : "A67C52"))&color=fff&size=55"
                                                 width="55"
                                                 height="55"
                                                 class="rounded-circle"
                                                 style="@(student.IsSuspended ? "opacity:0.6;" : "")">
                                        }

                                    </td>


                                    <!-- Student ID -->

                                    <td>

                                        <span class="fw-semibold"
                                              style="color:#5F5146;">

                                            @student.StudentIdNumber

                                        </span>

                                    </td>


                                    <!-- Name & Status -->

                                    <td>

                                        <div>
                                            <strong style="color:#5F5146;">
                                                @student.FullName
                                            </strong>
                                        </div>
                                        <div class="mt-1">
                                            @if (is2xMissedSuspended)
                                            {
                                                <span class="badge px-2 py-1 rounded-pill" style="background:#DC2626; color:#fff; font-size:10.5px; font-weight:700;">
                                                    <i class="bi bi-calendar-x me-1"></i>2x Missed (Suspended)
                                                </span>
                                            }
                                            else if (student.IsSuspended)
                                            {
                                                <span class="badge px-2 py-1 rounded-pill" style="background:#E65C00; color:#fff; font-size:10px; font-weight:600;">
                                                    <i class="bi bi-slash-circle me-1"></i>Suspended
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge px-2 py-1 rounded-pill" style="background:#E8F5E9; color:#2E7D32; font-size:10px; font-weight:600;">
                                                    <i class="bi bi-check-circle me-1"></i>Active
                                                </span>
                                            }
                                        </div>

                                    </td>


                                    <!-- Department -->

                                    <td>

                                        <span class="badge rounded-pill px-3 py-2"
                                              style="background:#EEE4DA;
                                            color:#705F50;">

                                            @student.Department

                                        </span>

                                    </td>


                                    <!-- Semester -->

                                    <td>

                                        @student.Semester

                                    </td>


                                    <!-- Email -->

                                    <td>

                                        @student.Email

                                    </td>


                                    <!-- Actions -->

                                    <td>

                                        <div class="d-flex justify-content-center align-items-center gap-1">

                                            <a asp-controller="Admin"
                                               asp-action="StudentDetails"
                                               asp-route-id="@student.StudentId"
                                               class="btn btn-sm rounded-3"
                                               style="background:#D8C7B8; color:#55483D;"
                                               title="View Student Clinical &amp; Assessment Profile">
                                                <i class="bi bi-eye"></i>
                                            </a>

                                            <a asp-controller="Admin"
                                               asp-action="EditStudent"
                                               asp-route-id="@student.StudentId"
                                               class="btn btn-sm rounded-3"
                                               style="background:#E5D3B3; color:#665438;"
                                               title="Edit Student Information">
                                                <i class="bi bi-pencil"></i>
                                            </a>

                                            <button type="button" class="btn btn-sm rounded-3 btn-change-password"
                                                    style="background:#C8B6A6; color:#4A3B32;"
                                                    title="Change Student Password"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#changeStudentPasswordModal"
                                                    data-student-id="@student.StudentId"
                                                    data-student-name="@student.FullName"
                                                    data-student-code="@student.StudentIdNumber">
                                                <i class="bi bi-key-fill"></i>
                                            </button>

                                            @if (student.IsSuspended)
                                            {
                                                <form asp-controller="Admin" asp-action="UnsuspendStudent" method="post" style="display:inline;">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@student.StudentId" />
                                                    <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                                    <button type="submit" class="btn btn-sm rounded-3 fw-bold"
                                                            style="background:#DCFCE7; color:#15803D; border:1px solid #BBF7D0;"
                                                            title="Reactivate Student Account"
                                                            onclick="return confirm('Reactivate student account for @student.FullName (@student.StudentIdNumber)? Their portal login will be restored.');">
                                                        <i class="bi bi-person-check-fill me-1"></i>Active
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <form asp-controller="Admin" asp-action="SuspendStudent" method="post" style="display:inline;">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@student.StudentId" />
                                                    <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                                    <button type="submit" class="btn btn-sm rounded-3"
                                                            style="background:#FFE0B2; color:#7A3A00;"
                                                            title="Suspend Student"
                                                            onclick="return confirm('Suspend this student account? They will not be able to log in.')">
                                                        <i class="bi bi-person-slash"></i>
                                                    </button>
                                                </form>
                                            }

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="7"
                                    class="text-center py-5">

                                    <i class="bi bi-person-x"
                                       style="font-size:45px;
                                    color:#B8AAA0;"></i>

                                    <p class="text-muted mt-2 mb-0">

                                        No students found.

                                    </p>

                                </td>

                            </tr>
                        }

                    </tbody>

                    <!-- ================= No Search Result ================= -->

                    <tbody>

                        <tr id="noSearchResult"
                            style="display:none;">

                            <td colspan="7"
                                class="text-center py-5">

                                <i class="bi bi-search"
                                   style="font-size:40px;
                                color:#B8AAA0;"></i>

                                <h5 class="mt-3"
                                    style="color:#5F5146;">

                                    No matching student found

                                </h5>

                                <p class="text-muted mb-0">

                                    Try searching with a different name,
                                    ID, department or email.

                                </p>

                            </td>

                        </tr>

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>


<!-- ================= Search Script ================= -->

<script>

    document.addEventListener("DOMContentLoaded", function() {

        const searchInput =
            document.getElementById("searchStudent");

        const clearButton =
            document.getElementById("clearSearch");

        const rows =
            document.querySelectorAll(".student-row");

        const noResult =
            document.getElementById("noSearchResult");

        const totalStudents =
            document.getElementById("totalStudents");


        function normalizeText(text) {

            return text
                .toLowerCase()
                .trim()
                .replace(/\s+/g, " ");

        }


        function searchStudents() {

            const searchValue =
                normalizeText(searchInput.value);

            let visibleCount = 0;


            rows.forEach(function(row) {

                const rowText =
                    normalizeText(row.textContent);

                if (
                    searchValue === "" ||
                    rowText.includes(searchValue)
                ) {

                    row.style.display = "";

                    visibleCount++;

                }
                else {

                    row.style.display = "none";

                }

            });


            // Show / hide no result message

            if (visibleCount === 0 && searchValue !== "") {

                noResult.style.display = "";

            }
            else {

                noResult.style.display = "none";

            }


            // Update visible student count

            totalStudents.textContent =
                visibleCount;


            // Show clear button

            if (searchValue !== "") {

                clearButton.style.display = "block";

            }
            else {

                clearButton.style.display = "none";

                totalStudents.textContent =
                    rows.length;

            }

        }


        // Search while typing

        searchInput.addEventListener(
            "input",
            searchStudents
        );


        // Clear search

        clearButton.addEventListener(
            "click",
            function() {

                searchInput.value = "";

                searchStudents();

                searchInput.focus();

            }
        );

        // Populate Change Password Modal
        var changePasswordModal = document.getElementById('changeStudentPasswordModal');
        if (changePasswordModal) {
            changePasswordModal.addEventListener('show.bs.modal', function(event) {
                var button = event.relatedTarget;
                if (!button) return;
                var studentId = button.getAttribute('data-student-id');
                var studentName = button.getAttribute('data-student-name');
                var studentCode = button.getAttribute('data-student-code');

                document.getElementById('modalStudentId').value = studentId;
                document.getElementById('modalStudentName').textContent = studentName;
                document.getElementById('modalStudentCode').textContent = studentCode;
                document.getElementById('modalNewPassword').value = '';
                document.getElementById('modalConfirmPassword').value = '';
            });
        }

    });

</script>

<!-- ================= Change Student Password Modal ================= -->
<div class="modal fade" id="changeStudentPasswordModal" tabindex="-1" aria-labelledby="changeStudentPasswordModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4 overflow-hidden">
            <div class="modal-header border-0 text-white p-4" style="background: linear-gradient(135deg, #8A7563, #5F5146);">
                <div>
                    <h5 class="modal-title fw-bold mb-1" id="changeStudentPasswordModalLabel">
                        <i class="bi bi-key-fill me-2"></i>Change Student Password
                    </h5>
                    <small class="text-white-50">Direct password reset by Administrator</small>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Admin" asp-action="ChangeStudentPassword" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="studentId" id="modalStudentId" value="" />
                <input type="hidden" name="returnUrl" value="/Admin/Students" />

                <div class="modal-body p-4">
                    <div class="p-3 rounded-3 mb-3" style="background:#FAF6F2; border:1px solid #E8DDD2;">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <small class="text-muted d-block">Student Name</small>
                                <strong class="text-dark" id="modalStudentName">-</strong>
                            </div>
                            <div class="text-end">
                                <small class="text-muted d-block">Student ID</small>
                                <span class="badge px-2.5 py-1 rounded-pill" style="background:#EEE4DA; color:#705F50;" id="modalStudentCode">-</span>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="modalNewPassword" class="form-label fw-semibold text-secondary small">New Password *</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-lock-fill text-muted"></i></span>
                            <input type="password" name="newPassword" id="modalNewPassword" class="form-control border-start-0" placeholder="Minimum 8 characters" required />
                        </div>
                        <small class="text-muted" style="font-size: 0.75rem;">Must contain at least 1 uppercase, 1 lowercase, 1 number & 1 special character.</small>
                    </div>

                    <div class="mb-3">
                        <label for="modalConfirmPassword" class="form-label fw-semibold text-secondary small">Confirm New Password *</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-shield-check text-muted"></i></span>
                            <input type="password" name="confirmPassword" id="modalConfirmPassword" class="form-control border-start-0" placeholder="Re-enter new password" required />
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 p-4 pt-0">
                    <button type="button" class="btn rounded-3 px-4" style="background:#E8DDD2; color:#5F5146;" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn text-white rounded-3 px-4 fw-bold" style="background:#A67C52;">
                        <i class="bi bi-check2-circle me-1"></i> Update Password
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>