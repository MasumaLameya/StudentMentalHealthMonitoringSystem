@model StudentMentalHealthMonitoringSystem.ViewModels.StudentClearanceCertificateViewModel

@{
    ViewData["Title"] = "Semester Screening Clearance Certificate";
}

<style>
    .student-app-bg {
        background: #F8FAFC;
        min-height: 100vh;
        padding-bottom: 2rem;
    }

    .glass-card {
        background: #ffffff;
        border: 1px solid #E2E8F0;
        border-radius: 1.25rem;
        box-shadow: 0 4px 20px rgba(15, 23, 42, 0.05);
    }

    /* Official Certificate Paper Styling */
    .certificate-paper {
        background: #FFFFFF;
        border: 10px double #004D25;
        border-radius: 1rem;
        padding: 3rem 2.5rem;
        position: relative;
        box-shadow: 0 10px 30px rgba(0, 77, 37, 0.08);
    }

    .certificate-watermark {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        opacity: 0.04;
        font-size: 18rem;
        color: #004D25;
        pointer-events: none;
        z-index: 0;
    }

    .certificate-content {
        position: relative;
        z-index: 1;
    }

    .clearance-stamp {
        border: 3px dashed #198754;
        border-radius: 0.75rem;
        padding: 0.6rem 1.5rem;
        display: inline-block;
        color: #198754;
        font-weight: 800;
        letter-spacing: 1px;
        text-transform: uppercase;
        transform: rotate(-2deg);
        background: rgba(25, 135, 84, 0.05);
    }

    .clearance-stamp.pending {
        border-color: #DC3545;
        color: #DC3545;
        background: rgba(220, 53, 69, 0.05);
    }

    @@media print {
        body * {
            visibility: hidden;
        }
        .certificate-paper, .certificate-paper * {
            visibility: visible;
        }
        .certificate-paper {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
            border: 6px double #004D25 !important;
            box-shadow: none !important;
            padding: 2rem !important;
        }
        .no-print {
            display: none !important;
        }
    }
</style>

<div class="student-app-bg py-3">
    <div class="container-fluid">
        <div class="row g-4">

            <!-- Sidebar Navigation -->
            <div class="col-lg-3 no-print">
                @await Html.PartialAsync("_StudentSidebar")
            </div>

            <!-- Main Content Area -->
            <div class="col-lg-9">

                <!-- Header Action Toolbar -->
                <div class="glass-card p-4 mb-4 no-print" style="background: linear-gradient(135deg, #004D25 0%, #006837 100%); color: #ffffff;">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                        <div>
                            <div class="badge bg-white text-dark rounded-pill px-3 py-1.5 mb-2 fw-bold">
                                <i class="bi bi-patch-check-fill text-success me-1"></i> Official Document
                            </div>
                            <h2 class="fw-bold mb-1 text-white">
                                <i class="bi bi-file-earmark-check me-2"></i>Screening Clearance Certificate
                            </h2>
                            <p class="text-white-50 fs-6 mb-0">Official institutional certificate verifying mental health screening compliance for course registration.</p>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            @if (Model.IsCleared)
                            {
                                <button type="button" onclick="window.print()" class="btn btn-light text-dark btn-lg rounded-3 px-4 py-2 fw-bold shadow-sm">
                                    <i class="bi bi-printer me-1"></i> Print / Save PDF
                                </button>
                            }
                            <a href="/Student/Reports" class="btn btn-outline-light rounded-3 px-3 py-2 fw-semibold">
                                <i class="bi bi-arrow-left me-1"></i> Reports Hub
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Semester Selector Toolbar (No Print) -->
                <div class="glass-card p-3 mb-4 no-print">
                    <form method="get" asp-controller="Student" asp-action="ClearanceCertificate" class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-calendar-event fs-5" style="color: #006837;"></i>
                            <span class="fw-bold text-dark">Select Academic Term:</span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <select name="semester" class="form-select form-select-sm" style="min-width: 180px;" onchange="this.form.submit()">
                                @foreach (var sem in Model.AvailableSemesters)
                                {
                                    <option value="@sem" selected="@(Model.SelectedSemester == sem)">@sem</option>
                                }
                            </select>
                        </div>
                    </form>
                </div>

                @if (!Model.IsCleared)
                {
                    <div class="alert alert-danger border-0 shadow-sm rounded-4 p-4 mb-4 no-print">
                        <div class="d-flex align-items-start gap-3">
                            <i class="bi bi-exclamation-triangle-fill text-danger fs-2"></i>
                            <div>
                                <h5 class="fw-bold text-danger mb-1">Clearance Incomplete for @Model.SelectedSemester</h5>
                                <p class="text-dark mb-3">
                                    You have not completed both mandatory screening assessments (PHQ-9 &amp; C-SSRS) for this semester. Your course registration clearance remains pending until both are submitted.
                                </p>
                                <div class="d-flex gap-2 flex-wrap">
                                    @if (!Model.HasCompletedPHQ)
                                    {
                                        <a href="/Student/PHQ" class="btn btn-danger btn-sm rounded-pill px-3 py-1.5 fw-semibold">
                                            <i class="bi bi-clipboard-pulse me-1"></i> Take PHQ-9 Assessment
                                        </a>
                                    }
                                    @if (!Model.HasCompletedCSSRS)
                                    {
                                        <a href="/Student/CSRRS" class="btn btn-danger btn-sm rounded-pill px-3 py-1.5 fw-semibold">
                                            <i class="bi bi-shield-check me-1"></i> Take C-SSRS Assessment
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <!-- ================= OFFICIAL CERTIFICATE DOCUMENT ================= -->
                <div class="certificate-paper">
                    <i class="bi bi-award-fill certificate-watermark"></i>

                    <div class="certificate-content">

                        <!-- Header -->
                        <div class="text-center mb-4">
                            <div class="d-inline-flex align-items-center justify-content-center bg-success text-white rounded-circle p-3 mb-2 shadow-sm" style="width: 60px; height: 60px; background-color: #004D25 !important;">
                                <i class="bi bi-heart-pulse-fill fs-2"></i>
                            </div>
                            <h3 class="fw-bold text-uppercase mb-1" style="color: #004D25; letter-spacing: 1px;">
                                International University of Business Agriculture and Technology
                            </h3>
                            <h5 class="fw-semibold text-secondary mb-1">Student Mental Health Monitoring Center</h5>
                            <p class="text-muted small mb-0">Official Semester Mental Health Screening Clearance &amp; Academic Authorization</p>
                        </div>

                        <hr style="border-top: 2px solid #004D25; opacity: 0.3;" class="my-4" />

                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
                            <div>
                                <small class="text-muted text-uppercase fw-bold d-block">Certificate No:</small>
                                <strong class="text-dark font-monospace" style="font-size: 1.05rem;">@Model.CertificateNumber</strong>
                            </div>
                            <div class="text-end">
                                <small class="text-muted text-uppercase fw-bold d-block">Issued Date:</small>
                                <strong class="text-dark">@Model.IssuedDate.ToString("dd MMMM, yyyy")</strong>
                            </div>
                        </div>

                        <!-- Statement of Clearance -->
                        <div class="p-4 rounded-4 mb-4" style="background: #FAF8F5; border: 1px solid #EFE8E1;">
                            <p class="fs-6 text-dark mb-3" style="line-height: 1.7;">
                                This is to officially certify that the student specified below has completed the mandatory institutional psychological and mental health screening protocol for the <strong>@Model.SelectedSemester</strong> academic term as prescribed by university governance.
                            </p>

                            <div class="row g-3">
                                <div class="col-sm-6">
                                    <div class="p-2.5 bg-white rounded-3 border">
                                        <small class="text-muted d-block">Student Full Name:</small>
                                        <strong class="text-dark fs-6">@Model.FullName</strong>
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="p-2.5 bg-white rounded-3 border">
                                        <small class="text-muted d-block">Student ID Number:</small>
                                        <strong class="text-dark fs-6">@Model.StudentIdNumber</strong>
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="p-2.5 bg-white rounded-3 border">
                                        <small class="text-muted d-block">Academic Department:</small>
                                        <strong class="text-dark fs-6">Department of @Model.Department</strong>
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="p-2.5 bg-white rounded-3 border">
                                        <small class="text-muted d-block">Enrolled Academic Term:</small>
                                        <strong class="text-dark fs-6">@Model.SelectedSemester</strong>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Screening Protocol Breakdown -->
                        <div class="mb-4">
                            <h6 class="fw-bold text-uppercase text-secondary mb-3" style="letter-spacing: 0.5px;">
                                <i class="bi bi-clipboard-check me-1"></i> Screening Evaluation Summary
                            </h6>

                            <div class="table-responsive">
                                <table class="table table-bordered align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Screening Module</th>
                                            <th>Protocol Type</th>
                                            <th>Completion Date</th>
                                            <th>Compliance Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td><strong>PHQ-9 Assessment</strong></td>
                                            <td>Patient Health Questionnaire (Depression Scale)</td>
                                            <td>@(Model.PHQCompletionDate?.ToString("MMM dd, yyyy") ?? "Not Completed")</td>
                                            <td>
                                                @if (Model.HasCompletedPHQ)
                                                {
                                                    <span class="badge bg-success rounded-pill px-3 py-1">Verified Completed</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger rounded-pill px-3 py-1">Pending</span>
                                                }
                                            </td>
                                        </tr>
                                        <tr>
                                            <td><strong>C-SSRS Assessment</strong></td>
                                            <td>Columbia Suicide Severity Rating Scale</td>
                                            <td>@(Model.CSSRSCompletionDate?.ToString("MMM dd, yyyy") ?? "Not Completed")</td>
                                            <td>
                                                @if (Model.HasCompletedCSSRS)
                                                {
                                                    <span class="badge bg-success rounded-pill px-3 py-1">Verified Completed</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger rounded-pill px-3 py-1">Pending</span>
                                                }
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Official Clearance Stamp & Signature Block -->
                        <div class="row align-items-center pt-3">
                            <div class="col-sm-6 text-center text-sm-start mb-3 mb-sm-0">
                                <div class="clearance-stamp @(Model.IsCleared ? "" : "pending")">
                                    <i class="bi @(Model.IsCleared ? "bi-patch-check-fill" : "bi-x-octagon-fill") me-1"></i>
                                    @Model.ClearanceStatus
                                </div>
                                <small class="text-muted d-block mt-2">Verification Code: <code>@Model.VerificationCode</code></small>
                            </div>

                            <div class="col-sm-6 text-center text-sm-end">
                                <div class="d-inline-block text-center" style="min-width: 200px;">
                                    <div style="border-bottom: 2px solid #333; height: 35px; margin-bottom: 5px;">
                                        <span class="font-monospace text-muted" style="font-size: 0.85rem;">[Digitally Verified SMHMS Center]</span>
                                    </div>
                                    <strong class="d-block text-dark small">Director / Authorized Clinician</strong>
                                    <small class="text-muted" style="font-size: 0.75rem;">University Mental Health Services</small>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

            </div>

        </div>
    </div>
</div>
