@{
    ViewData["Title"] = "Student Mental Health Reports";
}

<style>
    .student-app-bg {
        background: #F8FAFC;
        min-height: 100vh;
        padding-bottom: 2rem;
    }

    .glass-card {
        background: #ffffff;
        border: 1px solid #E2E8F0;
        border-radius: 1.25rem;
        box-shadow: 0 4px 20px rgba(15, 23, 42, 0.05);
    }

    .student-sidebar .list-group-item {
        border: none;
        border-radius: 0.75rem;
        margin-bottom: 0.35rem;
        padding: 0.8rem 1.1rem;
        font-weight: 600;
        font-size: 0.95rem;
        color: #1E293B;
        transition: all 0.2s ease;
        display: flex;
        align-items: center;
        gap: 0.85rem;
    }

    .student-sidebar .list-group-item i {
        font-size: 1.25rem;
        color: #2563EB;
        width: 26px;
        text-align: center;
    }

    .student-sidebar .list-group-item:hover {
        background: #EFF6FF;
        color: #1E3A8A;
        transform: translateX(4px);
    }

    .student-sidebar .list-group-item.active {
        background: linear-gradient(135deg, #1E3A8A 0%, #2563EB 100%);
        color: #ffffff;
        box-shadow: 0 4px 14px rgba(37, 99, 235, 0.35);
    }

    .student-sidebar .list-group-item.active i {
        color: #ffffff;
    }
</style>

<div class="student-app-bg py-3">
    <div class="container-fluid">
        <div class="row g-4">

            <!-- Sidebar Navigation -->
            <div class="col-lg-3">
                @await Html.PartialAsync("_StudentSidebar")
            </div>

            <!-- Main Content Area -->
            <div class="col-lg-9">

                <!-- Header Banner -->
                <div class="glass-card p-4 mb-4" style="background: linear-gradient(135deg, #1E3A8A 0%, #2563EB 100%); color: #ffffff;">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                        <div>
                            <h2 class="fw-bold mb-1 text-white">
                                <i class="bi bi-file-earmark-medical me-2"></i>Official Mental Health Reports
                            </h2>
                            <p class="text-white-50 fs-6 mb-0">Access and review official semester screening evaluation reports and counseling summaries.</p>
                        </div>
                        <a href="/Student/Dashboard" class="btn btn-light text-primary btn-lg rounded-3 px-4 py-2 fw-bold shadow-sm">
                            <i class="bi bi-arrow-left me-1"></i> Dashboard
                        </a>
                    </div>
                </div>

                <div class="row g-4">
                    <!-- 1. Semester Screening Report -->
                    <div class="col-md-6">
                        <div class="glass-card p-4 text-center h-100 d-flex flex-column justify-content-between">
                            <div>
                                <div class="badge bg-primary-subtle text-primary p-3 rounded-circle mb-3">
                                    <i class="bi bi-journal-text fs-2"></i>
                                </div>
                                <h4 class="fw-bold text-dark mb-2">Semester Screening Report</h4>
                                <p class="text-muted fs-6 mb-4">
                                    Comprehensive semester screening evaluation report including PHQ-9 depression scale and C-SSRS suicide risk classification.
                                </p>
                            </div>
                            <a href="/Student/SemesterScreening" class="btn btn-outline-primary btn-lg rounded-pill fw-semibold w-100 shadow-sm py-2.5">
                                <i class="bi bi-file-earmark-text me-1"></i> View Semester Report
                            </a>
                        </div>
                    </div>

                    <!-- 2. Counseling & Progress Report -->
                    <div class="col-md-6">
                        <div class="glass-card p-4 text-center h-100 d-flex flex-column justify-content-between">
                            <div>
                                <div class="badge bg-danger-subtle text-danger p-3 rounded-circle mb-3">
                                    <i class="bi bi-heart-pulse fs-2"></i>
                                </div>
                                <h4 class="fw-bold text-dark mb-2">Counseling &amp; Clinical Progress Report</h4>
                                <p class="text-muted fs-6 mb-4">
                                    Psychologist observation notes, session-by-session improvement indicators, coping guidance, and recovery trajectory.
                                </p>
                            </div>
                            <a href="/Student/Progress" class="btn btn-outline-danger btn-lg rounded-pill fw-semibold w-100 shadow-sm py-2.5">
                                <i class="bi bi-graph-up-arrow me-1"></i> View Counseling Report
                            </a>
                        </div>
                    </div>

                    <!-- 3. Official Screening Clearance Certificate -->
                    <div class="col-md-6">
                        <div class="glass-card p-4 text-center h-100 d-flex flex-column justify-content-between border-success-subtle" style="background: linear-gradient(180deg, #FFFFFF 0%, #F0FDF4 100%);">
                            <div>
                                <div class="badge bg-success-subtle text-success p-3 rounded-circle mb-3">
                                    <i class="bi bi-patch-check-fill fs-2"></i>
                                </div>
                                <div class="badge bg-success text-white rounded-pill px-3 py-1 mb-2">Official Certificate</div>
                                <h4 class="fw-bold text-dark mb-2">Screening Clearance Certificate</h4>
                                <p class="text-muted fs-6 mb-4">
                                    Official institutional certificate verifying completion of mandatory semester mental health screening for course registration.
                                </p>
                            </div>
                            <a href="/Student/ClearanceCertificate" class="btn btn-success btn-lg rounded-pill fw-semibold w-100 shadow-sm py-2.5 text-white">
                                <i class="bi bi-award-fill me-1"></i> View Official Certificate
                            </a>
                        </div>
                    </div>

                    <!-- 4. AI Telehealth & Coping History -->
                    <div class="col-md-6">
                        <div class="glass-card p-4 text-center h-100 d-flex flex-column justify-content-between border-primary-subtle" style="background: linear-gradient(180deg, #FFFFFF 0%, #EEF2FF 100%);">
                            <div>
                                <div class="badge p-3 rounded-circle mb-3" style="background: #E0E7FF; color: #4338CA;">
                                    <i class="bi bi-chat-heart-fill fs-2"></i>
                                </div>
                                <div class="badge rounded-pill px-3 py-1 mb-2 text-white" style="background: #4338CA;">Digital Care</div>
                                <h4 class="fw-bold text-dark mb-2">AI Telehealth &amp; Coping History</h4>
                                <p class="text-muted fs-6 mb-4">
                                    Confidential consultation history from 24/7 AI Companion chat and Live Voice Bot sessions with personalized coping advice.
                                </p>
                            </div>
                            <a href="/Student/AIHistory" class="btn btn-lg rounded-pill fw-semibold w-100 shadow-sm py-2.5 text-white" style="background: #4338CA;">
                                <i class="bi bi-robot me-1"></i> View AI Telehealth History
                            </a>
                        </div>
                    </div>
                </div>

            </div>

        </div>
    </div>
</div>