@{
    ViewData["Title"] = "Reports";
}

<div class="container mt-4">

    <div class="row">

        <div class="col-md-6 mb-4">

            <div class="card shadow">

                <div class="card-body text-center">

                    <h4>Semester Report</h4>

                    <p>View semester screening report.</p>

                    <button class="btn btn-primary">

                        View

                    </button>

                </div>

            </div>

        </div>

        <div class="col-md-6 mb-4">

            <div class="card shadow">

                <div class="card-body text-center">

                    <h4>Risk Assessment Report</h4>

                    <p>AI generated risk analysis.</p>

                    <button class="btn btn-success">

                        View

                    </button>

                </div>

            </div>

        </div>

        <div class="col-md-6 mb-4">

            <div class="card shadow">

                <div class="card-body text-center">

                    <h4>Counseling Report</h4>

                    <p>Psychologist counseling summary.</p>

                    <button class="btn btn-warning">

                        View

                    </button>

                </div>

            </div>

        </div>

        <div class="col-md-6 mb-4">

            <div class="card shadow">

                <div class="card-body text-center">

                    <h4>Overall Mental Health History</h4>

                    <p>Complete longitudinal report.</p>

                    <button class="btn btn-danger">

                        View

                    </button>

                </div>

            </div>

        </div>

    </div>

</div>