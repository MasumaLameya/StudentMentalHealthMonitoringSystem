@{
    ViewData["Title"] = "Forgot Password - Student";
}

<style>
    .forgot-container {
        min-height: calc(100vh - 180px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2.5rem 1rem;
    }

    .forgot-card {
        background: #ffffff;
        border: 1px solid #D1E2D7;
        border-radius: 1.25rem;
        box-shadow: 0 8px 30px rgba(0, 77, 37, 0.08);
        overflow: hidden;
        width: 100%;
        max-width: 460px;
    }

    .forgot-header {
        background: linear-gradient(135deg, #004D25 0%, #006837 100%);
        border-bottom: 3px solid #FFC20E;
        padding: 2rem 1.75rem;
        text-align: center;
        color: #ffffff;
    }
</style>

<div class="forgot-container">
    <div class="forgot-card">
        <div class="forgot-header">
            <div class="badge bg-white p-3 rounded-circle shadow-sm mb-3">
                <i class="bi bi-shield-lock-fill fs-2" style="color: #006837;"></i>
            </div>
            <h3 class="fw-bold mb-1 text-white">Forgot Password?</h3>
            <p class="text-white-50 fs-6 mb-0">Enter your registered email to receive an OTP</p>
        </div>

        <div class="p-4">
            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger border-0 rounded-3 mb-3 small">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i> @ViewBag.Error
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger border-0 rounded-3 mb-3 small">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i> @TempData["ErrorMessage"]
                </div>
            }

            <form asp-controller="Student" asp-action="ForgotPassword" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-4">
                    <label class="form-label fw-bold text-dark fs-6 mb-1">Student Email Address</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-envelope fs-5" style="color: #006837;"></i></span>
                        <input type="email" name="email" class="form-control border-start-0 ps-2 fs-6" placeholder="student@example.com" required autofocus />
                    </div>
                    <small class="text-muted">A 6-digit verification code will be sent to this email.</small>
                </div>

                <button type="submit" class="btn text-white w-100 rounded-3 py-2.5 fw-bold mb-3 shadow-sm fs-6" style="background:#006837; border-color:#006837;">
                    <i class="bi bi-send-fill me-1"></i> Send Verification Code
                </button>
            </form>

            <div class="text-center">
                <a asp-controller="Student" asp-action="Login" class="text-decoration-none fw-semibold small" style="color: #006837;">
                    <i class="bi bi-arrow-left me-1"></i> Back to Student Login
                </a>
            </div>
        </div>
    </div>
</div>
