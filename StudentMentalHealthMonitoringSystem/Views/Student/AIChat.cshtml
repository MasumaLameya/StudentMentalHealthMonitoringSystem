@{
    ViewData["Title"] = "AI Mental Health Assistant";
}

<div class="container-fluid mt-4">

    <div class="row">

        <div class="col-lg-3">

            <div class="card shadow">

                <div class="card-body">

                    <h4 class="text-center text-primary">

                        AI Mental Health Assistant

                    </h4>

                    <hr>

                    <div class="list-group">

                        <a href="/Student/Dashboard" class="list-group-item list-group-item-action">
                            Dashboard
                        </a>

                        <a href="/Student/AIChat" class="list-group-item list-group-item-action active">
                            AI Chat
                        </a>

                        <a href="/Student/History" class="list-group-item list-group-item-action">
                            Conversation History
                        </a>

                        <a href="/Student/Profile" class="list-group-item list-group-item-action">
                            Profile
                        </a>

                    </div>

                </div>

            </div>

        </div>

        <div class="col-lg-9">

            <div class="card shadow">

                <div class="card-header bg-primary text-white">

                    <h4>AI Mental Health Chatbot</h4>

                </div>

                <div class="card-body">

                    <div style="height:500px;overflow-y:auto;background:#f8f9fa;padding:20px;border-radius:10px;">

                        <div class="text-end mb-3">

                            <span class="badge bg-primary p-3">

                                Hello, I have been feeling stressed recently.

                            </span>

                        </div>

                        <div class="text-start mb-3">

                            <span class="badge bg-success p-3">

                                I'm sorry you're feeling stressed. Would you like to tell me what has been bothering you lately?

                            </span>

                        </div>

                        <div class="text-end mb-3">

                            <span class="badge bg-primary p-3">

                                I have too much academic pressure.

                            </span>

                        </div>

                        <div class="text-start mb-3">

                            <span class="badge bg-success p-3">

                                Thank you for sharing that with me. Remember that you don't have to handle everything alone. If needed, our university psychologist is available to support you.

                            </span>

                        </div>

                    </div>

                    <div class="input-group mt-4">

                        <input type="text"
                               class="form-control"
                               placeholder="Type your message here...">

                        <button class="btn btn-primary">

                            Send

                        </button>

                    </div>

                </div>

            </div>

            <div class="card shadow mt-4">

                <div class="card-header bg-warning">

                    Chat Summary

                </div>

                <div class="card-body">

                    <table class="table table-bordered">

                        <tr>

                            <th>Conversation Status</th>

                            <td>Normal Conversation</td>

                        </tr>

                        <tr>

                            <th>Detected Emotion</th>

                            <td>Stress</td>

                        </tr>

                        <tr>

                            <th>Risk Level</th>

                            <td>Moderate</td>

                        </tr>

                        <tr>

                            <th>Recommendation</th>

                            <td>

                                Continue chatting or complete semester screening.

                            </td>

                        </tr>

                    </table>

                </div>

            </div>

        </div>

    </div>

</div>