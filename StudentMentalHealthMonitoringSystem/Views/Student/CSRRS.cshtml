@model StudentMentalHealthMonitoringSystem.Models.CSSRSAssessment

@{
    ViewData["Title"] = "C-SSRS Assessment";
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header bg-danger text-white">

            <h3>
                Columbia Suicide Severity Rating Scale
            </h3>

            <small>
                Please answer all questions honestly.
            </small>

        </div>

        <div class="card-body">

            <div class="alert alert-warning">

                Your responses will remain confidential and may be
                reviewed by authorised university personnel.

            </div>

            <form asp-controller="Student"
                  asp-action="CSRRS"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger">
                </div>

                <div class="table-responsive">

                    <table class="table table-bordered table-hover">

                        <thead class="table-danger">

                            <tr>

                                <th width="70%">
                                    Question
                                </th>

                                <th class="text-center">
                                    Yes
                                </th>

                                <th class="text-center">
                                    No
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            <!-- Question 1 -->

                            <tr>

                                <td>

                                    <strong>Question 1</strong>

                                    <br>

                                    <small class="text-muted">
                                        Have you wished you were dead or
                                        wished you could go to sleep and not wake up?
                                    </small>

                                    <br>

                                    <span asp-validation-for="Question1Answer"
                                          class="text-danger">
                                    </span>

                                </td>

                                <td class="text-center">

                                    <input asp-for="Question1Answer"
                                           type="radio"
                                           value="true"
                                           class="form-check-input">

                                </td>

                                <td class="text-center">

                                    <input asp-for="Question1Answer"
                                           type="radio"
                                           value="false"
                                           class="form-check-input">

                                </td>

                            </tr>

                            <!-- Question 2 -->

                            <tr>

                                <td>

                                    <strong>Question 2</strong>

                                    <br>

                                    <small class="text-muted">
                                        Have you had thoughts of killing yourself?
                                    </small>

                                    <br>

                                    <span asp-validation-for="Question2Answer"
                                          class="text-danger">
                                    </span>

                                </td>

                                <td class="text-center">

                                    <input asp-for="Question2Answer"
                                           type="radio"
                                           value="true"
                                           class="form-check-input">

                                </td>

                                <td class="text-center">

                                    <input asp-for="Question2Answer"
                                           type="radio"
                                           value="false"
                                           class="form-check-input">

                                </td>

                            </tr>

                            <!-- Question 3 -->

                            <tr>

                                <td>

                                    <strong>Question 3</strong>

                                    <br>

                                    <small class="text-muted">
                                        Have you been thinking about how
                                        you might do this?
                                    </small>

                                    <br>

                                    <span asp-validation-for="Question3Answer"
                                          class="text-danger">
                                    </span>

                                </td>

                                <td class="text-center">

                                    <input asp-for="Question3Answer"
                                           type="radio"
                                           value="true"
                                           class="form-check-input">

                                </td>

                                <td class="text-center">

                                    <input asp-for="Question3Answer"
                                           type="radio"
                                           value="false"
                                           class="form-check-input">

                                </td>

                            </tr>

                            <!-- Question 4 -->

                            <tr class="table-warning">

                                <td>

                                    <strong>Question 4</strong>

                                    <br>

                                    <small class="text-muted">
                                        Have you had these thoughts and
                                        had some intention of acting on them?
                                    </small>

                                    <br>

                                    <span asp-validation-for="Question4Answer"
                                          class="text-danger">
                                    </span>

                                </td>

                                <td class="text-center">

                                    <input asp-for="Question4Answer"
                                           type="radio"
                                           value="true"
                                           class="form-check-input">

                                </td>

                                <td class="text-center">

                                    <input asp-for="Question4Answer"
                                           type="radio"
                                           value="false"
                                           class="form-check-input">

                                </td>

                            </tr>

                            <!-- Question 5 -->

                            <tr class="table-warning">

                                <td>

                                    <strong>Question 5</strong>

                                    <br>

                                    <small class="text-muted">
                                        Have you started to work out the
                                        details of how to kill yourself?
                                    </small>

                                    <br>

                                    <span asp-validation-for="Question5Answer"
                                          class="text-danger">
                                    </span>

                                </td>

                                <td class="text-center">

                                    <input asp-for="Question5Answer"
                                           type="radio"
                                           value="true"
                                           class="form-check-input">

                                </td>

                                <td class="text-center">

                                    <input asp-for="Question5Answer"
                                           type="radio"
                                           value="false"
                                           class="form-check-input">

                                </td>

                            </tr>

                            <!-- Question 6 -->

                            <tr class="table-danger">

                                <td>

                                    <strong>Question 6</strong>

                                    <br>

                                    <small class="text-muted">
                                        Have you ever done anything,
                                        started to do anything, or prepared
                                        to do anything to end your life?
                                    </small>

                                    <br>

                                    <span asp-validation-for="Question6Answer"
                                          class="text-danger">
                                    </span>

                                </td>

                                <td class="text-center">

                                    <input asp-for="Question6Answer"
                                           type="radio"
                                           value="true"
                                           class="form-check-input">

                                </td>

                                <td class="text-center">

                                    <input asp-for="Question6Answer"
                                           type="radio"
                                           value="false"
                                           class="form-check-input">

                                </td>

                            </tr>

                        </tbody>

                    </table>

                </div>

                <div class="card mt-4">

                    <div class="card-body">

                        <label class="form-label">

                            If Question 6 is Yes, did this happen
                            within the past three months?

                        </label>

                        <div>

                            <input asp-for="RecentBehavior"
                                   type="radio"
                                   value="true"
                                   class="form-check-input">

                            <label class="me-4">
                                Yes
                            </label>

                            <input asp-for="RecentBehavior"
                                   type="radio"
                                   value="false"
                                   class="form-check-input">

                            <label>
                                No
                            </label>

                        </div>

                    </div>

                </div>

                <div class="mt-4">

                    <label asp-for="AdditionalInformation"
                           class="form-label">

                        Additional Information (Optional)

                    </label>

                    <textarea asp-for="AdditionalInformation"
                              class="form-control"
                              rows="5"
                              placeholder="Write any additional information..."></textarea>

                    <span asp-validation-for="AdditionalInformation"
                          class="text-danger">
                    </span>

                </div>

                <div class="text-end mt-4">

                    <a asp-controller="Student"
                       asp-action="Dashboard"
                       class="btn btn-secondary">

                        Back to Dashboard

                    </a>

                    <button type="submit"
                            class="btn btn-danger">

                        Submit Assessment

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}