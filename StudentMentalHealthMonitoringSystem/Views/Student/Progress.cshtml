@{
    ViewData["Title"] = "Student Registration";
}

<div class="container my-5">

    <div class="card shadow-lg border-0">

        <div class="card-header bg-success text-white text-center py-3">
            <h2>Student Registration Form</h2>
        </div>

        <div class="card-body">

            <form>

                <h4 class="text-primary mb-3">Basic Information</h4>

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label>Student ID</label>
                        <input class="form-control" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label>Full Name</label>
                        <input class="form-control" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label>Email</label>
                        <input type="email" class="form-control" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label>Password</label>
                        <input type="password" class="form-control" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label>Phone</label>
                        <input class="form-control" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label>Date of Birth</label>
                        <input type="date" class="form-control" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label>Gender</label>
                        <select class="form-select">
                            <option>Male</option>
                            <option>Female</option>
                            <option>Other</option>
                        </select>
                    </div>

                </div>

                <hr>

                <h4 class="text-primary mb-3">Academic Information</h4>

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label>Department</label>
                        <input class="form-control" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label>Current Semester</label>
                        <select class="form-select">
                            <option>Semester 1</option>
                            <option>Semester 2</option>
                            <option>Semester 3</option>
                            <option>Semester 4</option>
                            <option>Semester 5</option>
                            <option>Semester 6</option>
                            <option>Semester 7</option>
                            <option>Semester 8</option>
                            <option>Semester 9</option>
                            <option>Semester 10</option>
                            <option>Semester 11</option>
                            <option>Semester 12</option>
                        </select>
                    </div>

                </div>

                <hr>

                <h4 class="text-primary mb-3">Physical Information</h4>

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label>Height (cm)</label>
                        <input class="form-control" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label>Weight (kg)</label>
                        <input class="form-control" />
                    </div>

                </div>

                <hr>

                <h4 class="text-primary mb-3">Financial Condition</h4>

                <div class="mb-3">

                    <select class="form-select">

                        <option>Excellent</option>
                        <option>Good</option>
                        <option>Average</option>
                        <option>Poor</option>

                    </select>

                </div>

                <hr>

                <h4 class="text-primary mb-3">Guardian Information</h4>

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label>Guardian Name</label>
                        <input class="form-control" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label>Relationship</label>
                        <input class="form-control" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label>Guardian Phone</label>
                        <input class="form-control" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label>Guardian Email</label>
                        <input class="form-control" />
                    </div>

                </div>

                <div class="form-check mt-4">

                    <input class="form-check-input" type="checkbox">

                    <label class="form-check-label">

                        I agree with the university mental health policy.

                    </label>

                </div>

                <button class="btn btn-success mt-4 w-100">

                    Register

                </button>

            </form>

        </div>

    </div>

</div>