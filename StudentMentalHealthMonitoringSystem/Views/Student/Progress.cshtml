@model List<StudentMentalHealthMonitoringSystem.ViewModels.StudentProgressReportDetailViewModel>

@{
    Layout = "_Layout";
    ViewData["Title"] = "My Counseling Progress Report";
}

<div class="container py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-1">
                <i class="bi bi-graph-up-arrow me-2 text-primary"></i>
                My Counseling Progress & Recovery Report
            </h3>
            <p class="text-muted mb-0">
                Track your mental health counseling journey, threshold scores, session-by-session improvement, and overall recovery line graph.
            </p>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        @foreach (var report in Model)
        {
            <!-- Report Card Container -->
            <div class="card border-0 shadow-sm rounded-4 mb-5 bg-white overflow-hidden">
                
                <!-- Report Header Bar -->
                <div class="card-header bg-light border-0 p-4">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                        <div>
                            <div class="badge bg-primary rounded-pill px-3 py-2 mb-2">
                                <i class="bi bi-person-badge me-1"></i> Counseling Case Report
                            </div>
                            <h4 class="fw-bold text-dark mb-1">Assigned Psychologist: @report.PsychologistName</h4>
                            <small class="text-muted">
                                Active Period: <strong>@report.FirstSessionDate.ToString("MMM dd, yyyy")</strong> to <strong>@report.LatestSessionDate.ToString("MMM dd, yyyy")</strong>
                            </small>
                        </div>
                        <div>
                            @if (report.IsFinal)
                            {
                                <span class="badge bg-success-subtle text-success border border-success fs-6 px-4 py-2 rounded-pill">
                                    <i class="bi bi-check-circle-fill me-1"></i> Follow-up Completed
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning-subtle text-warning border border-warning fs-6 px-4 py-2 rounded-pill">
                                    <i class="bi bi-arrow-repeat me-1"></i> Continuous Follow-up (In Progress)
                                </span>
                            }
                        </div>
                    </div>
                </div>

                <div class="card-body p-4">
                    <!-- Metrics Cards -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-3">
                            <div class="card border-0 bg-light rounded-4 h-100">
                                <div class="card-body p-3 text-center">
                                    <div class="text-muted small fw-bold text-uppercase mb-1">Total Sessions</div>
                                    <h3 class="fw-bold text-dark mb-0">@report.TotalSessions</h3>
                                    <small class="text-muted">Completed Sessions</small>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="card border-0 bg-light rounded-4 h-100">
                                <div class="card-body p-3 text-center">
                                    <div class="text-muted small fw-bold text-uppercase mb-1">Initial Baseline Score</div>
                                    <h3 class="fw-bold text-secondary mb-0">@report.InitialScore / 100</h3>
                                    <small class="text-muted">Session 1 Evaluation</small>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="card border-0 bg-light rounded-4 h-100">
                                <div class="card-body p-3 text-center">
                                    <div class="text-muted small fw-bold text-uppercase mb-1">Current Recovery Score</div>
                                    <h3 class="fw-bold text-primary mb-0">@report.LatestScore / 100</h3>
                                    <small class="text-muted">Score Diff: <strong>@(report.ScoreDifference >= 0 ? "+" + report.ScoreDifference : report.ScoreDifference.ToString())</strong> pts</small>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="card border-0 bg-light rounded-4 h-100">
                                <div class="card-body p-3 text-center">
                                    <div class="text-muted small fw-bold text-uppercase mb-1">Overall Recovery Status</div>
                                    <div class="mt-2">
                                        @if (report.OverallImprovementStatus == "Improved")
                                        {
                                            <span class="badge bg-success fs-6 px-4 py-2 rounded-pill">
                                                <i class="bi bi-arrow-up-right-circle me-1"></i> Improved
                                            </span>
                                        }
                                        else if (report.OverallImprovementStatus == "Deteriorated")
                                        {
                                            <span class="badge bg-danger fs-6 px-4 py-2 rounded-pill">
                                                <i class="bi bi-arrow-down-right-circle me-1"></i> Needs Attention
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark fs-6 px-4 py-2 rounded-pill">
                                                <i class="bi bi-dash-circle me-1"></i> Stable Progress
                                            </span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Line Chart: Student Progress Trajectory -->
                    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
                        <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0">
                            <h5 class="fw-bold text-dark mb-0">
                                <i class="bi bi-activity me-2 text-primary"></i>
                                Recovery & Progress Trajectory Line Graph
                            </h5>
                            <small class="text-muted">Your recovery score trajectory across follow-up counseling sessions (X-axis: Sessions, Y-axis: Score 0-100)</small>
                        </div>
                        <div class="card-body p-4" style="min-height: 340px;">
                            <canvas id="studentLineChart_@report.ObservationReportId" style="max-height: 300px;"></canvas>
                        </div>
                    </div>

                    <!-- Session-by-Session Follow-up Table with Key Observation Info -->
                    <div class="card border-0 shadow-sm rounded-4 bg-white mb-4">
                        <div class="card-header bg-transparent border-0 pt-4 px-4 pb-2">
                            <h5 class="fw-bold text-dark mb-0">
                                <i class="bi bi-journal-check me-2 text-primary"></i>
                                Follow-up Sessions & Observation Key Details
                            </h5>
                            <small class="text-muted">Session-by-session observation stages, mental health status, functional domains, and progress indicators</small>
                        </div>
                        <div class="card-body p-4">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Follow-up Session</th>
                                            <th>Date & Time</th>
                                            <th class="text-center">Mental Health</th>
                                            <th class="text-center">Safety Risk</th>
                                            <th>Functional Domains (5 Areas)</th>
                                            <th class="text-center">Score</th>
                                            <th class="text-center">Progress</th>
                                            <th>Clinical Observation</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var s in report.Sessions)
                                        {
                                            <tr>
                                                <td class="fw-bold text-primary">
                                                    @(s.SessionNumber == 1 ? "Session 1 (Intake)" : $"Follow-up {s.SessionNumber - 1}")
                                                </td>
                                                <td>
                                                    <div class="fw-semibold text-dark">@s.SessionDate.ToString("MMM dd, yyyy")</div>
                                                    <small class="text-muted">@s.CounselingTime</small>
                                                </td>
                                                <td class="text-center"><span class="badge bg-light text-dark border">@s.MentalHealthStatus</span></td>
                                                <td class="text-center"><span class="badge bg-light text-dark border">@s.SafetyRisk</span></td>
                                                <td class="small">
                                                    <div class="d-flex flex-wrap gap-1">
                                                        <span class="badge bg-light text-secondary border">Academic: @s.AcademicFunctioning</span>
                                                        <span class="badge bg-light text-secondary border">Sleep: @s.SleepCondition</span>
                                                        <span class="badge bg-light text-secondary border">Social: @s.SocialInteraction</span>
                                                        <span class="badge bg-light text-secondary border">Daily: @s.DailyActivities</span>
                                                        <span class="badge bg-light text-secondary border">Emotion: @s.EmotionalRegulation</span>
                                                    </div>
                                                </td>
                                                <td class="text-center fs-6 fw-bold text-primary">@s.SessionScore / 100</td>
                                                <td class="text-center">
                                                    @if (s.SessionImprovementStatus == "Improved")
                                                    {
                                                        <span class="badge bg-success rounded-pill px-3">
                                                            <i class="bi bi-arrow-up-right me-1"></i> Improved
                                                        </span>
                                                    }
                                                    else if (s.SessionImprovementStatus == "Deteriorated")
                                                    {
                                                        <span class="badge bg-danger rounded-pill px-3">
                                                            <i class="bi bi-arrow-down-right me-1"></i> Deteriorated
                                                        </span>
                                                    }
                                                    else if (s.SessionImprovementStatus == "Stable")
                                                    {
                                                        <span class="badge bg-info text-dark rounded-pill px-3">
                                                            <i class="bi bi-dash me-1"></i> Stable
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary rounded-pill px-3">Baseline</span>
                                                    }
                                                </td>
                                                <td class="small text-secondary" style="max-width: 250px;">
                                                    @(string.IsNullOrEmpty(s.ClinicalObservation) ? "Session completed successfully." : s.ClinicalObservation)
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- Final Overall Report: Initial vs Final Condition Summary -->
                    @{
                        var firstSession = report.Sessions.FirstOrDefault();
                        var lastSession = report.Sessions.LastOrDefault();
                    }
                    @if (firstSession != null && lastSession != null)
                    {
                        <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
                            <div class="card-header bg-dark text-white p-3">
                                <h5 class="fw-bold mb-0">
                                    <i class="bi bi-file-earmark-check-fill me-2 text-warning"></i>
                                    Final Overall Screening &amp; Observation Report
                                </h5>
                                <small class="text-white-50">Comparative evaluation between Initial Intake Condition and Final Follow-up Outcome</small>
                            </div>
                            <div class="card-body p-4">
                                <div class="row g-4">
                                    <div class="col-md-6 border-end">
                                        <div class="p-3 rounded-4 bg-light h-100">
                                            <div class="d-flex align-items-center justify-content-between mb-3">
                                                <span class="badge bg-secondary px-3 py-2 rounded-pill fs-6">Initial Condition (Baseline)</span>
                                                <span class="fw-bold text-muted">@firstSession.SessionDate.ToString("MMM dd, yyyy")</span>
                                            </div>
                                            <ul class="list-group list-group-flush bg-transparent">
                                                <li class="list-group-item bg-transparent px-0 d-flex justify-content-between">
                                                    <span class="text-muted">Mental Health Status:</span>
                                                    <strong class="text-danger">@firstSession.MentalHealthStatus</strong>
                                                </li>
                                                <li class="list-group-item bg-transparent px-0 d-flex justify-content-between">
                                                    <span class="text-muted">Current Safety Risk:</span>
                                                    <strong class="text-dark">@firstSession.SafetyRisk</strong>
                                                </li>
                                                <li class="list-group-item bg-transparent px-0 d-flex justify-content-between">
                                                    <span class="text-muted">Academic Functioning:</span>
                                                    <span>@firstSession.AcademicFunctioning</span>
                                                </li>
                                                <li class="list-group-item bg-transparent px-0 d-flex justify-content-between">
                                                    <span class="text-muted">Sleep & Emotion:</span>
                                                    <span>@firstSession.SleepCondition | @firstSession.EmotionalRegulation</span>
                                                </li>
                                                <li class="list-group-item bg-transparent px-0 d-flex justify-content-between">
                                                    <span class="text-muted">Initial Baseline Score:</span>
                                                    <span class="fw-bold fs-5 text-secondary">@firstSession.SessionScore / 100</span>
                                                </li>
                                            </ul>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="p-3 rounded-4 bg-light h-100">
                                            <div class="d-flex align-items-center justify-content-between mb-3">
                                                <span class="badge bg-success px-3 py-2 rounded-pill fs-6">
                                                    @(report.IsFinal ? "Final Discharged Condition" : "Latest Follow-up Condition")
                                                </span>
                                                <span class="fw-bold text-muted">@lastSession.SessionDate.ToString("MMM dd, yyyy")</span>
                                            </div>
                                            <ul class="list-group list-group-flush bg-transparent">
                                                <li class="list-group-item bg-transparent px-0 d-flex justify-content-between">
                                                    <span class="text-muted">Mental Health Status:</span>
                                                    <strong class="text-success">@lastSession.MentalHealthStatus</strong>
                                                </li>
                                                <li class="list-group-item bg-transparent px-0 d-flex justify-content-between">
                                                    <span class="text-muted">Current Safety Risk:</span>
                                                    <strong class="text-success">@lastSession.SafetyRisk</strong>
                                                </li>
                                                <li class="list-group-item bg-transparent px-0 d-flex justify-content-between">
                                                    <span class="text-muted">Academic Functioning:</span>
                                                    <span>@lastSession.AcademicFunctioning</span>
                                                </li>
                                                <li class="list-group-item bg-transparent px-0 d-flex justify-content-between">
                                                    <span class="text-muted">Sleep & Emotion:</span>
                                                    <span>@lastSession.SleepCondition | @lastSession.EmotionalRegulation</span>
                                                </li>
                                                <li class="list-group-item bg-transparent px-0 d-flex justify-content-between">
                                                    <span class="text-muted">Final Recovery Score:</span>
                                                    <span class="fw-bold fs-5 text-success">@lastSession.SessionScore / 100</span>
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>

                                <div class="mt-4 p-3 rounded-3 bg-light text-center">
                                    <div class="d-flex justify-content-around flex-wrap gap-3 align-items-center">
                                        <div>
                                            <span class="text-muted small d-block">Overall Outcome</span>
                                            <span class="badge bg-success fs-6 px-4 py-2 rounded-pill">
                                                <i class="bi bi-check-circle-fill me-1"></i> @report.OverallImprovementStatus (@(report.ScoreDifference >= 0 ? "+" + report.ScoreDifference : report.ScoreDifference.ToString()) pts)
                                            </span>
                                        </div>
                                        <div>
                                            <span class="text-muted small d-block">Case Status</span>
                                            <strong class="text-dark">@report.FollowUpStatusText</strong>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white">
            <div class="py-4">
                <i class="bi bi-journal-text fs-1 text-muted mb-3 d-block"></i>
                <h4 class="fw-bold text-dark">No Follow-up Progress Reports Found</h4>
                <p class="text-muted max-w-md mx-auto">
                    You currently have no recorded counseling follow-up observation reports. Progress tracking reports are automatically updated as you attend counseling sessions with your psychologist.
                </p>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            @if (Model != null)
            {
                foreach (var report in Model)
                {
                    <text>
                        (function() {
                            const sessionLabels = [
                                @Html.Raw(string.Join(",", report.Sessions.Select(s => $"'Session {s.SessionNumber} ({s.SessionDate:MMM dd})'")))
                            ];

                            const scoresData = [@string.Join(",", report.Sessions.Select(s => s.SessionScore))];

                            const ctx = document.getElementById('studentLineChart_@report.ObservationReportId').getContext('2d');
                            new Chart(ctx, {
                                type: 'line',
                                data: {
                                    labels: sessionLabels,
                                    datasets: [{
                                        label: 'My Recovery Progress Score',
                                        data: scoresData,
                                        fill: false,
                                        borderColor: '#a53838',
                                        borderWidth: 3,
                                        pointStyle: 'rect',
                                        pointRadius: 9,
                                        pointHoverRadius: 12,
                                        pointBackgroundColor: '#a53838',
                                        pointBorderColor: '#7a1f1f',
                                        pointBorderWidth: 2,
                                        tension: 0
                                    }]
                                },
                                options: {
                                    responsive: true,
                                    maintainAspectRatio: false,
                                    scales: {
                                        x: {
                                            grid: { display: true, color: '#e2e8f0' },
                                            ticks: { font: { size: 13, weight: 'bold' }, color: '#1e293b' },
                                            title: { display: true, text: 'Follow-up Sessions (Time / Date)', font: { size: 14, weight: 'bold' }, color: '#0f172a' }
                                        },
                                        y: {
                                            min: 0,
                                            max: 100,
                                            ticks: {
                                                stepSize: 20,
                                                font: { size: 13, weight: 'bold' },
                                                color: '#1e293b',
                                                callback: function(value) { return value + ' pts'; }
                                            },
                                            grid: { color: '#cbd5e1' },
                                            title: { display: true, text: 'Scoring Scale (0 - 100)', font: { size: 14, weight: 'bold' }, color: '#0f172a' }
                                        }
                                    },
                                    plugins: {
                                        legend: {
                                            position: 'top',
                                            labels: {
                                                font: { size: 14, weight: 'bold' },
                                                color: '#0f172a',
                                                usePointStyle: true,
                                                pointStyle: 'rect'
                                            }
                                        },
                                        tooltip: {
                                            callbacks: {
                                                label: function (ctx) {
                                                    return ` Progress Score: ${ctx.raw} / 100`;
                                                }
                                            }
                                        }
                                    }
                                }
                            });
                        })();
                    </text>
                }
            }
        });
    </script>
}