@model StudentMentalHealthMonitoringSystem.Models.PHQAssessment

@{
    ViewData["Title"] = "PHQ-9 Assessment";
}

<style>
    .student-app-bg {
        background: #F8FAFC;
        min-height: 100vh;
        padding-bottom: 2rem;
    }

    .glass-card {
        background: #ffffff;
        border: 1px solid #E2E8F0;
        border-radius: 1.25rem;
        box-shadow: 0 4px 20px rgba(15, 23, 42, 0.05);
    }

    .student-sidebar .list-group-item {
        border: none;
        border-radius: 0.75rem;
        margin-bottom: 0.35rem;
        padding: 0.8rem 1.1rem;
        font-weight: 600;
        font-size: 0.95rem;
        color: #1E293B;
        transition: all 0.2s ease;
        display: flex;
        align-items: center;
        gap: 0.85rem;
    }

    .student-sidebar .list-group-item i {
        font-size: 1.25rem;
        color: #2563EB;
        width: 26px;
        text-align: center;
    }

    .student-sidebar .list-group-item:hover {
        background: #EFF6FF;
        color: #1E3A8A;
        transform: translateX(4px);
    }

    .student-sidebar .list-group-item.active {
        background: linear-gradient(135deg, #1E3A8A 0%, #2563EB 100%);
        color: #ffffff;
        box-shadow: 0 4px 14px rgba(37, 99, 235, 0.35);
    }

    .student-sidebar .list-group-item.active i {
        color: #ffffff;
    }

    .phq-table th {
        background-color: #F4EEE8;
        color: #5F5146;
        font-weight: 600;
    }

    .phq-table td {
        vertical-align: middle;
    }
</style>

<div class="student-app-bg py-3">
    <div class="container-fluid">
        <div class="row g-4">

            <!-- Sidebar Navigation -->
            <div class="col-lg-3">
                <div class="glass-card p-4 text-center student-sidebar">
                    <div class="position-relative d-inline-block mb-3">
                        <img src="https://ui-avatars.com/api/?name=Student&background=8A7563&color=fff&size=110" class="rounded-circle shadow-sm border border-3 border-white" width="110" height="110" alt="Avatar" />
                    </div>

                    <h5 class="fw-bold mb-1" style="color: #5F5146;">Student Portal</h5>
                    <p class="text-muted small mb-3"><i class="bi bi-shield-check me-1"></i>Mental Health Monitoring</p>
                    
                    <hr class="my-3 opacity-25" />

                    <div class="list-group list-group-flush text-start">
                        <a href="/Student/Dashboard" class="list-group-item">
                            <i class="bi bi-speedometer2"></i> Dashboard
                        </a>
                        <a href="/Student/Profile" class="list-group-item">
                            <i class="bi bi-person-badge"></i> My Profile
                        </a>
                        <a href="/Student/SemesterScreening" class="list-group-item">
                            <i class="bi bi-journal-check"></i> Semester Screening
                        </a>
                        <a href="/Student/PHQ" class="list-group-item active">
                            <i class="bi bi-clipboard-pulse"></i> PHQ-9 Assessment
                        </a>
                        <a href="/Student/CSRRS" class="list-group-item">
                            <i class="bi bi-shield-check"></i> C-SSRS Assessment
                        </a>
                        <a href="/Student/Feelings" class="list-group-item">
                            <i class="bi bi-emoji-smile"></i> Daily Feelings
                        </a>
                        <a href="/Student/AIChat" class="list-group-item">
                            <i class="bi bi-robot"></i> AI Companion Chat
                        </a>
                        <a href="/VoiceBot/Index" class="list-group-item">
                            <i class="bi bi-mic"></i> Live Voice Bot
                        </a>
                        <a href="/Student/Appointment" class="list-group-item">
                            <i class="bi bi-calendar-event"></i> Counseling Session
                        </a>
                        <a href="/Student/History" class="list-group-item">
                            <i class="bi bi-clock-history"></i> History Records
                        </a>
                        <a href="/Student/Progress" class="list-group-item">
                            <i class="bi bi-graph-up-arrow"></i> Recovery Progress
                        </a>
                        <a href="/Student/Reports" class="list-group-item">
                            <i class="bi bi-file-earmark-medical"></i> Official Reports
                        </a>
                    </div>
                </div>
            </div>

            <!-- Main Content Area -->
            <div class="col-lg-9">

                <!-- Header Banner -->
                <div class="glass-card p-4 mb-4" style="background: linear-gradient(135deg, #1E3A8A 0%, #2563EB 100%); color: #ffffff;">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                        <div>
                            <h2 class="fw-bold mb-1 text-white">
                                <i class="bi bi-clipboard-pulse me-2"></i>PHQ-9 Depression Screening
                            </h2>
                            <p class="text-white-50 fs-6 mb-0">Please answer how often you have been bothered by the following over the last 2 weeks.</p>
                        </div>
                        <a href="/Student/SemesterScreening" class="btn btn-light text-primary btn-lg rounded-3 px-4 py-2 fw-bold shadow-sm">
                            <i class="bi bi-arrow-left me-1"></i> Screening Modules
                        </a>
                    </div>
                </div>

                <div class="glass-card p-4">
                    <div class="alert alert-info border-0 shadow-sm rounded-3 mb-4">
                        <i class="bi bi-info-circle-fill me-2"></i><strong>Instruction:</strong> Please select one option for every question from 0 (Not at all) to 3 (Nearly every day).
                    </div>

                    <form asp-controller="Student" asp-action="PHQ" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 rounded-3 mb-3"></div>

                        <div class="table-responsive">
                            <table class="table table-bordered align-middle phq-table mb-4">
                                <thead>
                                    <tr>
                                        <th style="width: 45%;">Question</th>
                                        <th class="text-center">Not at all<br><small class="text-muted">(0)</small></th>
                                        <th class="text-center">Several days<br><small class="text-muted">(1)</small></th>
                                        <th class="text-center">More than half<br><small class="text-muted">(2)</small></th>
                                        <th class="text-center">Nearly every day<br><small class="text-muted">(3)</small></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <!-- Q1 -->
                                    <tr>
                                        <td>
                                            <strong class="text-dark">1. Little interest or pleasure in doing things.</strong>
                                            <span asp-validation-for="Question1Score" class="text-danger d-block small"></span>
                                        </td>
                                        <td class="text-center"><input asp-for="Question1Score" type="radio" value="0" class="form-check-input" /></td>
                                        <td class="text-center"><input asp-for="Question1Score" type="radio" value="1" class="form-check-input" /></td>
                                        <td class="text-center"><input asp-for="Question1Score" type="radio" value="2" class="form-check-input" /></td>
                                        <td class="text-center"><input asp-for="Question1Score" type="radio" value="3" class="form-check-input" /></td>
                                    </tr>
                                    <!-- Q2 -->
                                    <tr>
                                        <td>
                                            <strong class="text-dark">2. Feeling down, depressed, or hopeless.</strong>
                                            <span asp-validation-for="Question2Score" class="text-danger d-block small"></span>
                                        </td>
                                        <td class="text-center"><input asp-for="Question2Score" type="radio" value="0" class="form-check-input" /></td>
                                        <td class="text-center"><input asp-for="Question2Score" type="radio" value="1" class="form-check-input" /></td>
                                        <td class="text-center"><input asp-for="Question2Score" type="radio" value="2" class="form-check-input" /></td>
                                        <td class="text-center"><input asp-for="Question2Score" type="radio" value="3" class="form-check-input" /></td>
                                    </tr>
                                    <!-- Q3 -->
                                    <tr>
                                        <td>
                                            <strong class="text-dark">3. Trouble falling or staying asleep, or sleeping too much.</strong>
                                            <span asp-validation-for="Question3Score" class="text-danger d-block small"></span>
                                        </td>
                                        <td class="text-center"><input asp-for="Question3Score" type="radio" value="0" class="form-check-input" /></td>
                                        <td class="text-center"><input asp-for="Question3Score" type="radio" value="1" class="form-check-input" /></td>
                                        <td class="text-center"><input asp-for="Question3Score" type="radio" value="2" class="form-check-input" /></td>
                                        <td class="text-center"><input asp-for="Question3Score" type="radio" value="3" class="form-check-input" /></td>
                                    </tr>
                                    <!-- Q4 -->
                                    <tr>
                                        <td>
                                            <strong class="text-dark">4. Feeling tired or having little energy.</strong>
                                            <span asp-validation-for="Question4Score" class="text-danger d-block small"></span>
                                        </td>
                                        <td class="text-center"><input asp-for="Question4Score" type="radio" value="0" class="form-check-input" /></td>
                                        <td class="text-center"><input asp-for="Question4Score" type="radio" value="1" class="form-check-input" /></td>
                                        <td class="text-center"><input asp-for="Question4Score" type="radio" value="2" class="form-check-input" /></td>
                                        <td class="text-center"><input asp-for="Question4Score" type="radio" value="3" class="form-check-input" /></td>
                                    </tr>
                                    <!-- Q5 -->
                                    <tr>
                                        <td>
                                            <strong class="text-dark">5. Poor appetite or overeating.</strong>
                                            <span asp-validation-for="Question5Score" class="text-danger d-block small"></span>
                                        </td>
                                        <td class="text-center"><input asp-for="Question5Score" type="radio" value="0" class="form-check-input" /></td>
                                        <td class="text-center"><input asp-for="Question5Score" type="radio" value="1" class="form-check-input" /></td>
                                        <td class="text-center"><input asp-for="Question5Score" type="radio" value="2" class="form-check-input" /></td>
                                        <td class="text-center"><input asp-for="Question5Score" type="radio" value="3" class="form-check-input" /></td>
                                    </tr>
                                    <!-- Q6 -->
                                    <tr>
                                        <td>
                                            <strong class="text-dark">6. Feeling bad about yourself — or that you are a failure or have let yourself or your family down.</strong>
                                            <span asp-validation-for="Question6Score" class="text-danger d-block small"></span>
                                        </td>
                                        <td class="text-center"><input asp-for="Question6Score" type="radio" value="0" class="form-check-input" /></td>
                                        <td class="text-center"><input asp-for="Question6Score" type="radio" value="1" class="form-check-input" /></td>
                                        <td class="text-center"><input asp-for="Question6Score" type="radio" value="2" class="form-check-input" /></td>
                                        <td class="text-center"><input asp-for="Question6Score" type="radio" value="3" class="form-check-input" /></td>
                                    </tr>
                                    <!-- Q7 -->
                                    <tr>
                                        <td>
                                            <strong class="text-dark">7. Trouble concentrating on things, such as reading the newspaper or watching television.</strong>
                                            <span asp-validation-for="Question7Score" class="text-danger d-block small"></span>
                                        </td>
                                        <td class="text-center"><input asp-for="Question7Score" type="radio" value="0" class="form-check-input" /></td>
                                        <td class="text-center"><input asp-for="Question7Score" type="radio" value="1" class="form-check-input" /></td>
                                        <td class="text-center"><input asp-for="Question7Score" type="radio" value="2" class="form-check-input" /></td>
                                        <td class="text-center"><input asp-for="Question7Score" type="radio" value="3" class="form-check-input" /></td>
                                    </tr>
                                    <!-- Q8 -->
                                    <tr>
                                        <td>
                                            <strong class="text-dark">8. Moving or speaking so slowly that other people could have noticed? Or being fidgety or restless.</strong>
                                            <span asp-validation-for="Question8Score" class="text-danger d-block small"></span>
                                        </td>
                                        <td class="text-center"><input asp-for="Question8Score" type="radio" value="0" class="form-check-input" /></td>
                                        <td class="text-center"><input asp-for="Question8Score" type="radio" value="1" class="form-check-input" /></td>
                                        <td class="text-center"><input asp-for="Question8Score" type="radio" value="2" class="form-check-input" /></td>
                                        <td class="text-center"><input asp-for="Question8Score" type="radio" value="3" class="form-check-input" /></td>
                                    </tr>
                                    <!-- Q9 -->
                                    <tr>
                                        <td>
                                            <strong class="text-dark">9. Thoughts that you would be better off dead, or of hurting yourself in some way.</strong>
                                            <span asp-validation-for="Question9Score" class="text-danger d-block small"></span>
                                        </td>
                                        <td class="text-center"><input asp-for="Question9Score" type="radio" value="0" class="form-check-input" /></td>
                                        <td class="text-center"><input asp-for="Question9Score" type="radio" value="1" class="form-check-input" /></td>
                                        <td class="text-center"><input asp-for="Question9Score" type="radio" value="2" class="form-check-input" /></td>
                                        <td class="text-center"><input asp-for="Question9Score" type="radio" value="3" class="form-check-input" /></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <div class="mb-4">
                            <label asp-for="FunctionalDifficulty" class="form-label fw-bold text-dark">
                                If you checked off any problems, how difficult have these problems made it for you to do your work, take care of things at home, or get along with other people?
                            </label>
                            <select asp-for="FunctionalDifficulty" class="form-select rounded-3">
                                <option value="Not difficult at all">Not difficult at all</option>
                                <option value="Somewhat difficult">Somewhat difficult</option>
                                <option value="Very difficult">Very difficult</option>
                                <option value="Extremely difficult">Extremely difficult</option>
                            </select>
                        </div>

                        <div class="mb-4">
                            <label asp-for="AdditionalComments" class="form-label fw-bold text-dark">
                                Additional Comments (Optional)
                            </label>
                            <textarea asp-for="AdditionalComments" class="form-control rounded-3" rows="4" placeholder="Write anything you would like to share..."></textarea>
                        </div>

                        <div class="d-flex justify-content-between align-items-center">
                            <a href="/Student/Dashboard" class="btn border bg-white text-dark rounded-3 px-4 py-2">
                                <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
                            </a>
                            <button type="submit" class="btn btn-primary btn-lg rounded-3 px-4 py-2.5 shadow-sm fw-bold text-white">
                                <i class="bi bi-send-fill me-1"></i> Submit PHQ-9 Assessment
                            </button>
                        </div>
                    </form>
                </div>

            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}