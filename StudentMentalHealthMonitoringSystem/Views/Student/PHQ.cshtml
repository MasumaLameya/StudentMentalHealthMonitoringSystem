@model StudentMentalHealthMonitoringSystem.Models.PHQAssessment

@{
    ViewData["Title"] = "PHQ-9 Assessment";
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header bg-primary text-white">

            <h3>PHQ-9 Depression Screening Questionnaire</h3>

            <small>
                Please answer based on how you have felt during the last two weeks.
            </small>

        </div>

        <div class="card-body">

            <div class="alert alert-info">

                <strong>Instruction:</strong>

                Select one option for every question.

            </div>

            <form asp-controller="Student"
                  asp-action="PHQ"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger">
                </div>

                <div class="table-responsive">

                    <table class="table table-bordered table-hover">

                        <thead class="table-primary">

                            <tr>

                                <th width="45%">Question</th>

                                <th class="text-center">
                                    Not at all
                                </th>

                                <th class="text-center">
                                    Several days
                                </th>

                                <th class="text-center">
                                    More than half the days
                                </th>

                                <th class="text-center">
                                    Nearly every day
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            <!-- Question 1 -->

                            <tr>

                                <td>

                                    <strong>Question 1</strong>

                                    <br>

                                    <small class="text-muted">
                                        Little interest or pleasure in doing things.
                                    </small>

                                    <br>

                                    <span asp-validation-for="Question1Score"
                                          class="text-danger">
                                    </span>

                                </td>

                                <td class="text-center">

                                    <input asp-for="Question1Score"
                                           type="radio"
                                           value="0"
                                           class="form-check-input">

                                </td>

                                <td class="text-center">

                                    <input asp-for="Question1Score"
                                           type="radio"
                                           value="1"
                                           class="form-check-input">

                                </td>

                                <td class="text-center">

                                    <input asp-for="Question1Score"
                                           type="radio"
                                           value="2"
                                           class="form-check-input">

                                </td>

                                <td class="text-center">

                                    <input asp-for="Question1Score"
                                           type="radio"
                                           value="3"
                                           class="form-check-input">

                                </td>

                            </tr>

                            <!-- Question 2 -->

                            <tr>

                                <td>

                                    <strong>Question 2</strong>

                                    <br>

                                    <small class="text-muted">
                                        Feeling down, depressed, or hopeless.
                                    </small>

                                    <br>

                                    <span asp-validation-for="Question2Score"
                                          class="text-danger">
                                    </span>

                                </td>

                                <td class="text-center">
                                    <input asp-for="Question2Score"
                                           type="radio"
                                           value="0"
                                           class="form-check-input">
                                </td>

                                <td class="text-center">
                                    <input asp-for="Question2Score"
                                           type="radio"
                                           value="1"
                                           class="form-check-input">
                                </td>

                                <td class="text-center">
                                    <input asp-for="Question2Score"
                                           type="radio"
                                           value="2"
                                           class="form-check-input">
                                </td>

                                <td class="text-center">
                                    <input asp-for="Question2Score"
                                           type="radio"
                                           value="3"
                                           class="form-check-input">
                                </td>

                            </tr>

                            <!-- Question 3 -->

                            <tr>

                                <td>

                                    <strong>Question 3</strong>

                                    <br>

                                    <small class="text-muted">
                                        Trouble falling or staying asleep, or sleeping too much.
                                    </small>

                                    <br>

                                    <span asp-validation-for="Question3Score"
                                          class="text-danger">
                                    </span>

                                </td>

                                <td class="text-center">
                                    <input asp-for="Question3Score"
                                           type="radio"
                                           value="0"
                                           class="form-check-input">
                                </td>

                                <td class="text-center">
                                    <input asp-for="Question3Score"
                                           type="radio"
                                           value="1"
                                           class="form-check-input">
                                </td>

                                <td class="text-center">
                                    <input asp-for="Question3Score"
                                           type="radio"
                                           value="2"
                                           class="form-check-input">
                                </td>

                                <td class="text-center">
                                    <input asp-for="Question3Score"
                                           type="radio"
                                           value="3"
                                           class="form-check-input">
                                </td>

                            </tr>

                            <!-- Question 4 -->

                            <tr>

                                <td>

                                    <strong>Question 4</strong>

                                    <br>

                                    <small class="text-muted">
                                        Feeling tired or having little energy.
                                    </small>

                                    <br>

                                    <span asp-validation-for="Question4Score"
                                          class="text-danger">
                                    </span>

                                </td>

                                <td class="text-center">
                                    <input asp-for="Question4Score"
                                           type="radio"
                                           value="0"
                                           class="form-check-input">
                                </td>

                                <td class="text-center">
                                    <input asp-for="Question4Score"
                                           type="radio"
                                           value="1"
                                           class="form-check-input">
                                </td>

                                <td class="text-center">
                                    <input asp-for="Question4Score"
                                           type="radio"
                                           value="2"
                                           class="form-check-input">
                                </td>

                                <td class="text-center">
                                    <input asp-for="Question4Score"
                                           type="radio"
                                           value="3"
                                           class="form-check-input">
                                </td>

                            </tr>

                            <!-- Question 5 -->

                            <tr>

                                <td>

                                    <strong>Question 5</strong>

                                    <br>

                                    <small class="text-muted">
                                        Poor appetite or overeating.
                                    </small>

                                    <br>

                                    <span asp-validation-for="Question5Score"
                                          class="text-danger">
                                    </span>

                                </td>

                                <td class="text-center">
                                    <input asp-for="Question5Score"
                                           type="radio"
                                           value="0"
                                           class="form-check-input">
                                </td>

                                <td class="text-center">
                                    <input asp-for="Question5Score"
                                           type="radio"
                                           value="1"
                                           class="form-check-input">
                                </td>

                                <td class="text-center">
                                    <input asp-for="Question5Score"
                                           type="radio"
                                           value="2"
                                           class="form-check-input">
                                </td>

                                <td class="text-center">
                                    <input asp-for="Question5Score"
                                           type="radio"
                                           value="3"
                                           class="form-check-input">
                                </td>

                            </tr>

                            <!-- Question 6 -->

                            <tr>

                                <td>

                                    <strong>Question 6</strong>

                                    <br>

                                    <small class="text-muted">
                                        Feeling bad about yourself, or that you are a failure.
                                    </small>

                                    <br>

                                    <span asp-validation-for="Question6Score"
                                          class="text-danger">
                                    </span>

                                </td>

                                <td class="text-center">
                                    <input asp-for="Question6Score"
                                           type="radio"
                                           value="0"
                                           class="form-check-input">
                                </td>

                                <td class="text-center">
                                    <input asp-for="Question6Score"
                                           type="radio"
                                           value="1"
                                           class="form-check-input">
                                </td>

                                <td class="text-center">
                                    <input asp-for="Question6Score"
                                           type="radio"
                                           value="2"
                                           class="form-check-input">
                                </td>

                                <td class="text-center">
                                    <input asp-for="Question6Score"
                                           type="radio"
                                           value="3"
                                           class="form-check-input">
                                </td>

                            </tr>

                            <!-- Question 7 -->

                            <tr>

                                <td>

                                    <strong>Question 7</strong>

                                    <br>

                                    <small class="text-muted">
                                        Trouble concentrating on study, reading, or other activities.
                                    </small>

                                    <br>

                                    <span asp-validation-for="Question7Score"
                                          class="text-danger">
                                    </span>

                                </td>

                                <td class="text-center">
                                    <input asp-for="Question7Score"
                                           type="radio"
                                           value="0"
                                           class="form-check-input">
                                </td>

                                <td class="text-center">
                                    <input asp-for="Question7Score"
                                           type="radio"
                                           value="1"
                                           class="form-check-input">
                                </td>

                                <td class="text-center">
                                    <input asp-for="Question7Score"
                                           type="radio"
                                           value="2"
                                           class="form-check-input">
                                </td>

                                <td class="text-center">
                                    <input asp-for="Question7Score"
                                           type="radio"
                                           value="3"
                                           class="form-check-input">
                                </td>

                            </tr>

                            <!-- Question 8 -->

                            <tr>

                                <td>

                                    <strong>Question 8</strong>

                                    <br>

                                    <small class="text-muted">
                                        Moving or speaking slowly, or feeling unusually restless.
                                    </small>

                                    <br>

                                    <span asp-validation-for="Question8Score"
                                          class="text-danger">
                                    </span>

                                </td>

                                <td class="text-center">
                                    <input asp-for="Question8Score"
                                           type="radio"
                                           value="0"
                                           class="form-check-input">
                                </td>

                                <td class="text-center">
                                    <input asp-for="Question8Score"
                                           type="radio"
                                           value="1"
                                           class="form-check-input">
                                </td>

                                <td class="text-center">
                                    <input asp-for="Question8Score"
                                           type="radio"
                                           value="2"
                                           class="form-check-input">
                                </td>

                                <td class="text-center">
                                    <input asp-for="Question8Score"
                                           type="radio"
                                           value="3"
                                           class="form-check-input">
                                </td>

                            </tr>

                            <!-- Question 9 -->

                            <tr class="table-warning">

                                <td>

                                    <strong>Question 9</strong>

                                    <br>

                                    <small class="text-muted">
                                        Thoughts that you would be better off dead or of hurting yourself.
                                    </small>

                                    <br>

                                    <span asp-validation-for="Question9Score"
                                          class="text-danger">
                                    </span>

                                </td>

                                <td class="text-center">
                                    <input asp-for="Question9Score"
                                           type="radio"
                                           value="0"
                                           class="form-check-input">
                                </td>

                                <td class="text-center">
                                    <input asp-for="Question9Score"
                                           type="radio"
                                           value="1"
                                           class="form-check-input">
                                </td>

                                <td class="text-center">
                                    <input asp-for="Question9Score"
                                           type="radio"
                                           value="2"
                                           class="form-check-input">
                                </td>

                                <td class="text-center">
                                    <input asp-for="Question9Score"
                                           type="radio"
                                           value="3"
                                           class="form-check-input">
                                </td>

                            </tr>

                        </tbody>

                    </table>

                </div>

                <div class="mt-4">

                    <label asp-for="FunctionalDifficulty"
                           class="form-label">

                        How difficult have these problems made your study,
                        work, or relationships?

                    </label>

                    <select asp-for="FunctionalDifficulty"
                            class="form-select">

                        <option value="">
                            -- Select an Option --
                        </option>

                        <option value="Not difficult">
                            Not difficult
                        </option>

                        <option value="Somewhat difficult">
                            Somewhat difficult
                        </option>

                        <option value="Very difficult">
                            Very difficult
                        </option>

                        <option value="Extremely difficult">
                            Extremely difficult
                        </option>

                    </select>

                </div>

                <div class="mt-4">

                    <label asp-for="AdditionalComments"
                           class="form-label">

                        Additional Comments (Optional)

                    </label>

                    <textarea asp-for="AdditionalComments"
                              class="form-control"
                              rows="5"
                              placeholder="Write anything you would like to share...">
                    </textarea>

                    <span asp-validation-for="AdditionalComments"
                          class="text-danger">
                    </span>

                </div>

                <div class="mt-4 text-end">

                    <a asp-controller="Student"
                       asp-action="Dashboard"
                       class="btn btn-secondary">

                        Back to Dashboard

                    </a>

                    <button type="submit"
                            class="btn btn-primary">

                        Submit Assessment

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}