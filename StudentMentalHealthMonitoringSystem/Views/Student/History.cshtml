@{
    ViewData["Title"] = "Mental Health History";
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header bg-dark text-white">

            <h3>Mental Health History</h3>

        </div>

        <div class="card-body">

            <table class="table table-bordered table-hover">

                <thead class="table-dark">

                    <tr>

                        <th>Semester</th>

                        <th>PHQ-9</th>

                        <th>C-SSRS</th>

                        <th>Risk Level</th>

                        <th>Counseling</th>

                        <th>Status</th>

                    </tr>

                </thead>

                <tbody>

                    <tr>

                        <td>Semester 1</td>

                        <td>6</td>

                        <td>Low</td>

                        <td>

                            <span class="badge bg-warning">

                                Moderate

                            </span>

                        </td>

                        <td>Completed</td>

                        <td>

                            Improved

                        </td>

                    </tr>

                    <tr>

                        <td>Semester 2</td>

                        <td>3</td>

                        <td>Low</td>

                        <td>

                            <span class="badge bg-success">

                                Normal

                            </span>

                        </td>

                        <td>Not Required</td>

                        <td>

                            Stable

                        </td>

                    </tr>

                    <tr>

                        <td>Semester 3</td>

                        <td>-</td>

                        <td>-</td>

                        <td>

                            <span class="badge bg-secondary">

                                Pending

                            </span>

                        </td>

                        <td>-</td>

                        <td>

                            Awaiting Screening

                        </td>

                    </tr>

                </tbody>

            </table>

        </div>

    </div>

</div>