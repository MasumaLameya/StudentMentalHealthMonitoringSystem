@model StudentMentalHealthMonitoringSystem.ViewModels.StudentScreeningClearanceViewModel

@{
    ViewData["Title"] = "Semester Screening Clearance Status";
}

<style>
    .student-app-bg {
        background: #F8FAFC;
        min-height: 100vh;
        padding-bottom: 2rem;
    }

    .glass-card {
        background: #ffffff;
        border: 1px solid #E2E8F0;
        border-radius: 1.25rem;
        box-shadow: 0 4px 20px rgba(15, 23, 42, 0.05);
    }

    .status-badge-cleared {
        background: #ECFDF5;
        border: 2px solid #10B981;
        color: #047857;
        border-radius: 1rem;
        padding: 1.25rem 2rem;
    }

    .status-badge-blocked {
        background: #FEF2F2;
        border: 2px solid #EF4444;
        color: #B91C1C;
        border-radius: 1rem;
        padding: 1.25rem 2rem;
    }
</style>

<div class="student-app-bg py-3">
    <div class="container-fluid">
        <div class="row g-4">

            <!-- Sidebar Navigation -->
            <div class="col-lg-3">
                @await Html.PartialAsync("_StudentSidebar")
            </div>

            <!-- Main Content Area -->
            <div class="col-lg-9">

                <!-- Header Banner -->
                <div class="glass-card p-4 mb-4" style="background: linear-gradient(135deg, #065F46 0%, #047857 50%, #059669 100%); color: #ffffff;">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                        <div>
                            <div class="badge bg-white text-dark rounded-pill px-3 py-1.5 mb-2 fw-bold">
                                <i class="bi bi-shield-check text-success me-1"></i> Academic Compliance
                            </div>
                            <h2 class="fw-bold mb-1 text-white">
                                <i class="bi bi-check2-square me-2"></i>Semester Screening Clearance Status
                            </h2>
                            <p class="text-white-50 fs-6 mb-0">Monitor your mandatory mental health screening completion and course registration eligibility.</p>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <a href="/Student/Reports" class="btn btn-outline-light rounded-pill px-4 py-2 fw-semibold">
                                <i class="bi bi-arrow-left me-1"></i> Reports Hub
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Semester Selector Toolbar -->
                <div class="glass-card p-3 mb-4">
                    <form method="get" asp-controller="Student" asp-action="ScreeningClearance" class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-calendar-check fs-5 text-success"></i>
                            <span class="fw-bold text-dark">Selected Academic Term:</span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <select name="semester" class="form-select form-select-sm" style="min-width: 180px;" onchange="this.form.submit()">
                                @foreach (var sem in Model.AvailableSemesters)
                                {
                                    <option value="@sem" selected="@(Model.SelectedSemester == sem)">@sem</option>
                                }
                            </select>
                        </div>
                    </form>
                </div>

                <!-- Main Status Card -->
                <div class="glass-card p-4 mb-4">
                    <div class="row align-items-center g-4">
                        <div class="col-md-7">
                            <h4 class="fw-bold text-dark mb-1">Registration Standing &amp; Clearance</h4>
                            <p class="text-muted small mb-3">Academic Term: <strong>@Model.SelectedSemester</strong> • Checked on: @Model.CheckedDate.ToString("MMM dd, yyyy")</p>

                            <div class="@(Model.IsCleared ? "status-badge-cleared" : "status-badge-blocked") mb-3">
                                <div class="d-flex align-items-center gap-3">
                                    <i class="bi @(Model.IsCleared ? "bi-check-circle-fill text-success" : "bi-x-octagon-fill text-danger") fs-1"></i>
                                    <div>
                                        <h4 class="fw-bold mb-0">@(Model.IsCleared ? "Cleared for Course Registration" : "Course Registration Locked")</h4>
                                        <small>@(Model.IsCleared ? "100% Mandatory Screening Completed" : "Action Required: Screening Incomplete")</small>
                                    </div>
                                </div>
                            </div>

                            <p class="text-dark small mb-0" style="line-height: 1.6;">
                                <i class="bi bi-info-circle text-primary me-1"></i>
                                @Model.AdministrativeRemarks
                            </p>
                        </div>

                        <div class="col-md-5">
                            <div class="p-3 bg-light rounded-4 border">
                                <h6 class="fw-bold text-secondary text-uppercase mb-3" style="font-size: 0.78rem;">Student Credentials</h6>
                                <div class="mb-2">
                                    <small class="text-muted d-block">Student Name:</small>
                                    <strong class="text-dark">@Model.FullName</strong>
                                </div>
                                <div class="mb-2">
                                    <small class="text-muted d-block">Student ID:</small>
                                    <strong class="text-dark">@Model.StudentIdNumber</strong>
                                </div>
                                <div>
                                    <small class="text-muted d-block">Department:</small>
                                    <strong class="text-dark">Department of @Model.Department</strong>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Module Completion Checklist -->
                <div class="glass-card p-4">
                    <h5 class="fw-bold text-dark mb-3">
                        <i class="bi bi-card-checklist text-primary me-2"></i> Mandatory Screening Checklist for @Model.SelectedSemester
                    </h5>

                    <div class="row g-3">
                        <!-- PHQ-9 Card -->
                        <div class="col-md-6">
                            <div class="p-4 rounded-4 border @(Model.HasCompletedPHQ ? "border-success-subtle bg-success-subtle bg-opacity-25" : "border-danger-subtle bg-danger-subtle bg-opacity-25") h-100 d-flex flex-column justify-content-between">
                                <div>
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <h6 class="fw-bold text-dark mb-0">1. PHQ-9 Depression Screening</h6>
                                        <span class="badge @(Model.HasCompletedPHQ ? "bg-success" : "bg-danger") rounded-pill px-3 py-1">
                                            @(Model.HasCompletedPHQ ? "Completed" : "Pending")
                                        </span>
                                    </div>
                                    <p class="text-muted small mb-3">Evaluates depression severity and emotional wellness over the past two weeks.</p>
                                    <div class="text-muted small">
                                        <div><strong>Date:</strong> @(Model.PHQCompletionDate?.ToString("MMM dd, yyyy - hh:mm tt") ?? "Not Submitted")</div>
                                        <div><strong>Result:</strong> @Model.PHQSeverityLevel</div>
                                    </div>
                                </div>

                                <div class="mt-3">
                                    @if (Model.HasCompletedPHQ)
                                    {
                                        <a href="/Student/PHQResult" class="btn btn-sm btn-outline-success rounded-pill px-3 w-100 fw-semibold">
                                            <i class="bi bi-eye me-1"></i> View PHQ-9 Result
                                        </a>
                                    }
                                    else
                                    {
                                        <a href="/Student/PHQ" class="btn btn-sm btn-danger rounded-pill px-3 w-100 fw-semibold">
                                            <i class="bi bi-pencil-square me-1"></i> Take PHQ-9 Assessment
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- C-SSRS Card -->
                        <div class="col-md-6">
                            <div class="p-4 rounded-4 border @(Model.HasCompletedCSSRS ? "border-success-subtle bg-success-subtle bg-opacity-25" : "border-danger-subtle bg-danger-subtle bg-opacity-25") h-100 d-flex flex-column justify-content-between">
                                <div>
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <h6 class="fw-bold text-dark mb-0">2. C-SSRS Suicide Risk Assessment</h6>
                                        <span class="badge @(Model.HasCompletedCSSRS ? "bg-success" : "bg-danger") rounded-pill px-3 py-1">
                                            @(Model.HasCompletedCSSRS ? "Completed" : "Pending")
                                        </span>
                                    </div>
                                    <p class="text-muted small mb-3">Evaluates safety risk factors to ensure student mental health protection.</p>
                                    <div class="text-muted small">
                                        <div><strong>Date:</strong> @(Model.CSSRSCompletionDate?.ToString("MMM dd, yyyy - hh:mm tt") ?? "Not Submitted")</div>
                                        <div><strong>Result:</strong> @Model.CSSRSRiskLevel Risk</div>
                                    </div>
                                </div>

                                <div class="mt-3">
                                    @if (Model.HasCompletedCSSRS)
                                    {
                                        <a href="/Student/CSRRSResult" class="btn btn-sm btn-outline-success rounded-pill px-3 w-100 fw-semibold">
                                            <i class="bi bi-eye me-1"></i> View C-SSRS Result
                                        </a>
                                    }
                                    else
                                    {
                                        <a href="/Student/CSRRS" class="btn btn-sm btn-danger rounded-pill px-3 w-100 fw-semibold">
                                            <i class="bi bi-pencil-square me-1"></i> Take C-SSRS Assessment
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

        </div>
    </div>
</div>
