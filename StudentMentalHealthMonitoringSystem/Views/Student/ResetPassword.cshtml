@{
    ViewData["Title"] = "Reset Password - Student";
    var email = ViewBag.Email as string ?? "";
}

<style>
    .reset-container {
        min-height: calc(100vh - 180px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2.5rem 1rem;
    }

    .reset-card {
        background: #ffffff;
        border: 1px solid #D1E2D7;
        border-radius: 1.25rem;
        box-shadow: 0 8px 30px rgba(0, 77, 37, 0.08);
        overflow: hidden;
        width: 100%;
        max-width: 480px;
    }

    .reset-header {
        background: linear-gradient(135deg, #004D25 0%, #006837 100%);
        border-bottom: 3px solid #FFC20E;
        padding: 2rem 1.75rem;
        text-align: center;
        color: #ffffff;
    }

    .otp-input {
        letter-spacing: 6px;
        font-size: 1.3rem;
        font-weight: 700;
        text-align: center;
    }
</style>

<div class="reset-container">
    <div class="reset-card">
        <div class="reset-header">
            <div class="badge bg-white p-3 rounded-circle shadow-sm mb-3">
                <i class="bi bi-key-fill fs-2" style="color: #006837;"></i>
            </div>
            <h3 class="fw-bold mb-1 text-white">Reset Password</h3>
            <p class="text-white-50 fs-6 mb-0">Enter the verification code & your new password</p>
        </div>

        <div class="p-4">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success border-0 rounded-3 mb-3 small">
                    <i class="bi bi-check-circle-fill me-1"></i> @TempData["SuccessMessage"]
                </div>
            }

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger border-0 rounded-3 mb-3 small">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i> @ViewBag.Error
                </div>
            }

            <div class="alert alert-light border border-success-subtle rounded-3 p-2.5 mb-3 text-center small">
                <span class="text-muted">Verification code sent to:</span><br />
                <strong class="text-dark">@email</strong>
            </div>

            <form asp-controller="Student" asp-action="ResetPassword" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label fw-bold text-dark fs-6 mb-1">6-Digit OTP Code</label>
                    <input type="text" name="otp" class="form-control otp-input" placeholder="••••••" maxlength="6" pattern="\d{6}" required autofocus autocomplete="one-time-code" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold text-dark fs-6 mb-1">New Password</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-lock fs-5" style="color: #006837;"></i></span>
                        <input type="password" name="newPassword" id="newPassword" class="form-control border-start-0 ps-2 fs-6" placeholder="••••••••" minlength="8" required />
                    </div>
                    <small class="text-muted">Min 8 chars, 1 uppercase, 1 lowercase, 1 number, 1 symbol.</small>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold text-dark fs-6 mb-1">Confirm New Password</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-shield-check fs-5" style="color: #006837;"></i></span>
                        <input type="password" name="confirmPassword" id="confirmPassword" class="form-control border-start-0 ps-2 fs-6" placeholder="••••••••" minlength="8" required />
                    </div>
                </div>

                <button type="submit" class="btn text-white w-100 rounded-3 py-2.5 fw-bold mb-3 shadow-sm fs-6" style="background:#006837; border-color:#006837;">
                    <i class="bi bi-check2-circle me-1"></i> Update Password & Log In
                </button>
            </form>

            <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                <button type="button" id="btnResend" class="btn btn-link p-0 text-decoration-none small text-muted">
                    <i class="bi bi-arrow-clockwise me-1"></i> Resend Code (<span id="countdown">60</span>s)
                </button>

                <a asp-controller="Student" asp-action="ForgotPassword" class="text-decoration-none fw-semibold small" style="color: #006837;">
                    Change Email
                </a>
            </div>
        </div>
    </div>
</div>

<script>
    let timeLeft = 60;
    const countdownEl = document.getElementById('countdown');
    const btnResend = document.getElementById('btnResend');

    const timer = setInterval(() => {
        timeLeft--;
        if (timeLeft <= 0) {
            clearInterval(timer);
            countdownEl.parentElement.innerHTML = '<a href="javascript:void(0)" onclick="resendOtp()" class="text-decoration-none fw-semibold small" style="color:#006837;"><i class="bi bi-arrow-clockwise me-1"></i> Resend Code</a>';
        } else {
            countdownEl.textContent = timeLeft;
        }
    }, 1000);

    async function resendOtp() {
        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
        try {
            const res = await fetch('@Url.Action("ResendResetOtp", "Student")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded'
                },
                body: '__RequestVerificationToken=' + encodeURIComponent(token)
            });
            const data = await res.json();
            alert(data.message);
            if (data.success) {
                location.reload();
            }
        } catch (e) {
            alert('Failed to resend verification code. Please try again.');
        }
    }
</script>
