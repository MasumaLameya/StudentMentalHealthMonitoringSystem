@{
    ViewData["Title"] = "Counseling Appointment";
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header bg-success text-white">

            <h3>On-Campus Counseling Appointment</h3>

        </div>

        <div class="card-body">

            <table class="table table-bordered">

                <tr>
                    <th>Appointment ID</th>
                    <td>APT-001</td>
                </tr>

                <tr>
                    <th>Date</th>
                    <td>15 July 2026</td>
                </tr>

                <tr>
                    <th>Time</th>
                    <td>10:00 AM</td>
                </tr>

                <tr>
                    <th>Psychologist</th>
                    <td>Dr. Sarah Ahmed</td>
                </tr>

                <tr>
                    <th>Counseling Room</th>
                    <td>Room MH-302</td>
                </tr>

                <tr>
                    <th>Building</th>
                    <td>Student Counseling Center</td>
                </tr>

                <tr>
                    <th>Status</th>
                    <td>
                        <span class="badge bg-success">
                            Scheduled
                        </span>
                    </td>
                </tr>

            </table>

            <div class="alert alert-info mt-4">

                <h5>Instructions</h5>

                <ul>

                    <li>Arrive at least 10 minutes before your appointment.</li>

                    <li>Bring your University ID card.</li>

                    <li>If you are unable to attend, inform the department beforehand.</li>

                </ul>

            </div>

            <div class="text-center">

                <button class="btn btn-success">

                    View Appointment Details

                </button>

            </div>

        </div>

    </div>

</div>