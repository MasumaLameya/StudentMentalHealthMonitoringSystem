@model StudentMentalHealthMonitoringSystem.ViewModels.AppointmentViewModel

@{
    Layout = "_Layout";
    var activeAppointment = ViewBag.ActiveAppointment as StudentMentalHealthMonitoringSystem.Models.Counseling;
    bool hasCompletedScreening = ViewBag.HasCompletedScreening != null ? (bool)ViewBag.HasCompletedScreening : true;
}

<style>
    .student-app-bg {
        background: #F4F8F5;
        min-height: 100vh;
        padding-bottom: 2.5rem;
    }

    .glass-card {
        background: #ffffff;
        border: 1px solid #D1E2D7;
        border-radius: 1.25rem;
        box-shadow: 0 4px 20px rgba(0, 77, 37, 0.05);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .active-appointment-card {
        background: #ffffff;
        border: 2px solid #006837;
        border-radius: 1.25rem;
        box-shadow: 0 8px 30px rgba(0, 104, 55, 0.12);
        overflow: hidden;
    }

    .active-header {
        background: linear-gradient(135deg, #004D25 0%, #006837 100%);
        color: #ffffff;
        padding: 1.5rem;
        border-bottom: 3px solid #FFC20E;
    }

    .info-badge-box {
        background: #EBF4EE;
        border: 1px solid #D1E2D7;
        border-radius: 0.9rem;
        padding: 1rem 1.25rem;
    }
</style>

<div class="student-app-bg py-3">
    <div class="container-fluid">
        <div class="row g-4">

            <!-- Sidebar Navigation -->
            <div class="col-lg-3">
                @await Html.PartialAsync("_StudentSidebar")
            </div>

            <!-- Main Content Area -->
            <div class="col-lg-9">

                <!-- Header Banner -->
                <div class="glass-card p-4 mb-4" style="background: linear-gradient(135deg, #004D25 0%, #006837 100%); color: #ffffff; border-bottom: 3px solid #FFC20E;">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                        <div>
                            <h2 class="fw-bold mb-1 text-white">
                                <i class="bi bi-calendar-check me-2 text-warning"></i>Counseling Appointment
                            </h2>
                            <p class="text-white-50 fs-6 mb-0">Schedule professional one-on-one sessions with university psychologists.</p>
                        </div>
                        <a href="/Student/Dashboard" class="btn bg-white text-dark btn-lg rounded-3 px-4 py-2 fw-bold shadow-sm border-0">
                            <i class="bi bi-arrow-left me-1" style="color: #006837;"></i> Dashboard
                        </a>
                    </div>
                </div>

                <!-- Alert Messages -->
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success border-0 shadow-sm rounded-3 mb-4 d-flex align-items-center">
                        <i class="bi bi-check-circle-fill fs-4 me-2 text-success"></i>
                        <div class="fw-semibold">@TempData["Success"]</div>
                    </div>
                }

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger border-0 shadow-sm rounded-3 mb-4 d-flex align-items-center">
                        <i class="bi bi-exclamation-triangle-fill fs-4 me-2 text-danger"></i>
                        <div class="fw-semibold">@TempData["Error"]</div>
                    </div>
                }

                @if (activeAppointment != null)
                {
                    <!-- ================= ACTIVE / PENDING APPOINTMENT ALREADY SCHEDULED CARD ================= -->
                    <div class="active-appointment-card mb-4">
                        <div class="active-header">
                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <div>
                                    <h4 class="fw-bold mb-1 text-white">
                                        <i class="bi bi-calendar-heart me-2 text-warning"></i>Appointment Already Scheduled
                                    </h4>
                                    <p class="text-white-50 mb-0">You currently have an active counseling appointment. You cannot book another session until this is completed.</p>
                                </div>
                                <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fs-6 fw-bold">
                                    <i class="bi bi-hourglass-split me-1"></i>Status: @activeAppointment.Status
                                </span>
                            </div>
                        </div>

                        <div class="p-4 p-md-5">
                            <div class="row g-4 mb-4">
                                <div class="col-md-6">
                                    <div class="info-badge-box h-100">
                                        <small class="text-secondary fw-bold text-uppercase d-block mb-1">
                                            <i class="bi bi-person-badge text-success me-1"></i>Assigned Psychologist
                                        </small>
                                        <h5 class="fw-bold mb-1" style="color: #004D25;">
                                            @(activeAppointment.Psychologist?.FullName ?? "University Psychologist")
                                        </h5>
                                        <span class="text-secondary small">@(activeAppointment.Psychologist?.Specialization ?? "Clinical Psychologist")</span>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="info-badge-box h-100">
                                        <small class="text-secondary fw-bold text-uppercase d-block mb-1">
                                            <i class="bi bi-calendar-date text-primary me-1"></i>Session Date
                                        </small>
                                        <h5 class="fw-bold mb-0 text-dark">
                                            @activeAppointment.CounselingDate.ToString("dddd, MMMM dd, yyyy")
                                        </h5>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="info-badge-box h-100">
                                        <small class="text-secondary fw-bold text-uppercase d-block mb-1">
                                            <i class="bi bi-clock-history text-warning me-1"></i>Session Time Slot
                                        </small>
                                        <h5 class="fw-bold mb-0 text-dark">
                                            @DateTime.Today.Add(activeAppointment.AppointmentTime).ToString("h:mm tt") - @DateTime.Today.Add(activeAppointment.AppointmentEndTime).ToString("h:mm tt")
                                        </h5>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="info-badge-box h-100">
                                        <small class="text-secondary fw-bold text-uppercase d-block mb-1">
                                            <i class="bi bi-geo-alt-fill text-danger me-1"></i>Location / Venue
                                        </small>
                                        <h5 class="fw-bold mb-0 text-dark">
                                            @(activeAppointment.AppointmentRoom ?? "Mental Health & Counseling Center, Room 402")
                                        </h5>
                                    </div>
                                </div>
                            </div>

                            <div class="alert alert-info border-0 rounded-3 mb-4 d-flex align-items-start">
                                <i class="bi bi-info-circle-fill fs-5 text-primary me-3 mt-1"></i>
                                <div>
                                    <strong>Notice on Multiple Appointments:</strong>
                                    <p class="mb-0 small text-secondary">
                                        Each student is assigned one active counseling session at a time to ensure optimal attention from our psychology team. If you require rescheduling or immediate crisis intervention, please visit the Counseling Center directly or reach out through emergency contact.
                                    </p>
                                </div>
                            </div>

                            <div class="alert alert-light border rounded-3 mb-4 d-flex align-items-center py-2.5 px-3" style="background-color: #F8F9FA;">
                                <i class="bi bi-shield-lock-fill text-success fs-4 me-3"></i>
                                <div class="small text-secondary">
                                    <strong class="text-dark">Appointment Modification Policy:</strong>
                                    Students cannot cancel counseling appointments directly once scheduled. If this appointment needs to be cancelled or rescheduled, please consult the University Counseling Center.
                                </div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 pt-3 border-top">
                                <div class="d-flex gap-2 flex-wrap">
                                    <a href="/Student/Dashboard" class="btn btn-outline-dark rounded-3 px-4 py-2.5 fw-bold">
                                        <i class="bi bi-arrow-left me-1"></i> Dashboard
                                    </a>
                                    <a href="/Student/History" class="btn btn-outline-primary rounded-3 px-4 py-2.5 fw-bold">
                                        <i class="bi bi-clock-history me-1"></i> Session History
                                    </a>
                                </div>
                                <div class="d-flex gap-2 flex-wrap">
                                    <a href="/Student/Reports" class="btn btn-success text-white rounded-3 px-4 py-2.5 fw-bold" style="background:#006837;">
                                        <i class="bi bi-file-earmark-medical me-1"></i> View Official Reports
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else if (!hasCompletedScreening)
                {
                    <!-- ================= SCREENING PREREQUISITE REQUIRED CARD ================= -->
                    <div class="glass-card p-4 p-md-5 mb-4 text-center">
                        <div class="mx-auto mb-4 d-flex align-items-center justify-content-center rounded-circle" style="width: 84px; height: 84px; background: #FFF3CD; border: 2px solid #FFEBAA;">
                            <i class="bi bi-shield-exclamation text-warning" style="font-size: 2.75rem;"></i>
                        </div>
                        <h3 class="fw-bold mb-2" style="color: #004D25;">Screening Assessment Required</h3>
                        <p class="text-secondary mx-auto mb-4" style="max-width: 680px; font-size: 1.05rem;">
                            Before you can schedule a counseling session, you must complete at least one baseline mental health screening (<strong class="text-dark">PHQ-9</strong> or <strong class="text-dark">C-SSRS</strong>). This ensures our psychologists have essential context to support you effectively.
                        </p>

                        <div class="row g-4 justify-content-center mb-4" style="max-width: 760px; margin: 0 auto;">
                            <div class="col-md-6">
                                <div class="card h-100 border-0 shadow-sm rounded-4 p-4 text-start" style="background: #F4FBF7; border: 1px solid #D1E2D7 !important;">
                                    <div class="d-flex align-items-center mb-3">
                                        <div class="badge bg-success text-white p-2.5 rounded-3 me-2">
                                            <i class="bi bi-clipboard2-pulse fs-5"></i>
                                        </div>
                                        <div>
                                            <h5 class="fw-bold mb-0 text-success">PHQ-9 Screening</h5>
                                            <small class="text-muted">Depression & Mood Assessment</small>
                                        </div>
                                    </div>
                                    <p class="small text-secondary mb-4">A standard 9-question clinical tool evaluating mood and symptom levels over the past 2 weeks.</p>
                                    <a href="/Student/PHQ" class="btn text-white w-100 rounded-3 py-2.5 fw-bold shadow-sm" style="background: #006837;">
                                        <i class="bi bi-pencil-square me-1"></i> Start PHQ-9 Assessment
                                    </a>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="card h-100 border-0 shadow-sm rounded-4 p-4 text-start" style="background: #FDF9F4; border: 1px solid #F0E2D4 !important;">
                                    <div class="d-flex align-items-center mb-3">
                                        <div class="badge bg-warning text-dark p-2.5 rounded-3 me-2">
                                            <i class="bi bi-heart-pulse fs-5"></i>
                                        </div>
                                        <div>
                                            <h5 class="fw-bold mb-0 text-dark">C-SSRS Screening</h5>
                                            <small class="text-muted">Columbia Suicide Severity Scale</small>
                                        </div>
                                    </div>
                                    <p class="small text-secondary mb-4">A standardized clinical questionnaire to gauge emotional distress and personal safety risks.</p>
                                    <a href="/Student/CSRRS" class="btn btn-warning text-dark w-100 rounded-3 py-2.5 fw-bold shadow-sm">
                                        <i class="bi bi-pencil-square me-1"></i> Start C-SSRS Assessment
                                    </a>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-center gap-2 flex-wrap pt-3 border-top">
                            <a href="/Student/SemesterScreening" class="btn btn-outline-success rounded-3 px-4 py-2.5 fw-bold">
                                <i class="bi bi-speedometer2 me-1"></i> Semester Screening Hub
                            </a>
                            <a href="/Student/Dashboard" class="btn btn-light border rounded-3 px-4 py-2.5 fw-bold">
                                <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
                            </a>
                        </div>
                    </div>
                }
                else
                {
                    <!-- ================= NEW APPOINTMENT BOOKING FORM ================= -->
                    <div class="row g-4">
                        <div class="col-lg-7">
                            <div class="glass-card p-4">
                                <div class="d-flex align-items-center mb-3">
                                    <div class="badge bg-success-subtle text-success p-2.5 rounded-circle me-2">
                                        <i class="bi bi-calendar-plus fs-5"></i>
                                    </div>
                                    <h4 class="fw-bold mb-0" style="color: #004D25;">Request Counseling Session</h4>
                                </div>
                                <p class="text-secondary small mb-4">Select your preferred date and 1-hour time slot. Our scheduler will automatically assign an available clinical psychologist.</p>

                                @if (!string.IsNullOrEmpty(Model.Message))
                                {
                                    <div class="alert alert-warning border-0 rounded-3 mb-4 d-flex align-items-center">
                                        <i class="bi bi-info-circle-fill fs-5 me-2"></i>
                                        <div>@Model.Message</div>
                                    </div>
                                }

                                <form asp-controller="Student" asp-action="Appointment" method="post">
                                    @Html.AntiForgeryToken()
                                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 mb-3"></div>

                                    <!-- Preferred Date -->
                                    <div class="mb-4">
                                        <label asp-for="PreferredDate" class="form-label fw-bold text-dark">
                                            <i class="bi bi-calendar3 text-success me-1"></i> Preferred Date
                                        </label>
                                        <input asp-for="PreferredDate" id="PreferredDate" type="date" min="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control rounded-3 p-3 fs-6" required onchange="validateTimeSlots()" />
                                        <span asp-validation-for="PreferredDate" class="text-danger small"></span>
                                        <div id="weekendErrorMsg" class="alert alert-danger border-0 p-2 mt-2 small d-none">
                                            <i class="bi bi-exclamation-triangle-fill me-1"></i> Counseling is only available from <strong>Saturday to Wednesday</strong>. Thursday and Friday are weekends.
                                        </div>
                                        <small class="text-muted d-block mt-1">Available counseling days: Saturday to Wednesday.</small>
                                    </div>

                                    <!-- Preferred Time Slot -->
                                    <div class="mb-4">
                                        <label asp-for="StartTime" class="form-label fw-bold text-dark">
                                            <i class="bi bi-clock text-success me-1"></i> Preferred Time Slot
                                        </label>
                                        <select asp-for="StartTime" id="StartTime" class="form-select rounded-3 p-3 fs-6" required onchange="validateTimeSlots()">
                                            <option value="">-- Select Counseling Time Slot --</option>
                                            <option value="08:30:00">8:30 AM - 9:30 AM</option>
                                            <option value="09:35:00">9:35 AM - 10:35 AM</option>
                                            <option value="10:40:00">10:40 AM - 11:40 AM</option>
                                            <option value="11:45:00">11:45 AM - 12:45 PM</option>
                                            <option value="13:10:00">1:10 PM - 2:10 PM</option>
                                            <option value="14:15:00">2:15 PM - 3:15 PM</option>
                                            <option value="15:20:00">3:20 PM - 4:20 PM</option>
                                            <option value="16:25:00">4:25 PM - 5:25 PM</option>
                                        </select>
                                        <span asp-validation-for="StartTime" class="text-danger small"></span>
                                        <div id="pastTimeErrorMsg" class="alert alert-danger p-2 mt-2 rounded-3 small d-none">
                                            <i class="bi bi-exclamation-octagon-fill me-1"></i> You cannot select a past time slot for today's date. Please choose a future time slot.
                                        </div>
                                        <small class="text-muted d-block mt-1">Sessions are fixed 1-hour confidential appointments.</small>
                                    </div>

                                    @if (Model.SuggestedTimes != null && Model.SuggestedTimes.Any())
                                    {
                                        <div class="card border-0 rounded-4 mb-4" style="background:#F7F2ED; border:1px solid #E8DDD2;">
                                            <div class="card-body p-3">
                                                <h6 class="fw-bold mb-2 text-dark">
                                                    <i class="bi bi-lightbulb-fill text-warning me-1"></i> Suggested Available Time Slots:
                                                </h6>
                                                <p class="text-secondary small mb-3">All psychologists are busy at your requested time. Click an alternative slot below:</p>
                                                <div class="d-flex flex-wrap gap-2">
                                                    @foreach (var time in Model.SuggestedTimes)
                                                    {
                                                        var suggestedEndTime = time.Add(TimeSpan.FromHours(1));
                                                        var startTimeText = DateTime.Today.Add(time).ToString("h:mm tt");
                                                        var endTimeText = DateTime.Today.Add(suggestedEndTime).ToString("h:mm tt");
                                                        <button type="button" class="btn btn-outline-dark btn-sm rounded-pill px-3 py-1.5 fw-semibold" onclick="selectSuggestedTime('@time.ToString(@"hh\:mm\:ss")')">
                                                            <i class="bi bi-clock me-1"></i> @startTimeText - @endTimeText
                                                        </button>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    }

                                    <!-- Submit Buttons -->
                                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                                        <a href="/Student/Dashboard" class="btn border bg-white text-dark rounded-3 px-4 py-2.5 fw-bold">
                                            <i class="bi bi-arrow-left me-1"></i> Dashboard
                                        </a>
                                        <button type="submit" class="btn text-white btn-lg rounded-3 px-4 py-2.5 shadow-sm fw-bold fs-6" style="background:#006837;">
                                            <i class="bi bi-send-check-fill me-1"></i> Request Appointment
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>

                        <!-- Right Info Column -->
                        <div class="col-lg-5">
                            <div class="glass-card p-4 mb-4">
                                <h5 class="fw-bold mb-3" style="color: #004D25;">
                                    <i class="bi bi-shield-check me-2"></i>How Scheduling Works
                                </h5>
                                <div class="d-flex align-items-start mb-3">
                                    <div class="badge bg-success-subtle text-success p-2 rounded-circle me-3">1</div>
                                    <div>
                                        <strong class="d-block text-dark">Select Date & Time</strong>
                                        <small class="text-secondary">Pick a working day (Sat–Wed) and convenient 1-hour slot.</small>
                                    </div>
                                </div>
                                <div class="d-flex align-items-start mb-3">
                                    <div class="badge bg-success-subtle text-success p-2 rounded-circle me-3">2</div>
                                    <div>
                                        <strong class="d-block text-dark">Smart Availability Check</strong>
                                        <small class="text-secondary">The system checks verified psychologists available at your selected time.</small>
                                    </div>
                                </div>
                                <div class="d-flex align-items-start mb-3">
                                    <div class="badge bg-success-subtle text-success p-2 rounded-circle me-3">3</div>
                                    <div>
                                        <strong class="d-block text-dark">Balanced Assignment</strong>
                                        <small class="text-secondary">Psychologists with lowest active case load receive immediate assignment.</small>
                                    </div>
                                </div>
                                <div class="d-flex align-items-start">
                                    <div class="badge bg-success-subtle text-success p-2 rounded-circle me-3">4</div>
                                    <div>
                                        <strong class="d-block text-dark">Instant Confirmation</strong>
                                        <small class="text-secondary">Your session is locked and displayed in your dashboard.</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }

            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        function selectSuggestedTime(time) {
            var startInput = document.getElementById("StartTime");
            if (startInput) {
                startInput.value = time;
                startInput.scrollIntoView({ behavior: "smooth", block: "center" });
                validateTimeSlots();
            }
        }

        function validateTimeSlots() {
            var dateInput = document.getElementById("PreferredDate");
            var timeSelect = document.getElementById("StartTime");
            var errorMsg = document.getElementById("pastTimeErrorMsg");
            var weekendMsg = document.getElementById("weekendErrorMsg");
            if (!dateInput || !timeSelect || !errorMsg) return;

            var selectedDateVal = dateInput.value;
            if (!selectedDateVal) return;

            // Check if day is Thursday (4) or Friday (5)
            // Note: date input gives yyyy-mm-dd. Create date using parts to avoid timezone shift
            var dateParts = selectedDateVal.split('-');
            var selectedDateObj = new Date(dateParts[0], dateParts[1] - 1, dateParts[2]);
            var dayOfWeek = selectedDateObj.getDay(); // 0: Sun, 1: Mon, 2: Tue, 3: Wed, 4: Thu, 5: Fri, 6: Sat

            if (weekendMsg) {
                if (dayOfWeek === 4 || dayOfWeek === 5) {
                    weekendMsg.classList.remove("d-none");
                } else {
                    weekendMsg.classList.add("d-none");
                }
            }

            var now = new Date();
            var todayStr = now.getFullYear() + '-' +
                String(now.getMonth() + 1).padStart(2, '0') + '-' +
                String(now.getDate()).padStart(2, '0');

            var isToday = (selectedDateVal === todayStr);
            var nowMinutes = (now.getHours() * 60) + now.getMinutes();

            var hasInvalidSelection = false;

            for (var i = 0; i < timeSelect.options.length; i++) {
                var opt = timeSelect.options[i];
                if (!opt.value) continue;

                var parts = opt.value.split(':');
                var optMinutes = (parseInt(parts[0], 10) * 60) + parseInt(parts[1], 10);

                if (isToday && optMinutes < nowMinutes) {
                    opt.disabled = true;
                    opt.text = opt.text.replace(' (Past Slot)', '') + ' (Past Slot)';
                    if (opt.selected) {
                        hasInvalidSelection = true;
                    }
                } else {
                    opt.disabled = false;
                    opt.text = opt.text.replace(' (Past Slot)', '');
                }
            }

            if (hasInvalidSelection) {
                errorMsg.classList.remove("d-none");
            } else {
                errorMsg.classList.add("d-none");
            }
        }

        document.addEventListener("DOMContentLoaded", function () {
            validateTimeSlots();
        });
    </script>
}