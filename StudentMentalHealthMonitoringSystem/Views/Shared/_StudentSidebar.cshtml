@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    var session = HttpContextAccessor.HttpContext?.Session;
    string studentName = session?.GetString("StudentName") ?? "Student";
    string studentIdNumber = session?.GetString("StudentIdNumber") ?? "";
    string studentDepartment = session?.GetString("StudentDepartment") ?? "CSE";
    string studentSemester = session?.GetString("StudentSemester") ?? StudentMentalHealthMonitoringSystem.Models.Student.GetCurrentActiveSemester();
    string profileImage = session?.GetString("StudentProfileImage") ?? "";
    
    // Determine active menu item
    string currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    string currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string activePage = ViewData["ActivePage"]?.ToString() ?? (currentController == "VoiceBot" ? "VoiceBot" : currentAction);
}

<style>
    .student-sidebar {
        background: #EBF4EE;
        border-radius: 1.25rem;
        padding: 1.5rem 1rem;
        border: 1px solid #D1E2D7;
    }

    .student-sidebar .list-group-item {
        border: none;
        border-radius: 0.9rem;
        margin-bottom: 0.45rem;
        padding: 0.95rem 1.35rem;
        font-weight: 700;
        font-size: 1.12rem;
        color: #1E293B;
        transition: all 0.2s ease;
        display: flex;
        align-items: center;
        gap: 1rem;
        background: transparent;
        text-decoration: none;
    }

    .student-sidebar .list-group-item i {
        font-size: 1.4rem;
        color: #006837;
        width: 30px;
        text-align: center;
    }

    .student-sidebar .list-group-item:hover {
        background: #D1EBD9;
        color: #004D25;
        transform: translateX(4px);
    }

    .student-sidebar .list-group-item.active {
        background: #FFFFFF;
        color: #004D25;
        font-weight: 800;
        box-shadow: 0 4px 16px rgba(0, 77, 37, 0.12);
    }

    .student-sidebar .list-group-item.active i {
        color: #006837;
    }
</style>

<div class="glass-card p-4 text-center student-sidebar">
    <div class="position-relative d-inline-block mb-3">
        @if (!string.IsNullOrEmpty(profileImage))
        {
            <img src="@Url.Content(profileImage)" class="rounded-circle shadow-sm border border-3 border-white" width="110" height="110" style="object-fit:cover;" alt="Avatar" />
        }
        else
        {
            <img src="https://ui-avatars.com/api/?name=@Uri.EscapeDataString(studentName)&background=006837&color=fff&size=110" class="rounded-circle shadow-sm border border-3 border-white" width="110" height="110" alt="Avatar" />
        }
        <span class="position-absolute bottom-0 end-0 p-2 bg-success border border-light rounded-circle" title="Active Student"></span>
    </div>

    <h4 class="fw-bold mb-1" style="color: #004D25;">@studentName</h4>
    @if (!string.IsNullOrWhiteSpace(studentIdNumber))
    {
        <p class="text-secondary fs-6 mb-3"><i class="bi bi-person-vcard me-1" style="color: #006837;"></i>ID: @studentIdNumber</p>
    }
    
    <div class="d-flex justify-content-center gap-2 mb-3">
        <span class="badge bg-white text-dark border px-3 py-2 rounded-pill"><i class="bi bi-building me-1 text-secondary"></i>@studentDepartment</span>
        <span class="badge bg-white text-dark border px-3 py-2 rounded-pill"><i class="bi bi-mortarboard me-1 text-secondary"></i>@studentSemester</span>
    </div>

    <hr class="my-3 opacity-25" />

    <div class="list-group list-group-flush text-start">
        <a href="/Student/Dashboard" class="list-group-item @(activePage == "Dashboard" ? "active" : "")">
            <i class="bi bi-speedometer2"></i> Dashboard
        </a>
        <a href="/Student/Profile" class="list-group-item @(activePage == "Profile" ? "active" : "")">
            <i class="bi bi-person-badge"></i> My Profile
        </a>
        <a href="/Student/SemesterScreening" class="list-group-item @(activePage == "SemesterScreening" ? "active" : "")">
            <i class="bi bi-journal-check"></i> Semester Screening
        </a>
        <a href="/Student/PHQ" class="list-group-item @(activePage == "PHQ" || activePage == "PHQResult" ? "active" : "")">
            <i class="bi bi-clipboard-pulse"></i> PHQ-9 Assessment
        </a>
        <a href="/Student/CSRRS" class="list-group-item @(activePage == "CSRRS" || activePage == "CSRRSResult" ? "active" : "")">
            <i class="bi bi-shield-check"></i> C-SSRS Assessment
        </a>
        <a href="/Student/AIChat" class="list-group-item @(activePage == "AIChat" ? "active" : "")">
            <i class="bi bi-robot"></i> AI Companion Chat
        </a>
        <a href="/VoiceBot/Index" class="list-group-item @(activePage == "VoiceBot" || activePage == "Index" && currentController == "VoiceBot" ? "active" : "")">
            <i class="bi bi-mic"></i> Live Voice Bot
        </a>
        <a href="/Student/Appointment" class="list-group-item @(activePage == "Appointment" ? "active" : "")">
            <i class="bi bi-calendar-event"></i> Counseling Session
        </a>
        <a href="/Student/History" class="list-group-item @(activePage == "History" ? "active" : "")">
            <i class="bi bi-clock-history"></i> History Records
        </a>
        <a href="/Student/Progress" class="list-group-item @(activePage == "Progress" ? "active" : "")">
            <i class="bi bi-graph-up-arrow"></i> Recovery Progress
        </a>
        <a href="/Student/Reports" class="list-group-item @(activePage == "Reports" ? "active" : "")">
            <i class="bi bi-file-earmark-medical"></i> Official Reports
        </a>
        <a href="/Student/Logout" class="list-group-item text-danger fw-bold border-top mt-2">
            <i class="bi bi-box-arrow-right text-danger me-1"></i> Logout
        </a>
    </div>
</div>