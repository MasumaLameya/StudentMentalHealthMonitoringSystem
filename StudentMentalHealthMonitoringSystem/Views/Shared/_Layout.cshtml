<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Student Mental Health Monitoring System for IUBAT</title>
    
    <!-- Google Fonts & Bootstrap 5.3 -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

    <style>
        /* ================= IUBAT BRAND THEME PREVIEW ================= */
        body {
            background-color: #F4F8F5;
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            color: #0F172A;
            font-size: 1.05rem;
            line-height: 1.6;
            min-height: 100vh;
        }

        .main-navbar {
            background: linear-gradient(135deg, #004D25 0%, #006837 100%);
            box-shadow: 0 4px 20px rgba(0, 77, 37, 0.2);
            padding: 0.75rem 1.25rem;
            border-bottom: 3px solid #FFC20E;
        }

        .navbar-brand {
            font-weight: 800;
            font-size: 1.25rem;
            color: #ffffff !important;
        }

        .navbar-nav .nav-link {
            color: rgba(255, 255, 255, 0.95) !important;
            font-weight: 600;
            font-size: 1.02rem;
            padding: 0.5rem 1rem !important;
            border-radius: 0.6rem;
            transition: all 0.2s ease;
        }

        .navbar-nav .nav-link:hover {
            color: #FFC20E !important;
            background: rgba(255, 255, 255, 0.15);
        }

        .navbar-nav .nav-link.active {
            color: #004D25 !important;
            background: #FFC20E;
            font-weight: 800;
        }

        .page-container {
            min-height: calc(100vh - 120px);
            padding-top: 1.25rem;
            padding-bottom: 1.5rem;
        }

        .main-footer {
            background: #004D25;
            color: #ffffff;
            padding: 1.25rem 0;
            font-size: 0.95rem;
            border-top: 3px solid #FFC20E;
        }

        /* Standard Typography Utilities */
        h1, .h1 { font-size: 2.3rem; font-weight: 800; color: #004D25; }
        h2, .h2 { font-size: 1.9rem; font-weight: 800; color: #004D25; }
        h3, .h3 { font-size: 1.6rem; font-weight: 700; color: #004D25; }
        h4, .h4 { font-size: 1.35rem; font-weight: 700; color: #004D25; }
        h5, .h5 { font-size: 1.2rem; font-weight: 700; color: #004D25; }
        h6, .h6 { font-size: 1.05rem; font-weight: 600; color: #004D25; }
        .text-secondary, .text-muted { color: #526A5E !important; }
    </style>
</head>

<body>
    <nav class="navbar navbar-expand-lg navbar-dark main-navbar">
        <div class="container-fluid px-lg-4">
            <a class="navbar-brand d-flex align-items-center" asp-controller="Home" asp-action="Index">
                <i class="bi bi-mortarboard-fill text-warning me-2 fs-4" style="color: #FFC20E !important;"></i>
                <span>IUBAT SMHMS</span>
            </a>

            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

@using Microsoft.AspNetCore.Http

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto gap-2 align-items-center">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-house-door me-1"></i> Home
                        </a>
                    </li>

                    @if (Context.Session.GetInt32("StudentId") != null)
                    {
                        <li class="nav-item">
                            <a class="nav-link text-warning fw-bold" asp-controller="Student" asp-action="Dashboard">
                                <i class="bi bi-speedometer2 me-1"></i> Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-danger text-white fw-bold px-3.5 py-1.5 rounded-pill shadow-sm" asp-controller="Student" asp-action="Logout">
                                <i class="bi bi-box-arrow-right me-1"></i> Logout
                            </a>
                        </li>
                    }
                    else if (Context.Session.GetInt32("PsychologistId") != null)
                    {
                        <li class="nav-item">
                            <a class="nav-link text-warning fw-bold" asp-controller="Psychologist" asp-action="Dashboard">
                                <i class="bi bi-speedometer2 me-1"></i> Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white fw-semibold" asp-controller="Psychologist" asp-action="Profile">
                                <i class="bi bi-person-circle me-1"></i> Profile
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-danger text-white fw-bold px-3.5 py-1.5 rounded-pill shadow-sm" asp-controller="Psychologist" asp-action="Logout">
                                <i class="bi bi-box-arrow-right me-1"></i> Logout
                            </a>
                        </li>
                    }
                    else if (Context.Session.GetInt32("DepartmentId") != null)
                    {
                        <li class="nav-item">
                            <a class="nav-link text-warning fw-bold" asp-controller="Department" asp-action="Dashboard">
                                <i class="bi bi-speedometer2 me-1"></i> Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-danger text-white fw-bold px-3.5 py-1.5 rounded-pill shadow-sm" asp-controller="Department" asp-action="Logout">
                                <i class="bi bi-box-arrow-right me-1"></i> Logout
                            </a>
                        </li>
                    }
                    else if (Context.Session.GetInt32("AdminId") != null)
                    {
                        <li class="nav-item">
                            <a class="nav-link text-warning fw-bold" asp-controller="Admin" asp-action="Dashboard">
                                <i class="bi bi-speedometer2 me-1"></i> Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-danger text-white fw-bold px-3.5 py-1.5 rounded-pill shadow-sm" asp-controller="Admin" asp-action="Logout">
                                <i class="bi bi-box-arrow-right me-1"></i> Logout
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Student" asp-action="Login">
                                <i class="bi bi-mortarboard me-1"></i> Student
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Psychologist" asp-action="Login">
                                <i class="bi bi-person-workspace me-1"></i> Psychologist
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Department" asp-action="Login">
                                <i class="bi bi-building me-1"></i> Department
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Admin" asp-action="Login">
                                <i class="bi bi-shield-lock me-1"></i> Admin
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <div class="page-container">
        @RenderBody()
    </div>

    <footer class="main-footer">
        <div class="container-fluid text-center px-3">
            <p class="mb-0 fw-semibold">Student Mental Health Monitoring System for IUBAT © 2026</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>