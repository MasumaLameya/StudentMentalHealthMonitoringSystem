<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"] - Student Mental Health Monitoring System</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

    <style>

            body {
                background: #f4f7fc;
                font-family: 'Segoe UI', sans-serif;
            }

            .navbar {
                box-shadow: 0px 2px 12px rgba(0,0,0,.15);
            }

            .navbar-brand {
                font-weight: bold;
                font-size: 22px;
            }

            .page-container {
                margin-top: 30px;
            }

            .card {
                border: none;
                border-radius: 12px;
                transition: .3s;
            }

                .card:hover {
                    transform: translateY(-5px);
                    box-shadow: 0px 5px 20px rgba(0,0,0,.15);
                }

            .btn {
                border-radius: 8px;
            }

            footer {
                margin-top: 60px;
                background: #0d6efd;
                color: white;
                padding: 15px;
                text-align: center;
            }

    </style>

</head>

<body>

    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">

        <div class="container-fluid">

            <a class="navbar-brand"
               asp-controller="Home"
               asp-action="Index">

                <i class="bi bi-heart-pulse-fill"></i>

                Student Mental Health Monitoring System

            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarNav">

                <span class="navbar-toggler-icon"></span>

            </button>

            <div class="collapse navbar-collapse"
                 id="navbarNav">

                <ul class="navbar-nav ms-auto">

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Home"
                           asp-action="Index">
                            Home
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Student"
                           asp-action="Login">
                            Student
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Psychologist"
                           asp-action="Login">
                            Psychologist
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Department"
                           asp-action="Login">
                            Department
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Admin"
                           asp-action="Login">
                            Admin
                        </a>
                    </li>

                </ul>

            </div>

        </div>

    </nav>

    <div class="container-fluid page-container">

        @RenderBody()

    </div>

    <footer>

        AI Assisted Student Mental Health Monitoring System © 2026

    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>