@{
    var departmentName =
        Context.Session.GetString("DepartmentName")
        ?? "Department";

    var currentAction =
        ViewContext.RouteData.Values["action"]?.ToString();
}


<!DOCTYPE html>

<html lang="en">

<head>

    <!-- =====================================================
         BASIC PAGE SETTINGS
         ===================================================== -->

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - SMHMS
    </title>


    <!-- =====================================================
         BOOTSTRAP CSS
         ===================================================== -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />


    <!-- =====================================================
         BOOTSTRAP ICONS
         ===================================================== -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <script src="~/lib/html2pdf/html2pdf.bundle.min.js"></script>
    <script src="~/js/report-pdf-engine.js" asp-append-version="true"></script>


    <!-- =====================================================
         DEPARTMENT LAYOUT CSS
         ===================================================== -->

    <style>

            /* =====================================================
                                   BODY
                                   ===================================================== */

            body {
                margin: 0;
                min-height: 100vh;
                background: linear-gradient( 135deg, #F4F8FA, #F8F6FA );
                color: #526A79;
                font-family: "Segoe UI", Arial, sans-serif;
            }


            /* =====================================================
                                   MAIN WRAPPER
                                   ===================================================== */

            .department-wrapper {
                min-height: 100vh;
                display: flex;
            }


            /* =====================================================
                                   SIDEBAR
                                   ===================================================== */

            .department-sidebar {
                width: 260px;
                min-height: 100vh;
                position: fixed;
                left: 0;
                top: 0;
                z-index: 1000;
                background: linear-gradient( 180deg, #DCECF5 0%, #E9E5F1 100% );
                border-right: 1px solid #D5E1E7;
                padding: 24px 16px;
                box-shadow: 5px 0 25px rgba(75, 105, 120, 0.07);
            }


            /* =====================================================
                                   BRAND
                                   ===================================================== */

            .department-brand {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 6px 10px 22px;
                border-bottom: 1px solid rgba(110, 135, 150, 0.18);
                margin-bottom: 20px;
            }


            .department-brand-icon {
                width: 48px;
                height: 48px;
                min-width: 48px;
                border-radius: 15px;
                background: rgba(255, 255, 255, 0.72);
                display: flex;
                align-items: center;
                justify-content: center;
                color: #5C8197;
                font-size: 22px;
                box-shadow: 0 5px 15px rgba(70, 100, 120, 0.08);
            }


            .department-brand-title {
                color: #466375;
                font-size: 16px;
                font-weight: 700;
                margin: 0;
            }


            .department-brand-subtitle {
                color: #8296A2;
                font-size: 11px;
                margin-top: 2px;
            }


            /* =====================================================
                                   SIDEBAR SECTION TITLE
                                   ===================================================== */

            .sidebar-section-title {
                color: #8A9BA5;
                font-size: 12px;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 1px;
                padding: 8px 12px;
                margin-bottom: 6px;
            }


            /* =====================================================
                                   NAVIGATION
                                   ===================================================== */

            .department-nav {
                display: flex;
                flex-direction: column;
                gap: 5px;
            }


            .department-nav-link {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 12px 14px;
                border-radius: 13px;
                text-decoration: none;
                color: #475569;
                font-size: 15px;
                font-weight: 600;
                transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease;
            }


                .department-nav-link:hover {
                    background: rgba(255, 255, 255, 0.75);
                    color: #0F172A;
                    transform: translateX(3px);
                }


                .department-nav-link.active {
                    background: #FFFFFF;
                    color: #0F172A;
                    font-weight: 700;
                    box-shadow: 0 5px 14px rgba(70, 100, 120, 0.1);
                }


            .department-nav-icon {
                width: 24px;
                text-align: center;
                font-size: 19px;
            }


            /* =====================================================
                                   SIDEBAR BOTTOM
                                   ===================================================== */

            .sidebar-bottom {
                position: absolute;
                left: 16px;
                right: 16px;
                bottom: 20px;
            }


            /* =====================================================
                                   DEPARTMENT USER BOX
                                   ===================================================== */

            .department-user-box {
                display: flex;
                align-items: center;
                gap: 11px;
                padding: 13px;
                background: rgba(255, 255, 255, 0.55);
                border: 1px solid rgba(130, 150, 160, 0.15);
                border-radius: 15px;
                margin-bottom: 10px;
            }


            .department-user-icon {
                width: 40px;
                height: 40px;
                min-width: 40px;
                border-radius: 12px;
                background: #EDF5F8;
                color: #628397;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 17px;
            }


            .department-user-name {
                color: #526B79;
                font-size: 12px;
                font-weight: 650;
            }


            .department-user-role {
                color: #91A0A8;
                font-size: 10px;
                margin-top: 2px;
            }


            /* =====================================================
                                   LOGOUT
                                   ===================================================== */

            .department-logout {
                display: flex;
                align-items: center;
                gap: 10px;
                width: 100%;
                padding: 11px 13px;
                border-radius: 12px;
                background: rgba(255, 255, 255, 0.48);
                color: #8A6972;
                text-decoration: none;
                font-size: 12px;
                transition: background 0.2s ease, color 0.2s ease;
            }


                .department-logout:hover {
                    background: #F7EDEF;
                    color: #A0616D;
                }


            /* =====================================================
                                   MAIN CONTENT AREA
                                   ===================================================== */

            .department-main {
                width: calc(100% - 260px);
                margin-left: 260px;
                min-height: 100vh;
            }


            /* =====================================================
                                   TOP BAR
                                   ===================================================== */

            .department-topbar {
                min-height: 74px;
                background: rgba(255, 255, 255, 0.88);
                border-bottom: 1px solid #E4EBEE;
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 14px 30px;
                position: sticky;
                top: 0;
                z-index: 900;
                backdrop-filter: blur(10px);
            }


            .topbar-page-title {
                color: #4B6575;
                font-size: 17px;
                font-weight: 650;
                margin: 0;
            }


            .topbar-page-subtitle {
                color: #94A1A8;
                font-size: 11px;
                margin-top: 2px;
            }


            /* =====================================================
                                   TOPBAR DEPARTMENT
                                   ===================================================== */

            .topbar-department {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 7px 12px;
                border-radius: 12px;
                background: #F1F6F8;
            }


            .topbar-department-icon {
                width: 32px;
                height: 32px;
                border-radius: 10px;
                background: #E3F1F7;
                color: #60859A;
                display: flex;
                align-items: center;
                justify-content: center;
            }


            .topbar-department-name {
                color: #607785;
                font-size: 12px;
                font-weight: 600;
            }


            /* =====================================================
                                   PAGE CONTENT
                                   ===================================================== */

            .department-content {
                padding: 28px 30px;
            }


            /* =====================================================
                                   MOBILE RESPONSIVE
                                   ===================================================== */

            @@media (max-width: 991px) {

                .department-sidebar {
                    position: relative;
                    width: 100%;
                    min-height: auto;
                    border-right: none;
                    border-bottom: 1px solid #D5E1E7;
                    padding: 18px;
                }


                .department-wrapper {
                    display: block;
                }


                .department-main {
                    width: 100%;
                    margin-left: 0;
                }


                .department-nav {
                    display: grid;
                    grid-template-columns: repeat(2, 1fr);
                    gap: 8px;
                }


                .sidebar-bottom {
                    position: static;
                    margin-top: 20px;
                }


                .department-topbar {
                    position: relative;
                    padding: 16px 20px;
                }


                .department-content {
                    padding: 20px;
                }
            }


            /* =====================================================
                                   SMALL MOBILE
                                   ===================================================== */

            @@media (max-width: 576px) {

                .department-nav {
                    grid-template-columns: 1fr;
                }


                .topbar-department {
                    display: none;
                }


                .department-content {
                    padding: 15px;
                }


                .department-brand {
                    padding-bottom: 16px;
                    margin-bottom: 14px;
                }
            }

    </style>

</head>


<body>


    <!-- =========================================================
     MAIN DEPARTMENT WRAPPER
     ========================================================= -->

    <div class="department-wrapper">


        <!-- =====================================================
         SIDEBAR
         ===================================================== -->

        <aside class="department-sidebar">


            <!-- =================================================
             BRAND
             ================================================= -->

            <div class="department-brand">

                <div class="department-brand-icon">

                    <i class="bi bi-heart-pulse"></i>

                </div>


                <div>

                    <div class="department-brand-title">

                        SMHMS

                    </div>


                    <div class="department-brand-subtitle">

                        Department Portal

                    </div>

                </div>

            </div>


            <!-- =================================================
             NAVIGATION TITLE
             ================================================= -->

            <div class="sidebar-section-title">

                Main Menu

            </div>


            <!-- =================================================
             NAVIGATION LINKS
             ================================================= -->

            <nav class="department-nav">


                <!-- =============================================
                 DASHBOARD
                 ============================================= -->

                <a asp-controller="Department"
                   asp-action="Dashboard"
                   class="department-nav-link
                    @(currentAction == "Dashboard"
                      ? "active"
                      : "")">

                    <span class="department-nav-icon">

                        <i class="bi bi-grid-1x2"></i>

                    </span>

                    <span>

                        Dashboard

                    </span>

                </a>


                <!-- =============================================
                 STUDENTS
                 ============================================= -->

                <a asp-controller="Department"
                   asp-action="Students"
                   class="department-nav-link
                    @(currentAction == "Students"
                      ? "active"
                      : "")">

                    <span class="department-nav-icon">

                        <i class="bi bi-people"></i>

                    </span>

                    <span>

                        Students

                    </span>

                </a>


                <!-- =============================================
                 COUNSELING
                 ============================================= -->

                <a asp-controller="Department"
                   asp-action="Counseling"
                   class="department-nav-link
                    @(currentAction == "Counseling"
                      ? "active"
                      : "")">

                    <span class="department-nav-icon">

                        <i class="bi bi-chat-heart"></i>

                    </span>

                    <span>

                        Counseling

                    </span>

                </a>


                <!-- =============================================
                 FOLLOW-UP
                 ============================================= -->

                <a asp-controller="Department"
                   asp-action="FollowUp"
                   class="department-nav-link
                    @(currentAction == "FollowUp"
                      ? "active"
                      : "")">

                    <span class="department-nav-icon">

                        <i class="bi bi-calendar-heart"></i>

                    </span>

                    <span>

                        Follow-up

                    </span>

                </a>


                <!-- =============================================
                 RISK REPORTS
                 ============================================= -->

                <a asp-controller="Department"
                   asp-action="Reports"
                   class="department-nav-link
                    @(currentAction == "Reports"
                      ? "active"
                      : "")">

                    <span class="department-nav-icon">

                        <i class="bi bi-bar-chart"></i>

                    </span>

                    <span>

                        Risk Reports

                    </span>

                </a>


                <!-- =============================================
                 OBSERVATION REPORTS
                 ============================================= -->

                <a asp-controller="Department"
                   asp-action="ObservationReports"
                   class="department-nav-link
                    @((currentAction == "ObservationReports" ||
                      currentAction == "ObservationReportDetails")
                      ? "active"
                      : "")">

                    <span class="department-nav-icon">

                        <i class="bi bi-journal-medical"></i>

                    </span>

                    <span>

                        Observation Reports

                    </span>

                </a>


                <!-- =============================================
                 SCREENING ANALYTICS
                 ============================================= -->

                <a asp-controller="Department"
                   asp-action="ScreeningAnalytics"
                   class="department-nav-link
                    @(currentAction == "ScreeningAnalytics"
                      ? "active"
                      : "")">

                    <span class="department-nav-icon">

                        <i class="bi bi-pie-chart-fill"></i>

                    </span>

                    <span>

                        Screening Analytics

                    </span>

                </a>


                <!-- =============================================
                 STUDENT PROGRESS REPORTS
                 ============================================= -->

                <a asp-controller="Department"
                   asp-action="StudentProgressReports"
                   class="department-nav-link
                    @((currentAction == "StudentProgressReports" || currentAction == "StudentProgressDetails")
                      ? "active"
                      : "")">

                    <span class="department-nav-icon">

                        <i class="bi bi-graph-up-arrow"></i>

                    </span>

                    <span>

                        Progress Reports

                    </span>

                </a>


                <!-- =============================================
                 SCREENING COMPLIANCE REPORT
                 ============================================= -->

                <a asp-controller="Department"
                   asp-action="ScreeningCompliance"
                   class="department-nav-link
                    @(currentAction == "ScreeningCompliance"
                      ? "active"
                      : "")">

                    <span class="department-nav-icon">

                        <i class="bi bi-journal-check"></i>

                    </span>

                    <span>

                        Screening Compliance

                    </span>

                </a>


                <!-- =============================================
                 END-OF-SEMESTER OVERALL REPORT
                 ============================================= -->

                <a asp-controller="Department"
                   asp-action="EndOfWeekSemesterReport"
                   class="department-nav-link
                    @(currentAction == "EndOfWeekSemesterReport"
                      ? "active"
                      : "")">

                    <span class="department-nav-icon">

                        <i class="bi bi-journal-text"></i>

                    </span>

                    <span>

                        Semester End Report

                    </span>

                </a>

            </nav>


            <!-- =================================================
             SIDEBAR BOTTOM
             ================================================= -->

            <div class="sidebar-bottom">


                <!-- =============================================
                 DEPARTMENT ACCOUNT
                 ============================================= -->

                <div class="department-user-box">

                    <div class="department-user-icon">

                        <i class="bi bi-building"></i>

                    </div>


                    <div class="overflow-hidden">

                        <div class="department-user-name text-truncate">

                            @departmentName

                        </div>


                        <div class="department-user-role">

                            Department Account

                        </div>

                    </div>

                </div>


                <!-- =============================================
                 LOGOUT
                 ============================================= -->

                <a asp-controller="Department"
                   asp-action="Logout"
                   class="department-logout">

                    <i class="bi bi-box-arrow-left"></i>

                    <span>

                        Logout

                    </span>

                </a>

            </div>

        </aside>


        <!-- =====================================================
         MAIN AREA
         ===================================================== -->

        <main class="department-main">


            <!-- =================================================
             TOP BAR
             ================================================= -->

            <header class="department-topbar">


                <!-- =============================================
                 PAGE INFORMATION
                 ============================================= -->

                <div>

                    <h6 class="topbar-page-title">

                        @ViewData["Title"]

                    </h6>


                    <div class="topbar-page-subtitle">

                        Student Mental Health Monitoring System

                    </div>

                </div>


                <!-- =============================================
                 DEPARTMENT NAME
                 ============================================= -->

                <div class="topbar-department">

                    <div class="topbar-department-icon">

                        <i class="bi bi-building"></i>

                    </div>


                    <span class="topbar-department-name">

                        @departmentName

                    </span>

                </div>

            </header>


            <!-- =================================================
             PAGE CONTENT
             ================================================= -->

            <div class="department-content">

                @RenderBody()

            </div>

        </main>

    </div>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- =========================================================
     OPTIONAL RAZOR SCRIPT SECTION
     ========================================================= -->
    @await RenderSectionAsync(
        "Scripts",
        required: false
    )

</body>

</html>