<!-- ================= Logo ================= -->

<div class="text-center py-4">

    <i class="bi bi-heart-pulse-fill"
       style="font-size:50px;color:white;"></i>

    <h4 class="text-white mt-3">

        SMHMS

    </h4>

    <small class="text-light">

        Admin Panel

    </small>

</div>


<hr class="text-light" />


<!-- ================= Menu ================= -->

<div class="list-group px-3">


    <!-- Dashboard -->

    <a asp-controller="Admin"
       asp-action="Dashboard"
       class="list-group-item list-group-item-action border-0 rounded-3 mb-2">

        <i class="bi bi-speedometer2 me-2"></i>

        Dashboard

    </a>


    <!-- Students -->

    <a asp-controller="Admin"
       asp-action="Students"
       class="list-group-item list-group-item-action border-0 rounded-3 mb-2">

        <i class="bi bi-mortarboard me-2"></i>

        Students

    </a>


    <!-- Psychologists -->

    <a asp-controller="Admin"
       asp-action="Psychologists"
       class="list-group-item list-group-item-action border-0 rounded-3 mb-2">

        <i class="bi bi-person-heart me-2"></i>

        Psychologists

    </a>


    <!-- Departments -->

    <a asp-controller="Admin"
       asp-action="Departments"
       class="list-group-item list-group-item-action border-0 rounded-3 mb-2">

        <i class="bi bi-building me-2"></i>

        Departments

    </a>


    <!-- Reports -->

    <a asp-controller="Admin"
       asp-action="Reports"
       class="list-group-item list-group-item-action border-0 rounded-3 mb-2">

        <i class="bi bi-file-earmark-bar-graph me-2"></i>

        Reports

    </a>


    <!-- Counseling -->

    <a asp-controller="Admin"
       asp-action="CounselingReport"
       class="list-group-item list-group-item-action border-0 rounded-3 mb-2">

        <i class="bi bi-calendar2-heart me-2"></i>

        Counseling

    </a>


    <!-- Observation Reports -->

    <a asp-controller="Admin"
       asp-action="ObservationReports"
       class="list-group-item list-group-item-action border-0 rounded-3 mb-2">

        <i class="bi bi-journal-medical me-2"></i>

        Observation Reports

    </a>


    <!-- Analytics -->

    <a asp-controller="Admin"
       asp-action="Analytics"
       class="list-group-item list-group-item-action border-0 rounded-3 mb-2">

        <i class="bi bi-bar-chart-line me-2"></i>

        Analytics

    </a>


    <!-- Screening Analytics -->

    <a asp-controller="Admin"
       asp-action="ScreeningAnalytics"
       class="list-group-item list-group-item-action border-0 rounded-3 mb-2">

        <i class="bi bi-pie-chart-fill me-2"></i>

        Screening Analytics

    </a>


    <!-- Student Progress Reports -->

    <a asp-controller="Admin"
       asp-action="StudentProgressReports"
       class="list-group-item list-group-item-action border-0 rounded-3 mb-2">

        <i class="bi bi-graph-up-arrow me-2"></i>

        Progress Reports

    </a>


    <!-- Screening Compliance -->

    <a asp-controller="Admin"
       asp-action="ScreeningCompliance"
       class="list-group-item list-group-item-action border-0 rounded-3 mb-2">

        <i class="bi bi-shield-check me-2"></i>

        Screening Compliance

    </a>


    <!-- Semester Transition & Management -->

    <a asp-controller="Admin"
       asp-action="SemesterManagement"
       class="list-group-item list-group-item-action border-0 rounded-3 mb-2">

        <i class="bi bi-arrow-repeat me-2"></i>

        Semester Transition

    </a>


    <!-- Department Semester End Reports -->

    <a asp-controller="Admin"
       asp-action="SemesterEndReports"
       class="list-group-item list-group-item-action border-0 rounded-3 mb-2">

        <i class="bi bi-journal-text me-2"></i>

        Semester End Reports

    </a>


    <!-- Settings -->

    <a asp-controller="Admin"
       asp-action="Settings"
       class="list-group-item list-group-item-action border-0 rounded-3 mb-2">

        <i class="bi bi-gear me-2"></i>

        Settings

    </a>


    <!-- Profile -->

    <a asp-controller="Admin"
       asp-action="Profile"
       class="list-group-item list-group-item-action border-0 rounded-3 mb-2">

        <i class="bi bi-person-circle me-2"></i>

        Profile

    </a>

</div>


<!-- ================= Logout ================= -->

<div class="position-absolute bottom-0 start-0 w-100 p-3">

    <a asp-controller="Admin"
       asp-action="Logout"
       class="btn btn-light w-100 rounded-3">

        <i class="bi bi-box-arrow-right me-2"></i>

        Logout

    </a>

</div>