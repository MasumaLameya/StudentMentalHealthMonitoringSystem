@{
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
}

<!-- ================= Logo ================= -->

<div class="text-center py-4">

    <i class="bi bi-heart-pulse-fill"
       style="font-size:48px;color:#8A7563;"></i>

    <h4 class="fw-bold mt-2" style="color:#5F5146;">
        SMHMS
    </h4>

    <small class="text-muted fw-semibold">
        Admin Panel
    </small>

</div>

<hr style="border-color:#EDE2D8; margin: 0 1rem 1rem 1rem;" />

<!-- ================= Menu ================= -->

<div class="list-group px-3" style="max-height: calc(100vh - 220px); overflow-y: auto;">

    <!-- Dashboard -->
    <a asp-controller="Admin"
       asp-action="Dashboard"
       class="list-group-item list-group-item-action border-0 rounded-3 mb-2 d-flex align-items-center @(currentAction == "Dashboard" ? "fw-bold shadow-sm" : "")"
       style="@(currentAction == "Dashboard" ? "background:#8A7563; color:white;" : "color:#5F5146; background:transparent;")">
        <i class="bi bi-speedometer2 me-2 @(currentAction == "Dashboard" ? "text-white" : "text-secondary")"></i>
        <span>Dashboard</span>
    </a>

    <!-- Students -->
    <a asp-controller="Admin"
       asp-action="Students"
       class="list-group-item list-group-item-action border-0 rounded-3 mb-2 d-flex align-items-center @(currentAction == "Students" || currentAction == "AddStudent" || currentAction == "EditStudent" || currentAction == "StudentDetails" ? "fw-bold shadow-sm" : "")"
       style="@(currentAction == "Students" || currentAction == "AddStudent" || currentAction == "EditStudent" || currentAction == "StudentDetails" ? "background:#8A7563; color:white;" : "color:#5F5146; background:transparent;")">
        <i class="bi bi-mortarboard me-2 @(currentAction == "Students" || currentAction == "AddStudent" || currentAction == "EditStudent" || currentAction == "StudentDetails" ? "text-white" : "text-secondary")"></i>
        <span>Students</span>
    </a>

    <!-- Psychologists -->
    <a asp-controller="Admin"
       asp-action="Psychologists"
       class="list-group-item list-group-item-action border-0 rounded-3 mb-2 d-flex align-items-center @(currentAction == "Psychologists" || currentAction == "AddPsychologist" || currentAction == "EditPsychologist" || currentAction == "PsychologistDetails" ? "fw-bold shadow-sm" : "")"
       style="@(currentAction == "Psychologists" || currentAction == "AddPsychologist" || currentAction == "EditPsychologist" || currentAction == "PsychologistDetails" ? "background:#8A7563; color:white;" : "color:#5F5146; background:transparent;")">
        <i class="bi bi-person-heart me-2 @(currentAction == "Psychologists" || currentAction == "AddPsychologist" || currentAction == "EditPsychologist" || currentAction == "PsychologistDetails" ? "text-white" : "text-secondary")"></i>
        <span>Psychologists</span>
    </a>

    <!-- Departments -->
    <a asp-controller="Admin"
       asp-action="Departments"
       class="list-group-item list-group-item-action border-0 rounded-3 mb-2 d-flex align-items-center @(currentAction == "Departments" || currentAction == "AddDepartment" || currentAction == "EditDepartment" ? "fw-bold shadow-sm" : "")"
       style="@(currentAction == "Departments" || currentAction == "AddDepartment" || currentAction == "EditDepartment" ? "background:#8A7563; color:white;" : "color:#5F5146; background:transparent;")">
        <i class="bi bi-building me-2 @(currentAction == "Departments" || currentAction == "AddDepartment" || currentAction == "EditDepartment" ? "text-white" : "text-secondary")"></i>
        <span>Departments</span>
    </a>

    <!-- Reports Hub -->
    <a asp-controller="Admin"
       asp-action="Reports"
       class="list-group-item list-group-item-action border-0 rounded-3 mb-2 d-flex align-items-center @(currentAction == "Reports" || currentAction == "Analytics" || currentAction == "ScreeningAnalytics" || currentAction == "CrisisEscalationReport" || currentAction == "PsychologistWorkloadReport" || currentAction == "StudentProgressReports" || currentAction == "AcademicAdministrationReport" || currentAction == "ScreeningCompliance" || currentAction == "CounselingReport" || currentAction == "StudentReport" || currentAction == "ObservationReports" ? "fw-bold shadow-sm" : "")"
       style="@(currentAction == "Reports" || currentAction == "Analytics" || currentAction == "ScreeningAnalytics" || currentAction == "CrisisEscalationReport" || currentAction == "PsychologistWorkloadReport" || currentAction == "StudentProgressReports" || currentAction == "AcademicAdministrationReport" || currentAction == "ScreeningCompliance" || currentAction == "CounselingReport" || currentAction == "StudentReport" || currentAction == "ObservationReports" ? "background:#8A7563; color:white;" : "color:#5F5146; background:transparent;")">
        <i class="bi bi-file-earmark-bar-graph me-2 @(currentAction == "Reports" || currentAction == "Analytics" || currentAction == "ScreeningAnalytics" || currentAction == "CrisisEscalationReport" || currentAction == "PsychologistWorkloadReport" || currentAction == "StudentProgressReports" || currentAction == "AcademicAdministrationReport" || currentAction == "ScreeningCompliance" || currentAction == "CounselingReport" || currentAction == "StudentReport" || currentAction == "ObservationReports" ? "text-white" : "text-secondary")"></i>
        <span>Reports Hub</span>
    </a>

    <!-- Semester Transition & Management -->
    <a asp-controller="Admin"
       asp-action="SemesterManagement"
       class="list-group-item list-group-item-action border-0 rounded-3 mb-2 d-flex align-items-center @(currentAction == "SemesterManagement" ? "fw-bold shadow-sm" : "")"
       style="@(currentAction == "SemesterManagement" ? "background:#8A7563; color:white;" : "color:#5F5146; background:transparent;")">
        <i class="bi bi-arrow-repeat me-2 @(currentAction == "SemesterManagement" ? "text-white" : "text-secondary")"></i>
        <span>Semester Transition</span>
    </a>

    <!-- Settings -->
    <a asp-controller="Admin"
       asp-action="Settings"
       class="list-group-item list-group-item-action border-0 rounded-3 mb-2 d-flex align-items-center @(currentAction == "Settings" ? "fw-bold shadow-sm" : "")"
       style="@(currentAction == "Settings" ? "background:#8A7563; color:white;" : "color:#5F5146; background:transparent;")">
        <i class="bi bi-gear me-2 @(currentAction == "Settings" ? "text-white" : "text-secondary")"></i>
        <span>Settings</span>
    </a>

    <!-- Profile -->
    <a asp-controller="Admin"
       asp-action="Profile"
       class="list-group-item list-group-item-action border-0 rounded-3 mb-2 d-flex align-items-center @(currentAction == "Profile" ? "fw-bold shadow-sm" : "")"
       style="@(currentAction == "Profile" ? "background:#8A7563; color:white;" : "color:#5F5146; background:transparent;")">
        <i class="bi bi-person-circle me-2 @(currentAction == "Profile" ? "text-white" : "text-secondary")"></i>
        <span>Profile</span>
    </a>

    <!-- Change Password -->
    <a asp-controller="Admin"
       asp-action="ChangePassword"
       class="list-group-item list-group-item-action border-0 rounded-3 mb-2 d-flex align-items-center @(currentAction == "ChangePassword" ? "fw-bold shadow-sm" : "")"
       style="@(currentAction == "ChangePassword" ? "background:#8A7563; color:white;" : "color:#5F5146; background:transparent;")">
        <i class="bi bi-key me-2 @(currentAction == "ChangePassword" ? "text-white" : "text-secondary")"></i>
        <span>Change Password</span>
    </a>

</div>

<!-- ================= Logout ================= -->

<div class="p-3 mt-auto">
    <a asp-controller="Admin"
       asp-action="Logout"
       class="btn btn-outline-danger w-100 rounded-3 d-flex align-items-center justify-content-center gap-2">
        <i class="bi bi-box-arrow-right"></i>
        <span>Logout</span>
    </a>
</div>