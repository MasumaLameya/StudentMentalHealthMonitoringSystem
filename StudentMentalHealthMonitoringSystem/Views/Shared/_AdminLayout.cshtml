<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>

        @ViewData["Title"] -
        Student Mental Health Monitoring System

    </title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <script src="~/lib/html2pdf/html2pdf.bundle.min.js"></script>
    <script src="~/js/report-pdf-engine.js" asp-append-version="true"></script>

</head>

<body style="background:#F8F5F2;">

    <div class="container-fluid">

        <div class="row">

            <!-- Sidebar -->

            <div class="col-lg-2 p-0">

                @await Html.PartialAsync("_AdminSidebar")

            </div>

            <!-- Main Content -->

            <div class="col-lg-10 p-0">

                @await Html.PartialAsync("_AdminNavbar")

                <div class="p-4">

                    @RenderBody()

                </div>

            </div>

        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>
