@model List<StudentMentalHealthMonitoringSystem.ViewModels.StudentProgressReportDetailViewModel>

@{
    Layout = "_Layout";
    ViewData["Title"] = "Student Counseling Progress & Recovery Report";
    var student = ViewBag.Student as StudentMentalHealthMonitoringSystem.Models.Student;
}

<style>
    .guardian-progress-page {
        padding: 30px 15px;
    }

    .guardian-header {
        background: linear-gradient(135deg, #A9D5E8, #C7DDE8, #DCD1E7);
        border-radius: 24px;
        padding: 30px;
        box-shadow: 0 8px 28px rgba(70,100,120,0.09);
    }

    .guardian-header h2 {
        color: #405F70;
        font-weight: 700;
    }

    .guardian-header p {
        color: #718894;
        font-size: 14px;
    }

    .glass-card {
        background: rgba(255, 255, 255, 0.95);
        border: 1px solid rgba(226, 232, 240, 0.8);
        border-radius: 1.25rem;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05);
    }
</style>

<div class="container py-4 guardian-progress-page">

    <!-- Top Header -->
    <div class="guardian-header mb-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <div style="color:#718894; font-size:12px; margin-bottom:5px;">
                    Guardian Portal &bull; Counseling Monitoring
                </div>
                <h2 class="mb-1">
                    <i class="bi bi-graph-up-arrow me-2"></i>
                    Student Progress &amp; Recovery Report
                </h2>
                <p class="mb-0">
                    Track the mental health counseling journey, recovery score trajectories, and psychologist session evaluations for @(student?.FullName ?? "your student").
                </p>
            </div>
            <div class="d-flex align-items-center gap-2">
                <a asp-controller="Guardian" asp-action="Dashboard" class="btn btn-light rounded-pill px-4 py-2 fw-semibold shadow-sm border">
                    <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
                </a>
            </div>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        @foreach (var report in Model)
        {
            <!-- Report Card Container -->
            <div class="card border-0 shadow-sm rounded-4 mb-5 bg-white overflow-hidden" id="guardianIndividualProgressReport_@report.ObservationReportId">
                
                <!-- Report Header Bar -->
                <div class="card-header bg-light border-0 p-4">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                        <div class="d-flex align-items-center gap-3">
                            <img src="@(string.IsNullOrEmpty(report.ProfileImage) ? "/images/default-avatar.png" : report.ProfileImage)"
                                 class="rounded-circle shadow-sm border border-2 border-primary" style="width: 65px; height: 65px; object-fit: cover;" alt="Avatar" />
                            <div>
                                <div class="badge bg-primary rounded-pill px-3 py-1 mb-1">
                                    <i class="bi bi-person-badge me-1"></i> Counseling Case Report
                                </div>
                                <h4 class="fw-bold text-dark mb-1">@report.StudentName</h4>
                                <div class="text-muted small">
                                    <span><i class="bi bi-card-text me-1"></i> ID: <strong>@report.StudentIdNumber</strong></span>
                                    <span class="mx-1">&bull;</span>
                                    <span><i class="bi bi-building me-1"></i> Dept: <strong>@report.Department</strong></span>
                                    <span class="mx-1">&bull;</span>
                                    <span><i class="bi bi-person-check me-1"></i> Psychologist: <strong>@report.PsychologistName</strong></span>
                                </div>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <button type="button" class="btn btn-danger rounded-pill px-4 py-2 fw-semibold shadow-sm" onclick="downloadReportPdf('#guardianIndividualProgressReport_@report.ObservationReportId', { title: '@report.StudentName - Progress Report', filename: '@(report.StudentName.Replace(" ", "_"))_Progress_Report' })">
                                <i class="bi bi-file-earmark-pdf-fill me-1"></i> Download PDF Report
                            </button>
                            @if (report.IsFinal)
                            {
                                <span class="badge bg-success-subtle text-success border border-success fs-6 px-4 py-2 rounded-pill">
                                    <i class="bi bi-check-circle-fill me-1"></i> Follow-up Completed
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning-subtle text-warning border border-warning fs-6 px-4 py-2 rounded-pill">
                                    <i class="bi bi-arrow-repeat me-1"></i> Continuous Follow-up (In Progress)
                                </span>
                            }
                        </div>
                    </div>
                </div>

                <div class="card-body p-4">
                    <!-- Metrics Cards -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-3">
                            <div class="card border-0 bg-light rounded-4 h-100">
                                <div class="card-body p-3 text-center">
                                    <div class="text-muted small fw-bold text-uppercase mb-1">Total Sessions</div>
                                    <h3 class="fw-bold text-dark mb-0">@report.TotalSessions</h3>
                                    <small class="text-muted">Conducted Sessions</small>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="card border-0 bg-light rounded-4 h-100">
                                <div class="card-body p-3 text-center">
                                    <div class="text-muted small fw-bold text-uppercase mb-1">Initial Baseline Score</div>
                                    @if (report.TotalSessions > 0)
                                    {
                                        <h3 class="fw-bold text-secondary mb-0">@report.InitialScore / 100</h3>
                                        <small class="text-muted">Session 1 Evaluation</small>
                                    }
                                    else
                                    {
                                        <h3 class="fw-bold text-secondary mb-0">-- / 100</h3>
                                        <small class="text-muted">Awaiting Evaluation</small>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="card border-0 bg-light rounded-4 h-100">
                                <div class="card-body p-3 text-center">
                                    <div class="text-muted small fw-bold text-uppercase mb-1">Current Recovery Score</div>
                                    @if (report.TotalSessions > 0)
                                    {
                                        <h3 class="fw-bold text-primary mb-0">@report.LatestScore / 100</h3>
                                        <small class="text-muted">Score Diff: <strong>@(report.ScoreDifference >= 0 ? "+" + report.ScoreDifference : report.ScoreDifference.ToString())</strong> pts</small>
                                    }
                                    else
                                    {
                                        <h3 class="fw-bold text-muted mb-0">-- / 100</h3>
                                        <small class="text-muted">No sessions evaluated yet</small>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="card border-0 bg-light rounded-4 h-100">
                                <div class="card-body p-3 text-center">
                                    <div class="text-muted small fw-bold text-uppercase mb-1">Overall Recovery Status</div>
                                    <div class="mt-2">
                                        @if (report.TotalSessions == 0 || report.OverallImprovementStatus == "Pending")
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary fs-6 px-4 py-2 rounded-pill">
                                                <i class="bi bi-clock-history me-1"></i> Awaiting Evaluation
                                            </span>
                                        }
                                        else if (report.OverallImprovementStatus == "Improved")
                                        {
                                            <span class="badge bg-success fs-6 px-4 py-2 rounded-pill">
                                                <i class="bi bi-arrow-up-right-circle me-1"></i> Improved
                                            </span>
                                        }
                                        else if (report.OverallImprovementStatus == "Deteriorated")
                                        {
                                            <span class="badge bg-danger fs-6 px-4 py-2 rounded-pill">
                                                <i class="bi bi-arrow-down-right-circle me-1"></i> Needs Attention
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark fs-6 px-4 py-2 rounded-pill">
                                                <i class="bi bi-dash-circle me-1"></i> Stable Progress
                                            </span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Line Chart: Student Progress Trajectory -->
                    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
                        <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0">
                            <h5 class="fw-bold text-dark mb-0">
                                <i class="bi bi-activity me-2 text-primary"></i>
                                Recovery &amp; Progress Trajectory Line Graph
                            </h5>
                            <small class="text-muted">Standardized recovery score trajectory across follow-up counseling sessions (X-axis: Sessions, Y-axis: Score 0-100)</small>
                        </div>
                        <div class="card-body p-4">
                            @if (report.TotalSessions > 0)
                            {
                                <div style="position: relative; height: 280px; width: 100%;">
                                    <canvas id="guardianLineChart_@report.ObservationReportId"></canvas>
                                </div>
                            }
                            else
                            {
                                <div class="text-center py-5 text-muted bg-light rounded-4">
                                    <i class="bi bi-graph-up text-secondary" style="font-size: 2.5rem;"></i>
                                    <h6 class="fw-bold mt-2 text-dark">No Session Evaluation Yet</h6>
                                    <p class="small text-muted mb-0">The recovery trajectory chart will appear here once the psychologist conducts the first counseling evaluation.</p>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Session-by-Session Follow-up Table with Key Observation Info -->
                    <div class="card border-0 shadow-sm rounded-4 bg-white mb-4">
                        <div class="card-header bg-transparent border-0 pt-4 px-4 pb-2">
                            <h5 class="fw-bold text-dark mb-0">
                                <i class="bi bi-journal-check me-2 text-primary"></i>
                                Follow-up Sessions &amp; Evaluation Timeline
                            </h5>
                            <small class="text-muted">Session-by-session observation stages, mental health status, functional domains, and recovery indicators</small>
                        </div>
                        <div class="card-body p-4">
                            @if (report.Sessions != null && report.Sessions.Any())
                            {
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Session Details</th>
                                                <th class="text-center">Recovery Score</th>
                                                <th class="text-center">Mental Health Status</th>
                                                <th class="text-center">Safety Risk</th>
                                                <th class="text-center">Functional Status</th>
                                                <th class="text-center">Session Progress</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var session in report.Sessions)
                                            {
                                                <tr>
                                                    <td>
                                                        <div class="fw-bold text-dark">@session.SessionTitle</div>
                                                        <div class="small text-muted">
                                                            <i class="bi bi-calendar3 me-1"></i> @session.SessionDate.ToString("MMM dd, yyyy")
                                                            @if (!string.IsNullOrEmpty(session.CounselingTime))
                                                            {
                                                                <span class="ms-1">&bull; @session.CounselingTime</span>
                                                            }
                                                        </div>
                                                    </td>
                                                    <td class="text-center">
                                                        <div class="fs-5 fw-bold text-primary">@session.SessionScore <span class="small fs-6 text-muted">/ 100</span></div>
                                                        @if (session.SessionNumber > 1)
                                                        {
                                                            <span class="badge @(session.ScoreChange >= 0 ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger") rounded-pill">
                                                                @(session.ScoreChange >= 0 ? "+" + session.ScoreChange : session.ScoreChange.ToString()) pts
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-secondary-subtle text-secondary rounded-pill">Baseline</span>
                                                        }
                                                    </td>
                                                    <td class="text-center">
                                                        <span class="badge @(session.MentalHealthStatus == "Normal" ? "bg-success" : session.MentalHealthStatus == "Moderate" ? "bg-warning text-dark" : "bg-danger") rounded-pill px-3 py-1">
                                                            @session.MentalHealthStatus
                                                        </span>
                                                    </td>
                                                    <td class="text-center">
                                                        <span class="badge @(session.SafetyRisk == "No Current Risk" ? "bg-success" : session.SafetyRisk == "Low Risk" ? "bg-info text-dark" : session.SafetyRisk == "Moderate Risk" ? "bg-warning text-dark" : "bg-danger") rounded-pill px-3 py-1">
                                                            @session.SafetyRisk
                                                        </span>
                                                    </td>
                                                    <td class="text-center small">
                                                        <div>Acad: <strong>@session.AcademicFunctioning</strong></div>
                                                        <div>Sleep: <strong>@session.SleepCondition</strong> | Social: <strong>@session.SocialInteraction</strong></div>
                                                    </td>
                                                    <td class="text-center">
                                                        <span class="badge @(session.OverallProgressStatus == "Improving" ? "bg-success" : session.OverallProgressStatus == "Deteriorating" ? "bg-danger" : "bg-warning text-dark") rounded-pill px-3 py-1">
                                                            @session.OverallProgressStatus
                                                        </span>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="text-center py-4 text-muted">
                                    <i class="bi bi-clock-history fs-3"></i>
                                    <p class="mt-2 mb-0">No counseling session observations recorded yet.</p>
                                </div>
                            }
                        </div>
                    </div>

                </div>
            </div>
        }
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 bg-white p-5 text-center">
            <div class="py-5">
                <i class="bi bi-clipboard-pulse text-muted" style="font-size: 3.5rem;"></i>
                <h4 class="fw-bold text-dark mt-3">No Counseling Progress Reports Available</h4>
                <p class="text-muted mb-4">
                    No active counseling case or progress reports have been logged for this student yet. Progress reports will be generated once counseling sessions and psychologist evaluations begin.
                </p>
                <a asp-controller="Guardian" asp-action="Dashboard" class="btn btn-primary rounded-pill px-4 py-2 fw-semibold">
                    <i class="bi bi-speedometer2 me-1"></i> Return to Dashboard
                </a>
            </div>
        </div>
    }

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            if (typeof Chart !== 'undefined') {
                @if (Model != null && Model.Any())
                {
                    @foreach (var report in Model.Where(r => r.TotalSessions > 0))
                    {
                        var chartLabels = report.Sessions.Select(s => s.SessionNumber == 1 ? "Session 1 (Baseline)" : $"Session {s.SessionNumber}").ToList();
                        var chartScores = report.Sessions.Select(s => s.SessionScore).ToList();
                        var labelsJson = System.Text.Json.JsonSerializer.Serialize(chartLabels);
                        var scoresJson = System.Text.Json.JsonSerializer.Serialize(chartScores);

                        <text>
                        (function() {
                            var ctx = document.getElementById('guardianLineChart_@report.ObservationReportId');
                            if (!ctx) return;

                            var labels = @Html.Raw(labelsJson);
                            var scores = @Html.Raw(scoresJson);

                            var recoveryTarget = 75.0;
                            var targetData = new Array(labels.length).fill(recoveryTarget);

                            new Chart(ctx, {
                                type: 'line',
                                data: {
                                    labels: labels,
                                    datasets: [
                                        {
                                            label: 'Student Recovery Score',
                                            data: scores,
                                            borderColor: '#2563eb',
                                            backgroundColor: 'rgba(37, 99, 235, 0.15)',
                                            borderWidth: 3,
                                            pointBackgroundColor: '#1d4ed8',
                                            pointBorderColor: '#ffffff',
                                            pointBorderWidth: 2,
                                            pointRadius: 6,
                                            pointHoverRadius: 8,
                                            tension: 0.35,
                                            fill: true
                                        },
                                        {
                                            label: 'Recovery Target (75.0)',
                                            data: targetData,
                                            borderColor: '#10b981',
                                            borderWidth: 2,
                                            borderDash: [6, 6],
                                            pointRadius: 0,
                                            fill: false
                                        }
                                    ]
                                },
                                options: {
                                    responsive: true,
                                    maintainAspectRatio: false,
                                    interaction: {
                                        mode: 'index',
                                        intersect: false
                                    },
                                    scales: {
                                        x: {
                                            grid: { display: true, color: '#e2e8f0' },
                                            ticks: { font: { size: 12, weight: 'bold' }, color: '#1e293b' },
                                            title: { display: true, text: 'Follow-up Sessions (Timeline)', font: { size: 13, weight: 'bold' }, color: '#0f172a' }
                                        },
                                        y: {
                                            min: 0,
                                            max: 100,
                                            ticks: {
                                                stepSize: 20,
                                                font: { size: 12, weight: 'bold' },
                                                color: '#1e293b',
                                                callback: function(value) { return value + ' pts'; }
                                            },
                                            grid: { color: '#cbd5e1' },
                                            title: { display: true, text: 'Recovery Score Scale (0 - 100)', font: { size: 13, weight: 'bold' }, color: '#0f172a' }
                                        }
                                    },
                                    plugins: {
                                        legend: {
                                            position: 'top',
                                            labels: {
                                                font: { size: 12, weight: 'bold' },
                                                color: '#0f172a',
                                                usePointStyle: true
                                            }
                                        },
                                        tooltip: {
                                            callbacks: {
                                                label: function (ctx) {
                                                    return ` Score: ${ctx.raw} / 100`;
                                                }
                                            }
                                        }
                                    }
                                }
                            });
                        })();
                        </text>
                    }
                }
            }
        });
    </script>
}
