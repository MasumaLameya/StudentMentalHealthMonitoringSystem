@{
    ViewData["Title"] = "Guardian Dashboard";

    var student = ViewBag.Student;

    var phqReports = ViewBag.PHQReports;

    var cssrsReports = ViewBag.CSSRSReports;

    var appointments = ViewBag.Appointments as List<StudentMentalHealthMonitoringSystem.Models.Counseling>;

    var upcomingAppointments = ViewBag.UpcomingAppointments as List<StudentMentalHealthMonitoringSystem.Models.Counseling>;
}


<style>

    .guardian-page {
        padding: 30px 15px;
    }

    /* ================= HEADER ================= */

    .guardian-header {
        background: linear-gradient( 135deg, #A9D5E8, #C7DDE8, #DCD1E7 );
        border-radius: 24px;
        padding: 30px;
        box-shadow: 0 8px 28px rgba(70,100,120,0.09);
    }

        .guardian-header h2 {
            color: #405F70;
            font-weight: 700;
        }

        .guardian-header p {
            color: #718894;
            font-size: 14px;
        }


    /* ================= LOGOUT ================= */

    .logout-btn {
        display: inline-block;
        background: rgba(255,255,255,0.78);
        color: #5D7887;
        border: 1px solid #D6E3E8;
        border-radius: 11px;
        padding: 9px 16px;
        text-decoration: none;
        font-size: 13px;
        font-weight: 600;
    }

        .logout-btn:hover {
            background: white;
            color: #526A79;
        }


    /* ================= STUDENT CARD ================= */

    .student-card {
        background: white;
        border: 1px solid #E1EAEE;
        border-radius: 20px;
        padding: 24px;
        box-shadow: 0 7px 24px rgba(70,100,120,0.06);
    }

    .student-icon {
        width: 55px;
        height: 55px;
        border-radius: 16px;
        background: #E7F3F8;
        color: #62869A;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 23px;
    }

    .student-label {
        color: #97A5AC;
        font-size: 11px;
        margin-bottom: 4px;
    }

    .student-value {
        color: #526A79;
        font-size: 14px;
        font-weight: 650;
    }


    /* ================= REPORT CARD ================= */

    .report-card {
        background: white;
        border: 1px solid #E1EAEE;
        border-radius: 22px;
        overflow: hidden;
        box-shadow: 0 7px 24px rgba(70,100,120,0.06);
    }

    .report-header {
        padding: 20px 22px;
        background: #F5F9FA;
        border-bottom: 1px solid #E7EEF1;
    }

        .report-header h5 {
            color: #526A79;
            font-weight: 700;
            margin: 0;
        }

        .report-header p {
            color: #97A5AC;
            font-size: 11px;
            margin: 4px 0 0;
        }

    .report-icon {
        width: 42px;
        height: 42px;
        border-radius: 13px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 19px;
    }


    /* ================= REPORT ROW ================= */

    .report-row {
        padding: 19px 22px;
        border-bottom: 1px solid #EEF2F4;
    }

        .report-row:last-child {
            border-bottom: none;
        }

    .semester {
        color: #526A79;
        font-size: 14px;
        font-weight: 650;
    }

    .report-date {
        color: #98A5AC;
        font-size: 11px;
    }


    /* ================= SCORE ================= */

    .score-box {
        background: #F8FAFB;
        border: 1px solid #E6EDF0;
        border-radius: 13px;
        padding: 10px 15px;
        text-align: center;
    }

    .score-label {
        color: #98A5AC;
        font-size: 9px;
        margin-bottom: 3px;
    }

    .score-value {
        color: #526A79;
        font-size: 18px;
        font-weight: 700;
    }


    /* ================= BADGES ================= */

    .report-badge {
        display: inline-block;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 10px;
        font-weight: 650;
    }

    .phq-badge {
        background: #EEEAF7;
        color: #766A99;
    }

    .cssrs-badge {
        background: #E6F2EB;
        color: #64806F;
    }


    /* ================= EMPTY ================= */

    .empty-state {
        padding: 45px 20px;
        text-align: center;
    }

    .empty-icon {
        width: 60px;
        height: 60px;
        margin: auto;
        border-radius: 18px;
        background: #EDF5F8;
        color: #7191A2;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
    }

    .empty-title {
        color: #526A79;
        font-weight: 650;
        margin-top: 13px;
    }

    .empty-text {
        color: #98A5AC;
        font-size: 12px;
    }


    /* ================= NOTICE ================= */

    .guardian-notice {
        background: #F3F7F8;
        border: none;
        border-radius: 17px;
        color: #647A85;
    }

</style>


<div class="container-fluid guardian-page">


    <!-- =====================================================
         ALERT MESSAGES
         ===================================================== -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm rounded-4 mb-4 d-flex align-items-center p-3">
            <i class="bi bi-check-circle-fill fs-4 me-3 text-success"></i>
            <div class="fw-semibold text-success-emphasis">@TempData["SuccessMessage"]</div>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger border-0 shadow-sm rounded-4 mb-4 d-flex align-items-center p-3">
            <i class="bi bi-exclamation-triangle-fill fs-4 me-3 text-danger"></i>
            <div class="fw-semibold text-danger-emphasis">@TempData["ErrorMessage"]</div>
        </div>
    }

    <!-- =====================================================
         HEADER
         ===================================================== -->
    <div class="guardian-header mb-4">

        <div class="row align-items-center">

            <div class="col-md-8">

                <div style="
                    color:#718894;
                    font-size:12px;
                    margin-bottom:5px;
                    ">

                    Guardian Portal

                </div>


                <h2 class="mb-2">

                    Guardian Dashboard

                </h2>


                <p class="mb-0">

                    View your student's mental health
                    assessment reports.

                </p>

            </div>


            <div class="col-md-4 text-md-end mt-3 mt-md-0 d-flex justify-content-md-end gap-2 flex-wrap align-items-center">
                <a asp-controller="Guardian"
                   asp-action="Appointments"
                   class="btn btn-light fw-bold text-dark rounded-3 px-3 py-2 shadow-sm border-0">
                    <i class="bi bi-calendar2-check text-primary me-1"></i>
                    Appointments
                </a>
                <a asp-controller="Guardian"
                   asp-action="Logout"
                   class="logout-btn">
                    <i class="bi bi-box-arrow-right me-1"></i>
                    Logout
                </a>
            </div>

        </div>

    </div>



    <!-- =====================================================
         STUDENT INFORMATION
         ===================================================== -->

    <div class="student-card mb-4">

        <div class="row align-items-center g-4">


            <div class="col-auto">

                <div class="student-icon">

                    <i class="bi bi-person-vcard"></i>

                </div>

            </div>


            <div class="col">

                <div class="student-label">

                    STUDENT NAME

                </div>

                <div class="student-value"
                     style="font-size:18px;">

                    @student.FullName

                </div>

            </div>


            <div class="col-md-3">

                <div class="student-label">

                    STUDENT ID

                </div>

                <div class="student-value">

                    @student.StudentIdNumber

                </div>

            </div>


            <div class="col-md-3">

                <div class="student-label">

                    DEPARTMENT

                </div>

                <div class="student-value">

                    @student.Department

                </div>

            </div>

        </div>

    </div>

    <!-- =====================================================
         SCHEDULED COUNSELING APPOINTMENTS
         ===================================================== -->
    <div class="report-card mb-4" style="border: 2px solid #BAE6FD;">
        <div class="report-header" style="background: linear-gradient(135deg, #F0F9FF 0%, #E0F2FE 100%);">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                <div>
                    <h5 style="color: #0369A1;">
                        <i class="bi bi-calendar2-check me-2 text-primary"></i>Scheduled Counseling Appointments
                    </h5>
                    <p>Monitor your student's professional counseling schedule and manage upcoming appointments</p>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <a asp-controller="Guardian" asp-action="Appointments" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-semibold bg-white">
                        <i class="bi bi-clock-history me-1"></i>All Appointments Log
                    </a>
                    <div class="report-icon" style="background: #E0F2FE; color: #0284C7;">
                        <i class="bi bi-calendar-heart"></i>
                    </div>
                </div>
            </div>
        </div>

        @if (upcomingAppointments != null && upcomingAppointments.Any())
        {
            <div class="p-4">
                <div class="alert alert-warning border-0 rounded-3 mb-3 d-flex align-items-center">
                    <i class="bi bi-info-circle-fill fs-4 text-warning me-3"></i>
                    <div>
                        <strong class="text-dark">Active Scheduled Appointment:</strong>
                        <div class="small text-secondary">Your student is scheduled for an upcoming session. If your student is unable to attend, you can cancel this appointment below prior to the session time.</div>
                    </div>
                </div>

                @foreach (var appt in upcomingAppointments)
                {
                    <div class="card border rounded-4 shadow-sm mb-3" style="background: #FFFFFF; border-color: #E2E8F0 !important;">
                        <div class="card-body p-4">
                            <div class="row align-items-center g-3">
                                <div class="col-lg-3 col-md-6">
                                    <small class="text-muted text-uppercase fw-bold d-block mb-1">
                                        <i class="bi bi-person-badge text-primary me-1"></i>Assigned Psychologist
                                    </small>
                                    <h6 class="fw-bold mb-0 text-dark">@(appt.Psychologist?.FullName ?? "University Psychologist")</h6>
                                    <small class="text-secondary">@(appt.Psychologist?.Specialization ?? "Clinical / Counseling Psychologist")</small>
                                </div>

                                <div class="col-lg-3 col-md-6">
                                    <small class="text-muted text-uppercase fw-bold d-block mb-1">
                                        <i class="bi bi-calendar-event text-success me-1"></i>Date &amp; Time Slot
                                    </small>
                                    <div class="fw-bold text-dark">@appt.CounselingDate.ToString("dddd, MMM dd, yyyy")</div>
                                    <small class="text-secondary">@DateTime.Today.Add(appt.AppointmentTime).ToString("h:mm tt") - @DateTime.Today.Add(appt.AppointmentEndTime).ToString("h:mm tt")</small>
                                </div>

                                <div class="col-lg-3 col-md-6">
                                    <small class="text-muted text-uppercase fw-bold d-block mb-1">
                                        <i class="bi bi-geo-alt text-danger me-1"></i>Location &amp; Status
                                    </small>
                                    <div class="fw-semibold text-dark">@(appt.AppointmentRoom ?? "Room 402, Counseling Center")</div>
                                    <span class="badge bg-warning text-dark rounded-pill px-3 py-1 small mt-1">
                                        <i class="bi bi-clock-fill me-1"></i>@appt.Status
                                    </span>
                                </div>

                                <div class="col-lg-3 col-md-6 text-lg-end">
                                    <button type="button" class="btn btn-outline-danger rounded-pill px-3 py-2 fw-semibold shadow-sm" data-bs-toggle="modal" data-bs-target="#guardianCancelModal_@appt.CounselingId">
                                        <i class="bi bi-x-circle me-1"></i>Cancel Appointment
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Guardian Cancellation Modal for Dashboard -->
                    <div class="modal fade" id="guardianCancelModal_@appt.CounselingId" tabindex="-1" aria-labelledby="guardianCancelModalLabel_@appt.CounselingId" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content rounded-4 border-0 shadow">
                                <div class="modal-header border-0 bg-danger text-white rounded-top-4 p-4">
                                    <h5 class="modal-title fw-bold" id="guardianCancelModalLabel_@appt.CounselingId">
                                        <i class="bi bi-exclamation-triangle-fill me-2"></i>Cancel Scheduled Appointment
                                    </h5>
                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <form asp-controller="Guardian" asp-action="CancelAppointment" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@appt.CounselingId" />
                                    <input type="hidden" name="returnUrl" value="/Guardian/Dashboard" />
                                    <div class="modal-body p-4">
                                        <div class="alert alert-warning border-0 rounded-3 mb-3">
                                            <i class="bi bi-info-circle me-1"></i>
                                            You are cancelling the appointment for <strong>@student.FullName</strong> with <strong>@(appt.Psychologist?.FullName ?? "University Psychologist")</strong> scheduled for <strong>@appt.CounselingDate.ToString("MMM dd, yyyy") (@DateTime.Today.Add(appt.AppointmentTime).ToString("h:mm tt"))</strong>.
                                        </div>
                                        <div class="mb-3">
                                            <label for="cancelReason_@appt.CounselingId" class="form-label fw-semibold text-dark small">
                                                Reason for Cancellation (Optional)
                                            </label>
                                            <textarea name="reason" id="cancelReason_@appt.CounselingId" rows="3" class="form-control rounded-3" placeholder="Please state why the student cannot attend..."></textarea>
                                        </div>
                                        <p class="small text-muted mb-0">
                                            Upon cancellation, this slot will be freed, and both student and psychologist will be notified via email.
                                        </p>
                                    </div>
                                    <div class="modal-footer border-0 p-4 pt-0">
                                        <button type="button" class="btn btn-light rounded-3 px-4 fw-semibold" data-bs-dismiss="modal">Keep Appointment</button>
                                        <button type="submit" class="btn btn-danger rounded-3 px-4 fw-bold">
                                            <i class="bi bi-x-circle me-1"></i> Confirm Cancellation
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-icon" style="background: #F0F9FF; color: #0284C7;">
                    <i class="bi bi-calendar-check"></i>
                </div>
                <div class="empty-title">No Active Scheduled Appointments</div>
                <div class="empty-text">Your student currently has no upcoming counseling appointments.</div>
                <div class="mt-3">
                    <a asp-controller="Guardian" asp-action="Appointments" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-semibold">
                        <i class="bi bi-clock-history me-1"></i>View Session History &amp; Past Logs
                    </a>
                </div>
            </div>
        }
    </div>



    <!-- =====================================================
         PHQ-9 REPORT
         ===================================================== -->

    <div class="report-card mb-4">


        <div class="report-header">

            <div class="d-flex
                align-items-center
                justify-content-between">

                <div>

                    <h5>

                        <i class="bi bi-heart-pulse me-2"></i>

                        PHQ-9 Reports

                    </h5>


                    <p>

                        Semester-wise depression screening results

                    </p>

                </div>


                <div class="report-icon"
                     style="
                    background:#EEEAF7;
                    color:#766A99;
                    ">

                    <i class="bi bi-heart-pulse"></i>

                </div>

            </div>

        </div>



        @if (phqReports != null &&
             phqReports.Count > 0)
        {

            foreach (var report in phqReports)
            {

                <div class="report-row">

                    <div class="row align-items-center g-3">


                        <!-- Semester -->

                        <div class="col-md-4">

                            <div class="semester">

                                @report.Semester

                            </div>


                            <div class="report-date">

                                @report.AssessmentDate.ToString(
                                    "dd MMM yyyy")

                            </div>

                        </div>


                        <!-- Score -->

                        <div class="col-md-4">

                            <div class="score-box">

                                <div class="score-label">

                                    PHQ-9 SCORE

                                </div>


                                <div class="score-value">

                                    @report.TotalScore

                                </div>

                            </div>

                        </div>


                        <!-- Severity -->

                        <div class="col-md-4 text-md-end">

                            <span class="report-badge phq-badge">

                                @report.SeverityLevel

                            </span>

                        </div>

                    </div>

                </div>

            }

        }
        else
        {

            <div class="empty-state">

                <div class="empty-icon">

                    <i class="bi bi-file-medical"></i>

                </div>


                <div class="empty-title">

                    No PHQ-9 Reports

                </div>


                <div class="empty-text">

                    No PHQ-9 assessment has been recorded
                    for this student yet.

                </div>

            </div>

        }

    </div>



    <!-- =====================================================
         C-SSRS REPORT
         ===================================================== -->

    <div class="report-card mb-4">


        <div class="report-header">

            <div class="d-flex
                align-items-center
                justify-content-between">

                <div>

                    <h5>

                        <i class="bi bi-shield-check me-2"></i>

                        C-SSRS Reports

                    </h5>


                    <p>

                        Semester-wise suicide risk screening results

                    </p>

                </div>


                <div class="report-icon"
                     style="
                    background:#E6F2EB;
                    color:#64806F;
                    ">

                    <i class="bi bi-shield-check"></i>

                </div>

            </div>

        </div>



        @if (cssrsReports != null &&
             cssrsReports.Count > 0)
        {

            foreach (var report in cssrsReports)
            {

                <div class="report-row">

                    <div class="row align-items-center g-3">


                        <!-- Semester -->

                        <div class="col-md-4">

                            <div class="semester">

                                @report.Semester

                            </div>


                            <div class="report-date">

                                @report.AssessmentDate.ToString(
                                    "dd MMM yyyy")

                            </div>

                        </div>


                        <!-- Risk -->

                        <div class="col-md-4">

                            <div class="score-box">

                                <div class="score-label">

                                    RISK LEVEL

                                </div>


                                <div class="score-value"
                                     style="
                                    font-size:14px;
                                    ">

                                    @report.RiskLevel

                                </div>

                            </div>

                        </div>


                        <!-- Status -->

                        <div class="col-md-4 text-md-end">

                            <span class="report-badge cssrs-badge">

                                Assessment Completed

                            </span>

                        </div>

                    </div>

                </div>

            }

        }
        else
        {

            <div class="empty-state">

                <div class="empty-icon">

                    <i class="bi bi-shield"></i>

                </div>


                <div class="empty-title">

                    No C-SSRS Reports

                </div>


                <div class="empty-text">

                    No C-SSRS assessment has been recorded
                    for this student yet.

                </div>

            </div>

        }

    </div>



    <!-- =====================================================
         GUARDIAN ACCESS NOTICE
         ===================================================== -->
    <div class="alert guardian-notice mb-0">
        <div class="d-flex align-items-start">
            <i class="bi bi-info-circle-fill me-3 fs-5 text-primary"></i>
            <div>
                <strong>Guardian Access Portal</strong>
                <div class="small mt-1">
                    Guardians have authorized access to view their student's PHQ-9 &amp; C-SSRS wellness assessment indicators and scheduled counseling appointments. If your student is unable to attend a scheduled appointment, you can cancel it via this portal before the appointment date.
                </div>
            </div>
        </div>
    </div>

</div>