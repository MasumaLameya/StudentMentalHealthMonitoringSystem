@{
    ViewData["Title"] = "Student Counseling Appointments - Guardian Portal";
    var student = ViewBag.Student as StudentMentalHealthMonitoringSystem.Models.Student;
    var appointments = ViewBag.Appointments as List<StudentMentalHealthMonitoringSystem.Models.Counseling> ?? new List<StudentMentalHealthMonitoringSystem.Models.Counseling>();
    var upcomingAppointments = ViewBag.UpcomingAppointments as List<StudentMentalHealthMonitoringSystem.Models.Counseling> ?? new List<StudentMentalHealthMonitoringSystem.Models.Counseling>();

    int totalCount = appointments.Count;
    int upcomingCount = upcomingAppointments.Count;
    int completedCount = appointments.Count(a => a.Status == "Completed");
    int cancelledCount = appointments.Count(a => a.Status == "Cancelled");
    int missedCount = appointments.Count(a => a.Status == "Missed");
    var now = DateTime.Now;
}

<style>
    .guardian-page {
        padding: 30px 15px;
        min-height: 100vh;
    }

    .guardian-header {
        background: linear-gradient(135deg, #A9D5E8, #C7DDE8, #DCD1E7);
        border-radius: 24px;
        padding: 30px;
        box-shadow: 0 8px 28px rgba(70,100,120,0.09);
    }

    .guardian-header h2 {
        color: #405F70;
        font-weight: 700;
    }

    .stat-card {
        background: #FFFFFF;
        border: 1px solid #E1EAEE;
        border-radius: 18px;
        padding: 20px;
        box-shadow: 0 4px 16px rgba(70,100,120,0.05);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .stat-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(70,100,120,0.08);
    }

    .report-card {
        background: white;
        border: 1px solid #E1EAEE;
        border-radius: 22px;
        overflow: hidden;
        box-shadow: 0 7px 24px rgba(70,100,120,0.06);
    }

    .report-header {
        padding: 20px 24px;
        background: #F5F9FA;
        border-bottom: 1px solid #E7EEF1;
    }

    .filter-btn {
        border-radius: 10px;
        font-weight: 600;
        font-size: 0.9rem;
        padding: 8px 16px;
    }

    .filter-btn.active {
        background-color: #0284C7 !important;
        border-color: #0284C7 !important;
        color: #ffffff !important;
    }

    .appointment-table-header {
        background: #F8FAFC;
        color: #64748B;
        font-size: 0.8rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .status-badge {
        font-size: 0.8rem;
        padding: 6px 14px;
        font-weight: 700;
        border-radius: 50rem;
    }
</style>

<div class="container-fluid guardian-page">

    <!-- Alerts -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm rounded-4 mb-4 d-flex align-items-center p-3">
            <i class="bi bi-check-circle-fill fs-4 me-3 text-success"></i>
            <div class="fw-semibold text-success-emphasis">@TempData["SuccessMessage"]</div>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger border-0 shadow-sm rounded-4 mb-4 d-flex align-items-center p-3">
            <i class="bi bi-exclamation-triangle-fill fs-4 me-3 text-danger"></i>
            <div class="fw-semibold text-danger-emphasis">@TempData["ErrorMessage"]</div>
        </div>
    }

    <!-- Header Banner -->
    <div class="guardian-header mb-4">
        <div class="row align-items-center">
            <div class="col-md-7">
                <div style="color: #718894; font-size: 13px; font-weight: 600; margin-bottom: 4px;">
                    <i class="bi bi-shield-check me-1"></i>Guardian Portal &bull; Counseling Oversight
                </div>
                <h2 class="mb-1">Student Counseling Appointments</h2>
                <p class="mb-0 text-secondary" style="font-size: 14px;">
                    Review upcoming and previous mental health counseling sessions for
                    <strong class="text-dark">@(student?.FullName ?? "Student")</strong> (ID: @(student?.StudentIdNumber ?? "N/A")).
                </p>
            </div>
            <div class="col-md-5 text-md-end mt-3 mt-md-0 d-flex justify-content-md-end gap-2 flex-wrap align-items-center">
                <a asp-controller="Guardian" asp-action="Dashboard" class="btn btn-light fw-bold text-dark rounded-3 px-3.5 py-2 shadow-sm border-0">
                    <i class="bi bi-arrow-left me-1"></i> Dashboard
                </a>
                <a asp-controller="Guardian" asp-action="Logout" class="btn btn-outline-secondary fw-bold rounded-3 px-3 py-2 bg-white">
                    <i class="bi bi-box-arrow-right me-1"></i> Logout
                </a>
            </div>
        </div>
    </div>

    <!-- Metrics Summary -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md">
            <div class="stat-card text-center h-100">
                <small class="text-muted text-uppercase fw-bold d-block mb-1">Total Sessions</small>
                <h3 class="fw-bold text-dark mb-0">@totalCount</h3>
                <small class="text-muted">All scheduled</small>
            </div>
        </div>
        <div class="col-6 col-md">
            <div class="stat-card text-center h-100 border-warning-subtle" style="background: #FFFDF5;">
                <small class="text-warning text-uppercase fw-bold d-block mb-1">Upcoming</small>
                <h3 class="fw-bold text-dark mb-0">@upcomingCount</h3>
                <small class="text-muted">Confirmed</small>
            </div>
        </div>
        <div class="col-6 col-md">
            <div class="stat-card text-center h-100 border-success-subtle" style="background: #F2FAF5;">
                <small class="text-success text-uppercase fw-bold d-block mb-1">Completed</small>
                <h3 class="fw-bold text-success mb-0">@completedCount</h3>
                <small class="text-muted">Attended</small>
            </div>
        </div>
        <div class="col-6 col-md">
            <div class="stat-card text-center h-100 border-danger-subtle" style="background: #FFF5F5;">
                <small class="text-danger text-uppercase fw-bold d-block mb-1">Cancelled</small>
                <h3 class="fw-bold text-danger mb-0">@cancelledCount</h3>
                <small class="text-muted">Pre-cancelled</small>
            </div>
        </div>
        <div class="col-6 col-md">
            <div class="stat-card text-center h-100 border-secondary-subtle" style="background: #F8F9FA;">
                <small class="text-secondary text-uppercase fw-bold d-block mb-1">Missed</small>
                <h3 class="fw-bold text-secondary mb-0">@missedCount</h3>
                <small class="text-muted">Unattended</small>
            </div>
        </div>
    </div>

    <!-- Appointments Management Card -->
    <div class="report-card mb-4">
        <div class="report-header d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h5 class="fw-bold mb-1" style="color: #405F70;">
                    <i class="bi bi-calendar-range me-2 text-primary"></i>Counseling Schedule History
                </h5>
                <p class="mb-0 text-muted" style="font-size: 13px;">Guardians can view full session history and cancel scheduled upcoming sessions.</p>
            </div>

            <!-- Filter Tabs -->
            <div class="btn-group shadow-sm rounded-3" role="group">
                <button type="button" class="btn btn-outline-primary filter-btn active" onclick="filterAppointments('all', this)">
                    All (@totalCount)
                </button>
                <button type="button" class="btn btn-outline-primary filter-btn" onclick="filterAppointments('Upcoming', this)">
                    Upcoming (@upcomingCount)
                </button>
                <button type="button" class="btn btn-outline-primary filter-btn" onclick="filterAppointments('Completed', this)">
                    Completed (@completedCount)
                </button>
                <button type="button" class="btn btn-outline-primary filter-btn" onclick="filterAppointments('Cancelled', this)">
                    Cancelled (@cancelledCount)
                </button>
                <button type="button" class="btn btn-outline-primary filter-btn" onclick="filterAppointments('Missed', this)">
                    Missed (@missedCount)
                </button>
            </div>
        </div>

        @if (!appointments.Any())
        {
            <div class="empty-state p-5 text-center">
                <div class="empty-icon mx-auto mb-3" style="width: 60px; height: 60px; background: #F0F9FF; color: #0284C7; border-radius: 18px; display: flex; align-items: center; justify-content: center; font-size: 24px;">
                    <i class="bi bi-calendar-x"></i>
                </div>
                <h5 class="fw-bold text-secondary mb-1">No Counseling Appointments Found</h5>
                <p class="text-muted small mb-0">There are no recorded counseling appointments on file for this student.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="appointment-table-header">
                        <tr>
                            <th class="ps-4 py-3">#</th>
                            <th class="py-3">Date &amp; Time Slot</th>
                            <th class="py-3">Assigned Psychologist</th>
                            <th class="py-3">Location / Venue</th>
                            <th class="py-3">Source / Referral</th>
                            <th class="py-3 text-center">Status</th>
                            <th class="pe-4 py-3 text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < appointments.Count; i++)
                        {
                            var a = appointments[i];
                            bool isUpcoming = (a.Status == "Confirmed" || a.Status == "Pending") &&
                                (a.CounselingDate.Date > DateTime.Today ||
                                (a.CounselingDate.Date == DateTime.Today && a.AppointmentTime > now.TimeOfDay));

                            string filterCategory = isUpcoming ? "Upcoming" : a.Status;

                            <tr class="appointment-row" data-category="@filterCategory">
                                <td class="ps-4 text-muted fw-bold small">@(i + 1)</td>
                                
                                <!-- Date & Time -->
                                <td>
                                    <div class="fw-bold text-dark">
                                        <i class="bi bi-calendar3 me-1.5 text-primary"></i>@a.CounselingDate.ToString("ddd, MMM dd, yyyy")
                                    </div>
                                    <div class="small text-secondary">
                                        <i class="bi bi-clock me-1 text-muted"></i>@DateTime.Today.Add(a.AppointmentTime).ToString("h:mm tt") - @DateTime.Today.Add(a.AppointmentEndTime).ToString("h:mm tt")
                                    </div>
                                </td>

                                <!-- Psychologist -->
                                <td>
                                    <div class="fw-bold text-dark">
                                        @(a.Psychologist?.FullName ?? "University Psychologist")
                                    </div>
                                    <div class="small text-secondary">
                                        @(a.Psychologist?.Specialization ?? "Counseling Specialist")
                                    </div>
                                </td>

                                <!-- Room -->
                                <td>
                                    <div class="small text-secondary">
                                        <i class="bi bi-geo-alt text-danger me-1"></i>@(a.AppointmentRoom ?? "Room 402, Counseling Center")
                                    </div>
                                </td>

                                <!-- Source -->
                                <td>
                                    @if (a.AppointmentSource == "AutoAssignment")
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger rounded-pill px-2.5 py-1 small">
                                            <i class="bi bi-lightning-fill me-1"></i>Screening Alert
                                        </span>
                                    }
                                    else if (a.AppointmentSource == "FollowUp")
                                    {
                                        <span class="badge bg-info-subtle text-info-emphasis border border-info rounded-pill px-2.5 py-1 small">
                                            <i class="bi bi-arrow-repeat me-1"></i>Follow-Up
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-dark border rounded-pill px-2.5 py-1 small">
                                            <i class="bi bi-person-check me-1 text-success"></i>Direct Booking
                                        </span>
                                    }
                                </td>

                                <!-- Status Badge -->
                                <td class="text-center">
                                    @if (a.Status == "Completed")
                                    {
                                        <span class="badge bg-success status-badge">
                                            <i class="bi bi-check-circle-fill me-1"></i>Completed
                                        </span>
                                    }
                                    else if (a.Status == "Cancelled")
                                    {
                                        <span class="badge bg-danger status-badge" title="@a.Observation">
                                            <i class="bi bi-x-circle-fill me-1"></i>Cancelled
                                        </span>
                                    }
                                    else if (a.Status == "Missed")
                                    {
                                        <span class="badge bg-secondary status-badge" title="Appointment passed without assessment">
                                            <i class="bi bi-calendar-x-fill me-1"></i>Missed
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark status-badge">
                                            <i class="bi bi-clock-fill me-1"></i>Scheduled
                                        </span>
                                    }
                                </td>

                                <!-- Action -->
                                <td class="pe-4 text-end">
                                    @if (isUpcoming)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3 fw-semibold" data-bs-toggle="modal" data-bs-target="#cancelModal_@a.CounselingId">
                                            <i class="bi bi-x-circle me-1"></i>Cancel Session
                                        </button>
                                    }
                                    else if (a.Status == "Completed")
                                    {
                                        <span class="text-success small fw-semibold">
                                            <i class="bi bi-check-all me-1"></i>Session Concluded
                                        </span>
                                    }
                                    else if (a.Status == "Cancelled")
                                    {
                                        <span class="text-muted small" title="@a.Observation">
                                            Cancelled
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Completed Period</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <!-- Modals for Cancel Actions -->
    @foreach (var a in appointments)
    {
        bool isUpcoming = (a.Status == "Confirmed" || a.Status == "Pending") &&
            (a.CounselingDate.Date > DateTime.Today ||
            (a.CounselingDate.Date == DateTime.Today && a.AppointmentTime > now.TimeOfDay));

        if (isUpcoming)
        {
            <div class="modal fade" id="cancelModal_@a.CounselingId" tabindex="-1" aria-labelledby="cancelModalLabel_@a.CounselingId" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content rounded-4 border-0 shadow">
                        <div class="modal-header border-0 bg-danger text-white rounded-top-4 p-4">
                            <h5 class="modal-title fw-bold" id="cancelModalLabel_@a.CounselingId">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>Cancel Scheduled Appointment
                            </h5>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <form asp-controller="Guardian" asp-action="CancelAppointment" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@a.CounselingId" />
                            <input type="hidden" name="returnUrl" value="/Guardian/Appointments" />
                            <div class="modal-body p-4">
                                <div class="alert alert-warning border-0 rounded-3 mb-3">
                                    <i class="bi bi-info-circle me-1"></i>
                                    You are cancelling the counseling appointment for <strong>@(student?.FullName ?? "Student")</strong> with <strong>@(a.Psychologist?.FullName ?? "University Psychologist")</strong>.
                                </div>
                                <div class="p-3 bg-light rounded-3 mb-3 border">
                                    <div class="d-flex justify-content-between mb-1">
                                        <span class="text-muted small">Date:</span>
                                        <strong class="text-dark small">@a.CounselingDate.ToString("dddd, MMM dd, yyyy")</strong>
                                    </div>
                                    <div class="d-flex justify-content-between">
                                        <span class="text-muted small">Time Slot:</span>
                                        <strong class="text-dark small">@DateTime.Today.Add(a.AppointmentTime).ToString("h:mm tt") - @DateTime.Today.Add(a.AppointmentEndTime).ToString("h:mm tt")</strong>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <label for="cancelReason_@a.CounselingId" class="form-label fw-semibold text-dark small">
                                        Reason for Cancellation (Optional)
                                    </label>
                                    <textarea name="reason" id="cancelReason_@a.CounselingId" rows="3" class="form-control rounded-3" placeholder="Please let the counseling center know why the student is unable to attend..."></textarea>
                                </div>
                                <p class="small text-muted mb-0">
                                    Upon confirmation, this session will be marked as cancelled, freeing the slot for other students. An official notification will be sent to the student and psychologist.
                                </p>
                            </div>
                            <div class="modal-footer border-0 p-4 pt-0">
                                <button type="button" class="btn btn-light rounded-3 px-4 fw-semibold" data-bs-dismiss="modal">Keep Appointment</button>
                                <button type="submit" class="btn btn-danger rounded-3 px-4 fw-bold">
                                    <i class="bi bi-x-circle me-1"></i> Confirm Cancellation
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }
    }

</div>

@section Scripts {
    <script>
        function filterAppointments(category, btn) {
            document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');

            var rows = document.querySelectorAll('.appointment-row');
            rows.forEach(row => {
                var rowCat = row.getAttribute('data-category');
                if (category === 'all' || rowCat === category) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        }
    </script>
}
