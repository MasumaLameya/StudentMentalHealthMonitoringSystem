@model StudentMentalHealthMonitoringSystem.ViewModels.DepartmentRiskReportViewModel

@{
    ViewData["Title"] = "Reports";
}

<style>

    .report-header {
        background: linear-gradient(135deg, #F5E7ED, #E9E1F1, #E7F0EC);
        border-radius: 24px;
        box-shadow: 0 8px 30px rgba(95,81,70,.07);
    }

    .main-card {
        background: #FFFFFF;
        border: none;
        border-radius: 22px;
        box-shadow: 0 8px 30px rgba(95,81,70,.07);
    }

    .page-title {
        color: #5F5146;
        font-weight: 700;
    }

    .page-subtitle {
        color: #9A8B7D;
        font-size: 14px;
    }

    .stat-card {
        background: #FCFAF8;
        border: 1px solid #EEE6DF;
        border-radius: 18px;
        padding: 22px;
        height: 100%;
        transition: transform 0.2s ease;
    }

    .stat-card:hover {
        transform: translateY(-2px);
    }

    .stat-icon {
        width: 45px;
        height: 45px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #E9E0F0;
        color: #917A9B;
    }

    .stat-number {
        color: #5F5146;
        font-size: 28px;
        font-weight: 700;
    }

    .risk-badge {
        background: #F2DDE1;
        color: #8D626A;
        border-radius: 30px;
        padding: 7px 13px;
        font-size: 12px;
        font-weight: 700;
    }

    .semester-badge {
        background: #E9E0F0;
        color: #76627F;
        border-radius: 10px;
        padding: 6px 10px;
        font-size: 12px;
        font-weight: 600;
    }

    .missed-badge {
        background: #FCE8E6;
        color: #C5221F;
        border-radius: 30px;
        padding: 6px 12px;
        font-size: 12px;
        font-weight: 700;
        display: inline-block;
    }

    .student-card {
        background: #FCFAF8;
        border: 1px solid #EEE6DF;
        border-radius: 18px;
    }

    .mail-btn {
        background: #9B839F;
        color: white;
        border: none;
        border-radius: 11px;
        padding: 8px 14px;
        font-size: 13px;
        font-weight: 600;
    }

        .mail-btn:hover {
            background: #846D88;
            color: white;
        }

    .empty-box {
        text-align: center;
        padding: 55px 20px;
    }

    .empty-icon {
        width: 72px;
        height: 72px;
        margin: auto;
        border-radius: 22px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #E7F0EC;
        color: #71877B;
    }

    .custom-nav-pills .nav-link {
        border-radius: 12px;
        padding: 10px 20px;
        font-weight: 600;
        color: #5F5146;
        background: #F3ECE7;
        margin-right: 8px;
        transition: all 0.2s ease;
    }

    .custom-nav-pills .nav-link.active {
        background: #9B839F;
        color: #FFFFFF;
    }

</style>


<div class="container-fluid">

    <!-- =========================================================
         Header
         ========================================================= -->

    <div class="report-header mb-4">

        <div class="p-4 p-lg-5">

            <div class="d-flex justify-content-between
                align-items-center flex-wrap gap-3">

                <div>

                    <div class="page-subtitle mb-1">

                        @Model.DepartmentName Department

                    </div>

                    <h2 class="page-title mb-1">

                        Department Reports Hub

                    </h2>

                    <p class="page-subtitle mb-0">

                        Monitor student mental health assessment results, high-risk cases, and missed counseling appointments.

                    </p>

                </div>


                <div style="font-size:42px;color:#9B839F;">

                    <i class="bi bi-file-earmark-medical"></i>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================================
         Statistics
         ========================================================= -->

    <div class="row g-4 mb-4">


        <!-- ================= Total Students ================= -->

        <div class="col-md-3">

            <div class="stat-card">

                <div class="d-flex align-items-center">

                    <div class="stat-icon me-3">

                        <i class="bi bi-people fs-5"></i>

                    </div>


                    <div>

                        <div class="page-subtitle">

                            Total Students

                        </div>

                        <div class="stat-number">

                            @Model.TotalStudents

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- ================= High Risk Students ================= -->

        <div class="col-md-3">

            <div class="stat-card">

                <div class="d-flex align-items-center">

                    <div class="stat-icon me-3" style="background: #FCE8E6; color: #C5221F;">

                        <i class="bi bi-exclamation-triangle fs-5"></i>

                    </div>


                    <div>

                        <div class="page-subtitle">

                            High Risk Students

                        </div>

                        <div class="stat-number text-danger">

                            @Model.HighRiskStudents

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- ================= Missed Appointments ================= -->

        <div class="col-md-3">

            <div class="stat-card">

                <div class="d-flex align-items-center">

                    <div class="stat-icon me-3" style="background: #FFF0D4; color: #B06000;">

                        <i class="bi bi-clock-history fs-5"></i>

                    </div>


                    <div>

                        <div class="page-subtitle">

                            Missed Appointments

                        </div>

                        <div class="stat-number text-warning-emphasis">

                            @Model.MissedAppointmentsCount

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- ================= Report Condition ================= -->

        <div class="col-md-3">

            <div class="stat-card">

                <div class="d-flex align-items-center">

                    <div class="stat-icon me-3">

                        <i class="bi bi-shield-exclamation fs-5"></i>

                    </div>


                    <div>

                        <div class="page-subtitle">

                            Report Condition

                        </div>

                        <div class="stat-number"
                             style="font-size:18px; margin-top: 4px;">

                            Severe / High Risk

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================================
         Tabs Navigation: High-Risk vs Missed Appointments
         ========================================================= -->

    <div class="main-card mb-4">

        <div class="card-body p-4 p-lg-5">

            <ul class="nav nav-pills custom-nav-pills mb-4" id="reportTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="high-risk-tab" data-bs-toggle="pill" data-bs-target="#highRiskPane" type="button" role="tab">
                        <i class="bi bi-shield-exclamation me-1"></i> High-Risk Cases (@Model.HighRiskStudents)
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="missed-appointments-tab" data-bs-toggle="pill" data-bs-target="#missedAppointmentsPane" type="button" role="tab">
                        <i class="bi bi-calendar-x me-1"></i> Missed Appointments (@Model.MissedAppointmentsCount)
                    </button>
                </li>
            </ul>

            <div class="tab-content" id="reportTabsContent">

                <!-- ================= TAB 1: HIGH RISK STUDENTS ================= -->
                <div class="tab-pane fade show active" id="highRiskPane" role="tabpanel">

                    <div class="mb-4">

                        <h5 class="page-title mb-1">

                            High-Risk Students Report

                        </h5>

                        <p class="page-subtitle mb-0">

                            Students identified with Severe or Extremely Severe screening results.

                        </p>

                    </div>


                    @if (Model.Students != null && Model.Students.Any())
                    {
                        <div class="row g-3">

                            @foreach (var student in Model.Students)
                            {
                                <div class="col-12">

                                    <div class="student-card p-4">

                                        <div class="row align-items-center g-4">


                                            <!-- ================= Student ================= -->

                                            <div class="col-lg-3">

                                                <div class="fw-semibold"
                                                     style="color:#5F5146;">

                                                    @student.FullName

                                                </div>

                                                <div class="page-subtitle">

                                                    @student.StudentIdNumber

                                                </div>

                                                <div class="page-subtitle">

                                                    @student.Email

                                                </div>

                                            </div>


                                            <!-- ================= High Risk Semester ================= -->

                                            <div class="col-lg-3">

                                                <div class="page-subtitle mb-2">

                                                    High Risk Semester

                                                </div>


                                                <span class="semester-badge">

                                                    @student.HighRiskSemester

                                                </span>


                                                <div class="page-subtitle mt-2">

                                                    Assessment:
                                                    @student.AssessmentDate.ToString("dd MMM yyyy")

                                                </div>

                                            </div>


                                            <!-- ================= Risk Level ================= -->

                                            <div class="col-lg-3">

                                                <div class="page-subtitle mb-2">

                                                    Risk Level

                                                </div>

                                                <span class="risk-badge">

                                                    @(student.TriggerSeverity
                                                        ?? student.RiskLevel)

                                                </span>


                                                <div class="page-subtitle mt-2">

                                                    Source:

                                                    <strong>

                                                        @(student.TriggerSource
                                                            ?? "N/A")

                                                    </strong>

                                                </div>

                                            </div>


                                            <!-- ================= Guardian ================= -->

                                            <div class="col-lg-3">

                                                <div class="page-subtitle mb-1">

                                                    Guardian

                                                </div>

                                                <div class="fw-semibold"
                                                     style="color:#6F6258;">

                                                    @(student.GuardianName
                                                        ?? "Not provided")

                                                </div>

                                                <div class="page-subtitle">

                                                    @(student.GuardianEmail
                                                        ?? "No email")

                                                </div>

                                            </div>

                                        </div>

                                    </div>

                                </div>
                            }

                        </div>
                    }
                    else
                    {
                        <!-- ================= No High Risk Student ================= -->

                        <div class="empty-box">

                            <div class="empty-icon mb-3">

                                <i class="bi bi-shield-check fs-2"></i>

                            </div>

                            <h5 class="page-title">

                                No High-Risk Cases

                            </h5>

                            <p class="page-subtitle mb-0">

                                No student currently has a
                                Severe or Extremely Severe screening result.

                            </p>

                        </div>
                    }

                </div>

                <!-- ================= TAB 2: MISSED APPOINTMENTS ================= -->
                <div class="tab-pane fade" id="missedAppointmentsPane" role="tabpanel">

                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
                        <div>
                            <h5 class="page-title mb-1">
                                Missed Counseling Appointments Report
                            </h5>
                            <p class="page-subtitle mb-0">
                                List of scheduled counseling sessions where the student was absent or marked as missed.
                            </p>
                        </div>
                        <div>
                            <a asp-controller="Department" asp-action="Counseling" class="btn btn-outline-dark btn-sm rounded-pill px-3 py-1.5 fw-semibold">
                                <i class="bi bi-calendar-plus me-1"></i> Go to Counseling &amp; Reschedule
                            </a>
                        </div>
                    </div>

                    @if (Model.MissedAppointments != null && Model.MissedAppointments.Any())
                    {
                        <div class="table-responsive">
                            <table class="table align-middle">
                                <thead>
                                    <tr style="border-bottom: 2px solid #EBE3DC; color: #8F7D70; font-size: 13px;">
                                        <th class="pb-3">Student</th>
                                        <th class="pb-3">Scheduled Date</th>
                                        <th class="pb-3">Time Slot</th>
                                        <th class="pb-3">Assigned Psychologist</th>
                                        <th class="pb-3">Source / Reason</th>
                                        <th class="pb-3 text-center">Status</th>
                                        <th class="pb-3 text-end">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var missed in Model.MissedAppointments)
                                    {
                                        var startTime = DateTime.Today.Add(missed.AppointmentTime).ToString("h:mm tt");
                                        var endTime = missed.AppointmentEndTime != default 
                                            ? DateTime.Today.Add(missed.AppointmentEndTime).ToString("h:mm tt") 
                                            : DateTime.Today.Add(missed.AppointmentTime.Add(TimeSpan.FromHours(1))).ToString("h:mm tt");

                                        <tr style="border-bottom: 1px solid #F0E8E1;">
                                            <td class="py-3">
                                                <div class="fw-bold text-dark">@(missed.Student?.FullName ?? "Unknown Student")</div>
                                                <div class="small text-muted">ID: @(missed.Student?.StudentIdNumber ?? "-") | @(missed.Student?.Semester ?? "N/A")</div>
                                                @if (missed.Student?.IsSuspended == true)
                                                {
                                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2 py-0.5 mt-1" style="font-size:10px;">
                                                        <i class="bi bi-person-x me-1"></i> Suspended
                                                    </span>
                                                }
                                            </td>
                                            <td class="py-3">
                                                <span class="semester-badge">
                                                    <i class="bi bi-calendar3 me-1"></i> @missed.CounselingDate.ToString("dd MMM yyyy")
                                                </span>
                                            </td>
                                            <td class="py-3">
                                                <span class="badge bg-light text-dark border px-2.5 py-1.5 rounded-3">
                                                    <i class="bi bi-clock me-1 text-muted"></i> @startTime - @endTime
                                                </span>
                                            </td>
                                            <td class="py-3">
                                                <div class="fw-semibold text-secondary">@(missed.Psychologist?.FullName ?? "Psychologist")</div>
                                                <small class="text-muted">@(missed.Psychologist?.Specialization ?? "Mental Health Counselor")</small>
                                            </td>
                                            <td class="py-3">
                                                <span class="badge bg-light text-muted border px-2.5 py-1 rounded-pill">
                                                    @(missed.AppointmentSource ?? missed.TriggerSource ?? "Screening / Request")
                                                </span>
                                            </td>
                                            <td class="py-3 text-center">
                                                <span class="missed-badge">
                                                    <i class="bi bi-clock-history me-1"></i> Missed
                                                </span>
                                            </td>
                                            <td class="py-3 text-end">
                                                @if (missed.Student?.IsSuspended == true)
                                                {
                                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2.5 py-1" style="font-size:11px;">
                                                        Student Suspended
                                                    </span>
                                                }
                                                else
                                                {
                                                    <a asp-controller="Department" asp-action="Counseling" class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1 fw-semibold shadow-sm">
                                                        <i class="bi bi-calendar-plus me-1"></i> Reschedule
                                                    </a>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="empty-box">
                            <div class="empty-icon mb-3" style="background:#E7F0EC; color:#4B8869;">
                                <i class="bi bi-check2-circle fs-2"></i>
                            </div>
                            <h5 class="page-title">
                                No Missed Appointments
                            </h5>
                            <p class="page-subtitle mb-0">
                                All students in this department have attended their scheduled counseling sessions.
                            </p>
                        </div>
                    }

                </div>

            </div>

        </div>

    </div>

</div>