@model StudentMentalHealthMonitoringSystem.ViewModels.DepartmentViewModel

@{
    Layout = "_DepartmentLayout";

    ViewData["Title"] = "Department Dashboard";
}


<!-- =========================================================
     DEPARTMENT DASHBOARD
     ========================================================= -->

<div class="container-fluid py-4">


    <!-- =====================================================
         PAGE HEADER
         ===================================================== -->

    <div class="dashboard-header mb-4">

        <div class="row align-items-center">

            <div class="col-lg-8">

                <div class="small text-uppercase mb-2"
                     style="
                    color:#6B8494;
                    font-weight:600;
                    letter-spacing:1px;
                    ">

                    @Model.DepartmentName Department

                </div>


                <h2 class="mb-2"
                    style="
                    color:#405B6B;
                    font-weight:700;
                    ">

                    Department Dashboard

                </h2>


                <p class="mb-0"
                   style="
                    color:#7B8E99;
                    font-size:15px;
                    ">

                    Monitor student mental health,
                    counseling and follow-up activities.

                </p>

            </div>


            <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">

                <div style="
                    width:68px;
                    height:68px;
                    margin-left:auto;
                    border-radius:20px;
                    background:rgba(255,255,255,0.70);
                    display:flex;
                    align-items:center;
                    justify-content:center;
                    color:#5C7890;
                    font-size:30px;
                    box-shadow:0 8px 20px rgba(80,110,130,0.10);
                    ">

                    <i class="bi bi-building"></i>

                </div>

            </div>

        </div>

    </div>

    <!-- =====================================================
         ALERT MESSAGES
         ===================================================== -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm rounded-4 mb-4 d-flex align-items-center p-3">
            <i class="bi bi-check-circle-fill fs-4 me-3 text-success"></i>
            <div class="fw-semibold">@TempData["Success"]</div>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger border-0 shadow-sm rounded-4 mb-4 d-flex align-items-center p-3">
            <i class="bi bi-exclamation-triangle-fill fs-4 me-3 text-danger"></i>
            <div class="fw-semibold">@TempData["Error"]</div>
        </div>
    }

    <!-- =====================================================
         SUMMARY CARDS
         ===================================================== -->

    <div class="row g-4 mb-4">


        <!-- =================================================
             TOTAL STUDENTS
             ================================================= -->

        <div class="col-xl-3 col-md-6">

            <div class="dashboard-card h-100">

                <div class="d-flex
                    justify-content-between
                    align-items-start">

                    <div>

                        <div class="card-label">

                            Total Students

                        </div>


                        <div class="card-number">

                            @Model.TotalStudents

                        </div>


                        <div class="card-description">

                            Students in your department

                        </div>

                    </div>


                    <div class="stat-icon"
                         style="
                        background:#E5F3FA;
                        color:#5B9AB8;
                        ">

                        <i class="bi bi-people"></i>

                    </div>

                </div>

            </div>

        </div>



        <!-- =================================================
             HIGH-RISK STUDENTS
             ================================================= -->

        <div class="col-xl-3 col-md-6">

            <div class="dashboard-card h-100">

                <div class="d-flex
                    justify-content-between
                    align-items-start">

                    <div>

                        <div class="card-label">

                            High Risk

                        </div>


                        <div class="card-number">

                            @Model.HighRiskStudents

                        </div>


                        <div class="card-description">

                            Students requiring attention

                        </div>

                    </div>


                    <div class="stat-icon"
                         style="
                        background:#F5EAF0;
                        color:#A96F8D;
                        ">

                        <i class="bi bi-heart-pulse"></i>

                    </div>

                </div>

            </div>

        </div>



        <!-- =================================================
             COUNSELING SESSIONS
             ================================================= -->

        <div class="col-xl-3 col-md-6">

            <div class="dashboard-card h-100">

                <div class="d-flex
                    justify-content-between
                    align-items-start">

                    <div>

                        <div class="card-label">

                            Counseling Sessions

                        </div>


                        <div class="card-number">

                            @Model.TotalCounselingSessions

                        </div>


                        <div class="card-description">

                            Total counseling records

                        </div>

                    </div>


                    <div class="stat-icon"
                         style="
                        background:#EEEAF7;
                        color:#8171A5;
                        ">

                        <i class="bi bi-chat-heart"></i>

                    </div>

                </div>

            </div>

        </div>



        <!-- =================================================
             UPCOMING FOLLOW-UPS
             ================================================= -->

        <div class="col-xl-3 col-md-6">

            <div class="dashboard-card h-100">

                <div class="d-flex
                    justify-content-between
                    align-items-start">

                    <div>

                        <div class="card-label">

                            Upcoming Follow-ups

                        </div>


                        <div class="card-number">

                            @Model.UpcomingFollowUps

                        </div>


                        <div class="card-description">

                            Follow-up appointments

                        </div>

                    </div>


                    <div class="stat-icon"
                         style="
                        background:#F6EFE5;
                        color:#A98963;
                        ">

                        <i class="bi bi-calendar-heart"></i>

                    </div>

                </div>

            </div>

        </div>

    </div>



    <!-- =====================================================
         LOWER SECTION
         ===================================================== -->

    <div class="row g-4">


        <!-- =================================================
             UPCOMING COUNSELING
             ================================================= -->

        <div class="col-lg-8">

            <div class="main-card h-100">


                <!-- =========================================
                     CARD HEADER
                     ========================================= -->

                <div class="card-header-clean">

                    <div>

                        <h5 class="mb-1"
                            style="
                            color:#4A6272;
                            font-weight:700;
                            ">

                            Upcoming Counseling

                        </h5>


                        <p class="mb-0"
                           style="
                            color:#8999A3;
                            font-size:13px;
                            ">

                            Next scheduled counseling appointments

                        </p>

                    </div>


                    <div class="section-icon">

                        <i class="bi bi-calendar2-heart"></i>

                    </div>

                </div>



                <!-- =========================================
                     CARD BODY
                     ========================================= -->

                <div class="card-body p-0">


                    <!-- =================================================
                         CHECK WHETHER APPOINTMENTS EXIST
                         ================================================= -->
                    @if (Model.UpcomingCounselings != null &&
                                             Model.UpcomingCounselings.Count > 0)
                    {

                        <div class="table-responsive">

                            <table class="table
                                align-middle
                                mb-0">


                                <thead>

                                    <tr>

                                        <th>
                                            Student
                                        </th>

                                        <th>
                                            Psychologist
                                        </th>

                                        <th>
                                            Date
                                        </th>

                                        <th>
                                            Time
                                        </th>

                                        <th>
                                            Status
                                        </th>

                                        <th class="text-end">
                                            Action
                                        </th>

                                    </tr>

                                </thead>



                                <tbody>


                                    <!-- =================================
                                         LOOP THROUGH COUNSELING RECORDS
                                         ================================= -->
                                    @foreach (
                                                                            var item
                                                                            in Model.UpcomingCounselings)
                                    {

                                        <tr>


                                            <!-- =========================
                                                 STUDENT
                                                 ========================= -->

                                            <td>

                                                <div class="fw-semibold"
                                                     style="
                                                    color:#526A79;
                                                    ">

                                                    @item.Student?.FullName

                                                </div>


                                                <small style="
                                                    color:#91A0A9;
                                                    ">

                                                    @item.Student?.StudentIdNumber

                                                </small>

                                            </td>



                                            <!-- =========================
                                                 PSYCHOLOGIST
                                                 ========================= -->

                                            <td>

                                                <span style="
                                                    color:#647A88;
                                                    ">

                                                    @item.Psychologist?.FullName

                                                </span>

                                            </td>



                                            <!-- =========================
                                                 DATE
                                                 ========================= -->

                                            <td>

                                                <span class="date-pill">

                                                    <i class="bi bi-calendar3 me-1"></i>

                                                    @item.CounselingDate.ToString(
                                                        "dd MMM yyyy")

                                                </span>

                                            </td>



                                            <!-- =========================
                                                 TIME
                                                 ========================= -->

                                            <td>

                                                <span style="
                                                    color:#647A88;
                                                    font-weight:500;
                                                    ">

                                                    @item.AppointmentTime.Hours.ToString("00"):@item.AppointmentTime.Minutes.ToString("00")

                                                    -

                                                    @item.AppointmentEndTime.Hours.ToString("00"):@item.AppointmentEndTime.Minutes.ToString("00")

                                                </span>

                                            </td>



                                            <!-- =========================
                                                 STATUS
                                                 ========================= -->

                                            <td>

                                                <span class="status-pill">

                                                    @item.Status

                                                </span>
                                            </td>

                                            <!-- =========================
                                                 ACTION (CANCEL)
                                                 ========================= -->
                                            <td class="text-end">
                                                @{
                                                    var nowTime = DateTime.Now;
                                                    bool isCancellable = (item.Status == "Confirmed" || item.Status == "Pending") &&
                                                        (item.CounselingDate.Date > DateTime.Today ||
                                                        (item.CounselingDate.Date == DateTime.Today && item.AppointmentTime > nowTime.TimeOfDay));
                                                }
                                                @if (isCancellable)
                                                {
                                                    <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3 py-1 fw-semibold shadow-sm" data-bs-toggle="modal" data-bs-target="#deptCancelModal_@item.CounselingId">
                                                        <i class="bi bi-x-circle me-1"></i>Cancel
                                                    </button>
                                                }
                                                else
                                                {
                                                    <span class="text-muted small">-</span>
                                                }
                                            </td>

                                        </tr>

                                    }

                                </tbody>

                            </table>

                        </div>

                        @foreach (var item in Model.UpcomingCounselings)
                        {
                            if ((item.Status == "Confirmed" || item.Status == "Pending") &&
                                (item.CounselingDate.Date > DateTime.Today ||
                                (item.CounselingDate.Date == DateTime.Today && item.AppointmentTime > DateTime.Now.TimeOfDay)))
                            {
                                <div class="modal fade" id="deptCancelModal_@item.CounselingId" tabindex="-1" aria-labelledby="deptCancelModalLabel_@item.CounselingId" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content rounded-4 border-0 shadow">
                                            <div class="modal-header border-0 bg-danger text-white rounded-top-4 p-4">
                                                <h5 class="modal-title fw-bold" id="deptCancelModalLabel_@item.CounselingId">
                                                    <i class="bi bi-exclamation-triangle-fill me-2"></i>Cancel Student Appointment
                                                </h5>
                                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <form asp-controller="Department" asp-action="CancelAppointment" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.CounselingId" />
                                                <input type="hidden" name="returnUrl" value="/Department/Dashboard" />
                                                <div class="modal-body p-4 text-start">
                                                    <div class="alert alert-warning border-0 rounded-3 mb-3">
                                                        <i class="bi bi-info-circle me-1"></i>
                                                        You are about to cancel the counseling appointment for <strong>@item.Student?.FullName</strong> (ID: @item.Student?.StudentIdNumber).
                                                    </div>
                                                    <div class="p-3 bg-light rounded-3 mb-3 border">
                                                        <div class="d-flex justify-content-between mb-1">
                                                            <span class="text-muted small">Psychologist:</span>
                                                            <strong class="text-dark small">@(item.Psychologist?.FullName ?? "University Psychologist")</strong>
                                                        </div>
                                                        <div class="d-flex justify-content-between mb-1">
                                                            <span class="text-muted small">Date:</span>
                                                            <strong class="text-dark small">@item.CounselingDate.ToString("dd MMM yyyy")</strong>
                                                        </div>
                                                        <div class="d-flex justify-content-between">
                                                            <span class="text-muted small">Time:</span>
                                                            <strong class="text-dark small">@item.AppointmentTime.Hours.ToString("00"):@item.AppointmentTime.Minutes.ToString("00") – @item.AppointmentEndTime.Hours.ToString("00"):@item.AppointmentEndTime.Minutes.ToString("00")</strong>
                                                        </div>
                                                    </div>
                                                    <div class="mb-3">
                                                        <label for="deptCancelReason_@item.CounselingId" class="form-label fw-semibold text-dark small">
                                                            Reason for Cancellation (Optional)
                                                        </label>
                                                        <textarea name="reason" id="deptCancelReason_@item.CounselingId" rows="3" class="form-control rounded-3" placeholder="Provide reason for cancelling..."></textarea>
                                                    </div>
                                                    <p class="small text-muted mb-0">
                                                        Cancelling will free the appointment slot and send email notifications to the student, psychologist, and guardian.
                                                    </p>
                                                </div>
                                                <div class="modal-footer border-0 p-4 pt-0">
                                                    <button type="button" class="btn btn-light rounded-3 px-4 fw-semibold" data-bs-dismiss="modal">Keep Appointment</button>
                                                    <button type="submit" class="btn btn-danger rounded-3 px-4 fw-bold">
                                                        <i class="bi bi-x-circle me-1"></i> Confirm Cancellation
                                                    </button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            }
                        }

                    }
                    else
                    {

                        <!-- =============================================
                             EMPTY STATE
                             ============================================= -->

                        <div class="text-center py-5">

                            <div class="empty-icon mb-3">

                                <i class="bi bi-calendar-check"></i>

                            </div>


                            <h6 style="
                                color:#5C6F7B;
                                font-weight:600;
                                ">

                                No Upcoming Counseling

                            </h6>


                            <p class="mb-0"
                               style="
                                color:#929FA7;
                                font-size:13px;
                                ">

                                There are no upcoming
                                counseling appointments.

                            </p>

                        </div>

                    }

                </div>

            </div>

        </div>



        <!-- =================================================
             QUICK ACTIONS
             ================================================= -->

        <div class="col-lg-4">

            <div class="main-card h-100">


                <!-- =========================================
                     QUICK ACTION HEADER
                     ========================================= -->

                <div class="card-header-clean">

                    <div>

                        <h5 class="mb-1"
                            style="
                            color:#4A6272;
                            font-weight:700;
                            ">

                            Quick Actions

                        </h5>


                        <p class="mb-0"
                           style="
                            color:#8999A3;
                            font-size:13px;
                            ">

                            Department management

                        </p>

                    </div>


                    <div class="section-icon">

                        <i class="bi bi-grid"></i>

                    </div>

                </div>



                <!-- =========================================
                     QUICK ACTION BODY
                     ========================================= -->

                <div class="card-body p-4">


                    <!-- =====================================
                         STUDENTS
                         ===================================== -->

                    <a asp-controller="Department"
                       asp-action="Students"
                       class="quick-action">

                        <div class="quick-action-icon"
                             style="
                            background:#E5F3FA;
                            color:#5B9AB8;
                            ">

                            <i class="bi bi-people"></i>

                        </div>


                        <div>

                            <div class="quick-action-title">

                                View Students

                            </div>


                            <div class="quick-action-text">

                                View students in your department

                            </div>

                        </div>


                        <i class="bi bi-chevron-right
                        quick-action-arrow"></i>

                    </a>



                    <!-- =====================================
                         COUNSELING
                         ===================================== -->

                    <a asp-controller="Department"
                       asp-action="Counseling"
                       class="quick-action">

                        <div class="quick-action-icon"
                             style="
                            background:#EEEAF7;
                            color:#8171A5;
                            ">

                            <i class="bi bi-chat-heart"></i>

                        </div>


                        <div>

                            <div class="quick-action-title">

                                Counseling

                            </div>


                            <div class="quick-action-text">

                                Manage counseling appointments

                            </div>

                        </div>


                        <i class="bi bi-chevron-right
                        quick-action-arrow"></i>

                    </a>



                    <!-- =====================================
                         FOLLOW-UP
                         ===================================== -->

                    <a asp-controller="Department"
                       asp-action="FollowUp"
                       class="quick-action">

                        <div class="quick-action-icon"
                             style="
                            background:#F6EFE5;
                            color:#A98963;
                            ">

                            <i class="bi bi-calendar-heart"></i>

                        </div>


                        <div>

                            <div class="quick-action-title">

                                Follow-up

                            </div>


                            <div class="quick-action-text">

                                Monitor follow-up appointments

                            </div>

                        </div>


                        <i class="bi bi-chevron-right
                        quick-action-arrow"></i>

                    </a>



                    <!-- =====================================
                         REPORTS
                         ===================================== -->

                    <a asp-controller="Department"
                       asp-action="Reports"
                       class="quick-action">

                        <div class="quick-action-icon"
                             style="
                            background:#F5EAF0;
                            color:#A96F8D;
                            ">

                            <i class="bi bi-bar-chart"></i>

                        </div>


                        <div>

                            <div class="quick-action-title">

                                Risk Reports

                            </div>


                            <div class="quick-action-text">

                                View high-risk student reports

                            </div>

                        </div>


                        <i class="bi bi-chevron-right
                        quick-action-arrow"></i>

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>



<!-- =========================================================
     DASHBOARD PAGE STYLES
     ========================================================= -->

<style>


    /* =========================================================
           DASHBOARD HEADER
           ========================================================= */

    .dashboard-header {
        background: linear-gradient( 135deg, #B8DDF0, #C9DFEC, #DCD3E9 );
        border-radius: 24px;
        padding: 32px;
        box-shadow: 0 10px 30px rgba(78, 112, 132, 0.10);
    }



    /* =========================================================
           SUMMARY CARD
           ========================================================= */

    .dashboard-card {
        background: #FFFFFF;
        border: 1px solid #E3EBEF;
        border-radius: 20px;
        padding: 24px;
        box-shadow: 0 8px 24px rgba(80, 105, 120, 0.07);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }


        .dashboard-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 28px rgba(80, 105, 120, 0.11);
        }



    /* =========================================================
           CARD TEXT
           ========================================================= */

    .card-label {
        color: #82929C;
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 8px;
    }


    .card-number {
        color: #465F6F;
        font-size: 32px;
        font-weight: 700;
        line-height: 1.1;
        margin-bottom: 7px;
    }


    .card-description {
        color: #9AA6AD;
        font-size: 12px;
    }



    /* =========================================================
           STAT ICON
           ========================================================= */

    .stat-icon {
        width: 52px;
        height: 52px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
    }



    /* =========================================================
           MAIN CARD
           ========================================================= */

    .main-card {
        background: #FFFFFF;
        border: 1px solid #E3EBEF;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 8px 24px rgba(80, 105, 120, 0.07);
    }



    /* =========================================================
           CARD HEADER
           ========================================================= */

    .card-header-clean {
        padding: 22px 24px;
        border-bottom: 1px solid #EDF1F3;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }



    /* =========================================================
           SECTION ICON
           ========================================================= */

    .section-icon {
        width: 42px;
        height: 42px;
        border-radius: 13px;
        background: #EDF4F8;
        color: #658296;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 19px;
    }



    /* =========================================================
           TABLE
           ========================================================= */

    .table thead th {
        background: #F7FAFB;
        color: #7A8D98;
        font-size: 12px;
        font-weight: 600;
        border-bottom: 1px solid #E9EFF2;
        padding: 15px 18px;
        white-space: nowrap;
    }


    .table tbody td {
        padding: 17px 18px;
        border-bottom: 1px solid #F0F3F5;
    }


    .table tbody tr:last-child td {
        border-bottom: none;
    }



    /* =========================================================
           DATE PILL
           ========================================================= */

    .date-pill {
        display: inline-flex;
        align-items: center;
        padding: 7px 10px;
        border-radius: 10px;
        background: #EDF6FA;
        color: #64879B;
        font-size: 12px;
        white-space: nowrap;
    }



    /* =========================================================
           STATUS PILL
           ========================================================= */

    .status-pill {
        display: inline-block;
        padding: 7px 12px;
        border-radius: 20px;
        background: #E9F3F7;
        color: #5C8295;
        font-size: 12px;
        font-weight: 600;
    }



    /* =========================================================
           EMPTY STATE
           ========================================================= */

    .empty-icon {
        width: 62px;
        height: 62px;
        margin: auto;
        border-radius: 18px;
        background: #EEF5F8;
        color: #7896A7;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 26px;
    }



    /* =========================================================
           QUICK ACTION
           ========================================================= */

    .quick-action {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 14px;
        margin-bottom: 10px;
        text-decoration: none;
        border-radius: 15px;
        transition: background 0.2s ease, transform 0.2s ease;
    }


        .quick-action:hover {
            background: #F6F9FA;
            transform: translateX(3px);
        }


        .quick-action:last-child {
            margin-bottom: 0;
        }



    /* =========================================================
           QUICK ACTION ICON
           ========================================================= */

    .quick-action-icon {
        width: 46px;
        height: 46px;
        min-width: 46px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 19px;
    }



    /* =========================================================
           QUICK ACTION TEXT
           ========================================================= */

    .quick-action-title {
        color: #536A78;
        font-size: 14px;
        font-weight: 650;
        margin-bottom: 3px;
    }


    .quick-action-text {
        color: #98A5AC;
        font-size: 11px;
    }



    /* =========================================================
           QUICK ACTION ARROW
           ========================================================= */

    .quick-action-arrow {
        margin-left: auto;
        color: #A2B0B8;
        font-size: 14px;
    }



    /* =========================================================
           MOBILE RESPONSIVE
           ========================================================= */

    @@media (max-width: 768px) {

        .dashboard-header {
            padding: 24px;
            border-radius: 20px;
        }


        .card-number {
            font-size: 27px;
        }
    }

</style>