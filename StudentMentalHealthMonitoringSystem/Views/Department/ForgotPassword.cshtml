@{
    ViewData["Title"] = "Forgot Password - Department";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-5 col-md-7 col-sm-10">
            <div class="card border-0 shadow-lg" style="border-radius:24px; overflow:hidden; background:#FFFFFF;">
                
                <!-- Header -->
                <div class="text-center p-4" style="background:linear-gradient(135deg, #A9D8F0, #BFDDF0, #D8D0E8);">
                    <div class="mb-3" style="width:70px; height:70px; margin:0 auto; border-radius:50%; background:rgba(255,255,255,0.65); display:flex; align-items:center; justify-content:center; color:#45677D; font-size:30px;">
                        <i class="bi bi-shield-lock"></i>
                    </div>
                    <h3 class="mb-1" style="color:#405B6B; font-weight:700;">Department Recovery</h3>
                    <p class="mb-0" style="color:#607889; font-size:14px;">Reset your department portal access password</p>
                </div>

                <!-- Body -->
                <div class="card-body p-4 p-lg-5">
                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger border-0 rounded-3 mb-3 small">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i> @ViewBag.Error
                        </div>
                    }

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger border-0 rounded-3 mb-3 small">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i> @TempData["ErrorMessage"]
                        </div>
                    }

                    <form asp-controller="Department" asp-action="ForgotPassword" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-4">
                            <label class="form-label fw-bold" style="color:#526A79; font-size:13px;">Department Email Address</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0" style="color:#587C8E;"><i class="bi bi-envelope"></i></span>
                                <input type="email" name="email" class="form-control border-start-0 ps-1" placeholder="dept@domain.edu" required autofocus />
                            </div>
                            <small class="text-muted">A 6-digit verification code will be sent to this email.</small>
                        </div>

                        <button type="submit" class="btn w-100 rounded-3 py-2.5 fw-bold mb-3 shadow-sm" style="background:#587C8E; color:#FFFFFF;">
                            <i class="bi bi-send-fill me-1"></i> Send Verification Code
                        </button>
                    </form>

                    <div class="text-center">
                        <a asp-controller="Department" asp-action="Login" class="text-decoration-none fw-semibold small" style="color:#587C8E;">
                            <i class="bi bi-arrow-left me-1"></i> Back to Department Login
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
