@model StudentMentalHealthMonitoringSystem.ViewModels.ScreeningAnalyticsViewModel

@{
    Layout = "_DepartmentLayout";
    ViewData["Title"] = "Department Screening Analytics";
}

<div class="container-fluid py-4" id="deptScreeningAnalyticsContent">

    <!-- ================= Header ================= -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-1">
                <i class="bi bi-pie-chart-fill me-2 text-primary"></i>
                @Model.UserDepartment Screening Analytics
            </h3>
            <p class="text-muted mb-0">
                Departmental screening report, severity breakdown percentages, and student numbers for <strong>@Model.SelectedSemester</strong>.
            </p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-primary fs-6 px-3 py-2 rounded-pill">
                <i class="bi bi-building me-1"></i> @Model.UserDepartment
            </span>
        </div>
    </div>

    <!-- ================= Filters ================= -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4">
            <form method="get" asp-controller="Department" asp-action="ScreeningAnalytics" class="row g-3 align-items-end">
                <div class="col-md-9">
                    <label for="semester" class="form-label fw-semibold text-secondary">
                        <i class="bi bi-calendar3 me-1"></i> Select Semester
                    </label>
                    <select id="semester" name="semester" class="form-select rounded-3">
                        @foreach (var sem in Model.AvailableSemesters)
                        {
                            <option value="@sem" selected="@(sem == Model.SelectedSemester ? "selected" : null)">@sem</option>
                        }
                    </select>
                </div>

                <div class="col-md-3">
                    <button type="submit" class="btn btn-primary w-100 rounded-3 py-2 fw-semibold">
                        <i class="bi bi-filter me-1"></i> Filter Semester
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- ================= KPI Summary Cards ================= -->
    <div class="row g-3 mb-4">
        <div class="col-md-2">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-body p-3 text-center">
                    <div class="text-muted small fw-bold uppercase mb-1">Total Screenings</div>
                    <h3 class="fw-extrabold text-dark mb-0">@Model.TotalScreeningsConducted</h3>
                    <small class="text-muted">@Model.TotalScreenedStudents Students</small>
                </div>
            </div>
        </div>

        <div class="col-md-2.5" style="width: 20%;">
            <div class="card border-0 shadow-sm rounded-4 h-100 border-start border-4 border-success bg-white">
                <div class="card-body p-3">
                    <div class="text-success small fw-bold text-uppercase mb-1"><i class="bi bi-emoji-smile me-1"></i> Normal</div>
                    <h3 class="fw-bold text-success mb-0">@Model.NormalPercentage%</h3>
                    <div class="text-muted small">@Model.NormalCount / @Model.TotalScreenedStudents Students</div>
                </div>
            </div>
        </div>

        <div class="col-md-2.5" style="width: 20%;">
            <div class="card border-0 shadow-sm rounded-4 h-100 border-start border-4 border-warning bg-white">
                <div class="card-body p-3">
                    <div class="text-warning small fw-bold text-uppercase mb-1"><i class="bi bi-emoji-neutral me-1"></i> Moderate</div>
                    <h3 class="fw-bold text-warning mb-0">@Model.ModeratePercentage%</h3>
                    <div class="text-muted small">@Model.ModerateCount / @Model.TotalScreenedStudents Students</div>
                </div>
            </div>
        </div>

        <div class="col-md-2.5" style="width: 20%;">
            <div class="card border-0 shadow-sm rounded-4 h-100 border-start border-4 border-danger bg-white">
                <div class="card-body p-3">
                    <div class="text-danger small fw-bold text-uppercase mb-1"><i class="bi bi-emoji-frown me-1"></i> Severe</div>
                    <h3 class="fw-bold text-danger mb-0">@Model.SeverePercentage%</h3>
                    <div class="text-muted small">@Model.SevereCount / @Model.TotalScreenedStudents Students</div>
                </div>
            </div>
        </div>

        <div class="col-md-2.5" style="width: 20%;">
            <div class="card border-0 shadow-sm rounded-4 h-100 border-start border-4 border-dark bg-white">
                <div class="card-body p-3">
                    <div class="text-dark small fw-bold text-uppercase mb-1"><i class="bi bi-exclamation-octagon me-1"></i> Extremely Severe</div>
                    <h3 class="fw-bold text-dark mb-0">@Model.ExtremelySeverePercentage%</h3>
                    <div class="text-muted small">@Model.ExtremelySevereCount / @Model.TotalScreenedStudents Students</div>
                </div>
            </div>
        </div>
    </div>

    <!-- ================= Charts Row ================= -->
    <div class="row g-4 mb-4">
        <!-- Chart 1: Doughnut Severity Distribution -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0">
                    <h5 class="fw-bold text-dark mb-0">
                        <i class="bi bi-pie-chart me-2 text-primary"></i>
                        Department Severity Proportions
                    </h5>
                    <small class="text-muted">Percentages of Normal, Moderate, Severe, and Extremely Severe students</small>
                </div>
                <div class="card-body p-4 d-flex align-items-center justify-content-center" style="min-height: 320px;">
                    <canvas id="deptDoughnutChart" style="max-height: 280px;"></canvas>
                </div>
            </div>
        </div>

        <!-- Chart 2: Severity Status Bar Chart -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0">
                    <h5 class="fw-bold text-dark mb-0">
                        <i class="bi bi-bar-chart-line me-2 text-primary"></i>
                        Severity Student Counts & Percentages
                    </h5>
                    <small class="text-muted">Student numbers for each severity level in @Model.UserDepartment</small>
                </div>
                <div class="card-body p-4" style="min-height: 320px;">
                    <canvas id="deptBarChart" style="max-height: 280px;"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- ================= Summary Table ================= -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-transparent border-0 pt-4 px-4 pb-2">
            <h5 class="fw-bold text-dark mb-0">
                <i class="bi bi-table me-2 text-primary"></i>
                @Model.UserDepartment Screening Summary
            </h5>
            <small class="text-muted">Detailed statistics for your department</small>
        </div>
        <div class="card-body p-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Department</th>
                            <th class="text-center">Total Students</th>
                            <th class="text-center">Total Screened</th>
                            <th class="text-center text-success">Normal</th>
                            <th class="text-center text-warning">Moderate</th>
                            <th class="text-center text-danger">Severe</th>
                            <th class="text-center text-dark">Extremely Severe</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.DepartmentBreakdowns != null && Model.DepartmentBreakdowns.Any())
                        {
                            var d = Model.DepartmentBreakdowns.First();
                            <tr>
                                <td class="fw-semibold">@d.DepartmentName</td>
                                <td class="text-center">@d.TotalStudents</td>
                                <td class="text-center"><span class="badge bg-secondary rounded-pill px-3">@d.TotalScreened</span></td>
                                <td class="text-center">
                                    <span class="fw-bold text-success">@d.NormalPercentage%</span>
                                    <span class="text-muted small ms-1">(@d.NormalCount)</span>
                                </td>
                                <td class="text-center">
                                    <span class="fw-bold text-warning">@d.ModeratePercentage%</span>
                                    <span class="text-muted small ms-1">(@d.ModerateCount)</span>
                                </td>
                                <td class="text-center">
                                    <span class="fw-bold text-danger">@d.SeverePercentage%</span>
                                    <span class="text-muted small ms-1">(@d.SevereCount)</span>
                                </td>
                                <td class="text-center">
                                    <span class="fw-bold text-dark">@d.ExtremelySeverePercentage%</span>
                                    <span class="text-muted small ms-1">(@d.ExtremelySevereCount)</span>
                                </td>
                            </tr>
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">No screening records found for this semester.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Chart 1: Doughnut Chart
            const ctxDoughnut = document.getElementById('deptDoughnutChart').getContext('2d');
            new Chart(ctxDoughnut, {
                type: 'doughnut',
                data: {
                    labels: ['Normal', 'Moderate', 'Severe', 'Extremely Severe'],
                    datasets: [{
                        data: [@Model.NormalCount, @Model.ModerateCount, @Model.SevereCount, @Model.ExtremelySevereCount],
                        backgroundColor: ['#198754', '#ffc107', '#dc3545', '#212529'],
                        borderWidth: 2,
                        borderColor: '#ffffff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: { padding: 15, font: { size: 12, weight: 'bold' } }
                        },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    let label = context.label || '';
                                    let val = context.raw || 0;
                                    let total = @Model.TotalScreenedStudents;
                                    let pct = total > 0 ? ((val / total) * 100).toFixed(1) : 0;
                                    return `${label}: ${val} Students (${pct}%)`;
                                }
                            }
                        }
                    }
                }
            });

            // Chart 2: Bar Chart
            const ctxBar = document.getElementById('deptBarChart').getContext('2d');
            new Chart(ctxBar, {
                type: 'bar',
                data: {
                    labels: ['Normal', 'Moderate', 'Severe', 'Extremely Severe'],
                    datasets: [{
                        label: 'Student Percentage (%)',
                        data: [@Model.NormalPercentage, @Model.ModeratePercentage, @Model.SeverePercentage, @Model.ExtremelySeverePercentage],
                        backgroundColor: ['#198754', '#ffc107', '#dc3545', '#212529'],
                        borderRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: { max: 100, ticks: { callback: v => v + '%' } }
                    },
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function(ctx) {
                                    return `Percentage: ${ctx.raw}%`;
                                }
                            }
                        }
                    }
                }
            });
        });
    </script>
}
