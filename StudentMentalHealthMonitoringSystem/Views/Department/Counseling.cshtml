@model IEnumerable<StudentMentalHealthMonitoringSystem.Models.Student>

@{
    // =========================================================
    // PAGE CONFIGURATION
    // =========================================================

    ViewData["Title"] = "Counseling";


    // Logged-in Department Name
    var departmentName =
        ViewBag.DepartmentName as string ?? "Department";


    // Existing Counseling Records
    // Controller থেকে ViewBag-এ আসবে
    var counselings =
        ViewBag.Counselings as
        IEnumerable<StudentMentalHealthMonitoringSystem.Models.Counseling>
        ?? Enumerable.Empty<StudentMentalHealthMonitoringSystem.Models.Counseling>();

    // Missed Auto-Assigned Screening Sessions
    var missedScreeningCounselings =
        ViewBag.MissedScreeningCounselings as
        IEnumerable<StudentMentalHealthMonitoringSystem.Models.Counseling>
        ?? Enumerable.Empty<StudentMentalHealthMonitoringSystem.Models.Counseling>();
}


<style>

    /* =========================================================
               MAIN PAGE / HEADER
               ========================================================= */

    .counseling-header {
        background: linear-gradient( 135deg, #F5E7ED, #E9E1F1, #E7F0EC );
        border-radius: 24px;
        box-shadow: 0 8px 30px rgba(95, 81, 70, .07);
    }


    /* =========================================================
               COMMON CARD DESIGN
               ========================================================= */

    .main-card {
        background: #FFFFFF;
        border: none;
        border-radius: 22px;
        box-shadow: 0 8px 30px rgba(95, 81, 70, .07);
    }


    /* =========================================================
               PAGE TITLE & SUBTITLE
               ========================================================= */

    .page-title {
        color: #5F5146;
        font-weight: 700;
    }


    .page-subtitle {
        color: #9A8B7D;
        font-size: 14px;
    }


    /* =========================================================
               FORM LABEL
               ========================================================= */

    .form-label {
        color: #6F6258;
        font-size: 13px;
        font-weight: 600;
    }


    /* =========================================================
               FORM INPUTS
               ========================================================= */

    .form-control,
    .form-select {
        border: 1px solid #E5DCD5;
        border-radius: 13px;
        padding: 11px 14px;
        color: #5F5146;
        background: #FFFFFF;
    }


        /* Input focus effect */

        .form-control:focus,
        .form-select:focus {
            border-color: #B9A4BE;
            box-shadow: 0 0 0 3px rgba(185, 164, 190, .15);
        }


    /* =========================================================
               BOOKING BUTTON
               ========================================================= */

    .book-btn {
        background: #9B839F;
        color: #FFFFFF;
        border: none;
        border-radius: 13px;
        padding: 11px 24px;
        font-weight: 600;
        transition: all .2s ease;
    }


        .book-btn:hover {
            background: #846D88;
            color: #FFFFFF;
            transform: translateY(-1px);
            box-shadow: 0 6px 15px rgba(132, 109, 136, .18);
        }


    /* =========================================================
               APPOINTMENT RULE CARD
               ========================================================= */

    .rule-card {
        background: #FBF8F6;
        border: 1px solid #EEE6DF;
        border-radius: 17px;
        padding: 15px;
        transition: all .2s ease;
    }


        .rule-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(95, 81, 70, .05);
        }


    /* Rule icon */

    .rule-icon {
        width: 42px;
        height: 42px;
        border-radius: 13px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #E9E0F0;
        color: #90779A;
        flex-shrink: 0;
    }


    /* =========================================================
               EXISTING APPOINTMENT CARD
               ========================================================= */

    .appointment-card {
        background: #FCFAF8;
        border: 1px solid #EEE6DF;
        border-radius: 18px;
        transition: all .2s ease;
    }


        .appointment-card:hover {
            background: #FBF8F6;
            box-shadow: 0 6px 18px rgba(95, 81, 70, .05);
            transform: translateY(-1px);
        }


    /* =========================================================
               DATE BADGE
               ========================================================= */

    .date-badge {
        background: #E9E0F0;
        color: #76627F;
        border-radius: 11px;
        padding: 8px 12px;
        font-size: 12px;
        font-weight: 600;
        display: inline-block;
        white-space: nowrap;
    }


    /* =========================================================
               TIME BADGE
               ========================================================= */

    .time-badge {
        background: #F2E5E8;
        color: #856873;
        border-radius: 11px;
        padding: 8px 12px;
        font-size: 12px;
        font-weight: 600;
        display: inline-block;
        white-space: nowrap;
    }


    /* =========================================================
               CONFIRMED STATUS
               ========================================================= */

    .status-confirmed {
        background: #E0ECE5;
        color: #657A6B;
        border-radius: 30px;
        padding: 7px 13px;
        font-size: 12px;
        font-weight: 600;
        display: inline-block;
    }


    /* =========================================================
               PENDING STATUS
               ========================================================= */

    .status-pending {
        background: #F3E6D5;
        color: #8B7157;
        border-radius: 30px;
        padding: 7px 13px;
        font-size: 12px;
        font-weight: 600;
        display: inline-block;
    }


    /* =========================================================
               COMPLETED STATUS
               ========================================================= */

    .status-completed {
        background: #DCE8E3;
        color: #5F786C;
        border-radius: 30px;
        padding: 7px 13px;
        font-size: 12px;
        font-weight: 600;
        display: inline-block;
    }


    /* =========================================================
               CANCELLED STATUS
               ========================================================= */

    .status-cancelled {
        background: #F2DDE1;
        color: #8D626A;
        border-radius: 30px;
        padding: 7px 13px;
        font-size: 12px;
        font-weight: 600;
        display: inline-block;
    }

    .status-missed {
        background: #E9ECEF;
        color: #6C757D;
        border-radius: 30px;
        padding: 7px 13px;
        font-size: 12px;
        font-weight: 600;
        display: inline-block;
    }


    /* =========================================================
               EMPTY STATE
               ========================================================= */

    .empty-box {
        padding: 55px 20px;
        text-align: center;
    }


    .empty-icon {
        width: 72px;
        height: 72px;
        margin: auto;
        border-radius: 22px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #EEE6F1;
        color: #917A9B;
    }


    /* =========================================================
               RESPONSIVE DESIGN
               ========================================================= */

    @@media (max-width: 768px) {

        .counseling-header {
            border-radius: 20px;
        }

        .main-card {
            border-radius: 18px;
        }

        .appointment-card {
            border-radius: 16px;
        }
    }

</style>


<div class="container-fluid">


    <!-- =========================================================
         PAGE HEADER
         ========================================================= -->

    <div class="counseling-header mb-4">

        <div class="p-4 p-lg-5">

            <div class="d-flex justify-content-between
                align-items-center
                flex-wrap gap-3">


                <!-- ================= Header Text ================= -->

                <div>

                    <div class="page-subtitle mb-1">

                        @departmentName Department

                    </div>


                    <h2 class="page-title mb-1">

                        Counseling Management

                    </h2>


                    <p class="page-subtitle mb-0">

                        Schedule counseling appointments using
                        available fixed counseling slots.

                    </p>

                </div>


                <!-- ================= Header Icon ================= -->

                <div style="
                    width:64px;
                    height:64px;
                    border-radius:20px;
                    background:rgba(255,255,255,.55);
                    display:flex;
                    align-items:center;
                    justify-content:center;
                    color:#9B839F;
                    font-size:30px;
                    box-shadow:0 6px 20px rgba(95,81,70,.06);
                    ">

                    <i class="bi bi-calendar-heart"></i>

                </div>

            </div>

        </div>

    </div>



    <!-- =========================================================
         SUCCESS / ERROR MESSAGES
         ========================================================= -->
    @if (TempData["Success"] != null)
    {
        <div class="alert border-0 rounded-4 mb-4"
             style="
            background:#E4EFE8;
            color:#60776A;
            ">

            <i class="bi bi-check-circle me-2"></i>

            @TempData["Success"]

        </div>
    }


    @if (TempData["Error"] != null)
    {
        <div class="alert border-0 rounded-4 mb-4"
             style="
            background:#F3E0E3;
            color:#8B626B;
            ">

            <i class="bi bi-exclamation-circle me-2"></i>

            @TempData["Error"]

        </div>
    }



    <!-- =========================================================
         BOOKING SECTION + APPOINTMENT RULES
         ========================================================= -->

    <div class="row g-4 mb-4">


        <!-- =====================================================
             LEFT SIDE - CREATE APPOINTMENT
             ===================================================== -->

        <div class="col-lg-8">

            <div class="main-card">

                <div class="card-body p-4 p-lg-5">


                    <div class="d-flex align-items-center gap-3 mb-2">

                        <div style="
                            width:45px;
                            height:45px;
                            border-radius:14px;
                            background:#F2E4E9;
                            color:#966F7D;
                            display:flex;
                            align-items:center;
                            justify-content:center;
                            ">

                            <i class="bi bi-calendar-plus fs-5"></i>

                        </div>


                        <div>

                            <h5 class="page-title mb-1">

                                Create Counseling Appointment

                            </h5>

                            <p class="page-subtitle mb-0">

                                Select a student, preferred date and
                                counseling time slot.

                            </p>

                        </div>

                    </div>


                    @if (ViewBag.SuggestedTimes != null && ((IEnumerable<TimeSpan>)ViewBag.SuggestedTimes).Any())
                    {
                        var suggestedTimesList = (IEnumerable<TimeSpan>)ViewBag.SuggestedTimes;
                        <div class="card border-0 rounded-4 mb-4" style="background:#F7F2ED; border:1px solid #E8DDD2;">
                            <div class="card-body p-3">
                                <h6 class="fw-bold mb-2 text-dark">
                                    <i class="bi bi-lightbulb-fill text-warning me-1"></i> Suggested Available Time Slots:
                                </h6>
                                <p class="text-secondary small mb-3">All psychologists are busy at your requested time. Click an alternative free slot below:</p>
                                <div class="d-flex flex-wrap gap-2">
                                    @foreach (var time in suggestedTimesList)
                                    {
                                        var suggestedEndTime = time.Add(TimeSpan.FromHours(1));
                                        var startTimeText = DateTime.Today.Add(time).ToString("h:mm tt");
                                        var endTimeText = DateTime.Today.Add(suggestedEndTime).ToString("h:mm tt");
                                        <button type="button" class="btn btn-outline-dark btn-sm rounded-pill px-3 py-1.5 fw-semibold" onclick="selectSuggestedSlot('@time.ToString(@"hh\:mm\:ss")')">
                                            <i class="bi bi-clock me-1"></i> @startTimeText - @endTimeText
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    }

                    <!-- =================================================
                         BOOKING FORM
                         ================================================= -->

                    <form asp-controller="Department"
                          asp-action="Counseling"
                          method="post"
                          class="mt-4">

                        @Html.AntiForgeryToken()


                        <!-- ================= Student Selection with Live Search ================= -->

                        <div class="mb-4">

                            <label class="form-label d-flex justify-content-between align-items-center mb-2">
                                <span><i class="bi bi-person me-1"></i> Student</span>
                                <small class="text-muted fw-normal">Search by Name, Email, or Student ID</small>
                            </label>

                            <div class="input-group mb-2">
                                <span class="input-group-text bg-white border-end-0" style="border-radius: 13px 0 0 13px; border-color: #E5DCD5;">
                                    <i class="bi bi-search text-secondary"></i>
                                </span>
                                <input type="text"
                                       id="studentSearchInput"
                                       class="form-control border-start-0"
                                       style="border-radius: 0 13px 13px 0;"
                                       placeholder="Type student name, email, or student ID to filter..."
                                       onkeyup="filterDepartmentStudents()"
                                       onfocus="filterDepartmentStudents()" />
                            </div>

                            <select name="studentId"
                                    id="studentSelect"
                                    class="form-select"
                                    size="5"
                                    required
                                    onchange="updateSelectedStudentPreview()">

                                <option value="" disabled selected>-- Select Student from List --</option>

                                @foreach (var student in Model)
                                {
                                    var selectedStudentId = ViewBag.SelectedStudentId as int?;
                                    var isSelected = selectedStudentId.HasValue && selectedStudentId.Value == student.StudentId;
                                    var searchData = $"{student.FullName} {student.StudentIdNumber} {student.Email} {student.Department}".ToLower();

                                    <option value="@student.StudentId"
                                            selected="@isSelected"
                                            data-name="@student.FullName"
                                            data-id="@student.StudentIdNumber"
                                            data-email="@(student.Email ?? "")"
                                            data-search="@searchData">
                                        @student.FullName | ID: @student.StudentIdNumber | Email: @(student.Email ?? "N/A")
                                    </option>
                                }

                            </select>

                            <div id="noStudentMatchMessage" class="text-danger small mt-1 d-none">
                                <i class="bi bi-exclamation-circle me-1"></i> No matching student found.
                            </div>

                            <!-- Selected Student Information Card -->
                            <div id="selectedStudentInfoBox" class="mt-3 p-3 rounded-3 d-none" style="background: #F7F3F8; border: 1px solid #E5DCE8;">
                                <div class="d-flex align-items-center gap-3">
                                    <div style="width: 40px; height: 40px; border-radius: 12px; background: #9B839F; color: #ffffff; display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 1.1rem;">
                                        <i class="bi bi-person-check-fill"></i>
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark mb-0" id="previewStudentName">Selected Student</div>
                                        <div class="small text-secondary">
                                            <span id="previewStudentId" class="me-2 fw-semibold"></span>
                                            <span id="previewStudentEmail"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>



                        <!-- ================= Date + Slot ================= -->

                        <div class="row g-4">


                            <div class="col-md-6">

                                <label class="form-label">

                                    <i class="bi bi-calendar3 me-1"></i>

                                    Preferred Date

                                </label>


                                <input type="date"
                                       name="counselingDate"
                                       class="form-control"
                                       min="@DateTime.Today.ToString("yyyy-MM-dd")"
                                       value="@(ViewBag.SelectedDate ?? DateTime.Today.ToString("yyyy-MM-dd"))"
                                       required />


                                <small class="page-subtitle">

                                    Saturday – Wednesday

                                </small>

                            </div>



                            <div class="col-md-6">

                                <label class="form-label">

                                    <i class="bi bi-clock me-1"></i>

                                    Counseling Slot

                                </label>

                                @{
                                    var selStartTime = ViewBag.SelectedStartTime as string;
                                }

                                <select name="startTime"
                                        class="form-select"
                                        required>

                                    <option value="">Select Time Slot</option>
                                    <option value="08:30:00" selected="@(selStartTime == "08:30:00")">8:30 AM - 9:30 AM</option>
                                    <option value="09:35:00" selected="@(selStartTime == "09:35:00")">9:35 AM - 10:35 AM</option>
                                    <option value="10:40:00" selected="@(selStartTime == "10:40:00")">10:40 AM - 11:40 AM</option>
                                    <option value="11:45:00" selected="@(selStartTime == "11:45:00")">11:45 AM - 12:45 PM</option>
                                    <option value="13:10:00" selected="@(selStartTime == "13:10:00")">1:10 PM - 2:10 PM</option>
                                    <option value="14:15:00" selected="@(selStartTime == "14:15:00")">2:15 PM - 3:15 PM</option>
                                    <option value="15:20:00" selected="@(selStartTime == "15:20:00")">3:20 PM - 4:20 PM</option>
                                    <option value="16:25:00" selected="@(selStartTime == "16:25:00")">4:25 PM - 5:25 PM</option>

                                </select>


                                <small class="page-subtitle">

                                    Fixed one-hour counseling slots

                                </small>

                            </div>

                        </div>



                        <div class="mt-4">

                            <button type="submit"
                                    class="book-btn">

                                <i class="bi bi-search me-2"></i>

                                Find & Assign Psychologist

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>



        <!-- =====================================================
             RIGHT SIDE - APPOINTMENT RULES
             ===================================================== -->

        <div class="col-lg-4">

            <div class="main-card h-100">

                <div class="card-body p-4">


                    <div class="d-flex align-items-center gap-3 mb-4">

                        <div style="
                            width:45px;
                            height:45px;
                            border-radius:14px;
                            background:#EAE3F0;
                            color:#8D7597;
                            display:flex;
                            align-items:center;
                            justify-content:center;
                            ">

                            <i class="bi bi-info-circle fs-5"></i>

                        </div>


                        <div>

                            <h5 class="page-title mb-1">

                                Appointment Rules

                            </h5>

                            <p class="page-subtitle mb-0">

                                Counseling scheduling guidelines

                            </p>

                        </div>

                    </div>



                    <!-- ================= Rule 1 ================= -->

                    <div class="rule-card mb-3">

                        <div class="d-flex">

                            <div class="rule-icon me-3">

                                <i class="bi bi-calendar3"></i>

                            </div>

                            <div>

                                <div class="fw-semibold"
                                     style="color:#5F5146;">

                                    Counseling Days

                                </div>

                                <div class="page-subtitle mt-1">

                                    Saturday – Wednesday

                                </div>

                            </div>

                        </div>

                    </div>



                    <!-- ================= Rule 2 ================= -->

                    <div class="rule-card mb-3">

                        <div class="d-flex">

                            <div class="rule-icon me-3">

                                <i class="bi bi-clock"></i>

                            </div>

                            <div>

                                <div class="fw-semibold"
                                     style="color:#5F5146;">

                                    Fixed Counseling Slots

                                </div>

                                <div class="page-subtitle mt-1">

                                    8:30 AM – 5:25 PM (8 Fixed 1-Hour Slots)

                                </div>

                            </div>

                        </div>

                    </div>



                    <!-- ================= Rule 3 ================= -->

                    <div class="rule-card mb-3">

                        <div class="d-flex">

                            <div class="rule-icon me-3">

                                <i class="bi bi-person-check"></i>

                            </div>

                            <div>

                                <div class="fw-semibold"
                                     style="color:#5F5146;">

                                    Availability Check

                                </div>

                                <div class="page-subtitle mt-1">

                                    Existing counseling appointments
                                    are checked before assignment.

                                </div>

                            </div>

                        </div>

                    </div>



                    <!-- ================= Rule 4 ================= -->

                    <div class="rule-card">

                        <div class="d-flex">

                            <div class="rule-icon me-3">

                                <i class="bi bi-hourglass-split"></i>

                            </div>

                            <div>

                                <div class="fw-semibold"
                                     style="color:#5F5146;">

                                    Maximum Session

                                </div>

                                <div class="page-subtitle mt-1">

                                    1 hour

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>



    <!-- =========================================================
         MISSED AUTO-ASSIGNED SCREENING SESSIONS ALERT SECTION
         ========================================================= -->
    @if (missedScreeningCounselings.Any())
    {
        <div class="main-card mb-4 border-start border-4 border-danger shadow-sm" style="background: #FFFBFB;">
            <div class="card-body p-4 p-lg-5">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
                    <div class="d-flex align-items-center gap-3">
                        <div style="width:48px; height:48px; border-radius:14px; background:#FEE2E2; color:#DC2626; display:flex; align-items:center; justify-content:center; box-shadow:0 4px 12px rgba(220,38,38,0.15);">
                            <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                        </div>
                        <div>
                            <div class="d-flex align-items-center gap-2">
                                <h5 class="page-title mb-0 text-danger fw-bold">
                                    Missed Auto-Assigned Screening Sessions
                                </h5>
                                <span class="badge bg-danger text-white rounded-pill px-3 py-1">
                                    @missedScreeningCounselings.Count() Students Pending Follow-up
                                </span>
                            </div>
                            <p class="page-subtitle mb-0 mt-1" style="color:#991B1B;">
                                These students had automated counseling appointments triggered by clinical mental health screening but missed their session. Immediate departmental reach-out is recommended.
                            </p>
                        </div>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table align-middle mb-0" style="border-collapse: separate; border-spacing: 0 8px;">
                        <thead>
                            <tr class="text-secondary small text-uppercase" style="border-bottom: 2px solid #F3D0D5;">
                                <th class="ps-3 py-2">Student</th>
                                <th class="py-2">Screening Trigger</th>
                                <th class="py-2">Severity</th>
                                <th class="py-2">Missed Slot</th>
                                <th class="py-2">Assigned Psychologist</th>
                                <th class="py-2">Status</th>
                                <th class="text-end pe-3 py-2">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var missed in missedScreeningCounselings)
                            {
                                var stName = missed.Student?.FullName ?? "Student";
                                var stIdNum = missed.Student?.StudentIdNumber ?? "-";
                                var stSemester = missed.Student?.Semester ?? "-";
                                var trig = string.IsNullOrWhiteSpace(missed.TriggerSource) ? "Screening Assessment" : missed.TriggerSource;
                                var sev = string.IsNullOrWhiteSpace(missed.TriggerSeverity) ? (missed.RiskLevel ?? "High Risk") : missed.TriggerSeverity;
                                var psy = missed.Psychologist?.FullName ?? "Assigned Psychologist";
                                var slotTime = DateTime.Today.Add(missed.AppointmentTime).ToString("h:mm tt") + " - " + DateTime.Today.Add(missed.AppointmentEndTime).ToString("h:mm tt");

                                <tr style="background:#FFFFFF; border-radius:12px; box-shadow:0 2px 8px rgba(0,0,0,0.03);">
                                    <td class="ps-3 py-3" style="border-top-left-radius:12px; border-bottom-left-radius:12px;">
                                        <div class="d-flex align-items-center gap-2">
                                            <div style="width:36px; height:36px; border-radius:10px; background:#FEE2E2; color:#DC2626; display:flex; align-items:center; justify-content:center; font-weight:bold; font-size:0.9rem;">
                                                @(stName.Length > 0 ? stName.Substring(0,1).ToUpper() : "S")
                                            </div>
                                            <div>
                                                <strong class="d-block text-dark" style="font-size:0.92rem;">@stName</strong>
                                                <small class="text-muted">ID: @stIdNum • Sem: @stSemester</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="py-3">
                                        <span class="badge rounded-pill px-3 py-1.5 fw-bold" style="background:#FBEAEB; color:#991B1B;">
                                            <i class="bi bi-shield-exclamation me-1"></i> @trig
                                        </span>
                                    </td>
                                    <td class="py-3">
                                        @if (sev == "Extremely Severe")
                                        {
                                            <span class="badge bg-danger text-white rounded-pill px-3 py-1.5 shadow-sm">
                                                <i class="bi bi-exclamation-octagon-fill me-1"></i> @sev
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-1.5">
                                                <i class="bi bi-exclamation-triangle-fill me-1"></i> @sev
                                            </span>
                                        }
                                    </td>
                                    <td class="py-3">
                                        <div class="fw-semibold text-danger" style="font-size:0.85rem;">
                                            <i class="bi bi-calendar-x me-1"></i> @missed.CounselingDate.ToString("dd MMM yyyy")
                                        </div>
                                        <small class="text-muted">@slotTime</small>
                                    </td>
                                    <td class="py-3">
                                        <span class="text-dark fw-semibold" style="font-size:0.88rem;">@psy</span>
                                    </td>
                                    <td class="py-3">
                                        <span class="badge bg-danger text-white rounded-pill px-3 py-1.5 shadow-sm">
                                            <i class="bi bi-x-circle-fill me-1"></i> Missed
                                        </span>
                                    </td>
                                    <td class="text-end pe-3 py-3" style="border-top-right-radius:12px; border-bottom-right-radius:12px;">
                                        <div class="d-flex justify-content-end gap-2">
                                            <a asp-controller="Department" asp-action="StudentDetails" asp-route-id="@missed.StudentId"
                                               class="btn btn-sm btn-outline-dark rounded-pill px-3 py-1 fw-semibold">
                                                <i class="bi bi-person-bounding-box me-1"></i> Student Case
                                            </a>
                                            <button type="button" class="btn btn-sm btn-danger rounded-pill px-3 py-1 fw-semibold shadow-sm"
                                                    onclick="selectMissedStudentForBooking(@missed.StudentId)">
                                                <i class="bi bi-calendar-plus me-1"></i> Re-book
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <!-- =========================================================
         EXISTING COUNSELING APPOINTMENTS
         ========================================================= -->

    <div class="main-card">

        <div class="card-body p-4 p-lg-5">

            <div class="d-flex justify-content-between
                align-items-center
                flex-wrap gap-3 mb-4">


                <div class="d-flex align-items-center gap-3">

                    <div style="
                        width:45px;
                        height:45px;
                        border-radius:14px;
                        background:#E3EEE7;
                        color:#647A6C;
                        display:flex;
                        align-items:center;
                        justify-content:center;
                        ">

                        <i class="bi bi-calendar-check fs-5"></i>

                    </div>


                    <div>

                        <h5 class="page-title mb-1">

                            Counseling Appointments

                        </h5>


                        <p class="page-subtitle mb-0">

                            Recent counseling appointments
                            within your department.

                        </p>

                    </div>

                </div>


                <div style="
                    color:#9B839F;
                    font-size:25px;
                    ">

                    <i class="bi bi-calendar-heart"></i>

                </div>

            </div>


            @if (counselings.Any())
            {
                <div class="row g-3">

                    @foreach (var item in counselings)
                    {
                        var startHour =
                            item.AppointmentTime.Hours.ToString("00");

                        var startMinute =
                            item.AppointmentTime.Minutes.ToString("00");

                        var endHour =
                            item.AppointmentEndTime.Hours.ToString("00");

                        var endMinute =
                            item.AppointmentEndTime.Minutes.ToString("00");


                        <div class="col-12">

                            <div class="appointment-card p-4">

                                <div class="row align-items-center g-4">


                                    <!-- ================= Student ================= -->

                                    <div class="col-lg-3">

                                        <div class="d-flex align-items-center gap-3">

                                            <div style="
                                                width:42px;
                                                height:42px;
                                                border-radius:13px;
                                                background:#F2E4E9;
                                                color:#966F7D;
                                                display:flex;
                                                align-items:center;
                                                justify-content:center;
                                                flex-shrink:0;
                                                ">

                                                <i class="bi bi-person"></i>

                                            </div>


                                            <div>

                                                <div class="fw-semibold"
                                                     style="color:#5F5146;">

                                                    @item.Student?.FullName

                                                </div>


                                                <div class="page-subtitle">

                                                    @item.Student?.StudentIdNumber

                                                </div>

                                            </div>

                                        </div>

                                    </div>



                                    <!-- ================= Psychologist ================= -->

                                    <div class="col-lg-2">

                                        <div class="page-subtitle mb-1">

                                            Psychologist

                                        </div>


                                        <div class="fw-semibold"
                                             style="color:#6F6258;">

                                            @item.Psychologist?.FullName

                                        </div>

                                    </div>



                                    <!-- ================= Date ================= -->

                                    <div class="col-lg-2">

                                        <div class="page-subtitle mb-2">

                                            Date

                                        </div>


                                        <span class="date-badge">

                                            <i class="bi bi-calendar3 me-1"></i>

                                            @item.CounselingDate.ToString(
                                                "dd MMM yyyy"
                                            )

                                        </span>

                                    </div>



                                    <!-- ================= Time ================= -->

                                    <div class="col-lg-2">

                                        <div class="page-subtitle mb-2">

                                            Time

                                        </div>


                                        <span class="time-badge">

                                            <i class="bi bi-clock me-1"></i>

                                            @startHour:@startMinute

                                            <span style="opacity:.5;">

                                                –

                                            </span>

                                            @endHour:@endMinute

                                        </span>

                                    </div>



                                    <!-- ================= Status ================= -->

                                    <div class="col-lg-1">

                                        <div class="page-subtitle mb-2">

                                            Status

                                        </div>


                                        @{
                                            bool isItemPast = item.CounselingDate.Date < DateTime.Today ||
                                                (item.CounselingDate.Date == DateTime.Today &&
                                                 (item.AppointmentEndTime != default ? item.AppointmentEndTime < DateTime.Now.TimeOfDay : item.AppointmentTime < DateTime.Now.TimeOfDay));
                                        }
                                        @if (item.Status == "Completed")
                                        {
                                            <span class="status-completed">
                                                <i class="bi bi-check2-all me-1"></i>
                                                Completed
                                            </span>
                                        }
                                        else if (item.Status == "Cancelled")
                                        {
                                            <span class="status-cancelled" title="@item.Observation">
                                                <i class="bi bi-x-circle me-1"></i>
                                                Cancelled
                                            </span>
                                        }
                                        else if (item.Status == "Missed" || isItemPast)
                                        {
                                            <span class="status-missed">
                                                <i class="bi bi-clock-history me-1"></i>
                                                Missed
                                            </span>
                                        }
                                        else if (item.Status == "Confirmed")
                                        {
                                            <span class="status-confirmed">
                                                <i class="bi bi-check-circle me-1"></i>
                                                Confirmed
                                            </span>
                                        }
                                        else if (item.Status == "Pending")
                                        {
                                            <span class="status-pending">
                                                <i class="bi bi-clock me-1"></i>
                                                Pending
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-pending">
                                                @item.Status
                                            </span>
                                        }

                                    </div>

                                    <!-- ================= Action (Cancel / Reschedule) ================= -->
                                    <div class="col-lg-2 text-lg-end">
                                        <div class="page-subtitle mb-2 d-none d-lg-block">
                                            Action
                                        </div>
                                        @{
                                            var nowTime = DateTime.Now;
                                            bool isCancellable = (item.Status == "Confirmed" || item.Status == "Pending") &&
                                                (item.CounselingDate.Date > DateTime.Today ||
                                                (item.CounselingDate.Date == DateTime.Today && item.AppointmentTime > nowTime.TimeOfDay));
                                        }
                                        @if (isCancellable)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3 py-1.5 fw-semibold shadow-sm" data-bs-toggle="modal" data-bs-target="#deptCancelModal_@item.CounselingId">
                                                <i class="bi bi-x-circle me-1"></i>Cancel
                                            </button>
                                        }
                                        else if (item.Status == "Completed")
                                        {
                                            <span class="text-success small fw-semibold">
                                                <i class="bi bi-check-all me-1"></i>Completed
                                            </span>
                                        }
                                        else if (item.Status == "Cancelled")
                                        {
                                            @if (item.Student?.IsSuspended == true)
                                            {
                                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2.5 py-1" style="font-size:11px;">
                                                    <i class="bi bi-person-x me-1"></i> Student Suspended
                                                </span>
                                            }
                                            else
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1.5 fw-semibold shadow-sm" data-bs-toggle="modal" data-bs-target="#deptScheduleNextModal_@item.CounselingId" title="Schedule Next Appointment">
                                                    <i class="bi bi-calendar-plus me-1"></i>Reschedule
                                                </button>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted small">-</span>
                                        }
                                    </div>

                                </div>

                            </div>

                            @if ((item.Status == "Confirmed" || item.Status == "Pending") &&
                                 (item.CounselingDate.Date > DateTime.Today ||
                                 (item.CounselingDate.Date == DateTime.Today && item.AppointmentTime > DateTime.Now.TimeOfDay)))
                            {
                                <!-- Cancellation Modal for Department -->
                                <div class="modal fade" id="deptCancelModal_@item.CounselingId" tabindex="-1" aria-labelledby="deptCancelModalLabel_@item.CounselingId" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content rounded-4 border-0 shadow">
                                            <div class="modal-header border-0 bg-danger text-white rounded-top-4 p-4">
                                                <h5 class="modal-title fw-bold" id="deptCancelModalLabel_@item.CounselingId">
                                                    <i class="bi bi-exclamation-triangle-fill me-2"></i>Cancel Student Appointment
                                                </h5>
                                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <form asp-controller="Department" asp-action="CancelAppointment" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.CounselingId" />
                                                <input type="hidden" name="returnUrl" value="/Department/Counseling" />
                                                <div class="modal-body p-4 text-start">
                                                    <div class="alert alert-warning border-0 rounded-3 mb-3">
                                                        <i class="bi bi-info-circle me-1"></i>
                                                        You are about to cancel the scheduled counseling appointment for <strong>@item.Student?.FullName</strong> (ID: @item.Student?.StudentIdNumber).
                                                    </div>
                                                    <div class="p-3 bg-light rounded-3 mb-3 border">
                                                        <div class="d-flex justify-content-between mb-1">
                                                            <span class="text-muted small">Psychologist:</span>
                                                            <strong class="text-dark small">@(item.Psychologist?.FullName ?? "University Psychologist")</strong>
                                                        </div>
                                                        <div class="d-flex justify-content-between mb-1">
                                                            <span class="text-muted small">Date:</span>
                                                            <strong class="text-dark small">@item.CounselingDate.ToString("dd MMM yyyy")</strong>
                                                        </div>
                                                        <div class="d-flex justify-content-between">
                                                            <span class="text-muted small">Time Slot:</span>
                                                            <strong class="text-dark small">@startHour:@startMinute – @endHour:@endMinute</strong>
                                                        </div>
                                                    </div>
                                                    <div class="mb-3">
                                                        <label for="deptCancelReason_@item.CounselingId" class="form-label fw-semibold text-dark small">
                                                            Reason for Cancellation (Optional)
                                                        </label>
                                                        <textarea name="reason" id="deptCancelReason_@item.CounselingId" rows="2" class="form-control rounded-3" placeholder="Explain why the department is cancelling this appointment..."></textarea>
                                                    </div>

                                                    <div class="border-top pt-3 mt-3">
                                                        <h6 class="fw-bold text-dark small mb-2">
                                                            <i class="bi bi-calendar-plus me-1 text-primary"></i> Reschedule Next Appointment Date (Optional)
                                                        </h6>
                                                        <div class="row g-2 mb-2">
                                                            <div class="col-md-6">
                                                                <label class="form-label text-dark small fw-semibold mb-1">Next Date (Sat-Wed)</label>
                                                                <input type="date" name="nextDate" class="form-control rounded-3" min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" onchange="validateSaturdayToWednesday(this)" />
                                                            </div>
                                                            <div class="col-md-6">
                                                                <label class="form-label text-dark small fw-semibold mb-1">Time Slot</label>
                                                                <select name="nextTime" class="form-select rounded-3">
                                                                    <option value="">-- Optional Slot --</option>
                                                                    <option value="08:30:00">08:30 AM - 09:30 AM</option>
                                                                    <option value="09:35:00">09:35 AM - 10:35 AM</option>
                                                                    <option value="10:40:00">10:40 AM - 11:40 AM</option>
                                                                    <option value="11:45:00">11:45 AM - 12:45 PM</option>
                                                                    <option value="13:10:00">01:10 PM - 02:10 PM</option>
                                                                    <option value="14:15:00">02:15 PM - 03:15 PM</option>
                                                                    <option value="15:20:00">03:20 PM - 04:20 PM</option>
                                                                    <option value="16:25:00">04:25 PM - 05:25 PM</option>
                                                                </select>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <p class="small text-muted mb-0 mt-3">
                                                        Cancelling this appointment will free the time slot and immediately notify the student, psychologist, and guardian via email.
                                                    </p>
                                                </div>
                                                <div class="modal-footer border-0 p-4 pt-0">
                                                    <button type="button" class="btn btn-light rounded-3 px-4 fw-semibold" data-bs-dismiss="modal">Keep Appointment</button>
                                                    <button type="submit" class="btn btn-danger rounded-3 px-4 fw-bold">
                                                        <i class="bi bi-x-circle me-1"></i> Confirm Cancellation
                                                    </button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            }

                            @if (item.Status == "Cancelled")
                            {
                                <!-- Reschedule Modal for Department -->
                                <div class="modal fade" id="deptScheduleNextModal_@item.CounselingId" tabindex="-1" aria-labelledby="deptScheduleNextModalLabel_@item.CounselingId" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content rounded-4 border-0 shadow">
                                            <div class="modal-header border-0 rounded-top-4 p-4" style="background:#8D7597; color:white;">
                                                <h5 class="modal-title fw-bold" id="deptScheduleNextModalLabel_@item.CounselingId">
                                                    <i class="bi bi-calendar-plus me-2"></i>Schedule Next Appointment
                                                </h5>
                                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <form asp-controller="Department" asp-action="ScheduleNextAppointment" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="studentId" value="@item.StudentId" />
                                                <input type="hidden" name="previousCounselingId" value="@item.CounselingId" />
                                                <input type="hidden" name="returnUrl" value="/Department/Counseling" />
                                                <div class="modal-body p-4 text-start">
                                                    <div class="alert alert-info border-0 rounded-3 mb-3" style="background:#F7F3F8; color:#76627F;">
                                                        <div class="fw-bold mb-1">Student: @(item.Student?.FullName ?? "Student") (@(item.Student?.StudentIdNumber ?? "-"))</div>
                                                        <small class="text-muted">Previous session was cancelled on @item.CounselingDate.ToString("dd MMM yyyy").</small>
                                                    </div>
                                                    
                                                    <div class="mb-3">
                                                        <label class="form-label fw-semibold text-dark small">Next Appointment Date <span class="text-danger">*</span></label>
                                                        <input type="date" 
                                                               name="appointmentDate" 
                                                               class="form-control rounded-3" 
                                                               min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" 
                                                               required 
                                                               onchange="validateSaturdayToWednesday(this)" />
                                                        <div class="form-text text-muted small">
                                                            Available strictly <strong>Saturday to Wednesday</strong>.
                                                        </div>
                                                    </div>

                                                    <div class="mb-3">
                                                        <label class="form-label fw-semibold text-dark small">Appointment Time Slot <span class="text-danger">*</span></label>
                                                        <select name="appointmentTime" class="form-select rounded-3" required>
                                                            <option value="">-- Select Time Slot --</option>
                                                            <option value="08:30:00">8:30 AM - 9:30 AM</option>
                                                            <option value="09:35:00">9:35 AM - 10:35 AM</option>
                                                            <option value="10:40:00">10:40 AM - 11:40 AM</option>
                                                            <option value="11:45:00">11:45 AM - 12:45 PM</option>
                                                            <option value="13:10:00">1:10 PM - 2:10 PM</option>
                                                            <option value="14:15:00">2:15 PM - 3:15 PM</option>
                                                            <option value="15:20:00">3:20 PM - 4:20 PM</option>
                                                            <option value="16:25:00">4:25 PM - 5:25 PM</option>
                                                        </select>
                                                    </div>

                                                    <div class="mb-3">
                                                        <label class="form-label fw-semibold text-dark small">Room / Location (Optional)</label>
                                                        <input type="text" name="appointmentRoom" class="form-control rounded-3" placeholder="e.g. Counseling Room 402" value="@item.AppointmentRoom" />
                                                    </div>
                                                </div>
                                                <div class="modal-footer border-0 p-4 pt-0">
                                                    <button type="button" class="btn btn-light rounded-3 px-4 fw-semibold" data-bs-dismiss="modal">Close</button>
                                                    <button type="submit" class="btn rounded-3 px-4 fw-bold" style="background:#8D7597; color:white;">
                                                        <i class="bi bi-calendar-check me-1"></i> Confirm Next Appointment
                                                    </button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            }

                        </div>
                    }

                </div>
            }
            else
            {
                <div class="empty-box">

                    <div class="empty-icon mb-3">

                        <i class="bi bi-calendar-x fs-2"></i>

                    </div>


                    <h5 class="page-title">

                        No Counseling Appointments

                    </h5>


                    <p class="page-subtitle mb-0">

                        No counseling appointment has been
                        created for your department yet.

                    </p>

                </div>
            }

        </div>

    </div>

</div>

@section Scripts {
    <script>
        function filterDepartmentStudents() {
            var input = document.getElementById("studentSearchInput");
            var filter = input.value.toLowerCase().trim();
            var select = document.getElementById("studentSelect");
            var options = select.options;
            var visibleCount = 0;

            for (var i = 0; i < options.length; i++) {
                var opt = options[i];
                if (!opt.value) continue;

                var searchData = (opt.getAttribute("data-search") || opt.text).toLowerCase();
                if (filter === "" || searchData.indexOf(filter) > -1) {
                    opt.hidden = false;
                    opt.style.display = "";
                    visibleCount++;
                } else {
                    opt.hidden = true;
                    opt.style.display = "none";
                }
            }

            var noMatchMsg = document.getElementById("noStudentMatchMessage");
            if (visibleCount === 0 && filter !== "") {
                noMatchMsg.classList.remove("d-none");
            } else {
                noMatchMsg.classList.add("d-none");
            }
        }

        function updateSelectedStudentPreview() {
            var select = document.getElementById("studentSelect");
            var selectedOpt = select.options[select.selectedIndex];
            var infoBox = document.getElementById("selectedStudentInfoBox");

            if (selectedOpt && selectedOpt.value) {
                var name = selectedOpt.getAttribute("data-name");
                var idNum = selectedOpt.getAttribute("data-id");
                var email = selectedOpt.getAttribute("data-email");

                document.getElementById("previewStudentName").innerText = name;
                document.getElementById("previewStudentId").innerText = "ID: " + idNum;
                document.getElementById("previewStudentEmail").innerText = "• " + (email || "No email");
                infoBox.classList.remove("d-none");
            } else {
                infoBox.classList.add("d-none");
            }
        }

        function selectSuggestedSlot(timeSlot) {
            var slotSelect = document.querySelector("select[name='startTime']");
            if (slotSelect) {
                slotSelect.value = timeSlot;
                slotSelect.scrollIntoView({ behavior: "smooth", block: "center" });
            }
        }

        function selectMissedStudentForBooking(studentId) {
            var select = document.getElementById("studentSelect");
            var searchInput = document.getElementById("studentSearchInput");
            if (searchInput) {
                searchInput.value = "";
                filterDepartmentStudents();
            }
            if (select) {
                select.value = studentId;
                updateSelectedStudentPreview();
                select.scrollIntoView({ behavior: "smooth", block: "center" });
            }
        }

        function validateSaturdayToWednesday(input) {
            if (!input.value) return;
            var selectedDate = new Date(input.value + 'T00:00:00');
            var day = selectedDate.getDay(); // 0: Sunday, 1: Monday, 2: Tuesday, 3: Wednesday, 4: Thursday, 5: Friday, 6: Saturday
            if (day === 4 || day === 5) { // 4: Thursday, 5: Friday
                alert('Appointments can only be scheduled from Saturday to Wednesday (Thursday & Friday are weekend). Please select a valid working day.');
                input.value = '';
            }
        }

        document.addEventListener("DOMContentLoaded", function () {
            updateSelectedStudentPreview();
        });
    </script>
}