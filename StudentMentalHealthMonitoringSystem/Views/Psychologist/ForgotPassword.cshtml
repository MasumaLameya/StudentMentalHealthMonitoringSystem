@{
    ViewData["Title"] = "Forgot Password - Psychologist";
}

<style>
    .forgot-container {
        min-height: calc(100vh - 180px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 3rem 1rem;
    }

    .forgot-card {
        background: #ffffff;
        border: 1px solid #E2E8F0;
        border-radius: 1.5rem;
        box-shadow: 0 12px 35px rgba(15, 23, 42, 0.08);
        overflow: hidden;
        width: 100%;
        max-width: 460px;
    }

    .forgot-header {
        background: linear-gradient(135deg, #0F172A 0%, #1E3A8A 100%);
        padding: 2.25rem 2rem;
        text-align: center;
        color: #ffffff;
    }
</style>

<div class="forgot-container">
    <div class="forgot-card">
        <div class="forgot-header">
            <div class="badge bg-white text-danger p-3 rounded-circle shadow-sm mb-3">
                <i class="bi bi-shield-lock-fill fs-2 text-danger"></i>
            </div>
            <h3 class="fw-bold mb-1 text-white">Forgot Password?</h3>
            <p class="text-white-50 fs-6 mb-0">Psychologist clinical account recovery</p>
        </div>

        <div class="p-4 p-lg-5">
            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger border-0 rounded-3 mb-4 fs-6">
                    <i class="bi bi-exclamation-triangle-fill me-1.5"></i> @ViewBag.Error
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger border-0 rounded-3 mb-4 fs-6">
                    <i class="bi bi-exclamation-triangle-fill me-1.5"></i> @TempData["ErrorMessage"]
                </div>
            }

            <form asp-controller="Psychologist" asp-action="ForgotPassword" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-4">
                    <label class="form-label fw-bold text-dark fs-6 mb-1.5">Registered Email Address</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 fs-5"><i class="bi bi-envelope text-danger"></i></span>
                        <input type="email" name="email" class="form-control form-control-lg fs-6 border-start-0 ps-1" placeholder="psychologist@example.com" required autofocus />
                    </div>
                    <small class="text-muted">A 6-digit verification code will be sent to this email.</small>
                </div>

                <button type="submit" class="btn btn-danger btn-lg w-100 rounded-3 py-2.5 fw-bold mb-3 shadow-sm fs-6">
                    <i class="bi bi-send-fill me-1.5"></i> Send Verification Code
                </button>
            </form>

            <div class="text-center">
                <a asp-controller="Psychologist" asp-action="Login" class="text-decoration-none fw-semibold text-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Back to Psychologist Login
                </a>
            </div>
        </div>
    </div>
</div>
