@model IEnumerable<StudentMentalHealthMonitoringSystem.Models.Counseling>

@{
    Layout = "_Layout";
    ViewData["Title"] = "Counseling Appointments";
}

<div class="container-fluid py-3">

    <!-- ================= Header ================= -->

    <div class="card border-0 shadow-sm rounded-4 mb-4"
         style="background:#F4EEE8;">

        <div class="card-body p-4">

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

                <div>

                    <h2 class="fw-bold mb-1"
                        style="color:#5F5146;">

                        <i class="bi bi-calendar-check me-2"></i>

                        Counseling Appointments

                    </h2>

                    <p class="text-muted mb-0">

                        View students assigned to you for counseling.

                    </p>

                </div>


                @if (ViewBag.PsychologistName != null)
                {
                    <div class="text-end">

                        <small class="text-muted d-block">
                            Psychologist
                        </small>

                        <strong style="color:#5F5146;">

                            @ViewBag.PsychologistName

                        </strong>


                        <!-- ================= Reports ================= -->

                        <div class="mt-2 d-flex gap-2 justify-content-end flex-wrap">

                            <a asp-controller="Psychologist"
                               asp-action="ScreeningReports"
                               class="btn btn-sm rounded-3 px-3"
                               style="
                                background:#806C5D;
                                color:white;">

                                <i class="bi bi-file-earmark-medical me-1"></i>

                                Screening Reports

                            </a>



                            <a asp-controller="Psychologist"
                               asp-action="StudentProgressReports"
                               class="btn btn-sm rounded-3 px-3 btn-dark">

                                <i class="bi bi-graph-up-arrow me-1"></i>

                                Patient Progress & Line Graphs

                            </a>

                        </div>

                    </div>
                }

            </div>

        </div>

    </div>


    <!-- ================= Messages ================= -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success rounded-4">

            <i class="bi bi-check-circle-fill me-2"></i>

            @TempData["Success"]

        </div>
    }


    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger rounded-4">

            <i class="bi bi-exclamation-triangle-fill me-2"></i>

            @TempData["Error"]

        </div>
    }


    <!-- ================= Summary Cards ================= -->

    <div class="row g-4 mb-4">

        <!-- Total -->
        <div class="col-6 col-md">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-3 text-center">
                    <p class="text-muted small mb-1">Total</p>
                    <h3 class="fw-bold mb-0" style="color:#5F5146;">@Model.Count()</h3>
                </div>
            </div>
        </div>

        <!-- Confirmed -->
        <div class="col-6 col-md">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-3 text-center">
                    <p class="text-muted small mb-1">Confirmed</p>
                    <h3 class="fw-bold mb-0 text-warning">@Model.Count(c => c.Status == "Confirmed")</h3>
                </div>
            </div>
        </div>

        <!-- Completed -->
        <div class="col-6 col-md">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-3 text-center">
                    <p class="text-muted small mb-1">Completed</p>
                    <h3 class="fw-bold mb-0 text-success">@Model.Count(c => c.Status == "Completed")</h3>
                </div>
            </div>
        </div>

        <!-- Missed -->
        <div class="col-6 col-md">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-3 text-center">
                    <p class="text-muted small mb-1">Missed</p>
                    <h3 class="fw-bold mb-0 text-secondary">@Model.Count(c => c.Status == "Missed")</h3>
                </div>
            </div>
        </div>

        <!-- Cancelled -->
        <div class="col-6 col-md">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-3 text-center">
                    <p class="text-muted small mb-1">Cancelled</p>
                    <h3 class="fw-bold mb-0 text-danger">@Model.Count(c => c.Status == "Cancelled")</h3>
                </div>
            </div>
        </div>

    </div>


    <!-- ================= Assigned Students ================= -->

    <div class="card border-0 shadow-sm rounded-4">

        <div class="card-header border-0 py-3"
             style="background:#E8DDD2;">

            <h5 class="mb-0"
                style="color:#5F5146;">

                <i class="bi bi-list-check me-2"></i>

                Assigned Students

            </h5>

        </div>


        <div class="card-body p-0">

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead style="background:#F7F2ED;">

                            <tr>

                                <th class="px-4 py-3">
                                    Student
                                </th>

                                <th class="py-3">
                                    Student ID
                                </th>

                                <th class="py-3">
                                    Department
                                </th>

                                <th class="py-3">
                                    Date
                                </th>

                                <th class="py-3">
                                    Time
                                </th>

                                <th class="py-3">
                                    Status
                                </th>

                                <th class="py-3">
                                    Follow-up
                                </th>

                                <th class="py-3 text-center">
                                    Action
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @{
                                var rescheduledList = ViewBag.RescheduledParentIds as List<int> ?? new List<int>();
                                var activeStudents = ViewBag.ActiveStudentIds as List<int> ?? new List<int>();
                                var activeApptMap = ViewBag.ActiveAppointmentByStudent as Dictionary<int, StudentMentalHealthMonitoringSystem.Models.Counseling> ?? new Dictionary<int, StudentMentalHealthMonitoringSystem.Models.Counseling>();
                            }

                            @foreach (var item in Model.OrderBy(c => c.CounselingDate.Date).ThenBy(c => c.AppointmentTime))
                            {
                                // ==========================================
                                // Prepare Display Values
                                // ==========================================

                                var dateText =
                                    item.CounselingDate.ToString(
                                        "dd MMM yyyy"
                                    );

                                var dayText =
                                    item.CounselingDate.ToString(
                                        "dddd"
                                    );

                                var startTimeText =
                                    DateTime.Today
                                        .Add(item.AppointmentTime)
                                        .ToString("h:mm tt");

                                var endTimeText =
                                    DateTime.Today
                                        .Add(item.AppointmentEndTime)
                                        .ToString("h:mm tt");


                                <tr>

                                    <!-- ================= Student ================= -->

                                    <td class="px-4 py-3"
                                        style="min-width:220px;">

                                        <div class="d-flex align-items-center">

                                            @if (item.Student != null &&
                                                 !string.IsNullOrWhiteSpace(
                                                     item.Student.ProfileImage))
                                            {
                                                <img src="@item.Student.ProfileImage"
                                                     alt="Student"
                                                     class="rounded-circle me-3"
                                                     style="
                                                width:45px;
                                                height:45px;
                                                min-width:45px;
                                                object-fit:cover;" />
                                            }
                                            else
                                            {
                                                <div class="rounded-circle d-flex align-items-center justify-content-center me-3"
                                                     style="
                                                    width:45px;
                                                    height:45px;
                                                    min-width:45px;
                                                    background:#EEE4DA;">

                                                    <i class="bi bi-person"
                                                       style="color:#806C5D;">
                                                    </i>

                                                </div>
                                            }


                                            <div>

                                                <div class="fw-semibold"
                                                     style="color:#5F5146;">

                                                    @(item.Student?.FullName ?? "Student")

                                                </div>


                                                <small class="text-muted">

                                                    @(item.Student?.Email ?? "-")

                                                </small>

                                            </div>

                                        </div>

                                    </td>


                                    <!-- ================= Student ID ================= -->

                                    <td class="py-3">

                                        @(item.Student?.StudentIdNumber ?? "-")

                                    </td>


                                    <!-- ================= Department ================= -->

                                    <td class="py-3">

                                        @(item.Student?.Department ?? "-")

                                    </td>


                                    <!-- ================= Date ================= -->

                                    <td class="py-3"
                                        style="min-width:140px;">

                                        <div class="fw-semibold"
                                             style="color:#5F5146;">

                                            @dateText

                                        </div>

                                        <small class="text-muted">

                                            @dayText

                                        </small>

                                    </td>


                                    <!-- ================= Time ================= -->

                                    <td class="py-3"
                                        style="min-width:180px;">

                                        <span class="badge rounded-pill px-3 py-2"
                                              style="
                                            background:#EEE4DA;
                                            color:#705F50;
                                            font-size:13px;">

                                            <i class="bi bi-clock me-1"></i>

                                            @startTimeText - @endTimeText

                                        </span>

                                    </td>


                                    <!-- ================= Status ================= -->

                                    <td class="py-3"
                                        style="min-width:120px;">

                                        @if (item.Status == "Completed")
                                        {
                                            <span class="badge bg-success rounded-pill px-3 py-2">

                                                <i class="bi bi-check-circle me-1"></i>

                                                Completed

                                            </span>
                                        }
                                        else if (item.Status == "Cancelled")
                                        {
                                            <span class="badge bg-danger rounded-pill px-3 py-2">

                                                <i class="bi bi-x-circle me-1"></i>

                                                Cancelled

                                            </span>
                                        }
                                        else if (item.Status == "Missed")
                                        {
                                            <span class="badge bg-secondary rounded-pill px-3 py-2">

                                                <i class="bi bi-calendar-x me-1"></i>

                                                Missed

                                            </span>
                                        }
                                        else if (item.Status == "Confirmed")
                                        {
                                            <span class="badge rounded-pill px-3 py-2"
                                                  style="
                                                background:#FFF3CD;
                                                color:#795F00;">

                                                <i class="bi bi-clock me-1"></i>

                                                Confirmed

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary rounded-pill px-3 py-2">

                                                @item.Status

                                            </span>
                                        }

                                    </td>


                                    <!-- ================= Follow-up ================= -->

                                    <td class="py-3"
                                        style="min-width:180px;">

                                        @if (item.NextFollowUpDate.HasValue)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1.5 fw-semibold" style="font-size:12px;">
                                                <i class="bi bi-calendar-check me-1"></i> Follow-up Scheduled
                                            </span>
                                        }
                                        else
                                        {
                                            @if (item.Status == "Completed")
                                            {
                                                @if (item.Student?.IsSuspended == true)
                                                {
                                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2.5 py-1" style="font-size:11px;">
                                                        <i class="bi bi-person-x me-1"></i> Student Suspended
                                                    </span>
                                                }
                                                else
                                                {
                                                    <div class="d-flex align-items-center gap-1 flex-wrap">
                                                        <span class="badge bg-light text-muted border rounded-pill px-2.5 py-1" style="font-size:11px;">
                                                            <i class="bi bi-dash-circle me-1"></i> No Follow-up
                                                        </span>
                                                        <button type="button"
                                                                class="btn btn-sm btn-outline-secondary rounded-3 px-2 py-0.5"
                                                                style="font-size: 11px;"
                                                                data-bs-toggle="modal"
                                                                data-bs-target="#scheduleFollowUpModal_@item.CounselingId"
                                                                title="Schedule Follow-up">
                                                            <i class="bi bi-plus-lg"></i>
                                                        </button>
                                                    </div>
                                                }
                                            }
                                            else
                                            {
                                                <span class="text-muted small">-</span>
                                            }
                                        }

                                    </td>


                                    <!-- ================= Action ================= -->

                                    <td class="py-3 text-center"
                                        style="min-width:180px;">

                                        @{
                                            bool canCancel = (item.Status == "Confirmed" || item.Status == "Pending") &&
                                                (item.CounselingDate.Date > DateTime.Today ||
                                                (item.CounselingDate.Date == DateTime.Today && item.AppointmentTime > DateTime.Now.TimeOfDay));
                                            bool isAlreadyRescheduled = rescheduledList.Contains(item.CounselingId);
                                            bool hasActiveAppointment = activeStudents.Contains(item.StudentId);
                                        }

                                        <div class="d-flex justify-content-center gap-1">
                                            <a asp-controller="Psychologist"
                                               asp-action="CounselingDetails"
                                               asp-route-id="@item.CounselingId"
                                               class="btn btn-sm rounded-3 px-3"
                                               style="
                                                background:#A67C52;
                                                color:white;">

                                                <i class="bi bi-eye me-1"></i>

                                                View

                                            </a>

                                            @if (canCancel)
                                            {
                                                <button type="button"
                                                        class="btn btn-sm btn-outline-danger rounded-3 px-2"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#psychCancelModal_@item.CounselingId"
                                                        title="Cancel Appointment">
                                                    <i class="bi bi-x-circle me-1"></i> Cancel
                                                </button>
                                            }
                                            else if (item.Status == "Cancelled" || item.Status == "Missed")
                                            {
                                                @if (item.Student?.IsSuspended == true)
                                                {
                                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2.5 py-1" style="font-size:11px;">
                                                        <i class="bi bi-person-x me-1"></i> Suspended
                                                    </span>
                                                }
                                                else if (isAlreadyRescheduled)
                                                {
                                                    <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill px-2.5 py-1" style="font-size:11px;" title="This session has already been rescheduled.">
                                                        <i class="bi bi-arrow-repeat me-1"></i> Rescheduled
                                                    </span>
                                                }
                                                else if (hasActiveAppointment)
                                                {
                                                    var nextAppt = activeApptMap.ContainsKey(item.StudentId) ? activeApptMap[item.StudentId] : null;
                                                    var nextInfo = nextAppt != null ? $"Scheduled for {nextAppt.CounselingDate:MMM dd, yyyy} at {DateTime.Today.Add(nextAppt.AppointmentTime):h:mm tt}" : "Active appointment already scheduled";
                                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2.5 py-1" style="font-size:11px;" title="@nextInfo">
                                                        <i class="bi bi-calendar-check me-1"></i> Appt Exists
                                                    </span>
                                                }
                                                else
                                                {
                                                    <button type="button"
                                                            class="btn btn-sm btn-outline-primary rounded-3 px-2"
                                                            data-bs-toggle="modal"
                                                            data-bs-target="#scheduleNextModal_@item.CounselingId"
                                                            title="Schedule Next Appointment">
                                                        <i class="bi bi-calendar-plus me-1"></i> Reschedule
                                                    </button>
                                                }
                                            }
                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

                <!-- Cancellation Modals for Psychologist Appointment -->
                @foreach (var item in Model)
                {
                    bool canCancelItem = (item.Status == "Confirmed" || item.Status == "Pending") &&
                        (item.CounselingDate.Date > DateTime.Today ||
                        (item.CounselingDate.Date == DateTime.Today && item.AppointmentTime > DateTime.Now.TimeOfDay));

                    if (canCancelItem)
                    {
                        <div class="modal fade" id="psychCancelModal_@item.CounselingId" tabindex="-1" aria-labelledby="psychCancelModalLabel_@item.CounselingId" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content rounded-4 border-0 shadow">
                                    <div class="modal-header border-0 bg-danger text-white rounded-top-4 p-4">
                                        <h5 class="modal-title fw-bold" id="psychCancelModalLabel_@item.CounselingId">
                                            <i class="bi bi-exclamation-triangle-fill me-2"></i>Cancel Appointment
                                        </h5>
                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <form asp-controller="Psychologist" asp-action="CancelAppointment" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.CounselingId" />
                                        <input type="hidden" name="returnUrl" value="/Psychologist/Appointment" />
                                        <div class="modal-body p-4">
                                            <div class="alert alert-warning border-0 rounded-3 mb-3">
                                                <i class="bi bi-info-circle me-1"></i>
                                                Cancel appointment with <strong>@(item.Student?.FullName ?? "Student")</strong> scheduled for <strong>@item.CounselingDate.ToString("MMM dd, yyyy")</strong> at <strong>@DateTime.Today.Add(item.AppointmentTime).ToString("h:mm tt")</strong>.
                                            </div>
                                            <div class="mb-3">
                                                <label for="psychCancelReason_@item.CounselingId" class="form-label fw-semibold text-dark small">
                                                    Reason for Cancellation (Optional)
                                                </label>
                                                <textarea name="reason" id="psychCancelReason_@item.CounselingId" rows="2" class="form-control rounded-3" placeholder="Provide note or reason for cancellation..."></textarea>
                                            </div>

                                            <div class="border-top pt-3 mt-3">
                                                <h6 class="fw-bold text-dark small mb-2">
                                                    <i class="bi bi-calendar-plus me-1 text-primary"></i> Reschedule Next Appointment Date (Optional)
                                                </h6>
                                                <div class="row g-2 mb-2">
                                                    <div class="col-md-6">
                                                        <label class="form-label text-dark small fw-semibold mb-1">Next Date (Sat-Wed)</label>
                                                        <input type="date" name="nextDate" class="form-control rounded-3" min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" onchange="validateSaturdayToWednesday(this)" />
                                                    </div>
                                                    <div class="col-md-6">
                                                        <label class="form-label text-dark small fw-semibold mb-1">Preferred Time Slot</label>
                                                        <select name="nextTime" class="form-select rounded-3">
                                                            <option value="">-- Optional Slot --</option>
                                                            <option value="08:30:00">08:30 AM - 09:30 AM</option>
                                                            <option value="09:35:00">09:35 AM - 10:35 AM</option>
                                                            <option value="10:40:00">10:40 AM - 11:40 AM</option>
                                                            <option value="11:45:00">11:45 AM - 12:45 PM</option>
                                                            <option value="13:10:00">01:10 PM - 02:10 PM</option>
                                                            <option value="14:15:00">02:15 PM - 03:15 PM</option>
                                                            <option value="15:20:00">03:20 PM - 04:20 PM</option>
                                                        </select>
                                                    </div>
                                                </div>
                                            </div>

                                            <p class="small text-muted mb-0 mt-3">
                                                Appointments can only be cancelled before the appointment date. An email notification will be sent to the student.
                                            </p>
                                        </div>
                                        <div class="modal-footer border-0 p-4 pt-0">
                                            <button type="button" class="btn btn-light rounded-3 px-4 fw-semibold" data-bs-dismiss="modal">Keep Appointment</button>
                                            <button type="submit" class="btn btn-danger rounded-3 px-4 fw-bold">
                                                <i class="bi bi-x-circle me-1"></i> Confirm Cancellation
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                }

                <!-- Follow-up Scheduling and Cancellation Modals -->
                @foreach (var item in Model)
                {
                    <!-- Schedule Follow-Up Modal -->
                    <div class="modal fade" id="scheduleFollowUpModal_@item.CounselingId" tabindex="-1" aria-labelledby="scheduleFollowUpModalLabel_@item.CounselingId" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content rounded-4 border-0 shadow">
                                <div class="modal-header border-0 rounded-top-4 p-4" style="background:#5F5146; color:white;">
                                    <h5 class="modal-title fw-bold" id="scheduleFollowUpModalLabel_@item.CounselingId">
                                        <i class="bi bi-calendar-plus me-2"></i>Schedule Next Follow-Up
                                    </h5>
                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <form asp-controller="Psychologist" asp-action="ScheduleFollowUp" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="counselingId" value="@item.CounselingId" />
                                    <div class="modal-body p-4">
                                        <div class="alert alert-info border-0 rounded-3 mb-3" style="background:#F4EEE8; color:#5F5146;">
                                            <div class="fw-bold mb-1">Student: @(item.Student?.FullName ?? "Student") (@(item.Student?.StudentIdNumber ?? "-"))</div>
                                            <small class="text-muted">Parent Session Date: @item.CounselingDate.ToString("dd MMM yyyy") | Status: @item.Status</small>
                                        </div>
                                        
                                        <div class="mb-3">
                                            <label class="form-label fw-semibold text-dark small">Follow-Up Date <span class="text-danger">*</span></label>
                                            <input type="date" 
                                                   name="followUpDate" 
                                                   id="followUpDate_@item.CounselingId"
                                                   class="form-control rounded-3" 
                                                   min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" 
                                                   required 
                                                   onchange="validateSaturdayToWednesday(this)" />
                                            <div class="form-text text-muted small">
                                                Available strictly <strong>Saturday to Wednesday</strong> (Thursday & Friday are weekend).
                                            </div>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label fw-semibold text-dark small">Follow-Up Time Slot <span class="text-danger">*</span></label>
                                            <select name="followUpTime" class="form-select rounded-3" required>
                                                <option value="">-- Select Time Slot --</option>
                                                <option value="08:30:00">8:30 AM - 9:30 AM</option>
                                                <option value="09:35:00">9:35 AM - 10:35 AM</option>
                                                <option value="10:40:00">10:40 AM - 11:40 AM</option>
                                                <option value="11:45:00">11:45 AM - 12:45 PM</option>
                                                <option value="13:10:00">1:10 PM - 2:10 PM</option>
                                                <option value="14:15:00">2:15 PM - 3:15 PM</option>
                                                <option value="15:20:00">3:20 PM - 4:20 PM</option>
                                                <option value="16:25:00">4:25 PM - 5:25 PM</option>
                                            </select>
                                        </div>

                                        <div class="p-3 rounded-3" style="background:#FAFAFA; border:1px dashed #DDD;">
                                            <small class="text-muted d-block">
                                                <i class="bi bi-shield-check text-success me-1"></i>
                                                Once scheduled, this follow-up cannot be overwritten directly. You can cancel it later if you need to reschedule.
                                            </small>
                                        </div>
                                    </div>
                                    <div class="modal-footer border-0 p-4 pt-0">
                                        <button type="button" class="btn btn-light rounded-3 px-4 fw-semibold" data-bs-dismiss="modal">Close</button>
                                        <button type="submit" class="btn rounded-3 px-4 fw-bold" style="background:#806C5D; color:white;">
                                            <i class="bi bi-check2-circle me-1"></i> Schedule Follow-Up
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>

                    <!-- Cancel Follow-Up Modal -->
                    @if (item.NextFollowUpDate.HasValue)
                    {
                        <div class="modal fade" id="cancelFollowUpModal_@item.CounselingId" tabindex="-1" aria-labelledby="cancelFollowUpModalLabel_@item.CounselingId" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content rounded-4 border-0 shadow">
                                    <div class="modal-header border-0 bg-danger text-white rounded-top-4 p-4">
                                        <h5 class="modal-title fw-bold" id="cancelFollowUpModalLabel_@item.CounselingId">
                                            <i class="bi bi-exclamation-triangle-fill me-2"></i>Cancel Follow-Up Appointment
                                        </h5>
                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <form asp-controller="Psychologist" asp-action="CancelFollowUp" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="counselingId" value="@item.CounselingId" />
                                        <div class="modal-body p-4">
                                            <div class="alert alert-warning border-0 rounded-3 mb-3">
                                                <i class="bi bi-info-circle me-1"></i>
                                                Cancel the scheduled follow-up for <strong>@(item.Student?.FullName ?? "Student")</strong> on <strong>@item.NextFollowUpDate.Value.ToString("MMM dd, yyyy")</strong>@(item.NextFollowUpTime.HasValue ? $" at {DateTime.Today.Add(item.NextFollowUpTime.Value):h:mm tt}" : "").
                                            </div>
                                            <div class="mb-3">
                                                <label for="followUpCancelReason_@item.CounselingId" class="form-label fw-semibold text-dark small">
                                                    Reason for Cancellation (Optional)
                                                </label>
                                                <textarea name="reason" id="followUpCancelReason_@item.CounselingId" rows="3" class="form-control rounded-3" placeholder="Provide note or reason for cancelling follow-up..."></textarea>
                                            </div>
                                            <p class="small text-muted mb-0">
                                                After cancelling, the slot will be freed and you can schedule a new follow-up anytime. An email notification will be sent to the student.
                                            </p>
                                        </div>
                                        <div class="modal-footer border-0 p-4 pt-0">
                                            <button type="button" class="btn btn-light rounded-3 px-4 fw-semibold" data-bs-dismiss="modal">Keep Follow-Up</button>
                                            <button type="submit" class="btn btn-danger rounded-3 px-4 fw-bold">
                                                <i class="bi bi-x-circle me-1"></i> Confirm Follow-Up Cancellation
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- Schedule Next Appointment Modal for Cancelled and Missed Sessions -->
                    @if ((item.Status == "Cancelled" || item.Status == "Missed") &&
                         item.Student?.IsSuspended != true &&
                         !rescheduledList.Contains(item.CounselingId) &&
                         !activeStudents.Contains(item.StudentId))
                    {
                        <div class="modal fade" id="scheduleNextModal_@item.CounselingId" tabindex="-1" aria-labelledby="scheduleNextModalLabel_@item.CounselingId" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content rounded-4 border-0 shadow">
                                    <div class="modal-header border-0 rounded-top-4 p-4" style="background:#806C5D; color:white;">
                                        <h5 class="modal-title fw-bold" id="scheduleNextModalLabel_@item.CounselingId">
                                            <i class="bi bi-calendar-plus me-2"></i>Schedule Next Appointment
                                        </h5>
                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <form asp-controller="Psychologist" asp-action="ScheduleNextAppointment" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="studentId" value="@item.StudentId" />
                                        <input type="hidden" name="previousCounselingId" value="@item.CounselingId" />
                                        <input type="hidden" name="returnUrl" value="/Psychologist/Appointment" />
                                        <div class="modal-body p-4">
                                            <div class="alert alert-info border-0 rounded-3 mb-3" style="background:#F4EEE8; color:#5F5146;">
                                                <div class="fw-bold mb-1">Student: @(item.Student?.FullName ?? "Student") (@(item.Student?.StudentIdNumber ?? "-"))</div>
                                                <small class="text-muted">Previous session was @(item.Status == "Missed" ? "missed" : "cancelled") on @item.CounselingDate.ToString("dd MMM yyyy").</small>
                                            </div>
                                            
                                            <div class="mb-3">
                                                <label class="form-label fw-semibold text-dark small">Next Appointment Date <span class="text-danger">*</span></label>
                                                <input type="date" 
                                                       name="appointmentDate" 
                                                       class="form-control rounded-3" 
                                                       min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" 
                                                       required 
                                                       onchange="validateSaturdayToWednesday(this)" />
                                                <div class="form-text text-muted small">
                                                    Appointments can only be scheduled from <strong>Saturday to Wednesday</strong>.
                                                </div>
                                            </div>

                                            <div class="mb-3">
                                                <label class="form-label fw-semibold text-dark small">Appointment Time Slot <span class="text-danger">*</span></label>
                                                <select name="appointmentTime" class="form-select rounded-3" required>
                                                    <option value="">-- Select Time Slot --</option>
                                                    <option value="08:30:00">8:30 AM - 9:30 AM</option>
                                                    <option value="09:35:00">9:35 AM - 10:35 AM</option>
                                                    <option value="10:40:00">10:40 AM - 11:40 AM</option>
                                                    <option value="11:45:00">11:45 AM - 12:45 PM</option>
                                                    <option value="13:10:00">1:10 PM - 2:10 PM</option>
                                                    <option value="14:15:00">2:15 PM - 3:15 PM</option>
                                                    <option value="15:20:00">3:20 PM - 4:20 PM</option>
                                                </select>
                                            </div>

                                            <div class="mb-3">
                                                <label class="form-label fw-semibold text-dark small">Room / Location (Optional)</label>
                                                <input type="text" name="appointmentRoom" class="form-control rounded-3" placeholder="e.g. Counseling Room 302" value="@item.AppointmentRoom" />
                                            </div>
                                        </div>
                                        <div class="modal-footer border-0 p-4 pt-0">
                                            <button type="button" class="btn btn-light rounded-3 px-4 fw-semibold" data-bs-dismiss="modal">Close</button>
                                            <button type="submit" class="btn rounded-3 px-4 fw-bold" style="background:#806C5D; color:white;">
                                                <i class="bi bi-calendar-check me-1"></i> Confirm Next Appointment
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                }
            }
            else
            {
                <!-- ================= Empty State ================= -->

                <div class="text-center py-5">

                    <div class="rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3"
                         style="
                        width:70px;
                        height:70px;
                        background:#EEE4DA;">

                        <i class="bi bi-calendar-x fs-2"
                           style="color:#806C5D;">
                        </i>

                    </div>


                    <h5 class="fw-bold"
                        style="color:#5F5146;">

                        No Counseling Appointments

                    </h5>


                    <p class="text-muted mb-0">

                        Students assigned to you for counseling
                        will appear here.

                    </p>

                </div>
            }

        </div>

    </div>

</div>

@section Scripts {
    <script>
        function validateSaturdayToWednesday(input) {
            if (!input.value) return;
            var selectedDate = new Date(input.value + 'T00:00:00');
            var day = selectedDate.getDay(); // 0: Sunday, 1: Monday, 2: Tuesday, 3: Wednesday, 4: Thursday, 5: Friday, 6: Saturday
            if (day === 4 || day === 5) { // 4: Thursday, 5: Friday
                alert('Follow-up appointments can only be scheduled from Saturday to Wednesday (Thursday & Friday are weekend). Please select a valid working day.');
                input.value = '';
            }
        }
    </script>
}