@model StudentMentalHealthMonitoringSystem.Models.Student

@{
    ViewData["Title"] = "Delete Student";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-7">

            <div class="card shadow-lg border-0 rounded-4">

                <!-- Header -->

                <div class="card-header text-white text-center py-3"
                     style="background:#C27B5C;">

                    <h2>

                        <i class="bi bi-trash me-2"></i>Delete Student

                    </h2>

                </div>

                <div class="card-body p-4">

                    <div class="alert alert-warning">

                        <h5>

                            Are you sure you want to delete this student?

                        </h5>

                        <p class="mb-0">

                            This action cannot be undone.

                        </p>

                    </div>

                    <div class="text-center mb-4">

                        @if (!string.IsNullOrEmpty(Model.ProfileImage))
                        {
                            <img src="@Model.ProfileImage"
                                 class="rounded-circle shadow"
                                 width="140"
                                 height="140"
                                 style="object-fit:cover;">
                        }
                        else
                        {
                            <img src="https://ui-avatars.com/api/?name=@Model.FullName&background=C27B5C&color=fff&size=140"
                                 class="rounded-circle shadow">
                        }

                    </div>

                    <table class="table table-bordered">

                        <tr>
                            <th width="35%">Student ID</th>
                            <td>@Model.StudentIdNumber</td>
                        </tr>

                        <tr>
                            <th>Name</th>
                            <td>@Model.FullName</td>
                        </tr>

                        <tr>
                            <th>Email</th>
                            <td>@Model.Email</td>
                        </tr>

                        <tr>
                            <th>Department</th>
                            <td>@Model.Department</td>
                        </tr>

                        <tr>
                            <th>Semester</th>
                            <td>@Model.Semester</td>
                        </tr>

                    </table>

                    <form asp-action="DeleteStudent"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input asp-for="StudentId"
                               type="hidden" />

                        <div class="d-flex justify-content-between mt-4">

                            <a asp-action="Students"
                               class="btn btn-secondary">

                                Cancel

                            </a>

                            <button type="submit"
                                    class="btn btn-danger">

                                Delete Student

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>
