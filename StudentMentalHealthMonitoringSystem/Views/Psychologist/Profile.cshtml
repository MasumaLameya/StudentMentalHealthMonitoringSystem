@model StudentMentalHealthMonitoringSystem.Models.Psychologist

@{
    ViewData["Title"] = "Psychologist Profile";
}

<div class="container py-5">

    <div class="card shadow-lg border-0 rounded-4">

        <!-- ================= Header ================= -->

        <div class="card-header bg-primary text-white text-center py-4 rounded-top-4">

            <h2 class="mb-0">

                <i class="bi bi-person-badge-fill me-2"></i>

                Psychologist Profile

            </h2>

        </div>

        <div class="card-body p-5">

            <div class="row align-items-center">

                <!-- ================= Profile Image ================= -->

                <div class="col-md-4 text-center mb-4 mb-md-0">

                    @if (!string.IsNullOrEmpty(Model.ProfileImage))
                    {
                        <img src="@Model.ProfileImage"
                             class="rounded-circle border border-4 border-primary shadow"
                             width="180"
                             height="180"
                             style="object-fit:cover;">
                    }
                    else
                    {
                        <img src="https://ui-avatars.com/api/?name=@Model.FullName&background=0d6efd&color=fff&size=180"
                             class="rounded-circle border border-4 border-primary shadow"
                             width="180"
                             height="180">
                    }

                    <h4 class="mt-3 mb-1">

                        @Model.FullName

                    </h4>

                    <span class="badge bg-success fs-6">

                        @Model.Specialization

                    </span>

                </div>

                <!-- ================= Profile Information ================= -->

                <div class="col-md-8">

                    <div class="row g-3">

                        <!-- ================= Email ================= -->

                        <div class="col-md-6">

                            <div class="card border-0 shadow-sm p-3 h-100">

                                <small class="text-muted">

                                    <i class="bi bi-envelope-fill text-primary me-2"></i>

                                    Email

                                </small>

                                <h6 class="mt-2">

                                    @Model.Email

                                </h6>

                            </div>

                        </div>

                        <!-- ================= Phone ================= -->

                        <div class="col-md-6">

                            <div class="card border-0 shadow-sm p-3 h-100">

                                <small class="text-muted">

                                    <i class="bi bi-telephone-fill text-success me-2"></i>

                                    Phone

                                </small>

                                <h6 class="mt-2">

                                    @Model.Phone

                                </h6>

                            </div>

                        </div>

                        <!-- ================= Specialization ================= -->

                        <div class="col-md-6">

                            <div class="card border-0 shadow-sm p-3 h-100">

                                <small class="text-muted">

                                    <i class="bi bi-award-fill text-warning me-2"></i>

                                    Specialization

                                </small>

                                <h6 class="mt-2">

                                    @Model.Specialization

                                </h6>

                            </div>

                        </div>

                        <!-- ================= Qualification ================= -->

                        <div class="col-md-6">

                            <div class="card border-0 shadow-sm p-3 h-100">

                                <small class="text-muted">

                                    <i class="bi bi-mortarboard-fill text-danger me-2"></i>

                                    Qualification

                                </small>

                                <h6 class="mt-2">

                                    @Model.Qualification

                                </h6>

                            </div>

                        </div>

                        <!-- ================= Experience ================= -->

                        <div class="col-md-6">

                            <div class="card border-0 shadow-sm p-3 h-100">

                                <small class="text-muted">

                                    <i class="bi bi-briefcase-fill text-primary me-2"></i>

                                    Experience

                                </small>

                                <h6 class="mt-2">

                                    @Model.Experience Years

                                </h6>

                            </div>

                        </div>

                    </div>

                    <!-- ================= Buttons ================= -->

                    <div class="mt-4">

                        <a asp-controller="Psychologist"
                           asp-action="Dashboard"
                           class="btn btn-secondary">

                            Back to Dashboard

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

<style>

    .card {
        transition: 0.3s;
    }

        .card:hover {
            transform: translateY(-5px);
        }

    .rounded-circle {
        object-fit: cover;
    }

</style>