@model IEnumerable<StudentMentalHealthMonitoringSystem.Models.Counseling>

@{
    ViewData["Title"] = "Counseling Reports";
}

<div class="container mt-4" id="psychologistReportsContent">

    <div class="card shadow">

        <div class="card-header bg-dark text-white">
            <h3 class="mb-0">📋 Counseling Reports Log</h3>
        </div>

        <div class="card-body">

            @if (!Model.Any())
            {
                <div class="alert alert-info">

                    No Report Available.

                </div>
            }
            else
            {
                <table class="table table-bordered table-striped">

                    <thead>

                        <tr>

                            <th>Student</th>

                            <th>Psychologist</th>

                            <th>Date</th>

                            <th>Risk Level</th>

                            <th>Status</th>

                            <th>Recommendation</th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>

                                    @item.Student?.FullName

                                </td>

                                <td>

                                    @item.Psychologist?.FullName

                                </td>

                                <td>

                                    @item.CounselingDate.ToString("dd MMM yyyy")

                                </td>

                                <td>

                                    @item.RiskLevel

                                </td>

                                <td>
                                    @{
                                        bool isPastReport = item.CounselingDate.Date < DateTime.Today || 
                                                            (item.CounselingDate.Date == DateTime.Today && 
                                                             (item.AppointmentEndTime != default ? item.AppointmentEndTime < DateTime.Now.TimeOfDay : item.AppointmentTime < DateTime.Now.TimeOfDay));
                                    }
                                    @if (item.Status == "Completed")
                                    {
                                        <span class="badge bg-success">
                                            Completed
                                        </span>
                                    }
                                    else if (item.Status == "Cancelled")
                                    {
                                        <span class="badge bg-danger">
                                            Cancelled
                                        </span>
                                    }
                                    else if (item.Status == "Missed" || isPastReport)
                                    {
                                        <span class="badge bg-secondary">
                                            Missed
                                        </span>
                                    }
                                    else if (item.Status == "Confirmed")
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Confirmed
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">
                                            @item.Status
                                        </span>
                                    }

                                </td>

                                <td>

                                    @item.Recommendation

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>
            }

        </div>

    </div>

</div>