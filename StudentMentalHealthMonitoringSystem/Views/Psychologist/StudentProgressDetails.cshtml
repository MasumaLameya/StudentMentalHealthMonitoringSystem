@model StudentMentalHealthMonitoringSystem.ViewModels.StudentProgressReportDetailViewModel

@{
    Layout = "_Layout";
    ViewData["Title"] = $"{Model.StudentName} - Patient Progress";
}

<div class="container-fluid py-4">

    <!-- Back Button -->
    <div class="mb-3">
        <a asp-controller="Psychologist" asp-action="StudentProgressReports" class="btn btn-sm btn-outline-secondary rounded-3">
            <i class="bi bi-arrow-left me-1"></i> Back to Patient Progress Reports
        </a>
    </div>

    <!-- Student Header -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div class="d-flex align-items-center gap-3">
                    <img src="@(string.IsNullOrEmpty(Model.ProfileImage) ? "/images/default-avatar.png" : Model.ProfileImage)"
                         class="rounded-circle shadow-sm border border-2 border-primary" style="width: 70px; height: 70px; object-fit: cover;" alt="Avatar" />
                    <div>
                        <h4 class="fw-bold text-dark mb-1">@Model.StudentName</h4>
                        <div class="d-flex align-items-center flex-wrap gap-2 text-muted small">
                            <span><i class="bi bi-card-text me-1"></i> ID: <strong>@Model.StudentIdNumber</strong></span>
                            <span>•</span>
                            <span><i class="bi bi-building me-1"></i> Dept: <strong>@Model.Department</strong></span>
                            <span>•</span>
                            <span><i class="bi bi-envelope me-1"></i> Email: <strong>@Model.Email</strong></span>
                        </div>
                    </div>
                </div>

                <div>
                    @if (Model.IsFinal)
                    {
                        <span class="badge bg-success-subtle text-success border border-success fs-6 px-4 py-2 rounded-pill">
                            <i class="bi bi-check-circle-fill me-1"></i> Follow-up Completed (Finished)
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-warning-subtle text-warning border border-warning fs-6 px-4 py-2 rounded-pill">
                            <i class="bi bi-arrow-repeat me-1"></i> Continuous Follow-up (In Progress)
                        </span>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Metric Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-body p-3 text-center">
                    <div class="text-muted small fw-bold text-uppercase mb-1">Total Sessions</div>
                    <h3 class="fw-bold text-dark mb-0">@Model.TotalSessions</h3>
                    <small class="text-muted">@Model.FirstSessionDate.ToString("MMM dd, yyyy") - @Model.LatestSessionDate.ToString("MMM dd, yyyy")</small>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-body p-3 text-center">
                    <div class="text-muted small fw-bold text-uppercase mb-1">Initial Baseline Score</div>
                    <h3 class="fw-bold text-secondary mb-0">@Model.InitialScore / 100</h3>
                    <small class="text-muted">Session 1 Baseline</small>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-body p-3 text-center">
                    <div class="text-muted small fw-bold text-uppercase mb-1">Latest Score</div>
                    <h3 class="fw-bold text-primary mb-0">@Model.LatestScore / 100</h3>
                    <small class="text-muted">Score Diff: <strong>@(Model.ScoreDifference >= 0 ? "+" + Model.ScoreDifference : Model.ScoreDifference.ToString())</strong> pts</small>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-body p-3 text-center">
                    <div class="text-muted small fw-bold text-uppercase mb-1">Overall Patient Progress</div>
                    <div class="mt-2">
                        @if (Model.OverallImprovementStatus == "Improved")
                        {
                            <span class="badge bg-success fs-6 px-4 py-2 rounded-pill">
                                <i class="bi bi-arrow-up-right-circle me-1"></i> Patient Improved
                            </span>
                        }
                        else if (Model.OverallImprovementStatus == "Deteriorated")
                        {
                            <span class="badge bg-danger fs-6 px-4 py-2 rounded-pill">
                                <i class="bi bi-arrow-down-right-circle me-1"></i> Needs Attention
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark fs-6 px-4 py-2 rounded-pill">
                                <i class="bi bi-dash-circle me-1"></i> Stable Progress
                            </span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Line Chart: Progress Trajectory -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
        <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0">
            <h5 class="fw-bold text-dark mb-0">
                <i class="bi bi-activity me-2 text-primary"></i>
                Patient Recovery Line Graph
            </h5>
            <small class="text-muted">Progress score trajectory across all counseling sessions (X-axis: Sessions, Y-axis: Score 0-100)</small>
        </div>
        <div class="card-body p-4" style="min-height: 350px;">
            <canvas id="psychologistProgressLineChart" style="max-height: 320px;"></canvas>
        </div>
    </div>

    <!-- Session History Table with Key Observation Info -->
    <div class="card border-0 shadow-sm rounded-4 bg-white mb-4">
        <div class="card-header bg-transparent border-0 pt-4 px-4 pb-2">
            <h5 class="fw-bold text-dark mb-0">
                <i class="bi bi-journal-check me-2 text-primary"></i>
                Follow-up Sessions & Observation Key Details
            </h5>
            <small class="text-muted">Detailed observation stages, threshold scores, functional domains, and session improvement ratings</small>
        </div>
        <div class="card-body p-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Follow-up Session</th>
                            <th>Date & Time</th>
                            <th class="text-center">Mental Health</th>
                            <th class="text-center">Safety Risk</th>
                            <th>Functional Domains (5 Areas)</th>
                            <th class="text-center">Threshold Score</th>
                            <th class="text-center">Session Progress</th>
                            <th>Clinical Observation</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Sessions != null && Model.Sessions.Any())
                        {
                            @foreach (var s in Model.Sessions)
                            {
                                <tr>
                                    <td class="fw-bold text-primary">
                                        @(s.SessionNumber == 1 ? "Session 1 (Intake)" : $"Follow-up {s.SessionNumber - 1}")
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-dark">@s.SessionDate.ToString("MMM dd, yyyy")</div>
                                        <small class="text-muted">@s.CounselingTime</small>
                                    </td>
                                    <td class="text-center"><span class="badge bg-light text-dark border">@s.MentalHealthStatus</span></td>
                                    <td class="text-center"><span class="badge bg-light text-dark border">@s.SafetyRisk</span></td>
                                    <td class="small">
                                        <div class="d-flex flex-wrap gap-1">
                                            <span class="badge bg-light text-secondary border">Academic: @s.AcademicFunctioning</span>
                                            <span class="badge bg-light text-secondary border">Sleep: @s.SleepCondition</span>
                                            <span class="badge bg-light text-secondary border">Social: @s.SocialInteraction</span>
                                            <span class="badge bg-light text-secondary border">Daily: @s.DailyActivities</span>
                                            <span class="badge bg-light text-secondary border">Emotion: @s.EmotionalRegulation</span>
                                        </div>
                                    </td>
                                    <td class="text-center fs-6 fw-bold text-primary">@s.SessionScore / 100</td>
                                    <td class="text-center">
                                        @if (s.SessionImprovementStatus == "Improved")
                                        {
                                            <span class="badge bg-success rounded-pill px-3">
                                                <i class="bi bi-arrow-up-right me-1"></i> Improved
                                            </span>
                                        }
                                        else if (s.SessionImprovementStatus == "Deteriorated")
                                        {
                                            <span class="badge bg-danger rounded-pill px-3">
                                                <i class="bi bi-arrow-down-right me-1"></i> Deteriorated
                                            </span>
                                        }
                                        else if (s.SessionImprovementStatus == "Stable")
                                        {
                                            <span class="badge bg-info text-dark rounded-pill px-3">
                                                <i class="bi bi-dash me-1"></i> Stable
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary rounded-pill px-3">Baseline</span>
                                        }
                                    </td>
                                    <td class="small text-secondary" style="max-width: 300px;">
                                        @(string.IsNullOrEmpty(s.ClinicalObservation) ? "-" : s.ClinicalObservation)
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted py-4">No session observations recorded yet.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Final Overall Report: Initial vs Final Condition Summary -->
    @{
        var firstSession = Model.Sessions?.FirstOrDefault();
        var lastSession = Model.Sessions?.LastOrDefault();
    }
    @if (firstSession != null && lastSession != null)
    {
        <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden mb-4">
            <div class="card-header bg-dark text-white p-3">
                <h5 class="fw-bold mb-0">
                    <i class="bi bi-file-earmark-check-fill me-2 text-warning"></i>
                    Final Overall Screening &amp; Observation Report
                </h5>
                <small class="text-white-50">Comparative evaluation between Initial Intake Condition and Final Follow-up Outcome</small>
            </div>
            <div class="card-body p-4">
                <div class="row g-4">
                    <div class="col-md-6 border-end">
                        <div class="p-3 rounded-4 bg-light h-100">
                            <div class="d-flex align-items-center justify-content-between mb-3">
                                <span class="badge bg-secondary px-3 py-2 rounded-pill fs-6">Initial Condition (Baseline)</span>
                                <span class="fw-bold text-muted">@firstSession.SessionDate.ToString("MMM dd, yyyy")</span>
                            </div>
                            <ul class="list-group list-group-flush bg-transparent">
                                <li class="list-group-item bg-transparent px-0 d-flex justify-content-between">
                                    <span class="text-muted">Mental Health Status:</span>
                                    <strong class="text-danger">@firstSession.MentalHealthStatus</strong>
                                </li>
                                <li class="list-group-item bg-transparent px-0 d-flex justify-content-between">
                                    <span class="text-muted">Current Safety Risk:</span>
                                    <strong class="text-dark">@firstSession.SafetyRisk</strong>
                                </li>
                                <li class="list-group-item bg-transparent px-0 d-flex justify-content-between">
                                    <span class="text-muted">Academic Functioning:</span>
                                    <span>@firstSession.AcademicFunctioning</span>
                                </li>
                                <li class="list-group-item bg-transparent px-0 d-flex justify-content-between">
                                    <span class="text-muted">Sleep & Emotion:</span>
                                    <span>@firstSession.SleepCondition | @firstSession.EmotionalRegulation</span>
                                </li>
                                <li class="list-group-item bg-transparent px-0 d-flex justify-content-between">
                                    <span class="text-muted">Initial Baseline Score:</span>
                                    <span class="fw-bold fs-5 text-secondary">@firstSession.SessionScore / 100</span>
                                </li>
                            </ul>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="p-3 rounded-4 bg-light h-100">
                            <div class="d-flex align-items-center justify-content-between mb-3">
                                <span class="badge bg-success px-3 py-2 rounded-pill fs-6">
                                    @(Model.IsFinal ? "Final Discharged Condition" : "Latest Follow-up Condition")
                                </span>
                                <span class="fw-bold text-muted">@lastSession.SessionDate.ToString("MMM dd, yyyy")</span>
                            </div>
                            <ul class="list-group list-group-flush bg-transparent">
                                <li class="list-group-item bg-transparent px-0 d-flex justify-content-between">
                                    <span class="text-muted">Mental Health Status:</span>
                                    <strong class="text-success">@lastSession.MentalHealthStatus</strong>
                                </li>
                                <li class="list-group-item bg-transparent px-0 d-flex justify-content-between">
                                    <span class="text-muted">Current Safety Risk:</span>
                                    <strong class="text-success">@lastSession.SafetyRisk</strong>
                                </li>
                                <li class="list-group-item bg-transparent px-0 d-flex justify-content-between">
                                    <span class="text-muted">Academic Functioning:</span>
                                    <span>@lastSession.AcademicFunctioning</span>
                                </li>
                                <li class="list-group-item bg-transparent px-0 d-flex justify-content-between">
                                    <span class="text-muted">Sleep & Emotion:</span>
                                    <span>@lastSession.SleepCondition | @lastSession.EmotionalRegulation</span>
                                </li>
                                <li class="list-group-item bg-transparent px-0 d-flex justify-content-between">
                                    <span class="text-muted">Final Recovery Score:</span>
                                    <span class="fw-bold fs-5 text-success">@lastSession.SessionScore / 100</span>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>

                <div class="mt-4 p-3 rounded-3 bg-light text-center">
                    <div class="d-flex justify-content-around flex-wrap gap-3 align-items-center">
                        <div>
                            <span class="text-muted small d-block">Overall Patient Progress</span>
                            <span class="badge bg-success fs-6 px-4 py-2 rounded-pill">
                                <i class="bi bi-check-circle-fill me-1"></i> @Model.OverallImprovementStatus (@(Model.ScoreDifference >= 0 ? "+" + Model.ScoreDifference : Model.ScoreDifference.ToString()) pts)
                            </span>
                        </div>
                        <div>
                            <span class="text-muted small d-block">Follow-up Outcome Status</span>
                            <strong class="text-dark">@Model.FollowUpStatusText</strong>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const sessionLabels = [
                @Html.Raw(string.Join(",", (Model.Sessions ?? new List<StudentMentalHealthMonitoringSystem.ViewModels.SessionProgressDetail>()).Select(s => $"'Session {s.SessionNumber} ({s.SessionDate:MMM dd})'")))
            ];

            const scoresData = [@string.Join(",", (Model.Sessions ?? new List<StudentMentalHealthMonitoringSystem.ViewModels.SessionProgressDetail>()).Select(s => s.SessionScore))];

            const ctx = document.getElementById('psychologistProgressLineChart').getContext('2d');
            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: sessionLabels,
                    datasets: [{
                        label: 'Student Progress Score',
                        data: scoresData,
                        fill: false,
                        borderColor: '#a53838',
                        borderWidth: 3,
                        pointStyle: 'rect',
                        pointRadius: 9,
                        pointHoverRadius: 12,
                        pointBackgroundColor: '#a53838',
                        pointBorderColor: '#7a1f1f',
                        pointBorderWidth: 2,
                        tension: 0
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        x: {
                            grid: { display: true, color: '#e2e8f0' },
                            ticks: { font: { size: 13, weight: 'bold' }, color: '#1e293b' },
                            title: { display: true, text: 'Follow-up Sessions (Time / Date)', font: { size: 14, weight: 'bold' }, color: '#0f172a' }
                        },
                        y: {
                            min: 0,
                            max: 100,
                            ticks: {
                                stepSize: 20,
                                font: { size: 13, weight: 'bold' },
                                color: '#1e293b',
                                callback: function(value) { return value + ' pts'; }
                            },
                            grid: { color: '#cbd5e1' },
                            title: { display: true, text: 'Scoring Scale (0 - 100)', font: { size: 14, weight: 'bold' }, color: '#0f172a' }
                        }
                    },
                    plugins: {
                        legend: {
                            position: 'top',
                            labels: {
                                font: { size: 14, weight: 'bold' },
                                color: '#0f172a',
                                usePointStyle: true,
                                pointStyle: 'rect'
                            }
                        },
                        tooltip: {
                            callbacks: {
                                label: function (ctx) {
                                    return ` Progress Score: ${ctx.raw} / 100`;
                                }
                            }
                        }
                    }
                }
            });
        });
    </script>
}
