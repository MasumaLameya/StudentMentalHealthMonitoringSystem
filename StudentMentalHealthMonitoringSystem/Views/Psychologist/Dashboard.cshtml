@model StudentMentalHealthMonitoringSystem.ViewModels.PsychologistDashboardViewModel

@{
    ViewData["Title"] = "Psychologist Dashboard";
}

<style>

    /* =========================================================
           PSYCHOLOGIST DASHBOARD - NUDE LAVENDER THEME
           Only affects this page
           ========================================================= */

    .psy-dashboard {
        --psy-bg: #F8FAFC;
        --psy-white: #ffffff;
        --psy-lavender: #0284C7;
        --psy-lavender-dark: #0F172A;
        --psy-lavender-light: #F0F3F8;
        --psy-nude: #E2E8F0;
        --psy-nude-light: #F8FAFC;
        --psy-nude-dark: #334155;
        --psy-text: #0F172A;
        --psy-muted: #64748B;
        --psy-border: #E2E8F0;
        --psy-success: #10B981;
        --psy-warning: #F59E0B;
        --psy-danger: #EF4444;
        background: var(--psy-bg);
        min-height: calc(100vh - 60px);
        padding: 24px;
        font-size: 1.05rem;
    }


        /* ================= General Card ================= */

        .psy-dashboard .psy-card {
            background: var(--psy-white);
            border: 1px solid var(--psy-border);
            border-radius: 22px;
            box-shadow: 0 8px 30px rgba(77, 63, 94, 0.07);
        }


        /* =========================================================
           SIDEBAR
           ========================================================= */

        .psy-dashboard .psy-sidebar {
            position: sticky;
            top: 20px;
            overflow: hidden;
        }


        .psy-dashboard .psy-profile-area {
            padding: 32px 24px 25px;
            text-align: center;
            background: linear-gradient( 145deg, #f8f2ed 0%, #f2edf8 100% );
        }


        .psy-dashboard .psy-avatar-wrapper {
            width: 126px;
            height: 126px;
            margin: 0 auto 18px;
            padding: 5px;
            border-radius: 50%;
            background: linear-gradient( 135deg, var(--psy-nude-dark), var(--psy-lavender) );
            box-shadow: 0 8px 24px rgba(116, 95, 140, 0.18);
        }


        .psy-dashboard .psy-avatar {
            width: 116px;
            height: 116px;
            object-fit: cover;
            border-radius: 50%;
            border: 4px solid white;
        }


        .psy-dashboard .psy-profile-name {
            color: var(--psy-text);
            font-size: 22px;
            font-weight: 700;
            margin-bottom: 5px;
        }


        .psy-dashboard .psy-specialization {
            color: var(--psy-muted);
            font-size: 14px;
            margin-bottom: 0;
        }


        .psy-dashboard .psy-role-badge {
            display: inline-block;
            margin-top: 12px;
            padding: 6px 13px;
            background: var(--psy-lavender-light);
            color: var(--psy-lavender-dark);
            font-size: 12px;
            font-weight: 600;
            border-radius: 20px;
        }


        /* ================= Sidebar Menu ================= */

        .psy-dashboard .psy-menu {
            padding: 14px;
        }


            .psy-dashboard .psy-menu a {
                border: none;
                border-radius: 12px;
                margin-bottom: 7px;
                padding: 12px 14px;
                color: #5d5564;
                background: transparent;
                font-weight: 500;
                transition: all 0.2s ease;
            }


                .psy-dashboard .psy-menu a i {
                    width: 25px;
                    color: #998da5;
                }


                .psy-dashboard .psy-menu a:hover {
                    background: #f5f0f8;
                    color: var(--psy-lavender-dark);
                    transform: translateX(3px);
                }


                .psy-dashboard .psy-menu a.active {
                    background: linear-gradient( 135deg, #8e7ab8, #74629d );
                    color: white;
                    box-shadow: 0 7px 18px rgba(119, 98, 157, 0.22);
                }


                    .psy-dashboard .psy-menu a.active i {
                        color: white;
                    }


            .psy-dashboard .psy-menu .psy-logout {
                color: #a95e65;
                margin-top: 12px;
                border-top: 1px solid #eee9f0;
                padding-top: 15px;
            }


                .psy-dashboard .psy-menu .psy-logout:hover {
                    background: #fbefef;
                    color: #994f56;
                }


        /* =========================================================
           MAIN AREA
           ========================================================= */

        .psy-dashboard .psy-page-heading {
            margin-bottom: 24px;
        }


        .psy-dashboard .psy-page-title {
            color: var(--psy-text);
            font-size: 30px;
            font-weight: 750;
            margin-bottom: 5px;
        }


        .psy-dashboard .psy-page-subtitle {
            color: var(--psy-muted);
            margin-bottom: 0;
        }


        /* =========================================================
           STAT CARDS
           ========================================================= */

        .psy-dashboard .psy-stat-card {
            height: 100%;
            background: white;
            border: 1px solid var(--psy-border);
            border-radius: 19px;
            padding: 22px;
            box-shadow: 0 7px 24px rgba(67, 55, 78, 0.06);
            transition: all 0.2s ease;
        }


            .psy-dashboard .psy-stat-card:hover {
                transform: translateY(-3px);
                box-shadow: 0 12px 28px rgba(67, 55, 78, 0.10);
            }


        .psy-dashboard .psy-stat-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }


        .psy-dashboard .psy-stat-title {
            color: var(--psy-muted);
            font-size: 14px;
            font-weight: 600;
            margin-bottom: 7px;
        }


        .psy-dashboard .psy-stat-number {
            color: var(--psy-text);
            font-size: 31px;
            line-height: 1;
            font-weight: 750;
            margin-bottom: 0;
        }


        .psy-dashboard .psy-stat-icon {
            width: 52px;
            height: 52px;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 21px;
        }


        /* High Risk */

        .psy-dashboard .psy-risk-icon {
            background: #f8eaea;
            color: var(--psy-danger);
        }


        /* Today */

        .psy-dashboard .psy-today-icon {
            background: var(--psy-lavender-light);
            color: var(--psy-lavender);
        }


        /* Completed */

        .psy-dashboard .psy-completed-icon {
            background: #eaf3ef;
            color: var(--psy-success);
        }


        /* Pending */

        .psy-dashboard .psy-pending-icon {
            background: #f8f0e5;
            color: var(--psy-warning);
        }


        /* =========================================================
           WELCOME CARD
           ========================================================= */

        .psy-dashboard .psy-welcome-card {
            overflow: hidden;
            position: relative;
        }


        .psy-dashboard .psy-welcome-top {
            background: linear-gradient( 135deg, #eee5dc 0%, #eee9f7 100% );
            padding: 24px 26px;
            border-bottom: 1px solid var(--psy-border);
        }


        .psy-dashboard .psy-welcome-title {
            color: var(--psy-text);
            font-size: 20px;
            font-weight: 700;
            margin-bottom: 0;
        }


        .psy-dashboard .psy-welcome-body {
            padding: 28px;
        }


        .psy-dashboard .psy-welcome-name {
            color: var(--psy-lavender-dark);
            font-weight: 700;
        }


        .psy-dashboard .psy-info-box {
            background: #faf8fc;
            border: 1px solid #eee8f2;
            border-radius: 16px;
            padding: 17px 18px;
            display: flex;
            align-items: flex-start;
            margin-top: 20px;
        }


        .psy-dashboard .psy-info-icon {
            width: 42px;
            height: 42px;
            min-width: 42px;
            border-radius: 13px;
            background: var(--psy-lavender-light);
            color: var(--psy-lavender-dark);
            display: flex;
            justify-content: center;
            align-items: center;
            margin-right: 14px;
        }


        .psy-dashboard .psy-info-text {
            color: #6f6776;
            font-size: 14px;
            line-height: 1.7;
            margin: 0;
        }


    /* =========================================================
           RESPONSIVE
           ========================================================= */

    @@media (max-width: 991px) {

        .psy-dashboard {
            padding: 15px;
        }

            .psy-dashboard .psy-sidebar {
                position: static;
                margin-bottom: 24px;
            }

            .psy-dashboard .psy-page-title {
                font-size: 25px;
            }
    }

</style>


<div class="psy-dashboard">

    <div class="container-fluid p-0">

        <div class="row g-4">

            <!-- ===================================================== -->
            <!-- Sidebar -->
            <!-- ===================================================== -->

            <div class="col-lg-3">

                <div class="psy-card psy-sidebar">

                    <!-- ================= Profile ================= -->

                    <div class="psy-profile-area">

                        <div class="psy-avatar-wrapper">

                            @if (!string.IsNullOrEmpty(
                                Model.Psychologist?.ProfileImage))
                            {
                                <img src="@Model.Psychologist.ProfileImage"
                                     class="psy-avatar"
                                     alt="Psychologist Profile" />
                            }
                            else
                            {
                                <img src="https://ui-avatars.com/api/?name=@Model.Psychologist?.FullName&background=8D7AB8&color=ffffff&size=120"
                                     class="psy-avatar"
                                     alt="Psychologist Profile" />
                            }

                        </div>


                        <div class="psy-profile-name">

                            @Model.Psychologist?.FullName

                        </div>


                        <p class="psy-specialization">

                            @Model.Psychologist?.Specialization

                        </p>


                        <span class="psy-role-badge">

                            <i class="bi bi-heart-pulse me-1"></i>

                            Psychologist

                        </span>

                    </div>


                    <!-- ================= Menu ================= -->

                    <div class="psy-menu">

                        <div class="list-group">

                            <!-- Dashboard -->

                            <a asp-controller="Psychologist"
                               asp-action="Dashboard"
                               class="list-group-item list-group-item-action active">

                                <i class="bi bi-grid me-2"></i>

                                Dashboard

                            </a>


                            <!-- High Risk Students -->

                            <a asp-controller="Psychologist"
                               asp-action="Students"
                               class="list-group-item list-group-item-action">

                                <i class="bi bi-people me-2"></i>

                                High Risk Students

                            </a>


                            <!-- Counseling Schedule -->

                            <a asp-controller="Psychologist"
                               asp-action="Appointment"
                               class="list-group-item list-group-item-action">

                                <i class="bi bi-calendar-check me-2"></i>

                                Counseling Schedule

                            </a>


                            <!-- Counseling Notes -->

                            <a asp-controller="Psychologist"
                               asp-action="Counseling"
                               class="list-group-item list-group-item-action">

                                <i class="bi bi-journal-text me-2"></i>

                                Counseling Notes

                            </a>


                            <!-- Reports -->

                            <a asp-controller="Psychologist"
                               asp-action="Reports"
                               class="list-group-item list-group-item-action">

                                <i class="bi bi-bar-chart me-2"></i>

                                Reports

                            </a>


                            <!-- Profile -->

                            <a asp-controller="Psychologist"
                               asp-action="Profile"
                               class="list-group-item list-group-item-action">

                                <i class="bi bi-person-circle me-2"></i>

                                Profile

                            </a>


                            <!-- Logout -->

                            <a asp-controller="Psychologist"
                               asp-action="Logout"
                               class="list-group-item list-group-item-action psy-logout">

                                <i class="bi bi-box-arrow-right me-2"></i>

                                Logout

                            </a>

                        </div>

                    </div>

                </div>

            </div>


            <!-- ===================================================== -->
            <!-- Main Content -->
            <!-- ===================================================== -->

            <div class="col-lg-9">


                <!-- ================= Page Heading ================= -->

                <div class="psy-page-heading">

                    <h2 class="psy-page-title">

                        Psychologist Dashboard

                    </h2>


                    <p class="psy-page-subtitle">

                        Welcome back. Here is an overview of your
                        counseling activities.

                    </p>

                </div>


                <!-- ================================================= -->
                <!-- Statistics -->
                <!-- ================================================= -->

                <div class="row g-3 mb-4">


                    <!-- ================= High Risk ================= -->

                    <div class="col-md-6 col-xl-3">

                        <div class="psy-stat-card">

                            <div class="psy-stat-header">

                                <div>

                                    <div class="psy-stat-title">

                                        High Risk Students

                                    </div>

                                    <h2 class="psy-stat-number">

                                        @Model.HighRiskStudents

                                    </h2>

                                </div>


                                <div class="psy-stat-icon psy-risk-icon">

                                    <i class="bi bi-person-exclamation"></i>

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- ================= Today's Sessions ================= -->

                    <div class="col-md-6 col-xl-3">

                        <div class="psy-stat-card">

                            <div class="psy-stat-header">

                                <div>

                                    <div class="psy-stat-title">

                                        Today's Sessions

                                    </div>

                                    <h2 class="psy-stat-number">

                                        @Model.TodaySessions

                                    </h2>

                                </div>


                                <div class="psy-stat-icon psy-today-icon">

                                    <i class="bi bi-calendar2-check"></i>

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- ================= Completed ================= -->

                    <div class="col-md-6 col-xl-3">

                        <div class="psy-stat-card">

                            <div class="psy-stat-header">

                                <div>

                                    <div class="psy-stat-title">

                                        Completed

                                    </div>

                                    <h2 class="psy-stat-number">

                                        @Model.CompletedSessions

                                    </h2>

                                </div>


                                <div class="psy-stat-icon psy-completed-icon">

                                    <i class="bi bi-check-circle"></i>

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- ================= Pending ================= -->

                    <div class="col-md-6 col-xl-3">

                        <div class="psy-stat-card">

                            <div class="psy-stat-header">

                                <div>

                                    <div class="psy-stat-title">

                                        Pending

                                    </div>

                                    <h2 class="psy-stat-number">

                                        @Model.PendingSessions

                                    </h2>

                                </div>


                                <div class="psy-stat-icon psy-pending-icon">

                                    <i class="bi bi-hourglass-split"></i>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- ================================================= -->
                <!-- Dashboard Overview -->
                <!-- ================================================= -->

                <div class="psy-card psy-welcome-card">

                    <div class="psy-welcome-top">

                        <h5 class="psy-welcome-title">

                            <i class="bi bi-stars me-2"></i>

                            Dashboard Overview

                        </h5>

                    </div>


                    <div class="psy-welcome-body">

                        <h4 style="
                            color:#433D4B;
                            font-weight:700;">

                            Welcome,

                            <span class="psy-welcome-name">

                                @Model.Psychologist?.FullName

                            </span>

                        </h4>


                        <p style="
                            color:#82798A;
                            line-height:1.7;
                            margin-top:12px;">

                            Use your dashboard to review students,
                            manage counseling schedules, complete
                            counseling records and view reports.

                        </p>


                        <!-- ================= Information ================= -->

                        <div class="psy-info-box">

                            <div class="psy-info-icon">

                                <i class="bi bi-info-circle"></i>

                            </div>


                            <div>

                                <strong style="color:#514760;">

                                    Counseling Management

                                </strong>


                                <p class="psy-info-text mt-1">

                                    Students assigned to you can be viewed
                                    from Counseling Schedule. Open an
                                    appointment to review student information
                                    and complete the counseling record.

                                </p>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>